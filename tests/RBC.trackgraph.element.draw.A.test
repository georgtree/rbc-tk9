# RBC.trackgraph.element.draw.A.test --
#
###Abstract
# Trackgraph element draw tests, including interactions with owned tracks.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Package Definition
package provide trackgraph.element

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval trackgraph.element {
    source [file join [file dirname [info script]] RBC.trackgraph.support.tcl]

    # Number the generated cases independently within each test group.
    array set testCase {4 0}

    test RBC.trackgraph.element.draw.A.1.1 {element and axis ownership changes are checked before commit} -setup {
        Create
    } -body {
        list [catch {.tg element configure v -track current}] \
            [.tg element cget v -track] [.tg element cget v -mapy] \
            [catch {.tg track configure voltage -yaxes {}}] \
            [catch {.tg axis delete volts}] [catch {.tg track delete voltage}] \
            [catch {.tg yaxis use amps}]
    } -cleanup {destroy .tg} -result {1 voltage volts 1 1 1 1}

    test RBC.trackgraph.element.draw.A.2.1 {vector notifications update line and strip geometry in their own tracks} -setup {
        Create
        ::rbc::vector create trackX trackY
        trackX set {0 5 10}
        trackY set {0 0 0}
        .tg element configure i -xdata trackX -ydata trackY
    } -body {
        trackY set {1 2 3}
        update
        lassign [.tg track transform current 5 2] x y
        list [.tg element closest $x $y hit -halo 3] $hit(name) $hit(index) $hit(y)
    } -cleanup {destroy .tg; ::rbc::vector destroy trackX trackY} -result {1 i 1 2.0}

    test RBC.trackgraph.element.draw.A.3.1 {out-of-range lines are clipped to their owning track} -setup {
        Create
        .tg element configure v -data {0 -100 10 100}
    } -body {
        set svg [.tg svg output]
        lassign [.tg track bbox voltage] l t r b
        set count 0
        set valid 1
        foreach line [split $svg \n] {
            if {[string first {stroke="#ff0000"} $line]<0} {continue}
            if {[regexp {<polyline points="([^"]+)"} $line -> points]} {
                foreach {x y} [string map {, { }} $points] {
                    if {$y < $t-1 || $y > $b+1} {set valid 0}
                    incr count
                }
            }
        }
        list [expr {$count>0}] $valid
    } -cleanup {destroy .tg} -result {1 1}

    foreach renderer {native cairo} {
        foreach inverted {0 1} {
            test RBC.trackgraph.element.draw.A.4.[incr testCase(4)] {out-of-range trace pixels remain inside their track} \
                -constraints trackRenderer$renderer -setup {
                Create $inverted
                .tg configure -renderer $renderer
                .tg element configure v -data {0 -100 10 100} -linewidth 1
                set photo [image create photo]
            } -body {
                update
                .tg snap $photo
                lassign [.tg track bbox voltage] l t r b
                set count 0
                set outside 0
                for {set y 0} {$y < [image height $photo]} {incr y} {
                    for {set x 0} {$x < [image width $photo]} {incr x} {
                        lassign [$photo get $x $y] red green blue
                        if {$red>180 && $green<80 && $blue<80} {
                            incr count
                            if {$y < $t-1 || $y > $b+1 || $x < $l-1 || $x > $r+1} {incr outside}
                        }
                    }
                }
                list [expr {$count>0}] $outside
            } -cleanup {image delete $photo; destroy .tg} -result {1 0}
        }
    }
    cleanupTests
}
namespace delete ::trackgraph.element
