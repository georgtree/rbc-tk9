	# ------------------------------------------------------------------------------------
	# Purpose: Tests different conditions when evaluating norm
	# ------------------------------------------------------------------------------------ 
	test RBC.vector.expr.A.1.48 {
		Test norm
	} -setup {
		vector create Vector1
		Vector1 set {-13.11 -1.5 7.3 9.5 -1.1 1.2}
	} -body {
		vector expr {norm(Vector1)} 
	} -cleanup {
		vector destroy Vector1
	} -result {0.0 0.5134896063688633 0.9026979212737727 1.0 0.5311808934099956 0.6329057938965059}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Tests different conditions when evaluating sort (ascending by default)
	# ------------------------------------------------------------------------------------ 
	test RBC.vector.expr.A.1.49 {
		Test sort
	} -setup {
		vector create Vector1
		Vector1 set {-13.11 -1.5 7.3 9.5 -1.1 1.2}
	} -body {
		vector expr {sort(Vector1)} 
	} -cleanup {
		vector destroy Vector1
	} -result {-13.11 -1.5 -1.1 1.2 7.3 9.5}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Tests different conditions when evaluating random (produces vector)
	# ------------------------------------------------------------------------------------ 
	test RBC.vector.expr.A.1.50 {
		Test random
	} -setup {
		vector create Vector1(5)
	} -body {
		vector expr {random(Vector1)}
		for {set i 0} {$i < [Vector1 length]} {incr i} {
	        if {[Vector1 index $i] < 0 || [Vector1 index $i] > 1} {
	            return 0
	        }
	    }
	    return 1
	} -cleanup {
		vector destroy Vector1
	} -result {1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Tests length when vector has no elements
	# ------------------------------------------------------------------------------------ 
	test RBC.vector.expr.A.1.51 {
		Test length no elements
	} -setup {
		vector create Vector1(0)
	} -body {
		vector expr {length(Vector1)} 
	} -cleanup {
		vector destroy Vector1
	} -result {0.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure command substitution works inside vector expressions.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.1 {
		Command substitution
	} -body {
		vector expr {[expr {2 + 3}]}
	} -result {5.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure command substitution may contain multiple Tcl commands.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.2 {
		Multiple commands in command substitution
	} -body {
		vector expr {[set ::rbcVectorExprTmp 4; expr {$::rbcVectorExprTmp + 3}]}
	} -cleanup {
		unset -nocomplain ::rbcVectorExprTmp
	} -result {7.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure nested brackets are matched correctly.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.3 {
		Nested command substitution
	} -body {
		vector expr {[expr {[expr {2 + 3}] * 2}]}
	} -result {10.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the expression parser resumes immediately after the matching ].
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.4 {
		Command substitution termination
	} -body {
		vector expr {
			[expr {2 + 3}] * 4
		}
	} -result {20.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure malformed command substitution reports an error.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.5 {
		Missing close bracket
	} -body {
		set code [catch { vector expr {[expr {2 + 3}} } message]
		list $code [string match {*missing close-bracket*} $message]
	} -result {1 1}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure errors from nested Tcl commands propagate normally.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.6 {
		Command substitution error
	} -body {
		set code [catch {vector expr {[error nested-failure]}} message]
		list $code $message
	} -result {1 nested-failure}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure command substitution results larger than the embedded parse buffer
	#          are handled correctly.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.7 {
		Large command substitution
	} -body {
		vector expr {[format %0200d 5]}
	} -result {5.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Exercise cleanup of an expanded substitution buffer on an error path.
	# ------------------------------------------------------------------------------------
	test RBC.vector.expr.A.2.8 {
		Large command substitution error
	} -body {
		catch {vector expr {[string repeat x 200]}}
	} -result {1}

    test RBC.vector.expr.A.3.1 {
