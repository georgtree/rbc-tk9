    test RBC.vector.expr.A.5.9 {
        complex vector expression: precedence
    } -setup {
        vector create A -type complex
        vector create B -type complex
        A set {{1 2}}
        B set {{3 4}}
    } -body {
        vector expr {A + B * 2}
    } -cleanup {
        catch {vector destroy A}
        catch {vector destroy B}
    } -result {{7.0 10.0}}

    test RBC.vector.expr.A.5.10 {
        complex instance expr
    } -setup {
        vector create C -type complex
        C set {{1 2} {3 4}}
    } -body {
        C expr {C * 2}
        list [C type] [C range 0 end]
    } -cleanup {
        catch {vector destroy C}
    } -result {complex {{2.0 4.0} {6.0 8.0}}}

    test RBC.vector.expr.A.5.11 {
        real target rejects complex expression result
    } -setup {
        vector create R
        vector create C -type complex
        R set {10 20}
        C set {{1 2} {3 4}}
    } -body {
        set code [catch {R expr {C + 1}} message]
        list $code $message [R range 0 end]
    } -cleanup {
        catch {vector destroy R}
        catch {vector destroy C}
    } -result {1 {can't store complex expression result in real vector} {10.0 20.0}}

    # ------------------------------------------------------------------------------------
    # Purpose: Test complex-valued math functions that return real values.
    # ------------------------------------------------------------------------------------
    test RBC.vector.expr.A.6.1 {
        complex abs
    } -setup {
        vector create C -type complex
        C set {{3 4} {-3 4} {0 -2}}
    } -body {
        vector expr {abs(C)}
    } -cleanup {
        catch {vector destroy C}
    } -result {5.0 5.0 2.0}

    test RBC.vector.expr.A.6.2 {
        complex arg
    } -setup {
        vector create C -type complex
        C set {{1 0} {0 1} {-1 0} {0 -1}}
    } -body {
        set values [vector expr {arg(C)}]
        lassign $values a b c d
        set pi [expr {acos(-1.0)}]
        expr {
            abs($a) < 1.0e-12 &&
            abs($b - $pi / 2.0) < 1.0e-12 &&
            abs($c - $pi) < 1.0e-12 &&
            abs($d + $pi / 2.0) < 1.0e-12
        }
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.6.3 {
        complex real
    } -setup {
        vector create C -type complex
        C set {{1 2} {-3 4} {0 -5}}
    } -body {
        vector expr {real(C)}
    } -cleanup {
        catch {vector destroy C}
    } -result {1.0 -3.0 0.0}

    test RBC.vector.expr.A.6.4 {
        complex imag
    } -setup {
        vector create C -type complex
        C set {{1 2} {-3 4} {0 -5}}
    } -body {
        vector expr {imag(C)}
    } -cleanup {
        catch {vector destroy C}
    } -result {2.0 4.0 -5.0}

    test RBC.vector.expr.A.6.5 {
        complex conj
    } -setup {
        vector create C -type complex
        C set {{1 2} {-3 4} {0 -5}}
    } -body {
        vector expr {conj(C)}
    } -cleanup {
        catch {vector destroy C}
    } -result {{1.0 -2.0} {-3.0 -4.0} {0.0 5.0}}

    test RBC.vector.expr.A.6.6 {
        complex projection participates in real expression
    } -setup {
        vector create C -type complex
        C set {{1 2} {3 -4}}
    } -body {
        vector expr {real(C) + imag(C)}
    } -cleanup {
        catch {vector destroy C}
    } -result {3.0 -1.0}

    test RBC.vector.expr.A.6.7 {
        real projection functions
    } -setup {
        vector create R
        R set {-2 0 3}
    } -body {
        list [vector expr {real(R)}] [vector expr {imag(R)}] [vector expr {conj(R)}]
    } -cleanup {
        catch {vector destroy R}
    } -result {{-2.0 0.0 3.0} {0.0 0.0 0.0} {-2.0 0.0 3.0}}

    test RBC.vector.expr.A.6.8 {
        complex target accepts real math result
    } -setup {
        vector create C -type complex
        C set {{3 4} {5 12}}
    } -body {
        C expr {abs(C)}
        list [C type] [C range 0 end]
    } -cleanup {
        catch {vector destroy C}
    } -result {complex {{5.0 0.0} {13.0 0.0}}}

    # ------------------------------------------------------------------------------------
    # Purpose: Test complex-valued transcendental math functions.
    # ------------------------------------------------------------------------------------
    test RBC.vector.expr.A.7.1 {
        complex sqrt
    } -setup {
        vector create C -type complex
        C set {{-1 0} {3 4} {3 -4}}
    } -body {
        vector expr {sqrt(C)}
    } -cleanup {
        catch {vector destroy C}
    } -result {{0.0 1.0} {2.0 1.0} {2.0 -1.0}}

    test RBC.vector.expr.A.7.2 {
        complex log principal branch
    } -setup {
        vector create C -type complex
        C set {{-1 0} {0 1}}
    } -body {
        set values [vector expr {log(C)}]
        lassign $values a b
        lassign $a ar ai
        lassign $b br bi
        set pi [expr {acos(-1.0)}]
        expr {
            abs($ar) < 1.0e-12 &&
            abs($ai - $pi) < 1.0e-12 &&
            abs($br) < 1.0e-12 &&
            abs($bi - $pi / 2.0) < 1.0e-12
        }
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.7.3 {
        complex exp log round trip
    } -setup {
        vector create C -type complex
        C set {{2 3} {-2 3} {0.5 -1.25}}
    } -body {
        set actual [vector expr {exp(log(C))}]
        set expected [C range 0 end]
        foreach a $actual e $expected {
            lassign $a ar ai
            lassign $e er ei
            if {abs($ar - $er) > 1.0e-12 || abs($ai - $ei) > 1.0e-12} {
                return 0
            }
        }
        return 1
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.7.4 {
        complex log10
    } -setup {
        vector create C -type complex
        C set {{2 3} {-2 3} {0.5 -1.25}}
    } -body {
        set actual [vector expr {log10(C) * log(10)}]
        set expected [vector expr {log(C)}]
        foreach a $actual e $expected {
            lassign $a ar ai
            lassign $e er ei
            if {abs($ar - $er) > 1.0e-12 || abs($ai - $ei) > 1.0e-12} {
                return 0
            }
        }
        return 1
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.7.5 {
        complex sin cos identity
    } -setup {
        vector create C -type complex
        C set {{0.5 1.25} {-1 0.75} {2 -0.5}}
    } -body {
        set values [vector expr { sin(C) * sin(C) + cos(C) * cos(C) }]
        foreach value $values {
            lassign $value real imag
            if {abs($real - 1.0) > 1.0e-12 || abs($imag) > 1.0e-12} {
                return 0
            }
        }
        return 1
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.7.6 {
        complex sinh cosh identity
    } -setup {
        vector create C -type complex
        C set {{0.5 1.25} {-1 0.75} {2 -0.5}}
    } -body {
        set values [vector expr { cosh(C) * cosh(C) - sinh(C) * sinh(C) }]
        foreach value $values {
            lassign $value real imag
            if {abs($real - 1.0) > 1.0e-12 || abs($imag) > 1.0e-12} {
                return 0
            }
        }
        return 1
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.7.7 {
        real and complex sqrt preserve type semantics
    } -body {
        set realCode [catch { vector expr {sqrt(-1)} }]
        set complexValue [ vector expr {sqrt({-1 0})} ]
        list $realCode $complexValue
    } -result {1 {{0.0 1.0}}}

    # ------------------------------------------------------------------------------------
    # Purpose: Test complex tangent and inverse trigonometric functions.
    # ------------------------------------------------------------------------------------
    test RBC.vector.expr.A.8.1 {
        complex tan agrees with sin/cos
    } -setup {
        vector create C -type complex
        C set {{0.5 1.25} {-1 0.75} {2 -0.5}}
    } -body {
        set actual [vector expr {tan(C)}]
        set expected [vector expr {sin(C) / cos(C)}]
        foreach a $actual e $expected {
            lassign $a ar ai
            lassign $e er ei
            if {abs($ar - $er) > 1.0e-12 || abs($ai - $ei) > 1.0e-12} {
                return 0
            }
        }
        return 1
    } -cleanup {
        catch {vector destroy C}
    } -result 1

    test RBC.vector.expr.A.8.2 {
        complex tanh agrees with sinh/cosh
    } -setup {
        vector create C -type complex
        C set {{0.5 1.25} {-1 0.75} {2 -0.5}}
    } -body {
        set actual [vector expr {tanh(C)}]
        set expected [vector expr {sinh(C) / cosh(C)}]
        foreach a $actual e $expected {
            lassign $a ar ai
            lassign $e er ei
            if {abs($ar - $er) > 1.0e-12 || abs($ai - $ei) > 1.0e-12} {
                return 0
            }
        }
        return 1
    } -cleanup {
        catch {vector destroy C}
    } -result 1

