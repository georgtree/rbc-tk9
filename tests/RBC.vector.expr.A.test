        catch {vector destroy B}
    } -result {{11.0 2.0} {23.0 -1.0}}

    test RBC.vector.expr.A.5.8 {
        complex vector expression: scalar first
    } -setup {
        vector create C -type complex
        C set {{1 2} {3 -1}}
    } -body {
