        catch {vector expr $expression}
    } -result 1

    # ------------------------------------------------------------------------------------
    # Purpose: Ensure floating-point domain errors set both the result and structured
    #          errorCode correctly.
    # ------------------------------------------------------------------------------------
    test RBC.vector.expr.A.4.1 {
        Math domain error result and errorCode
    } -body {
        set code [catch {vector expr {sqrt(-1)}} message options]
        list $code $message [dict get $options -errorcode]
    } -result {1 {domain error: argument not in valid range} {ARITH DOMAIN {domain error: argument not in valid\
                                                                                    range}}}

    test RBC.vector.expr.A.5.1 {
        complex vector expression: vector value
    } -setup {
