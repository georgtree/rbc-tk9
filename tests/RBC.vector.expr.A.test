    test RBC.vector.expr.A.8.7 {
        complex atan round trip
    } -setup {
        vector create C -type complex
        C set {{0.5 0.25} {-1 0.75} {2 -0.5} {-2 -0.25}}
    } -body {
        set actual [vector expr {tan(atan(C))}]
        set expected [C range 0 end]
        foreach a $actual e $expected {
            lassign $a ar ai
            lassign $e er ei
            if {abs($ar - $er) > 1.0e-12 || abs($ai - $ei) > 1.0e-12} {
