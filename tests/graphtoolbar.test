test generalConfiguration-1 {names subcommand} -setup {
    set widget [graphtoolbar .gtb -width 400 -height 400]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
} -body {
    $widget names
} -result {makeSnapshotBut postScriptDialogBut graph toolbarFrame} -cleanup {
    destroy $widget
}

