test crosshairsInteractive-44 {smith closest axis mode uses mapped axis commands}\
        -constraints {isInteractive isCrosshairs} -setup {
    proc ::ClosestSmithAxisFormat {prefix widget value} {
        return "${prefix}:$value"
    }
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation smith\
                        -smithgrid impedance -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}\
                        -crosshairsmarkopts {-formatx .6g -formaty .6g}]
    pack .gtb -fill both -expand yes
    set graph [$widget subwidget graph]
    $graph configure -title {smith closest axis mode uses mapped axis commands} {*}$titleFont
    $graph axis configure x -min -1.2 -max 1.2 -command [list ::ClosestSmithAxisFormat GAMMA-REAL]
    $graph axis configure y -min -1.2 -max 1.2 -command [list ::ClosestSmithAxisFormat GAMMA-IMAG]
    #
    # Underlying Smith element coordinates are reflection
    # coefficient coordinates, Gamma = 0.2 + j0.4.
    #
    $graph element create Trace1 -data {0.2 0.4}
    #
    # Smith closest mode normally defaults to normalized impedance,
    # so select axis mode explicitly.
    #
    $widget configure -coordclosestmark axis
} -body {
    WaitForWindow $graph
    set x [$graph axis transform x 0.2]
    set y [$graph axis transform y 0.4]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    set lines [split [$graph marker cget crosshairsClosestText -text] \n]
    list [lindex $lines 0] [lindex $lines 1] [lindex $lines 2]
} -cleanup {
    rename ::ClosestSmithAxisFormat {}
    destroy .gtb
} -result {Trace1 real(h)=GAMMA-REAL:0.2 imag(v)=GAMMA-IMAG:0.4}

test crosshairsInteractive-45 {closest line marker displays parameter mapping}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest -crosshairsclosestopts\
                        {-interpolate no -halo 10 -single yes} -crosshairsmarkopts\
                        {-formatx .4g -formaty .4g -formatparam .3e}]
    pack .gtb -fill both -expand yes
    set graph [$widget subwidget graph]
    vector create param45
    param45 set {1.0e9 2.0e9 3.0e9}
    $graph element create Trace1 -x {0 1 2} -y {0 1 0} -param param45
} -body {
    WaitForWindow $graph
    lassign [$graph transform 1 1] x y
    GenerateGraphEvent $graph <Motion> $x $y $defaultDelay
    split [$graph marker cget crosshairsClosestText -text] \n
} -result {Trace1 x(h)=1 y(v)=1 param=2.000e+09} -cleanup {
    catch {vector destroy param45}
    destroy $widget
}

test crosshairsInteractive-46 {closest marker omits unavailable parameter mapping}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest -crosshairsclosestopts\
                        {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    set graph [$widget subwidget graph]
    vector create x46 y46 param46
    x46 set {0 1 2}
    y46 set {0 1 0}
    param46 set {10 20 30}
    $graph element create Trace1 -x x46 -y y46 -param param46
    # Valid after configuration, then deliberately make the live
    # parameter mapping temporarily unavailable.
    param46 length 2
} -body {
    WaitForWindow $graph
    lassign [$graph transform 1 1] x y
    GenerateGraphEvent $graph <Motion> $x $y $defaultDelay
    set text [$graph marker cget crosshairsClosestText -text]
    list [string match {*param=*} $text] [split $text \n]
} -result {0 {Trace1 x(h)=1 y(v)=1}} -cleanup {
    catch {vector destroy x46 y46 param46}
    destroy $widget
}

test crosshairsInteractive-47 {smith closest marker displays parameter mapping} \
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation smith -crosshairs -crosshairsmode closest\
                        -coordclosestmark gamma -crosshairsclosestopts {-interpolate no -halo 10 -single yes}\
                        -crosshairsmarkopts {-formatx .3g -formaty .3g -formatparam .3e}]
    pack .gtb -fill both -expand yes
    set graph [$widget subwidget graph]
    vector create gamma47 -type complex
    vector create frequency47
    gamma47 set {{0.0 0.0} {0.2 0.4} {0.4 0.2}}
    frequency47 set { 1.0e9 2.0e9 3.0e9 }
    $graph element create Trace1 -cdata gamma47 -param frequency47
} -body {
    WaitForWindow $graph
    $widget configure -coordclosestmark gamma
    lassign [$graph transform 0.2 0.4] x y
    GenerateGraphEvent $graph <Motion> $x $y $defaultDelay
    split [$graph marker cget crosshairsClosestText -text] \n
} -result {Trace1 Gamma=0.2+j0.4 param=2.000e+09} -cleanup {
    catch {vector destroy gamma47 frequency47}
    destroy $widget
}

#### axes
test axesInteractive-1 {change of axis scale} -constraints {isInteractive isAxes} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -scaletoggle all]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {change of axis scale} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
    set axis x
    set side bottom
} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph $axis $side] axisX axisY
    set plotX [expr {[$graph extents leftmargin] + [$graph extents plotwidth] / 2}]
    set plotY [expr {[$graph extents topmargin] + [$graph extents plotheight] / 2}]
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $plotX $plotY $defaultDelay
    return $scale
}  -result {0 1} -cleanup {
    destroy $widget
}

test axesInteractive-2 {polar grid axis cannot be toggled to logarithmic scale}\
        -constraints {isInteractive isAxes} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -scaletoggle all]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar grid axis cannot be logarithmic} {*}$titleFont
    $widget graph axis configure x -min 1 -max 10 -hide no
    $widget graph axis configure y -min 1 -max 10 -hide no
    $widget graph grid configure -hide no
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph x bottom] axisX axisY
    set before [$graph axis cget x -logscale]
    GenerateGraphEvent $graph <Motion> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    list $before [$graph axis cget x -logscale]
} -result {0 0} -cleanup {
    destroy $widget
}

test axesInteractive-3 {polar auxiliary axis can be toggled to logarithmic scale}\
        -constraints {isInteractive isAxes} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -scaletoggle all]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar auxiliary axis can be logarithmic} {*}$titleFont
    $widget graph axis create xAlt -min 1 -max 100
    $widget graph x2axis use xAlt
    $widget setAxisActiveScale all
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph xAlt top] axisX axisY
    set before [$graph axis cget xAlt -logscale]
    GenerateGraphEvent $graph <Motion> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    list $before [$graph axis cget xAlt -logscale]
} -result {0 1} -cleanup {
    destroy $widget
}

#### cross-interactions
test crossInteractive-1 {single-stage zoom, check crosshairs marking disabling during selection}\
        -match approxEqual -constraints {isInteractive isCross} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoomtitle -zoommark\
                        -zoomboxopts {-linewidth 1} -crosshairs -crosshairsmode current]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {single-stage zoom, check crosshairs marking disabling during\
                                            selection} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox $defaultDelay
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox $defaultDelay
    set crosshairsMarkerExists [$widget graph marker exists crosshairsText]
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <Motion> [expr {$bXPointBox+1}] [expr {$bYPointBox+1}] $defaultDelay
    sleep $defaultDelay
    lappend crosshairsMarkerExists [$widget graph marker exists crosshairsText]
    return $crosshairsMarkerExists
}  -result {0 1}  -cleanup {
    destroy $widget
}

