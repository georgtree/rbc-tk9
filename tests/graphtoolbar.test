test crosshairsInteractive-37 {closest bar marker: outside-arrow threshold follows configured arrow shape}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}\
                        -crosshairsbarlineopts {-arrowshape {50 60 10}}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: outside-arrow threshold follows configured arrow shape}\
            {*}$titleFont
    $widget graph configure -barwidth 0.8 -baseline 5
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    #
    # This bar is much longer than the tiny-bar case above, but is
    # deliberately too short for two 60-pixel arrowheads.
    #
    $widget graph element create Bar1 -data {5 7}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 5 6] x y
    set found [$graph element closest $x $y info -along both -interpolate no -halo 1000 Bar1]
    set x [expr {round(($info(left)+$info(right))/2.0)}]
    set y [expr {round(($info(top)+$info(bottom))/2.0)}]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    set firstMarker crosshairsClosestBarLineFirstArrow
    set lastMarker crosshairsClosestBarLineLastArrow
    list $found [$graph marker cget crosshairsClosestBarLine -arrow] [$graph marker exists $firstMarker]\
            [$graph marker cget $firstMarker -arrow] [$graph marker exists $lastMarker]\
            [$graph marker cget $lastMarker -arrow]
} -cleanup {
    unset -nocomplain info
    destroy .gtb
} -result {1 none 1 first 1 first}

test crosshairsInteractive-38 {closest marker: axis commands format bar values}\
        -constraints {isInteractive isCrosshairs} -setup {
    proc ::ClosestAxisFormat {prefix widget value} {
        return "${prefix}:${widget}:${value}"
    }
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}\
                        -crosshairsmarkopts {-formatx .2f -formaty .1f}]
    pack .gtb -fill both -expand yes
    set graph [.gtb subwidget graph]
    $graph configure -title {closest marker: axis commands format bar values} {*}$titleFont
    $graph configure -barwidth 0.8
    $graph axis configure x -min 0 -max 10 -command [list ::ClosestAxisFormat {X label}]
    $graph axis configure y -min 0 -max 10 -command [list ::ClosestAxisFormat {Y label}]
    $graph element create Bar1 -data {2.34567 7.12549}
} -body {
    WaitForWindow $graph
    set x [$graph axis transform x 2.34567]
    set y [$graph axis transform y 4]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    set lines [split [$graph marker cget crosshairsClosestText -text] \n]
    list [lindex $lines 0] [lindex $lines 1] [lindex $lines 2]
} -cleanup {
    rename ::ClosestAxisFormat {}
    destroy .gtb
} -result {Bar1 {x(h)=X label:.gtb.graph:2.34567} {y(v)=Y label:.gtb.graph:7.12549}}

test crosshairsInteractive-39 {closest bar marker: categorical x-axis command replaces raw value}\
        -constraints {isInteractive isCrosshairs} -setup {
    proc ::ClosestCategoryFormat {widget value} {
        set labels [dict create 1 January 2 February 3 March]
        return [dict get $labels $value]
    }
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}\
                        -crosshairsmarkopts {-formatx .3f -formaty .2f}]
    pack .gtb -fill both -expand yes
    set graph [.gtb subwidget graph]
    $graph configure -title {closest bar marker: categorical x-axis command replaces raw value} {*}$titleFont
    $graph configure -barwidth 0.8
    $graph axis configure x -min 0 -max 4 -majorticks {1 2 3} -command ::ClosestCategoryFormat
    $graph axis configure y -min 0 -max 10
    $graph element create Bar1 -data {2 7.5}
} -body {
    WaitForWindow $graph
    set x [$graph axis transform x 2]
    set y [$graph axis transform y 4]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    set lines [split [$graph marker cget crosshairsClosestText -text] \n]
    list [lindex $lines 1] [lindex $lines 2]
} -cleanup {
    rename ::ClosestCategoryFormat {}
    destroy .gtb
} -result {x(h)=February y(v)=7.50}


test crosshairsInteractive-40 {closest marker: failing axis command falls back to normal formatted value}\
        -constraints {isInteractive isCrosshairs} -setup {
    set ::closestAxisFailCalled 0
    proc ::ClosestAxisFailFormat {widget value} {
        #
        # Normal major-tick formatting must succeed.  Only the
        # selected bar value fails, so RBC's own axis redraw does
        # not generate an unrelated background error.
        #
        if {$value eq {2.25}} {
            set ::closestAxisFailCalled 1
            error {intentional closest-marker formatter failure}
        }
        return "tick:$value"
    }
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}\
                        -crosshairsmarkopts {-formatx .3f -formaty .1f}]
    pack .gtb -fill both -expand yes
    set graph [.gtb subwidget graph]
    $graph configure -title {closest marker: failing axis command falls back to normal formatted value} {*}$titleFont
    $graph configure -barwidth 0.8
    $graph axis configure x -min 0 -max 10 -majorticks {0 2 4 6 8 10} -command ::ClosestAxisFailFormat
    $graph axis configure y -min 0 -max 10
    $graph element create Bar1 -data {2.25 7}
} -body {
    WaitForWindow $graph
    #
    # Clear any state from the initial graph layout.  2.25 is not
    # one of the explicitly configured major ticks.
    #
    set ::closestAxisFailCalled 0
    set x [$graph axis transform x 2.25]
    set y [$graph axis transform y 4]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    set lines [split [$graph marker cget crosshairsClosestText -text] \n]
    list [lindex $lines 1] [lindex $lines 2] $::closestAxisFailCalled
} -cleanup {
    unset -nocomplain ::closestAxisFailCalled
    rename ::ClosestAxisFailFormat {}
    destroy .gtb
} -result {x(h)=2.250 y(v)=7.0 1}


test crosshairsInteractive-41 {closest marker: formatter follows element mapped axes}\
        -constraints {isInteractive isCrosshairs} -setup {
    proc ::ClosestMappedAxisFormat {prefix widget value} {
        return "${prefix}:$value"
    }
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    set graph [.gtb subwidget graph]
    $graph configure -title {closest marker: formatter follows element mapped axes} {*}$titleFont
    #
    # Give the primary axes deliberately different formatters.  If
    # ClosestAxisMarkerText accidentally uses x/y instead of the
    # element's mappings, this test will expose it.
    #
    $graph axis configure x -min 0 -max 10 -command [list ::ClosestMappedAxisFormat PRIMARY-X]
    $graph axis configure y -min 0 -max 10 -command [list ::ClosestMappedAxisFormat PRIMARY-Y]
    $graph axis create xAlt -min 100 -max 200 -command [list ::ClosestMappedAxisFormat ALT-X]
    $graph axis create yAlt -min 0 -max 2000 -command [list ::ClosestMappedAxisFormat ALT-Y]
    $graph x2axis use xAlt
    $graph y2axis use yAlt
    $graph element create Bar1 -data {150 1250} -mapx xAlt -mapy yAlt
} -body {
    WaitForWindow $graph
    set x [$graph axis transform xAlt 150]
    set y [$graph axis transform yAlt 600]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    set lines [split [$graph marker cget crosshairsClosestText -text] \n]
    list [lindex $lines 1] [lindex $lines 2]
} -cleanup {
    rename ::ClosestMappedAxisFormat {}
    destroy .gtb
} -result {xAlt(h)=ALT-X:150 yAlt(v)=ALT-Y:1250}


