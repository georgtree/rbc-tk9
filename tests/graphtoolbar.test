test crosshairsInteractive-21 {closest bar marker: stacked mode marks only selected segment}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: stacked mode marks only selected segment} {*}$titleFont
    $widget graph configure -barwidth 0.8 -baseline 0 -barmode stacked
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Element1 -data {7 3}
    $widget graph element create Element2 -data {7 5}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 7 4] x y
    $graph element closest $x $y info1 -along both -interpolate no -halo 1000 Element1
    $graph element closest $x $y info2 -along both -interpolate no -halo 1000 Element2
    lassign [$graph transform 7 0] baseX baseY
    if {(abs($info1(top) - $baseY) > 1.0) && (abs($info1(bottom) - $baseY) > 1.0)} {
        set element Element1
        array set selected [array get info1]
    } else {
        set element Element2
        array set selected [array get info2]
    }
    set x [expr {round(($selected(left) + $selected(right)) / 2.0)}]
    set y [expr {round(($selected(top) + $selected(bottom)) / 2.0)}]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    lassign [MarkerWidgetCoords $graph crosshairsClosestBarLine] lineX1 lineY1 lineX2 lineY2
    set markedElement [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    list [expr {$markedElement eq $element}] [expr {abs($lineY1 - $selected(top)) <= 1.0}]\
            [expr {abs($lineY2 - $selected(bottom)) <= 1.0}] [expr {abs($lineY1 - $baseY) > 1.0}]\
            [expr {abs($lineY2 - $baseY) > 1.0}]
} -cleanup {
    unset -nocomplain info1 info2 selected
    destroy .gtb
} -result {1 1 1 1 1}

test crosshairsInteractive-22 {closest bar marker: aligned mode uses selected rendered rectangle}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: aligned mode uses selected rendered rectangle} {*}$titleFont
    $widget graph configure -barwidth 0.8 -barmode aligned
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Element1 -data {7 4}
    $widget graph element create Element2 -data {7 7}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 7 2] x y
    $graph element closest $x $y info1 -along both -interpolate no -halo 1000 Element1
    $graph element closest $x $y info2 -along both -interpolate no -halo 1000 Element2
    set x [expr {round(($info1(left) + $info1(right)) / 2.0)}]
    set y [expr {round(($info1(top) + $info1(bottom)) / 2.0)}]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    lassign [MarkerWidgetCoords $graph crosshairsClosestBarLine] lineX1 lineY1 lineX2 lineY2
    set markedElement [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    list [expr {$markedElement eq {Element1}}]\
            [expr {($info1(left) != $info2(left)) || ($info1(right) != $info2(right)) }]\
            [expr {abs($lineY1 - $info1(top)) <= 1.0}] [expr {abs($lineY2 - $info1(bottom)) <= 1.0}]\
            [expr {(abs($lineX1 - ($info1(left) - 4)) <= 1.0) || (abs($lineX1 - ($info1(right) + 4)) <= 1.0)}]
} -cleanup {
    unset -nocomplain info1 info2
    destroy .gtb
} -result {1 1 1 1 1}

test crosshairsInteractive-23 {closest bar marker: overlap mode creates marker for each bar with single no}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 500 -single no}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: overlap mode creates marker for each bar with single no}\
            {*}$titleFont
    $widget graph configure -barwidth 0.8 -barmode overlap
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Element1 -data {7 4}
    $widget graph element create Element2 -data {7 7}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 7 2] x y
    $graph element closest $x $y info1 -along both -interpolate no -halo 500 Element1
    $graph element closest $x $y info2 -along both -interpolate no -halo 500 Element2
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    unset -nocomplain marker1 marker2
    foreach i {0 1} {
        set name [lindex [split [$graph marker cget crosshairsClosestText$i -text] \n] 0]
        if {$name eq {Element1}} {
            set marker1 crosshairsClosestBarLine$i
        } elseif {$name eq {Element2}} {
            set marker2 crosshairsClosestBarLine$i
        }
    }
    lassign [MarkerWidgetCoords $graph $marker1] x11 y11 x12 y12
    lassign [MarkerWidgetCoords $graph $marker2] x21 y21 x22 y22
    list [info exists marker1] [info exists marker2] [expr {abs($y11 - $info1(top)) <= 1.0}]\
            [expr {abs($y12 - $info1(bottom)) <= 1.0}] [expr {abs($y21 - $info2(top)) <= 1.0}]\
            [expr {abs($y22 - $info2(bottom)) <= 1.0}]\
            [expr {(abs($x11 - ($info1(left) - 4)) <= 1.0) || (abs($x11 - ($info1(right) + 4)) <= 1.0)}]\
            [expr {(abs($x21 - ($info2(left) - 4)) <= 1.0) || (abs($x21 - ($info2(right) + 4)) <= 1.0)}]
} -cleanup {
    unset -nocomplain info1 info2 marker1 marker2
    destroy .gtb
} -result {1 1 1 1 1 1 1 1}

test crosshairsInteractive-24 {closest bar marker: inverted graph uses horizontal dimension line}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: inverted graph uses horizontal dimension line} {*}$titleFont
    $widget graph configure -barwidth 0.8 -invertxy yes
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Bar1 -data {6 8}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 6 4] x y
    set found [$graph element closest $x $y info -along both -interpolate no -halo 2 Bar1]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    lassign [MarkerWidgetCoords $graph crosshairsClosestBarLine] lineX1 lineY1 lineX2 lineY2
    set anchor [$graph marker cget crosshairsClosestText -anchor]
    if {$anchor eq {s}} {
        set position [expr {abs($lineY1 - ($info(top) - 4)) <= 1.0}]
    } elseif {$anchor eq {n}} {
        set position [expr {abs($lineY1 - ($info(bottom) + 4)) <= 1.0}]
    } else {
        set position false
    }
    list $found [expr {abs($lineX1 - $info(left)) <= 1.0}] [expr {abs($lineX2 - $info(right)) <= 1.0}]\
            [expr {abs($lineY1 - $lineY2) <= 1.0}] $position
} -cleanup {
    unset -nocomplain info
    destroy .gtb
} -result {1 1 1 1 1}

test crosshairsInteractive-25 {closest marker: mixed bar and line elements select the correct marker type}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest marker: mixed bar and line elements select the correct marker type}\
            {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph bar create Bar1 -data {2 8}
    $widget graph line create Line1 -data {6 2 7 2 8 2} -symbol circle
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 2 4] barX barY
    GenerateGraphEvent $graph <Motion> $barX $barY 50
    sleep $defaultDelay
    set barText [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    set barResult [list [$graph element type Bar1] $barText [$graph marker exists crosshairsClosestText]\
                           [$graph marker exists crosshairsClosestTextBox]\
                           [$graph marker exists crosshairsClosestBarLine]\
                           [$graph marker exists crosshairsClosestBitmap]]
    lassign [$graph transform 7 2] lineX lineY
    GenerateGraphEvent $graph <Motion> $lineX $lineY 50
    sleep $defaultDelay
    set lineText [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    set lineResult [list [$graph element type Line1] $lineText [$graph marker exists crosshairsClosestText]\
                            [$graph marker exists crosshairsClosestTextBox]\
                            [$graph marker exists crosshairsClosestBarLine]\
                            [$graph marker exists crosshairsClosestBitmap]]
    list $barResult $lineResult
} -cleanup {
    destroy .gtb
} -result {{BarElement Bar1 1 1 1 0} {LineElement Line1 1 1 0 1}}

test crosshairsInteractive-26 {closest marker: mixed bar and line elements use independent marker types with single no}\
        -constraints {isInteractive isCrosshairs}  -setup {
    set widget [graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 30 -single no}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest marker: mixed bar and line elements use independent marker types with\
                                            single no} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph bar create Bar1 -data {5 8}
    $widget graph line create Line1 -data {4 4 5 4 6 4} -symbol circle
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 5 4] x y
    set barFound [$graph element closest $x $y barInfo -along both -interpolate no -halo 30 Bar1]
    set lineFound [$graph element closest $x $y lineInfo -along both -interpolate no -halo 30 Line1]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    unset -nocomplain barIndex lineIndex
    foreach i {0 1} {
        set marker crosshairsClosestText$i
        if {![$graph marker exists $marker]} {
            continue
        }
        set element [lindex [split [$graph marker cget $marker -text] \n] 0]
        if {$element eq {Bar1}} {
            set barIndex $i
        } elseif {$element eq {Line1}} {
            set lineIndex $i
        }
    }
    if { ![info exists barIndex] || ![info exists lineIndex] } {
        return [list found $barFound $lineFound indexes [info exists barIndex] [info exists lineIndex]]
    }
    set barResult [list [$graph marker exists crosshairsClosestText$barIndex]\
                           [$graph marker exists crosshairsClosestText${barIndex}Box]\
                           [$graph marker exists crosshairsClosestBarLine$barIndex]\
                           [$graph marker exists crosshairsClosestBitmap$barIndex]]
    set lineResult [list [$graph marker exists crosshairsClosestText$lineIndex]\
                            [$graph marker exists crosshairsClosestText${lineIndex}Box]\
                            [$graph marker exists crosshairsClosestBarLine$lineIndex]\
                            [$graph marker exists crosshairsClosestBitmap$lineIndex]]
    list $barFound $lineFound [$graph element type Bar1] [$graph element type Line1] $barResult $lineResult
} -cleanup {
    unset -nocomplain barInfo lineInfo barIndex lineIndex
    destroy .gtb
} -result {1 1 BarElement LineElement {1 1 1 0} {1 1 0 1}}

test crosshairsInteractive-27 {polar current marker supports axis, complex, and polar representations}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -crosshairs\
                        -crosshairsmode current -crosshairsmarkopts {-formatx .6g -formaty .6g}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar current marker representations} {*}$titleFont
    $widget graph axis configure x -min -6 -max 6
    $widget graph axis configure y -min -6 -max 6
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set x [$graph axis transform x 3]
    set y [$graph axis transform y 4]
    set real [$graph axis invtransform x $x]
    set imag [$graph axis invtransform y $y]
    set axisText [ExpectedRealImagMarkerText $real $imag .6g .6g]
    set expected [list $axisText $axisText [ExpectedComplexMarkerText z $real $imag .6g .6g]\
                          [ExpectedPolarMarkerText $real $imag .6g .6g]]
    set actual [list]
    foreach mode {auto axis complex polar} {
        $widget configure -coordmark $mode
        GenerateGraphEvent $graph <Motion> $x $y 20
        if {![$graph marker exists crosshairsText]} {
            return "crosshairsText marker was not created for mode '$mode'"
        }
        lappend actual [$graph marker cget crosshairsText -text]
    }
    if {$actual ne $expected} {
        return [list expected $expected actual $actual]
    }
    return
} -result {} -cleanup {
    destroy $widget
}

test crosshairsInteractive-28 {smith current marker supports all coordinate representations}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation smith -smithgrid impedance -crosshairs\
                        -crosshairsmode current -crosshairsmarkopts {-formatx .6g -formaty .6g}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {smith current marker representations} {*}$titleFont
    $widget graph axis configure x -min -1.2 -max 1.2
    $widget graph axis configure y -min -1.2 -max 1.2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set x [$graph axis transform x 0.2]
    set y [$graph axis transform y 0.4]
    set gammaReal [$graph axis invtransform x $x]
    set gammaImag [$graph axis invtransform y $y]
    lassign [ExpectedSmithNormalized $gammaReal $gammaImag impedance] zReal zImag
    lassign [ExpectedSmithNormalized $gammaReal $gammaImag admittance] yReal yImag
    set axisText [ExpectedRealImagMarkerText $gammaReal $gammaImag .6g .6g]
    set expected [list [ExpectedRealImagMarkerText $zReal $zImag .6g .6g] $axisText\
                          [ExpectedComplexMarkerText z $gammaReal $gammaImag .6g .6g]\
                          [ExpectedPolarMarkerText $gammaReal $gammaImag .6g .6g]\
                          [ExpectedComplexMarkerText Gamma $gammaReal $gammaImag .6g .6g]\
                          [ExpectedComplexMarkerText z $zReal $zImag .6g .6g]\
                          [ExpectedRealImagMarkerText $zReal $zImag .6g .6g]\
                          [ExpectedComplexMarkerText y $yReal $yImag .6g .6g]\
                          [ExpectedRealImagMarkerText $yReal $yImag .6g .6g]]
    set modes {auto axis complex polar gamma normalizedimpedance normalizedimpedanceri normalizedadmittance\
                       normalizedadmittanceri}
    set actual [list]
    foreach mode $modes {
        $widget configure -coordmark $mode
        GenerateGraphEvent $graph <Motion> $x $y 20
        lappend actual [$graph marker cget crosshairsText -text]
    }
    $widget configure -coordmark auto
    foreach {gridMode expectedMode} {admittance admittance both impedance} {
        $graph configure -smithgrid $gridMode
        GenerateGraphEvent $graph <Motion> $x $y 20
        if {$expectedMode eq {impedance}} {
            lappend actual [$graph marker cget crosshairsText -text]
            lappend expected [ExpectedRealImagMarkerText $zReal $zImag .6g .6g]
        } else {
            lappend actual [$graph marker cget crosshairsText -text]
            lappend expected [ExpectedRealImagMarkerText $yReal $yImag .6g .6g]
        }
    }
    if {$actual ne $expected} {
        return [list expected $expected actual $actual]
    }
    return
} -result {} -cleanup {
    destroy $widget
}

test crosshairsInteractive-29 {polar current axis marker includes visible auxiliary axes and hidden grid axes}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -crosshairs\
                        -crosshairsmode current -coordmark axis -crosshairsmarkopts {-formatx .6g -formaty .6g}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar current marker with multiple axes} {*}$titleFont
    $widget graph axis configure x -min -2 -max 2 -hide yes
    $widget graph axis configure y -min -2 -max 2 -hide yes
    $widget graph axis create xAlt -min 100 -max 200
    $widget graph axis create yAlt -min 1000 -max 2000
    $widget graph x2axis use xAlt
    $widget graph y2axis use yAlt
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {round($left+$width/2.0)}]
    set y [expr {round($top+$height/2.0)}]
    set expected [join [list [format "xAlt(h)=%.6g" [$graph axis invtransform xAlt $x]]\
                                [format "real(h)=%.6g" [$graph axis invtransform x $x]]\
                                [format "yAlt(v)=%.6g" [$graph axis invtransform yAlt $y]]\
                                [format "imag(v)=%.6g" [$graph axis invtransform y $y]]] \n]
    GenerateGraphEvent $graph <Motion> $x $y 20
    sleep $defaultDelay
    set actual [$graph marker cget crosshairsText -text]
    list [expr {$actual eq $expected}] [$graph marker cget crosshairsText -mapx]\
            [$graph marker cget crosshairsText -mapy]
} -result {1 xAlt yAlt} -cleanup {
    destroy $widget
}

