        set expected [list [expr {$count >= 1}] [expr {$count >= 2}]]
        GenerateGraphEvent $graph <Motion> $x $y 5
        set actual [list [$graph marker exists crosshairsClosestText0] [$graph marker exists crosshairsClosestText1]]
        if {$actual != $expected} {
            lappend failures [list $x $y $expected $actual]
        }
    }
    return $failures
}  -result {} -cleanup {
    destroy $widget
}

