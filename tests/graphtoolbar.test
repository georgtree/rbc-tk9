test crosshairsInteractive-17 {closest marker: ordinary line marker is removed outside halo}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest marker: ordinary line marker is removed outside halo} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Element1 -data {5 5} -symbol circle
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 5 5] x1 y1
    lassign [$graph transform 9 9] x2 y2
    GenerateGraphEvent $graph <Motion> $x1 $y1 50
    set before [list [$graph marker exists crosshairsClosestText] [$graph marker exists crosshairsClosestTextBox]\
                        [$graph marker exists crosshairsClosestBitmap]]
    GenerateGraphEvent $graph <Motion> $x2 $y2 50
    sleep $defaultDelay
    set after [$graph marker names crosshairsClosest*]
    list $before $after
} -cleanup {
    destroy .gtb
} -result {{1 1 1} {}}

