    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox $defaultDelay
    lappend actualStates [list {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y]]
    lappend expectedStates [lindex $expectedStates 1]
    return [approxNestedEqual $actualStates $expectedStates]
}  -result true  -cleanup {
    destroy $widget
}

