    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 1 4] x y
    set found [$graph element closest $x $y info -along both -interpolate no -halo 2\
                       VeryLongBarElementNameForPlacement]
    GenerateGraphEvent $graph <Motion> $x $y 50
    lassign [MarkerWidgetCoords $graph crosshairsClosestBarLine] lineX1 lineY1 lineX2 lineY2
    lassign [MarkerWidgetCoords $graph crosshairsClosestText] textX textY
    sleep $defaultDelay
    list $found [expr {[$graph marker cget crosshairsClosestText -anchor] eq {w}}]\
            [expr {abs($lineX1 - ($info(right) + 4)) <= 1.0}] [expr {abs($lineX2 - ($info(right) + 4)) <= 1.0}]\
            [expr {abs($lineY1 - $info(top)) <= 1.0}] [expr {abs($lineY2 - $info(bottom)) <= 1.0}]\
            [expr {$textX > $lineX1}]
