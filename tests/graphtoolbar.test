test crosshairsInteractive-31 {smith closest marker supports every available coordinate representation}\
        -constraints {isInteractive isCrosshairs} -setup {
    vector create gtbSmithGamma -type complex
    gtbSmithGamma set {{0.2 0.4}}
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation smith -smithgrid impedance -crosshairs\
                        -crosshairsmode closest -crosshairsmarkopts {-formatx .6g -formaty .6g}\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {smith closest marker representations} {*}$titleFont
    $widget graph axis configure x -min -1.2 -max 1.2
    $widget graph axis configure y -min -1.2 -max 1.2
    $widget graph element create Element1 -cdata gtbSmithGamma -z0 50 -symbol circle
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 0.2 0.4] x y
    set expected [list "Element1\n[ExpectedRealImagMarkerText 0.2 0.4 .6g .6g]"\
                          "Element1\n[ExpectedComplexMarkerText Gamma 0.2 0.4 .6g .6g]"\
                          "Element1\n[ExpectedComplexMarkerText z 1 1 .6g .6g]"\
                          "Element1\n[ExpectedComplexMarkerText Z 50 50 .6g .6g Ohm]"\
                          "Element1\n[ExpectedComplexMarkerText y 0.5 -0.5 .6g .6g]"\
                          "Element1\n[ExpectedComplexMarkerText Y 0.01 -0.01 .6g .6g S]"]
    set actual [list]
    foreach mode {axis gamma normalizedimpedance impedance normalizedadmittance admittance} {
        $widget configure -coordclosestmark $mode
        GenerateGraphEvent $graph <Motion> $x $y 20
        if {![$graph marker exists crosshairsClosestText]} {
            return "crosshairsClosestText marker was not created for mode '$mode'"
        }
        lappend actual [$graph marker cget crosshairsClosestText -text]
    }
    if {$actual ne $expected} {
        return [list expected $expected actual $actual]
    }
    return
} -result {} -cleanup {
    destroy $widget
    catch {vector destroy gtbSmithGamma}
}

test crosshairsInteractive-32 {closest coordinate selector chooses valid default when polar changes to smith}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -crosshairs\
                        -crosshairsmode closest]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest coordinate selector after representation change} {*}$titleFont
    set graph [$widget subwidget graph]
    set combo [$widget subwidget closestCoordComBox]
} -body {
    WaitForWindow $graph
    $widget configure -coordclosestmark complex
    $graph configure -representation smith -smithgrid admittance
    uplevel #0 [$combo cget -postcommand]
    list [$widget configure -coordclosestmark] [$combo get]\
            [expr {{Normalized admittance} in [$combo cget -values]}]
} -result {normalizedadmittance {Normalized admittance} 1} -cleanup {
    destroy $widget
}

