} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph x bottom] axisX axisY
    set expected [list [ExpectedWheelLimits $graph x 0.5] [ExpectedWheelLimits $graph y 0.5]]
    GenerateGraphWheelEvent $graph $axisX $axisY 120 20
    set actual [list [$graph axis limits x] [$graph axis limits y]]
    approxNestedEqual $actual $expected
} -result true -cleanup {
