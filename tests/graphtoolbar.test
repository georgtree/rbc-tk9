test zoomInteractive-16 {wheel zoom with inverted axes} -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {}\
                        -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {wheel zoom with inverted axes} -invertxy yes {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min -100 -max 100
    $widget graph element create line1 -data {0 -100 5 0 10 100}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/3}]
    set y [expr {$top+$height*2/3}]
    # With -invertxy, the X data dimension is physical widget Y and
    # the Y data dimension is physical widget X.
    set expected [list {*}[ExpectedWheelLimits $graph x 0.5 $y] {*}[ExpectedWheelLimits $graph y 0.5 $x]]
    GenerateGraphWheelEvent $graph $x $y 120 20
    set actual [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    approxNestedEqual $actual $expected
} -result true -cleanup {
    destroy $widget
}

test zoomInteractive-17 {each wheel zoom step is reversible with right-click pop}\
        -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {}\
                        -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {each wheel zoom step is reversible with right-click pop} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min -100 -max 100
    $widget graph element create line1 -data {0 -100 5 0 10 100}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/3}]
    set y [expr {$top+$height*2/3}]
    set state0 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphWheelEvent $graph $x $y 120 20
    set state1 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphWheelEvent $graph $x $y 120 20
    set state2 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-3> $x $y 20
    GenerateGraphEvent $graph <ButtonRelease-3> $x $y 20
    set pop1 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-3> $x $y 20
    GenerateGraphEvent $graph <ButtonRelease-3> $x $y 20
    set pop2 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    expr {![approxNestedEqual $state0 $state1] && ![approxNestedEqual $state1 $state2] &&\
                  [approxNestedEqual $pop1 $state1] && [approxNestedEqual $pop2 $state0]}
} -result 1 -cleanup {
    destroy $widget
}

test zoomInteractive-18 {wheel zoom scales element-mapped axis not installed in a margin}\
         -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {} -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {wheel zoom scales element-mapped non-margin axis} {*}$titleFont
    #
    # time1 is the visible Y axis.  The default y axis is deliberately
    # removed from the margin, but line1 remains mapped to it.
    #
    $widget graph axis create time1 -min 100 -max 200
    $widget graph axis create unusedY -min 1000 -max 2000
    $widget graph yaxis use time1
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 20
    $widget graph element create line1 -data {2 4 5 10 8 16} -mapx x -mapy y -symbol circle
    $widget graph element create line2 -data {2 120 5 150 8 180} -mapx x -mapy time1 -symbol circle
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    #
    # Verify the setup: time1 is installed in the Y margin, while y is
    # used only by line1 and unusedY is not used at all.
    #
    set marginAxes [$graph yaxis use]
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/2}]
    set yPixel [expr {$top+$height/2}]
    set expectedX [ExpectedWheelLimits $graph x 0.5 $x]
    set expectedY [ExpectedWheelLimits $graph y 0.5 $yPixel]
    set expectedTime1 [ExpectedWheelLimits $graph time1 0.5 $yPixel]
    set unusedBefore [$graph axis limits unusedY]
    GenerateGraphWheelEvent $graph $x $yPixel 120 20
    set zoomed [list [$graph axis limits x] [$graph axis limits y] [$graph axis limits time1] [$graph axis limits\
                                                                                                       unusedY]]
    set expected [list $expectedX $expectedY $expectedTime1 $unusedBefore]
    set actual [list [expr {"time1" in $marginAxes}] [expr {"y" ni $marginAxes}]\
            [expr {[$graph element cget line1 -mapy] eq "y"}]\
                        [expr {[$graph element cget line2 -mapy] eq "time1"}] [expr {"unusedY" ni $marginAxes}] $zoomed]
    set expected [list 1 1 1 1 1 $expected]
    approxNestedEqual $actual $expected
} -result true -cleanup {
    destroy $widget
}

test zoomInteractive-19 {polar zoom box preserves plot aspect and clamps the second corner}\
        -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -zoom -zoommod {Any-}\
                        -zoommark -zoomboxopts {-linewidth 1}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar zoom box preserves plot aspect and clamps the second corner} {*}$titleFont
    $widget graph axis configure x -min -5 -max 5
    $widget graph axis configure y -min -5 -max 5
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set right [expr {$left+$width-1}]
    set bottom [expr {$top+$height-1}]
    set aX [expr {$left+$width/3}]
    set aY [expr {$top+$height/3}]
    set bX [expr {$right+100}]
    set bY [expr {$bottom+100}]
    lassign [ExpectedPolarZoomPoint $graph $aX $aY $bX $bY] expectedBX expectedBY
    lassign [$graph axis limits x] oldXMin oldXMax
    lassign [$graph axis limits y] oldYMin oldYMax
    set oldRangeRatio [expr {($oldXMax-$oldXMin)/($oldYMax-$oldYMin)}]
    set oldPlotSize [list $width $height]
    GenerateGraphEvent $graph <ButtonPress-1> $aX $aY $defaultDelay
    GenerateGraphEvent $graph <Motion> $bX $bY $defaultDelay
    set outline [MarkerWidgetCoords $graph gtbZoomOutline]
    set actualAX [lindex $outline 0]
    set actualAY [lindex $outline 1]
    set actualBX [lindex $outline 2]
    set actualBY [lindex $outline 5]
    set inside [expr {($actualBX >= $left-1) && ($actualBX <= $right+1) &&\
                          ($actualBY >= $top-1) && ($actualBY <= $bottom+1)}]
    set constrained [approxPixelCoordsEqual [list $actualBX $actualBY] [list $expectedBX $expectedBY] 1.5]
    GenerateGraphEvent $graph <ButtonRelease-1> $bX $bY 20
    lassign [$graph axis limits x] newXMin newXMax
    lassign [$graph axis limits y] newYMin newYMax
    set newRangeRatio [expr {($newXMax-$newXMin)/($newYMax-$newYMin)}]
    lassign [$graph extents plotarea] newLeft newTop newWidth newHeight
    list $inside $constrained [expr {abs($newRangeRatio-$oldRangeRatio) < 1e-6}]\
            [approxPixelCoordsEqual $oldPlotSize [list $newWidth $newHeight] 1.0]
} -result {1 true 1 true} -cleanup {
    destroy $widget
}

test zoomInteractive-20 {polar zoom box scales hidden grid axes and multiple visible axes}\
        -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -zoom -zoommod {Any-}\
                        -zoommark -zoomboxopts {-linewidth 1}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar zoom box scales hidden grid axes and multiple visible axes} {*}$titleFont
    $widget graph axis configure x -min -4 -max 4 -hide yes
    $widget graph axis configure y -min -4 -max 4 -hide yes
    $widget graph axis create xAlt -min 100 -max 200
    $widget graph axis create yAlt -min 1000 -max 2000
    $widget graph x2axis use xAlt
    $widget graph y2axis use yAlt
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set aX [expr {$left+$width/4}]
    set aY [expr {$top+$height/4}]
    set bX [expr {$left+$width*3/4}]
    set bY [expr {$top+$height*2/3}]
    lassign [ExpectedPolarZoomPoint $graph $aX $aY $bX $bY] expectedBX expectedBY
    set expected [list [ExpectedZoomLimits $graph $aX $aY $expectedBX $expectedBY x y]\
                           [ExpectedZoomLimits $graph $aX $aY $expectedBX $expectedBY xAlt yAlt]]
    GenerateGraphEvent $graph <ButtonPress-1> $aX $aY $defaultDelay
    GenerateGraphEvent $graph <Motion> $bX $bY $defaultDelay
    set outlineMap [list [$graph marker cget gtbZoomOutline -mapx] [$graph marker cget gtbZoomOutline -mapy]]
    set outline [MarkerWidgetCoords $graph gtbZoomOutline]
    set actualB [list [lindex $outline 2] [lindex $outline 5]]
    GenerateGraphEvent $graph <ButtonRelease-1> $bX $bY 20
    set actual [list [list {*}[$graph axis limits x] {*}[$graph axis limits y]]\
                         [list {*}[$graph axis limits xAlt] {*}[$graph axis limits yAlt]]]
    list [approxNestedEqual $actual $expected] $outlineMap\
            [approxPixelCoordsEqual $actualB [list $expectedBX $expectedBY] 1.5]
} -result {true {xAlt yAlt} true} -cleanup {
    destroy $widget
}

test zoomInteractive-21 {polar zoom corner markers use polar coordinates}\
        -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -zoom -zoommod {Any-}\
                        -zoommark -coordmark polar -zoommarkopts {-formatx .6g -formaty .6g}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {polar zoom corner markers use polar coordinates} {*}$titleFont
    $widget graph axis configure x -min -6 -max 6
    $widget graph axis configure y -min -6 -max 6
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set aX [$graph axis transform x 3]
    set aY [$graph axis transform y 4]
    set bX [$graph axis transform x -2]
    set bY [$graph axis transform y -1]
    set aReal [$graph axis invtransform x $aX]
    set aImag [$graph axis invtransform y $aY]
    set expectedA [ExpectedPolarMarkerText $aReal $aImag .6g .6g]
    GenerateGraphEvent $graph <ButtonPress-1> $aX $aY $defaultDelay
    GenerateGraphEvent $graph <Motion> $bX $bY $defaultDelay
    set outline [MarkerWidgetCoords $graph gtbZoomOutline]
    set actualBX [expr {round([lindex $outline 2])}]
    set actualBY [expr {round([lindex $outline 5])}]
    set bReal [$graph axis invtransform x $actualBX]
    set bImag [$graph axis invtransform y $actualBY]
    set expectedB [ExpectedPolarMarkerText $bReal $bImag .6g .6g]
    set actual [list [$graph marker cget gtbZoomText_A -text] [$graph marker cget gtbZoomText_B -text]\
                        [$graph marker cget gtbZoomText_A -mapx] [$graph marker cget gtbZoomText_A -mapy]]
    set expected [list $expectedA $expectedB x y]
    if {$actual ne $expected} {
        return [list expected $expected actual $actual]
    }
    return
} -result {} -cleanup {
    destroy $widget
}

test zoomInteractive-22 {smith zoom corner markers use automatic normalized impedance coordinates}\
        -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation smith -smithgrid impedance -zoom\
                        -zoommod {Any-} -zoommark -coordmark auto -zoommarkopts {-formatx .6g -formaty .6g}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {smith zoom corner markers use automatic normalized impedance coordinates}\
            {*}$titleFont
    $widget graph axis configure x -min -1.2 -max 1.2
    $widget graph axis configure y -min -1.2 -max 1.2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set aX [$graph axis transform x 0.2]
    set aY [$graph axis transform y 0.4]
    set bX [$graph axis transform x -0.2]
    set bY [$graph axis transform y -0.1]
    GenerateGraphEvent $graph <ButtonPress-1> $aX $aY $defaultDelay
    GenerateGraphEvent $graph <Motion> $bX $bY $defaultDelay
    # For this test the Polar grid maps x/y, so the raw outline
    # coordinates are the exact Gamma values used by MarkZoomPoint.
    # Avoid a transform -> round -> invtransform round-trip here.
    set coords [$graph marker cget gtbZoomOutline -coords]
    set aGammaReal [lindex $coords 0]
    set aGammaImag [lindex $coords 1]
    set bGammaReal [lindex $coords 4]
    set bGammaImag [lindex $coords 5]
    lassign [ExpectedSmithNormalized $aGammaReal $aGammaImag impedance] aReal aImag
    lassign [ExpectedSmithNormalized $bGammaReal $bGammaImag impedance] bReal bImag
    set expectedA [ExpectedRealImagMarkerText $aReal $aImag .6g .6g]
    set expectedB [ExpectedRealImagMarkerText $bReal $bImag .6g .6g]
    set actual [list [$graph marker cget gtbZoomText_A -text] [$graph marker cget gtbZoomText_B -text]]
    set expected [list $expectedA $expectedB]
    if {$actual ne $expected} {
        return [list expected $expected actual $actual]
    }
    return
} -result {} -cleanup {
    destroy $widget
}

test zoomInteractive-23 {wheel over polar grid axis scales both grid axes}\
        -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -type polar -representation polar -zoom -zoomwheel\
                        -zoomwheelmod {} -zoomwheelscale 2.0]
