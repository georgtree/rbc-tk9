package require rbc
namespace import rbc::*
package require tcltest
namespace import tcltest::*

set atol 1e-8
set rtol 1e-10
set defaultDelay 500

proc containsNumber {value} {
    if {[string is double -strict $value]} {
        return true
    }
    if {[catch {llength $value} len]} {
        return false
    }
    # Single-element and empty values are treated as atoms here.
    if {$len<=1} {
        return false
    }
    for {set i 0} {$i<$len} {incr i} {
        if {[containsNumber [lindex $value $i]]} {
            return true
        }
    }
    return false
}

proc approxNestedEqual {a b} {
    variable atol
    variable rtol
    set aIsNum [string is double -strict $a]
    set bIsNum [string is double -strict $b]
    # Numeric atoms: approximate comparison
    if {$aIsNum && $bIsNum} {
        return [expr {abs($a-$b)<=($atol+$rtol*abs($b))}]
    }
    # One numeric, one non-numeric
    if {$aIsNum!=$bIsNum} {
        return false
    }
    set aHasNum [containsNumber $a]
    set bHasNum [containsNumber $b]
    # If neither side contains numbers, compare as exact strings.
    # This preserves spaces, tabs, etc.
    if {!$aHasNum && !$bHasNum} {
        return [string equal $a $b]
    }
    # If only one side contains numeric structure, they differ.
    if {$aHasNum != $bHasNum} {
        return false
    }
    # Both contain numbers somewhere, so compare structurally as lists.
    if {[catch {llength $a} lenA]} {
        return false
    }
    if {[catch {llength $b} lenB]} {
        return false
    }
    if {$lenA != $lenB} {
        return false
    }
    for {set i 0} {$i<$lenA} {incr i} {
        set elemA [lindex $a $i]
        set elemB [lindex $b $i]
        if {![approxNestedEqual $elemA $elemB]} {
            return false
        }
    }
    return true
}

proc uniqkey {} {
	set key [expr {pow(2,31)+[clock clicks]}]
    set key [string range $key end-8 end-3]
    set key [clock seconds]$key
    return $key
}

proc sleep {ms} {
    set uniq [uniqkey]
    set ::__sleep__tmp__$uniq 0
    after $ms set ::__sleep__tmp__$uniq 1
    vwait ::__sleep__tmp__$uniq
    unset ::__sleep__tmp__$uniq
}

proc FindAxisPoint {graph axis side} {
    # Finds coordinates of provided axis for selected graph widget on certain side
    update idletasks
    set left [$graph extents leftmargin]
    set top [$graph extents topmargin]
    set width [$graph extents plotwidth]
    set height [$graph extents plotheight]
    switch -- $side {
        bottom {
            set x [expr {$left + $width / 2}]
            set y [expr {$top + $height}]
            set dx 0
            set dy 1
            set count [expr {[winfo height $graph] - $y}]
        }
        top {
            set x [expr {$left + $width / 2}]
            set y $top
            set dx 0
            set dy -1
            set count [expr {$top + 1}]
        }
        left {
            set x $left
            set y [expr {$top + $height / 2}]
            set dx -1
            set dy 0
            set count [expr {$left + 1}]
        }
        right {
            set x [expr {$left+$width}]
            set y [expr {$top+$height/2}]
            set dx 1
            set dy 0
            set count [expr {[winfo width $graph]-$x}]
        }
        default {
            return -code error "Unknown axis side '$side'"
        }
    }
    for {set i 0} {$i < $count} {incr i} {
        event generate $graph <Motion> -x $x -y $y
        update idletasks
        if {([$graph axis get current] eq $axis) && ([$graph axis get detail] eq {line})} {
            return [list $x $y]
        }
        incr x $dx
        incr y $dy
    }
    return -code error "Could not find line of axis '$axis'"
}

proc FindLegendPoint {graph element} {
    # Finds a physical widget position inside the legend entry
    # corresponding to the requested element.
    update idletasks
    set width [winfo width $graph]
    set height [winfo height $graph]
    # Legend entries are much larger than a few pixels, so scan
    # coarsely first to avoid unnecessary commands.
    for {set y 0} {$y<$height} {incr y 3} {
        for {set x 0} {$x<$width} {incr x 3} {
            if {[$graph legend get @$x,$y] eq $element} {
                return [list $x $y]
            }
        }
    }
    # defensive exact scan in case unusual geometry caused the
    # coarse scan to miss the entry.
    for {set y 0} {$y<$height} {incr y} {
        for {set x 0} {$x<$width} {incr x} {
            if {[$graph legend get @$x,$y] eq $element} {
                return [list $x $y]
            }
        }
    }
    return -code error "could not find legend entry for element '$element'"
}

proc GenerateGraphEvent {graph sequence x y time} {
    sleep $time
    event generate $graph $sequence -x $x -y $y
    update
}

proc GenerateGraphWheelEvent {graph x y delta time {modifier {}}} {
    sleep $time
    event generate $graph <${modifier}MouseWheel> -x $x -y $y -delta $delta
    update
}

proc approxPixelCoordsEqual {a b {tolerance 1.0}} {
    if {[llength $a] != [llength $b]} {
        return false
    }
    foreach x $a y $b {
        if {abs($x-$y) > $tolerance} {
            return false
        }
    }
    return true
}

proc ExpectedWheelLimits {graph axis factor {pixel {}}} {
    lassign [$graph axis limits $axis] min max
    set logscale [$graph axis cget $axis -logscale]
    if {$pixel eq {}} {
        if {$logscale} {
            set center [expr {exp((log($min)+log($max))/2.0)}]
        } else {
            set center [expr {($min+$max)/2.0}]
        }
    } else {
        set center [$graph axis invtransform $axis [expr {round($pixel)}]]
    }
    if {$logscale} {
        set logCenter [expr {log($center)}]
        set newMin [expr { exp($logCenter+(log($min)-$logCenter)*$factor) }]
        set newMax [expr { exp($logCenter+(log($max)-$logCenter)*$factor) }]
    } else {
        set newMin [expr {$center+($min-$center)*$factor}]
        set newMax [expr {$center+($max-$center)*$factor}]
    }
    return [list $newMin $newMax]
}

proc GenerateGraphWheelEvent {graph x y delta time {modifier {}}} {
    sleep $time
    event generate $graph <${modifier}MouseWheel> -x $x -y $y -delta $delta
    update
}

proc WaitForWindow {window} {
    if {![winfo exists $window]} {
        return -code error "Window '$window' does not exist"
    }
    if {![winfo viewable $window]} {
        tkwait visibility $window
    }
    update idletasks
    return [expr {[winfo viewable $window] && ([winfo width $window] > 1) && ([winfo height $window] > 1)}]
}

proc MarkerWidgetCoords {graph marker} {
    set mapx [$graph marker cget $marker -mapx]
    set mapy [$graph marker cget $marker -mapy]
    set coords [$graph marker cget $marker -coords]
    set result [list]
    foreach {xValue yValue} $coords {
        set xPixel [$graph axis transform $mapx $xValue]
        set yPixel [$graph axis transform $mapy $yValue]
        if {[$graph cget -invertxy]} {
            lappend result $yPixel $xPixel
        } else {
            lappend result $xPixel $yPixel
        }
    }
    return $result
}

proc MarkerWidgetSize {graph marker} {
    set coords [MarkerWidgetCoords $graph $marker]
    set xs [list]
    set ys [list]
    foreach {x y} $coords {
        lappend xs $x
        lappend ys $y
    }
    set xs [lsort -real $xs]
    set ys [lsort -real $ys]
    return [list [expr {[lindex $xs end]-[lindex $xs 0]}] [expr {[lindex $ys end]-[lindex $ys 0]}]]
}

proc approxPixelCoordsEqual {a b {tolerance 1.0}} {
    if {[llength $a] != [llength $b]} {
        return false
    }
    foreach x $a y $b {
        if {abs($x-$y) > $tolerance} {
            return false
        }
    }
    return true
}

proc ExpectedSmithNormalized {gammaReal gammaImag mode} {
    switch -- $mode {
        impedance {
            set denom [expr {(1.0-$gammaReal)*(1.0-$gammaReal)+$gammaImag*$gammaImag}]
            set real [expr {(1.0-$gammaReal*$gammaReal-$gammaImag*$gammaImag)/$denom}]
            set imag [expr {2.0*$gammaImag/$denom}]
        }
        admittance {
            set denom [expr {(1.0+$gammaReal)*(1.0+$gammaReal)+$gammaImag*$gammaImag}]
            set real [expr {(1.0-$gammaReal*$gammaReal-$gammaImag*$gammaImag)/$denom}]
            set imag [expr {-2.0*$gammaImag/$denom}]
        }
        default {
            return -code error "Unknown Smith normalized mode '$mode'"
        }
    }
    return [list $real $imag]
}

proc ExpectedComplexMarkerText {name real imag formatReal formatImag {unit {}}} {
    set realText [format "%$formatReal" $real]
    set imagText [format "%$formatImag" [expr {abs($imag)}]]
    set sign [expr {$imag < 0.0 ? "-" : "+"}]
    set text "${name}=${realText}${sign}j${imagText}"
    if {$unit ne {}} {
        append text " $unit"
    }
    return $text
}

proc ExpectedPolarMarkerText {real imag formatRadius formatAngle} {
    set radius [expr {hypot($real,$imag)}]
    if {$radius == 0.0} {
        set angle 0.0
    } else {
        set angle [expr {atan2($imag,$real)*180.0/acos(-1.0)}]
        if {$angle < 0.0} {
            set angle [expr {$angle+360.0}]
        }
    }
    return [format "r=%${formatRadius}\nangle=%${formatAngle} deg" $radius $angle]
}

proc ExpectedRealImagMarkerText {real imag formatReal formatImag {invert no}} {
    if {$invert} {
        set realOrientation v
        set imagOrientation h
    } else {
        set realOrientation h
        set imagOrientation v
    }
    return [format "real(%s)=%${formatReal}\nimag(%s)=%${formatImag}" $realOrientation $real $imagOrientation $imag]
}

proc ExpectedPolarZoomPoint {graph aX aY x y} {
    # Expected physical second corner for a Polar/Smith zoom box.
    # Clamp to the visible plot first, then preserve the current plot
    # aspect ratio exactly as the interactive zoom contract requires.
    lassign [$graph extents plotarea] left top width height
    set right [expr {$left+$width-1}]
    set bottom [expr {$top+$height-1}]
    set x [expr {max($left,min($right,$x))}]
    set y [expr {max($top,min($bottom,$y))}]
    if {($width <= 1) || ($height <= 1)} {
        return [list $x $y]
    }
    set dx [expr {$x-$aX}]
    set dy [expr {$y-$aY}]
    if {($dx == 0) || ($dy == 0)} {
        return [list $x $y]
    }
    set signX [expr {$dx < 0 ? -1 : 1}]
    set signY [expr {$dy < 0 ? -1 : 1}]
    set absDx [expr {abs($dx)}]
    set absDy [expr {abs($dy)}]
    set aspect [expr {double($width-1)/double($height-1)}]
    if {($absDx/$absDy) > $aspect} {
        set wantedDy [expr {$absDx/$aspect}]
        if {$signY > 0} {
            set availableDy [expr {$bottom-$aY}]
        } else {
            set availableDy [expr {$aY-$top}]
        }
        if {$wantedDy <= $availableDy} {
            set absDy $wantedDy
        } else {
            set absDy $availableDy
            set absDx [expr {$absDy*$aspect}]
        }
    } else {
        set wantedDx [expr {$absDy*$aspect}]
        if {$signX > 0} {
            set availableDx [expr {$right-$aX}]
        } else {
            set availableDx [expr {$aX-$left}]
        }
        if {$wantedDx <= $availableDx} {
            set absDx $wantedDx
        } else {
            set absDx $availableDx
            set absDy [expr {$absDx/$aspect}]
        }
    }
    return [list [expr {round($aX+$signX*$absDx)}] [expr {round($aY+$signY*$absDy)}]]
}

customMatch approxEqual approxNestedEqual

testConstraint isInteractive true
testConstraint isZoom true
testConstraint isCrosshairs true
testConstraint isAxes true
testConstraint isCross true
testConstraint isActiveLegend true


