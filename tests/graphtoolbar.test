test zoomInteractive-11 {wheel zoom in and out in plot area} -constraints {isInteractive isZoom} -setup {
    set widget [graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {} -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {wheel zoom in and out in plot area} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min -100 -max 100
    $widget graph element create line1 -data {0 -100 5 0 10 100}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/3}]
    set y [expr {$top+$height*2/3}]
    set expectedIn [list {*}[ExpectedWheelLimits $graph x 0.5 $x] {*}[ExpectedWheelLimits $graph y 0.5 $y]]
    sleep $defaultDelay
    GenerateGraphWheelEvent $graph $x $y 120 20
    set actualIn [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    set expectedOut [list {*}[ExpectedWheelLimits $graph x 2.0 $x] {*}[ExpectedWheelLimits $graph y 2.0 $y]]
    sleep $defaultDelay
    GenerateGraphWheelEvent $graph $x $y -120 20
    set actualOut [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    expr {[approxNestedEqual $actualIn $expectedIn] && [approxNestedEqual $actualOut $expectedOut]}
} -result 1 -cleanup {
    destroy $widget
}

