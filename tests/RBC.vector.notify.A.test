# RBC.vector.notify.A.test -- Reentrant internal vector client notifications.
package provide vector.notify
package require tcltest
namespace import tcltest::*

# The harness links the implementation privately and must run in its own process.
# Ordinary suite runs skip these cases; make test-vector-notify supplies the path.
set notifyAvailable 0
if {[info exists ::env(RBC_NOTIFY_TEST_LIB)]} {
    load $::env(RBC_NOTIFY_TEST_LIB) Rbcnotifytest
    set notifyAvailable 1
}
testConstraint notifyHarness $notifyAvailable

namespace eval vector.notify {
    foreach {case scenario immediate expected} {
        1 self 1 {{0 update 0 0} {1 update 0 0}}
        2 other 1 {{0 update 0 0}}
        3 destroy 1 {{0 update 0 0} {0 destroy -1 -1} {1 destroy -1 -1}}
        4 nested 1 {{0 update 0 0} {0 update 1 1} {1 update 1 1} {restored 0 0} {1 update 0 0}}
        5 add 1 {{0 update 0 0} {1 update 0 0} {0 update 1 1} {1 update 1 1} {2 update 1 1}}
        6 destroy-self 1 {{0 destroy -1 -1} {1 destroy -1 -1}}
        7 destroy-other 1 {{0 destroy -1 -1}}
        8 recursive-destroy 1 {{0 destroy -1 -1} {1 destroy -1 -1}}
        9 recreate 1 {{0 destroy -1 -1} {1 destroy -1 -1}}
        10 self 0 {{0 update 0 0} {1 update 0 0}}
        11 other 0 {{0 update 0 0}}
        12 destroy 0 {{0 update 0 0} {0 destroy -1 -1} {1 destroy -1 -1}}
        13 add 0 {{0 update 0 0} {1 update 0 0} {0 update 1 1} {1 update 1 1} {2 update 1 1}}
        14 destroy-self 0 {{0 destroy -1 -1} {1 destroy -1 -1}}
        15 destroy-other 0 {{0 destroy -1 -1}}
        16 recreate 0 {{0 destroy -1 -1} {1 destroy -1 -1}}
        17 nested 0 {{0 update 0 0} {restored 0 0} {1 update 0 0} {0 update 1 1} {1 update 1 1}}
        18 delete-interp 1 {{0 update 0 0} {1 update 0 0} {0 destroy -1 -1} {1 destroy -1 -1}}
        19 delete-interp 0 {{0 update 0 0} {1 update 0 0} {0 destroy -1 -1} {1 destroy -1 -1}}
    } {
        test RBC.vector.notify.A.1.$case "notification callback: $scenario, immediate=$immediate" \
            -constraints notifyHarness -body [list ::rbcnotifytest $scenario $immediate] -result $expected
    }
    foreach {group operation} {2 fft 3 ifft} {
        foreach {case phase action updates} {
            1 notify self {1 1}
            2 notify other {1 0}
            3 notify both {1 0}
            4 notify recreate {1 0}
            5 notify interp {1 0}
            6 release self {0 1}
            7 release other {1 0}
            8 release both {0 0}
            9 release recreate {0 0}
            10 release interp {0 0}
            11 trace self {0 1}
            12 trace other {1 0}
            13 trace both {0 0}
            14 trace interp {0 0}
            15 notify rename {1 1}
            16 release rename {1 1}
        } {
            test RBC.vector.notify.A.$group.$case "FFT commit: $operation $phase $action" \
                -constraints notifyHarness -body [list ::rbcffttest $operation $phase $action] \
                -result [concat {0 1 2} $updates]
        }
    }
    foreach {case phase updates} {1 release {2 2} 2 notify {2 2}} {
        test RBC.vector.notify.A.4.$case "FFT nested commit during $phase" \
            -constraints notifyHarness -body [list ::rbcffttest fft $phase nested] \
            -result [concat {0 1 2} $updates]
    }
    foreach {group operation} {5 window 6 fftfreq} {
        foreach {case phase action updates} {
            1 release self {0 0}
            2 notify self {1 0}
            3 trace self {0 0}
            4 release interp {0 0}
            5 notify interp {1 0}
            6 trace interp {0 0}
            7 release recreate {0 0}
        } {
            test RBC.vector.notify.A.$group.$case "generator commit: $operation $phase $action" \
                -constraints notifyHarness -body [list ::rbcffttest $operation $phase $action] \
                -result [concat {0 1 1} $updates]
        }
    }

    foreach {group operation} {7 natural 8 quadratic} {
        foreach {case phase action updates} {
            1 notify self 1
            2 notify recreate 1
            3 notify interp 1
            4 release self 0
            5 release recreate 0
            6 release interp 0
            7 trace self 0
            8 trace recreate 0
            9 trace interp 0
            10 notify rename 1
        } {
            test RBC.vector.notify.A.$group.$case "spline commit: $operation $phase $action" \
                -constraints notifyHarness -body [list ::rbcsplinetest $operation $phase $action] \
                -result [list 0 1 $updates 1]
        }
    }
    foreach {group operation} {9 pnatural 10 pquadratic} {
        foreach {case action} {1 self 2 recreate 3 interp 4 rename} {
            test RBC.vector.notify.A.$group.$case "complex spline commit: $operation $action" \
                -constraints notifyHarness -body [list ::rbcsplinetest $operation notify $action] \
                -result {0 1 1 0}
        }
    }
    proc CreationTrace {action args} {
        set ::splineSeen [::splineResult range 0 end]
        if {$action eq "destroy"} {rbc::vector destroy ::splineResult}
        if {$action eq "replace"} {
            rbc::vector destroy ::splineResult
            rbc::vector create ::splineResult
            ::splineResult set {99}
        }
    }
    foreach {case action expected} {
        1 keep {0 {0.0 0.5 1.0 1.5 2.0} 1}
        2 destroy {1 {0.0 0.5 1.0 1.5 2.0} 0}
        3 replace {1 {0.0 0.5 1.0 1.5 2.0} 1}
    } {
        test RBC.vector.notify.A.11.$case "new spline mapping trace: $action" \
            -constraints notifyHarness -setup {
                rbc::vector create ::splineX ::splineY ::splineQ
                ::splineX set {0 1 2}; ::splineY set {0 1 2}; ::splineQ set {0 .5 1 1.5 2}
                set ::splineResult placeholder
                trace add variable ::splineResult unset [list ::vector.notify::CreationTrace $action]
            } -body {
                set code [catch {rbc::spline natural ::splineX ::splineY ::splineQ ::splineResult}]
                list $code $::splineSeen [expr {[llength [info commands ::splineResult]] != 0}]
            } -cleanup {
                foreach name {::splineX ::splineY ::splineQ ::splineResult} {
                    catch {rbc::vector destroy $name}
                    catch {unset $name}
                }
                unset -nocomplain ::splineSeen
            } -result $expected
    }

}

    foreach {group operation} {20 set 21 append 22 binread} {
        foreach {case phase action updates releases} {
            1 release self 0 1
            2 release interp 0 1
            3 release recreate 0 1
            4 release rename 1 1
            5 notify self 1 1
            6 notify interp 1 1
            7 notify recreate 1 1
            8 notify rename 1 1
            9 trace self 0 1
            10 trace interp 0 1
        } {
            test RBC.vector.notify.A.$group.$case "command commit: $operation $phase $action" \
                -constraints notifyHarness -body [list ::rbcmutationtest $operation $phase $action] \
                -result [list 0 1 $releases $updates 0]
        }
    }
    foreach {case phase action releases updates} {
        1 notify self 1 {1 1}
        2 notify other 1 {1 0}
        3 notify both 2 {1 0}
        4 notify recreate 2 {1 0}
        5 notify interp 0 {1 0}
        6 notify rename 0 {1 1}
        7 trace self 1 {0 1}
        8 trace other 1 {1 0}
        9 trace both 2 {0 0}
        10 trace interp 0 {0 0}
    } {
        test RBC.vector.notify.A.23.$case "all sort destinations committed before $phase $action" \
            -constraints notifyHarness -body [list ::rbcmutationtest sort $phase $action] \
            -result [concat [list 0 1 $releases] $updates]
    }
    foreach {case action updates} {1 self 1 2 rename 1 3 recreate 1} {
        test RBC.vector.notify.A.24.$case "partial binary read notifies on error: $action" \
            -constraints notifyHarness -body [list ::rbcmutationtest binread-error notify $action] \
            -result [list 1 1 1 $updates 0]
    }
    namespace eval vector.notify {
        foreach {group operation} {25 index 26 length 27 seq 28 merge 29 populate 30 normalize 31 split 32 dup 36 length-zero} {
            foreach {case phase action updates} {
                1 release self 0
                2 release interp 0
                3 release recreate 0
                4 release rename 1
                5 notify self 1
                6 notify interp 1
                7 notify recreate 1
                8 notify rename 1
                9 trace self 0
                10 trace interp 0
            } {
                test RBC.vector.notify.A.$group.$case "completed command data before $operation $phase $action" \
                    -constraints notifyHarness -body [list ::rbcmutationtest $operation $phase $action] \
                    -result [list 0 1 1 $updates 0]
            }
        }
        foreach {group operation} {33 delete 34 random} {
            foreach {case phase action updates releases} {
                1 notify self 1 1
                2 notify interp 1 0
                3 notify recreate 1 1
                4 notify rename 1 0
                5 trace self 0 1
                6 trace interp 0 0
            } {
                test RBC.vector.notify.A.$group.$case "in-place command callbacks: $operation $phase $action" \
                    -constraints notifyHarness -body [list ::rbcmutationtest $operation $phase $action] \
                    -result [list 0 1 $releases $updates 0]
            }
        }
    }
    namespace eval vector.notify {
        foreach {group operation} {35 split-multi} {
            foreach {case phase action code releases updates} {
                1 release other 1 2 {1 0}
                2 release both 1 2 {0 0}
                3 release recreate 1 2 {0 0}
                4 release interp 1 1 {0 0}
                5 notify other 0 2 {1 0}
                6 notify both 0 2 {1 0}
                7 notify recreate 0 2 {1 0}
                8 trace other 0 2 {1 0}
            } {
                test RBC.vector.notify.A.$group.$case "retain later destination through $operation $phase $action" \
                    -constraints notifyHarness -body [list ::rbcmutationtest $operation $phase $action] \
                    -result [concat [list $code 1 $releases] $updates]
            }
        }
    }
    namespace eval vector.notify {
        foreach {group operation} {40 capi-resize 41 capi-reset 42 capi-volatile 43 capi-duplicate} {
            foreach {case phase action updates} {
                1 release self 0
                2 release interp 0
                3 release recreate 0
                4 release rename 1
                5 notify self 1
                6 notify interp 1
                7 notify recreate 1
                8 notify rename 1
                9 trace self 0
                10 trace interp 0
            } {
                if {$operation eq "capi-duplicate" && $phase ne "release"} continue
                set code [expr {$operation in {capi-resize capi-duplicate} &&
                                $phase eq "release" && $action in {self interp recreate}}]
                if {$operation eq "capi-duplicate"} {set updates 0}
                test RBC.vector.notify.A.$group.$case "C storage lifetime: $operation $phase $action" \
                    -constraints notifyHarness -body [list ::rbcmutationtest $operation $phase $action] \
                    -result [list $code 1 1 $updates 0]
            }
        }
        foreach {group operation} {44 capi-changed 45 capi-range} {
            foreach {case phase action releases updates} {
                1 notify self 1 1
                2 notify interp 0 1
                3 notify recreate 1 1
                4 notify rename 0 1
                5 trace self 1 0
                6 trace interp 0 0
            } {
                test RBC.vector.notify.A.$group.$case "C publication lifetime: $operation $phase $action" \
                    -constraints notifyHarness -body [list ::rbcmutationtest $operation $phase $action] \
                    -result [list 0 1 $releases $updates 0]
            }
        }
        foreach {case action code} {1 self 1 2 interp 1 3 recreate 1 4 rename 0} {
            test RBC.vector.notify.A.46.$case "C creation output pointer survives release callback: $action" \
                -constraints notifyHarness -body [list ::rbcmutationtest capi-create release $action] \
                -result [list $code 1 1 0 0]
        }
        foreach {case operation action code updates} {
            1 capi-resize mutate 1 1
            2 capi-resize lock 1 0
            3 capi-reset mutate 0 2
            4 capi-reset lock 0 1
            5 capi-duplicate mutate 0 1
            6 capi-duplicate lock 1 0
        } {
            test RBC.vector.notify.A.47.$case "C release reentry: $operation $action" \
                -constraints notifyHarness -body [list ::rbcmutationtest $operation release $action] \
                -result [list $code 1 1 $updates 0]
        }
    }
    cleanupTests
