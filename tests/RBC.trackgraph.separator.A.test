# RBC.trackgraph.separator.A.test --
#
###Abstract
# Trackgraph separator tests, including interactions with owned tracks.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Package Definition
package provide trackgraph.separator

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval trackgraph.separator {
    source [file join [file dirname [info script]] RBC.trackgraph.support.tcl]

    # Number the generated cases independently within each test group.
    array set testCase {9 0 11 0 12 0 13 0 15 0 16 0 17 0 18 0 20 0}

    test RBC.trackgraph.separator.A.1.1 {moving a separator changes only adjacent weights and respects minimum heights} -setup {
        Create
        ThirdTrack
    } -body {
        set outside [.tg track bbox auxiliary]
        set otherWeight [.tg track cget auxiliary -weight]
        set total [expr {[.tg track cget voltage -weight]+[.tg track cget current -weight]}]
        set old [.tg track sashpos voltage]
        set moved [.tg track sashpos voltage [expr {$old+20}]]
        set result [list [expr {abs($moved-$old-20)<=1}] [expr {$outside eq [.tg track bbox auxiliary]}] \
            [expr {$otherWeight == [.tg track cget auxiliary -weight]}] \
            [expr {abs($total-[.tg track cget voltage -weight]-[.tg track cget current -weight])<1e-12}]]
        foreach target {-1000000 1000000} {
            .tg track sashpos voltage $target
            foreach name {voltage current} {
                lassign [.tg track bbox $name] l t r b
                lappend result [expr {$b-$t >= [.tg track cget $name -minheight]-1}]
            }
        }
        set result
    } -cleanup {destroy .tg} -result {1 1 1 1 1 1 1 1}

    test RBC.trackgraph.separator.A.2.1 {separator hit tests exclude plots and margins} -setup {
        Create
    } -body {
        lassign [.tg track bbox voltage] l t r b
        set y [.tg track sashpos voltage]
        list [.tg track separator [expr {($l+$r)/2}] $y] \
            [.tg track separator [expr {$l-1}] $y] [.tg track separator $l $b] \
            [.tg track separator $l -100] [catch {.tg track sashpos current}] \
            [catch {.tg track sashpos voltage bad}]
    } -cleanup {destroy .tg} -result {voltage {} {} {} 1 1}

    test RBC.trackgraph.separator.A.3.1 {minimum-height compression leaves no space to redistribute} -setup {
        Create
        .tg track configure voltage -minheight 1000
        .tg track configure current -minheight 1000
    } -body {
        set old [.tg track sashpos voltage]
        list [expr {$old == [.tg track sashpos voltage [expr {$old+50}]]}] \
            [.tg track cget voltage -weight] [.tg track cget current -weight]
    } -cleanup {destroy .tg} -result {1 2.0 1.0}

    test RBC.trackgraph.separator.A.4.1 {default bindings do not resize tracks until explicitly enabled} -setup {
        Create
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        event generate .tg <ButtonRelease-1> -x $x -y [expr {$y+30}]
        update
        list [.tg cget -trackresize] [expr {$y == [.tg track sashpos voltage]}]
    } -cleanup {destroy .tg} -result {0 1}

    test RBC.trackgraph.separator.A.5.1 {pointer drag resizes, restores cursor and keeps bindings reusable} -setup {
        Create
        .tg configure -trackresize yes -cursor crosshair
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <Motion> -x $x -y $y
        set hover [.tg cget -cursor]
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        event generate .tg <ButtonRelease-1> -x $x -y [expr {$y+30}]
        update
        list $hover [expr {abs([.tg track sashpos voltage]-$y-30)<=1}] \
            [.tg cget -cursor] [dict exists $::rbc::trackgraph::drag .tg]
    } -cleanup {destroy .tg} -result {sb_v_double_arrow 1 crosshair 0}

    test RBC.trackgraph.separator.A.6.1 {clicking without motion does not quantize the weights} -setup {
        Create
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        set before [list [.tg track cget voltage -weight] [.tg track cget current -weight]]
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        expr {$before eq [list [.tg track cget voltage -weight] [.tg track cget current -weight]]}
    } -cleanup {destroy .tg} -result 1

    test RBC.trackgraph.separator.A.7.1 {moving the whole pair to another location cancels dragging} -setup {
        Create
        ThirdTrack
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        .tg track order {auxiliary voltage current}
        set before [list [.tg track cget voltage -weight] [.tg track cget current -weight]]
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        list [dict exists $::rbc::trackgraph::drag .tg] \
            [expr {$before eq [list [.tg track cget voltage -weight] [.tg track cget current -weight]]}]
    } -cleanup {destroy .tg} -result {0 1}

    test RBC.trackgraph.separator.A.8.1 {Escape restores original weights and geometry} -setup {
        Create
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        # Invoke the installed Escape binding without depending on WM focus.
        catch {eval [string map [list %W .tg] [bind Trackgraph <Escape>]]}
        update
        list [expr {$y == [.tg track sashpos voltage]}] [.tg track cget voltage -weight] \
            [.tg track cget current -weight] [dict exists $::rbc::trackgraph::drag .tg]
    } -cleanup {destroy .tg} -result {1 2.0 1.0 0}

    foreach change {{.tg track order {current voltage}} {.tg configure -trackresize no}} {
        test RBC.trackgraph.separator.A.9.[incr testCase(9)] {structural changes or disabling cancel the active gesture safely} -setup {
            Create
            .tg configure -trackresize yes
        } -body {
            lassign [SeparatorPoint] x y
            set originalCursor [.tg cget -cursor]
            event generate .tg <ButtonPress-1> -x $x -y $y
            eval $change
            event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
            update
            list [dict exists $::rbc::trackgraph::drag .tg] [expr {$originalCursor eq [.tg cget -cursor]}]
        } -cleanup {destroy .tg} -result {0 1}
    }

    test RBC.trackgraph.separator.A.10.1 {destroying a widget during drag clears per-widget state} -setup {
        Create
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        destroy .tg
        list [dict exists $::rbc::trackgraph::drag .tg] [dict exists $::rbc::trackgraph::cursors .tg]
    } -result {0 0}

    foreach format {svg postscript pdf} {
        test RBC.trackgraph.separator.A.11.[incr testCase(11)] {exports preserve reordered tracks and separator allocations} -setup {
            Create
            .tg track order {current voltage}
            .tg track sashpos current [expr {[.tg track sashpos current]+20}]
        } -body {
            set before [.tg track bbox current]
            set weights [list [.tg track cget current -weight] [.tg track cget voltage -weight]]
            .tg $format output -width 900 -height 700
            .tg $format configure -width 0 -height 0
            update
            list [.tg track order] [expr {$before eq [.tg track bbox current]}] \
                [expr {$weights eq [list [.tg track cget current -weight] [.tg track cget voltage -weight]]}]
        } -cleanup {destroy .tg} -result {{current voltage} 1 1}
    }

    foreach finish {release cancel invalidate} {
        test RBC.trackgraph.separator.A.12.[incr testCase(12)] {drag temporarily borrows focus and restores it on completion} -setup {
            FocusSetup
        } -body {
            lassign [SeparatorPoint] x y
            event generate .tg <ButtonPress-1> -x $x -y $y
            update
            set during [expr {[focus] eq ".tg"}]
            switch $finish {
                release {event generate .tg <ButtonRelease-1> -x $x -y $y}
                cancel {event generate .tg <Escape>}
                invalidate {
                    .tg configure -trackresize no
                    event generate .tg <B1-Motion> -x $x -y [expr {$y+20}]
                }
            }
            update
            list $during [focus] [dict exists $::rbc::trackgraph::drag .tg]
        } -cleanup {destroy .tg .trackFocus .trackOther} -result {1 .trackFocus 0}
    }

    foreach initial {empty graph destroyed changed} {
        test RBC.trackgraph.separator.A.13.[incr testCase(13)] {restoration respects empty, existing, destroyed and independently changed focus} -setup {
            FocusSetup
        } -body {
            switch $initial {
                graph {focus .tg}
            }
            update
            lassign [SeparatorPoint] x y
            event generate .tg <ButtonPress-1> -x $x -y $y
            update
            switch $initial {
                empty {dict set ::rbc::trackgraph::drag .tg focus {}}
                destroyed {destroy .trackFocus}
                changed {focus .trackOther; update}
            }
            event generate .tg <ButtonRelease-1> -x $x -y $y
            update
            set expected [dict get {empty . graph .tg destroyed . changed .trackOther} $initial]
            expr {[focus] eq $expected}
        } -cleanup {destroy .tg .trackFocus .trackOther} -result 1
    }

    test RBC.trackgraph.separator.A.14.1 {a second press does not overwrite the original focus owner} -setup {
        FocusSetup
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        update
        focus
    } -cleanup {destroy .tg .trackFocus .trackOther} -result .trackFocus

    foreach finish {release cancel invert} {
        test RBC.trackgraph.separator.A.15.[incr testCase(15)] {horizontal separators resize and cancel safely} -setup {
            Create
            .tg configure -invertxy yes -trackresize yes -cursor crosshair
            update
        } -body {
            set x [.tg track sashpos voltage]
            lassign [.tg track bbox voltage] l t r b
            set y [expr {($t+$b)/2}]
            event generate .tg <Motion> -x $x -y $y
            set cursor [.tg cget -cursor]
            event generate .tg <ButtonPress-1> -x $x -y $y
            if {$finish eq "invert"} {.tg configure -invertxy no}
            event generate .tg <B1-Motion> -x [expr {$x+30}] -y $y
            if {$finish eq "cancel"} {
                catch {eval [string map [list %W .tg] [bind Trackgraph <Escape>]]}
            } else {
                event generate .tg <ButtonRelease-1> -x [expr {$x+30}] -y $y
            }
            update
            set valid [expr {$finish eq "release" ? abs([.tg track sashpos voltage]-$x-30)<=1 :
                [.tg track cget voltage -weight]==2.0 && [.tg track cget current -weight]==1.0}]
            list $cursor $valid [.tg cget -cursor] [dict exists $::rbc::trackgraph::drag .tg]
        } -cleanup {destroy .tg} -result {sb_h_double_arrow 1 crosshair 0}
    }

    foreach inverted {0 1} {
        foreach renderer {native cairo} {
            test RBC.trackgraph.separator.A.16.[incr testCase(16)] {optional dividers follow the sash and disappear cleanly} \
                    -constraints trackRenderer$renderer -setup {
                Create $inverted
                .tg configure -renderer $renderer
                set photo [image create photo]
            } -body {
                set defaults [list [.tg cget -trackseparatorcolor] [.tg cget -trackseparatorwidth]]
                .tg configure -trackseparatorcolor #ff00ff -trackseparatorwidth 3
                update
                lassign [.tg track bbox voltage] l t r b
                set sash [.tg track sashpos voltage]
                if {$inverted} {set x $sash; set y [expr {($t+$b)/2}]} else {set x [expr {($l+$r)/2}]; set y $sash}
                .tg snap $photo
                set color [$photo get $x $y]
                .tg configure -trackseparatorcolor {}
                update
                .tg snap $photo
                list $defaults $color [expr {[$photo get $x $y] ne $color}] \
                    [catch {.tg configure -trackseparatorwidth 0}] [.tg cget -trackseparatorwidth]
            } -cleanup {image delete $photo; destroy .tg} -result {{{} 1} {255 0 255} 1 1 3}
        }
    }

    foreach inverted {0 1} {
        foreach format {svg pdf postscript} {
            test RBC.trackgraph.separator.A.17.[incr testCase(17)] {divider export is optional and restores its screen layout} -setup {
                Create $inverted
            } -body {
                set original [.tg $format output -decorations yes]
                set plain [.tg $format output -decorations no]
                set before [.tg track sashpos voltage]
                .tg configure -trackseparatorcolor magenta -trackseparatorwidth 2
                set decorated [.tg $format output -decorations yes]
                set enlarged [.tg $format output -width 900 -height 700]
                .tg $format configure -width 0 -height 0
                update
                list [expr {$original ne $decorated && $decorated ne $enlarged}] \
                    [expr {$plain eq [.tg $format output -decorations no]}] \
                    [expr {$before == [.tg track sashpos voltage]}]
            } -cleanup {destroy .tg} -result {1 1 1}
        }
    }

    foreach inverted {0 1} {
        test RBC.trackgraph.separator.A.18.[incr testCase(18)] {wide dividers stay strictly inside compressed gaps} -setup {
            Create $inverted
            .tg configure -renderer native -trackseparatorcolor magenta -trackseparatorwidth 100
            set photo [image create photo]
        } -body {
            set valid 1
            foreach size {640 100 110 120} {
                .tg configure -width $size -height $size
                update
                .tg snap $photo
                lassign [.tg track bbox voltage] l t r b
                lassign [.tg track bbox current] l2 t2 r2 b2
                for {set y 0} {$y<[image height $photo]} {incr y} {
                    for {set x 0} {$x<[image width $photo]} {incr x} {
                        if {[$photo get $x $y] eq {255 0 255}} {
                            if {$inverted ? !($x>$r && $x<$l2) : !($y>$b && $y<$t2)} {set valid 0}
                        }
                    }
                }
            }
            set valid
        } -cleanup {image delete $photo; destroy .tg} -result 1
    }

    test RBC.trackgraph.separator.A.19.1 {scrolling layout resizes requested height, changing extent instead of adjacent weights} -setup {
        ScrollSetup
    } -body {
        set height [.tg track cget voltage -height]
        set next [.tg track cget current -height]
        set weights [list [.tg track cget voltage -weight] [.tg track cget current -weight]]
        .tg track sashpos voltage [expr {[.tg track sashpos voltage]+30}]
        update
        list [expr {[.tg track cget voltage -height]==$height+30}] \
            [expr {[.tg track cget current -height]==$next}] \
            [expr {$weights eq [list [.tg track cget voltage -weight] [.tg track cget current -weight]]}]
    } -cleanup {destroy .tg} -result {1 1 1}

    foreach inverted {0 1} {
        test RBC.trackgraph.separator.A.20.[incr testCase(20)] {Escape restores requested size in scrolling mode and list scrolling cancels a gesture} -setup {
            ScrollSetup $inverted
            .tg track configure voltage -height 140
            .tg configure -trackresize yes
            update
        } -body {
            lassign [.tg track bbox voltage] l t r b
            set sash [.tg track sashpos voltage]
            if {$inverted} {set x $sash; set y [expr {($t+$b)/2}]} else {set x [expr {($l+$r)/2}]; set y $sash}
            event generate .tg <ButtonPress-1> -x $x -y $y
            event generate .tg <B1-Motion> -x [expr {$x+($inverted?20:0)}] -y [expr {$y+($inverted?0:20)}]
            set changed [expr {[.tg track cget voltage -height]==160}]
            set canceled [catch {::rbc::trackgraph::Cancel .tg}]
            set restored [expr {[.tg track cget voltage -height]==140}]
            event generate .tg <ButtonPress-1> -x $x -y $y
            .tg track view scroll 1 units
            event generate .tg <B1-Motion> -x $x -y $y
            list $changed $restored $canceled [dict exists $::rbc::trackgraph::drag .tg]
        } -cleanup {destroy .tg} -result {1 1 3 0}
    }
    cleanupTests
}
namespace delete ::trackgraph.separator
