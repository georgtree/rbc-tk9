# RBC.trackgraph.delete.A.test --
#
###Abstract
# Trackgraph delete tests, including interactions with owned tracks.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Package Definition
package provide trackgraph.delete

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval trackgraph.delete {
    source [file join [file dirname [info script]] RBC.trackgraph.support.tcl]

    test RBC.trackgraph.delete.A.1.1 {moving elements permits deleting tracks without deleting axes or vectors} -setup {
        Create
    } -body {
        .tg element configure v -track current -mapy amps
        .tg track delete voltage
        update
        list [.tg track names] [.tg element cget v -track] \
            [expr {"volts" in [.tg axis names]}] [.tg yaxis use]
    } -cleanup {destroy .tg} -result {current current 1 amps}

    test RBC.trackgraph.delete.A.2.1 {batch deletion accepts duplicates and retains axes for reuse} -setup {
        Create
        .tg element delete v i
        .tg track grid voltage configure -hide no
    } -body {
        .tg track delete
        .tg track delete voltage current voltage
        set empty [.tg track names]
        .tg track create restored -yaxes {volts amps}
        list $empty [.tg track cget restored -yaxes]
    } -cleanup {destroy .tg} -result {{} {volts amps}}

    test RBC.trackgraph.delete.A.3.1 {missing names and occupied tracks reject the entire deletion batch} -setup {
        Create
        .tg track create empty
    } -body {
        set before [.tg track names]
        set result {}
        foreach names {{empty missing} {empty voltage} {empty current}} {
            lappend result [catch {.tg track delete {*}$names}] [expr {$before eq [.tg track names]}]
        }
        .tg element delete v i
        .tg marker create line -name occupied -track voltage -mapy volts -coords {0 0 1 1}
        lappend result [catch {.tg track delete empty voltage}] [expr {$before eq [.tg track names]}]
        expr {0 ni $result}
    } -cleanup {destroy .tg} -result 1
    cleanupTests
}
namespace delete ::trackgraph.delete
