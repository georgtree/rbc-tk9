# Private EPS/window/color ownership checks; normal suite runs skip this harness.
package provide resources.lifecycle
package require tcltest
namespace import tcltest::*
set resourceAvailable 0
if {[info exists ::env(RBC_RESOURCE_TEST_LIB)]} {
    package require Tk
    load $::env(RBC_RESOURCE_TEST_LIB) Rbcresourcetest
    set resourceAvailable 1
}
testConstraint resourceHarness $resourceAvailable
namespace eval resources.lifecycle {
    test RBC.resources.lifecycle.A.1.1 {window lookup/deletion before first setter} \
        -constraints resourceHarness -body {
            ::rbcresourcetest missing
        } -result 1
    test RBC.resources.lifecycle.A.1.2 {window payload replacement and repeated deletion} \
        -constraints resourceHarness -body {
            ::rbcresourcetest roundtrip
        } -result 1
    test RBC.resources.lifecycle.A.1.3 {failed X parent lookup keeps the client window} \
        -constraints {resourceHarness unix} -body {
            ::rbcresourcetest parent
        } -result 1
    foreach {case action} {1 destroy 2 reconfigure} {
        test RBC.resources.lifecycle.A.2.$case "deleted EPS preview is released on $action" \
            -constraints resourceHarness -setup {
                canvas .resourceCanvas
                set photo [image create photo -width 4 -height 4]
                set item [.resourceCanvas create eps 0 0 -image $photo]
                ::rbcresourcetest reset
            } -body {
                image delete $photo
                set deferred [::rbcresourcetest frees]
                if {$action eq "reconfigure"} {
                    .resourceCanvas itemconfigure $item -image {}
                }
                destroy .resourceCanvas
                list $deferred [::rbcresourcetest frees]
            } -cleanup {
                catch {destroy .resourceCanvas}
                catch {image delete $photo}
            } -result {0 1}
    }
    foreach {case foreground background allowDefault expected} {
        1 red __rbc_invalid_color__ 0 {1 1 1 1 1}
        2 {} __rbc_invalid_color__ 0 {1 0 0 1 1}
        3 defcolor __rbc_invalid_color__ 1 {1 0 0 1 1}
        4 d __rbc_invalid_color__ 1 {1 0 0 1 1}
        5 __rbc_invalid_color__ blue 0 {1 0 0 1 1}
        6 red blue 0 {0 2 2 1 0}
        7 red red 0 {0 2 2 1 0}
        8 {} {} 0 {0 0 0 1 0}
        9 defcolor defcolor 1 {0 0 0 1 0}
        10 red {} 0 {0 1 1 1 0}
    } {
        test RBC.resources.lifecycle.A.3.$case {color-pair staging balances references and preserves output on failure} \
            -constraints resourceHarness -body {
                ::rbccolorpairtest $foreground $background $allowDefault
            } -result $expected
    }

}
cleanupTests
if {$resourceAvailable} {destroy .}
