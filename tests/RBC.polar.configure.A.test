# RBC.polar.configure.A.test --
#
###Abstract
# This file contains the automatic tests that test the configure
# function of the polar RBC component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#

###Package Definition
package provide polar.configure

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.configure {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that the polar command creates a Tk widget with class Polar.
	# ------------------------------------------------------------------------------------
	test RBC.polar.configure.A.1.1 {
		polar: Tk widget class
	} -setup {
		polar .polar1
	} -body {
		winfo class .polar1
	} -cleanup {
		destroy .polar1
	} -result {Polar}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that graph configuration options are available to polar widgets.
	# ------------------------------------------------------------------------------------
	test RBC.polar.configure.A.1.2 {
		polar configure: aspect
	} -setup {
		polar .polar1
	} -body {
		.polar1 configure -aspect 1.0
		.polar1 cget -aspect
	} -cleanup {
		destroy .polar1
	} -result {1.0}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that configuration options can be supplied at creation time.
	# ------------------------------------------------------------------------------------
	test RBC.polar.configure.A.1.3 {
		polar configure: creation-time aspect
	} -setup {
		polar .polar1 -aspect 1.0
	} -body {
		.polar1 cget -aspect
	} -cleanup {
		destroy .polar1
	} -result {1.0}

    test RBC.polar.configure.A.1.4 {
        polar configure: label anchor defaults
    } -setup {
        polar .polar1
    } -body {
        list [.polar1 cget -radiallabelanchor] [.polar1 cget -anglelabelanchor]
    } -cleanup {
        destroy .polar1
    } -result {se center}

    test RBC.polar.configure.A.1.5 {
        polar configure: label anchors
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure -radiallabelanchor nw -anglelabelanchor e
        list [.polar1 cget -radiallabelanchor] [.polar1 cget -anglelabelanchor]
    } -cleanup {
        destroy .polar1
    } -result {nw e}

    test RBC.polar.configure.A.1.6 {
        polar configure: creation-time label anchors
    } -setup {
        polar .polar1 -radiallabelanchor sw -anglelabelanchor n
    } -body {
        list [.polar1 cget -radiallabelanchor] [.polar1 cget -anglelabelanchor]
    } -cleanup {
        destroy .polar1
    } -result {sw n}

    test RBC.polar.configure.A.1.7 {
        polar configure: invalid label anchor rolls back
    } -setup {
        polar .polar1
    } -body {
        set code [catch {.polar1 configure -anglelabelanchor badAnchor}]
        list $code [.polar1 cget -anglelabelanchor]
    } -cleanup {
        destroy .polar1
    } -result {1 center}

    test RBC.polar.configure.A.1.8 {
        polar configure: anglelabelanchor accepts auto
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure -anglelabelanchor auto
        .polar1 cget -anglelabelanchor
    } -cleanup {
        destroy .polar1
    } -result {auto}

    test RBC.polar.configure.A.1.9 {
        polar configure: radiallabelanchor accepts auto
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure -radiallabelanchor auto
        .polar1 cget -radiallabelanchor
    } -cleanup {
        destroy .polar1
    } -result {auto}

    test RBC.polar.configure.A.1.10 {
        polar configure: creation-time auto anchors
    } -setup {
        polar .polar1 -radiallabelanchor auto -anglelabelanchor auto
    } -body {
        list [.polar1 cget -radiallabelanchor] [.polar1 cget -anglelabelanchor]
    } -cleanup {
        destroy .polar1
    } -result {auto auto}

    test RBC.polar.configure.A.1.11 {
        polar configure: invalid auto-anchor value rolls back
    } -setup {
        polar .polar1
        .polar1 configure -anglelabelanchor auto
    } -body {
        set code [catch {.polar1 configure -anglelabelanchor badAnchor}]
        list $code [.polar1 cget -anglelabelanchor]
    } -cleanup {
        destroy .polar1
    } -result {1 auto}

    test RBC.polar.configure.A.1.12 {
        polar configure: default aspect is square
    } -setup {
        polar .polar1
    } -body {
        .polar1 cget -aspect
    } -cleanup {
        destroy .polar1
    } -result {1.0}

    test RBC.polar.configure.A.1.13 {
        polar configure: explicit aspect overrides Polar default
    } -setup {
        polar .polar1 -aspect 0.75
    } -body {
        .polar1 cget -aspect
    } -cleanup {
        destroy .polar1
    } -result {0.75}

    test RBC.polar.configure.A.representation.1 {
        polar representation: default
    } -setup {
        polar .polar1
    } -body {
        .polar1 cget -representation
    } -cleanup {
        destroy .polar1
    } -result {polar}


    test RBC.polar.configure.A.representation.2 {
        polar representation: smith
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure -representation smith
        .polar1 cget -representation
    } -cleanup {
        destroy .polar1
    } -result {smith}


    test RBC.polar.configure.A.representation.3 {
        polar representation: creation-time smith
    } -setup {
        polar .polar1 -representation smith
    } -body {
        .polar1 cget -representation
    } -cleanup {
        destroy .polar1
    } -result {smith}


    test RBC.polar.configure.A.representation.4 {
        polar representation: bad value rolls back
    } -setup {
        polar .polar1 -representation smith
    } -body {
        set code [catch {.polar1 configure -representation bad}]
        list $code [.polar1 cget -representation]
    } -cleanup {
        destroy .polar1
    } -result {1 smith}

    test RBC.polar.configure.A.representation.5 {
        polar representation: live polar smith switching
    } -setup {
        vector create z -type complex
        z set {{0 0} {0.5 0.25}}
        polar .polar1
        pack .polar1
        .polar1 element create Element1 -cdata z
        update
    } -body {
        .polar1 configure -representation smith
        update
        set first [.polar1 cget -representation]
        .polar1 configure -representation polar
        update
        list $first [.polar1 cget -representation]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {smith polar}

    test RBC.polar.configure.A.smithgrid.1 {
        polar smithgrid: default
    } -setup {
        polar .polar1
    } -body {
        .polar1 cget -smithgrid
    } -cleanup {
        destroy .polar1
    } -result {impedance}

    test RBC.polar.configure.A.smithgrid.2 {
        polar smithgrid: admittance
    } -setup {
        polar .polar1 -smithgrid admittance
    } -body {
        .polar1 cget -smithgrid
    } -cleanup {
        destroy .polar1
    } -result {admittance}

    test RBC.polar.configure.A.smithgrid.3 {
        polar smithgrid: both
    } -setup {
        polar .polar1 -smithgrid both
    } -body {
        .polar1 cget -smithgrid
    } -cleanup {
        destroy .polar1
    } -result {both}

    test RBC.polar.configure.A.smithgrid.4 {
        polar smithgrid: invalid value rolls back
    } -setup {
        polar .polar1 -smithgrid admittance
    } -body {
        set code [catch {.polar1 configure -smithgrid bad}]
        list $code [.polar1 cget -smithgrid]
    } -cleanup {
