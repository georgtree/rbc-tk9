    test RBC.polar.configure.A.smithticks.1 {
        polar Smith ticks: defaults
    } -setup {
        polar .polar1
    } -body {
        list [.polar1 cget -smithrealmajorticks] \
             [.polar1 cget -smithrealminorticks] \
             [.polar1 cget -smithimagmajorticks] \
             [.polar1 cget -smithimagminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{0 0.2 0.5 1 2 5} {0.1 0.3 0.7 1.5 3 10} {0.2 0.5 1 2 5} {0.1 0.3 0.7 1.5 3 10}}

    test RBC.polar.configure.A.smithticks.2 {
        polar Smith ticks: custom creation-time values
    } -setup {
        polar .polar1 \
            -smithrealmajorticks {0 0.25 0.5 1 4} \
            -smithrealminorticks {0.1 0.75 3} \
            -smithimagmajorticks {0.25 0.5 1 4} \
            -smithimagminorticks {0.1 0.75 3}
    } -body {
        list [.polar1 cget -smithrealmajorticks] \
             [.polar1 cget -smithrealminorticks] \
             [.polar1 cget -smithimagmajorticks] \
             [.polar1 cget -smithimagminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{0 0.25 0.5 1 4} {0.1 0.75 3} {0.25 0.5 1 4} {0.1 0.75 3}}

    test RBC.polar.configure.A.smithticks.3 {
        polar Smith ticks: live configuration
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure \
            -smithrealmajorticks {0 0.4 1 2} \
            -smithrealminorticks {0.2 0.7} \
            -smithimagmajorticks {0.4 1 2} \
            -smithimagminorticks {0.2 0.7}
        list [.polar1 cget -smithrealmajorticks] \
             [.polar1 cget -smithrealminorticks] \
             [.polar1 cget -smithimagmajorticks] \
             [.polar1 cget -smithimagminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{0 0.4 1 2} {0.2 0.7} {0.4 1 2} {0.2 0.7}}

    test RBC.polar.configure.A.smithticks.4 {
        polar Smith ticks: empty lists
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure \
            -smithrealmajorticks {} \
            -smithrealminorticks {} \
            -smithimagmajorticks {} \
            -smithimagminorticks {}
        list [.polar1 cget -smithrealmajorticks] \
             [.polar1 cget -smithrealminorticks] \
             [.polar1 cget -smithimagmajorticks] \
             [.polar1 cget -smithimagminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{} {} {} {}}

    test RBC.polar.configure.A.smithticks.5 {
        polar Smith ticks: zero is allowed for real contours
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure -smithrealmajorticks {0 0.5 1} -smithrealminorticks {0 0.25 2}
        list [.polar1 cget -smithrealmajorticks] [.polar1 cget -smithrealminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{0 0.5 1} {0 0.25 2}}

    test RBC.polar.configure.A.smithticks.6 {
        polar Smith ticks: negative real tick rolls back
    } -setup {
        polar .polar1 -smithrealmajorticks {0 0.5 1}
    } -body {
        set code [catch {.polar1 configure -smithrealmajorticks {0 -0.5 1}}]
        list $code [.polar1 cget -smithrealmajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 0.5 1}}

    test RBC.polar.configure.A.smithticks.7 {
        polar Smith ticks: zero imaginary tick rolls back
    } -setup {
        polar .polar1 -smithimagmajorticks {0.5 1 2}
    } -body {
        set code [catch {.polar1 configure -smithimagmajorticks {0 0.5 1}}]
        list $code [.polar1 cget -smithimagmajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0.5 1 2}}

    test RBC.polar.configure.A.smithticks.8 {
        polar Smith ticks: negative imaginary tick rolls back
    } -setup {
        polar .polar1 -smithimagminorticks {0.25 0.75 3}
    } -body {
        set code [catch {.polar1 configure -smithimagminorticks {0.25 -0.75 3}}]
        list $code [.polar1 cget -smithimagminorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0.25 0.75 3}}

    test RBC.polar.configure.A.smithticks.9 {
        polar Smith ticks: non-finite tick rolls back
    } -setup {
        polar .polar1 -smithrealminorticks {0.1 0.3 0.7}
    } -body {
        set code [catch {.polar1 configure -smithrealminorticks {0.1 Inf 0.7}}]
        list $code [.polar1 cget -smithrealminorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0.1 0.3 0.7}}

    test RBC.polar.configure.A.smithticks.10 {
        polar Smith ticks: malformed list rolls back
    } -setup {
        polar .polar1 -smithrealmajorticks {0 0.5 1}
    } -body {
        set bad "{malformed"
        set code [catch {.polar1 configure -smithrealmajorticks $bad}]
        list $code [.polar1 cget -smithrealmajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 0.5 1}}

    test RBC.polar.configure.A.smithticks.11 {
        polar Smith ticks: invalid earlier duplicate is not hidden
    } -setup {
        polar .polar1
    } -body {
        set code [catch {.polar1 configure -smithrealmajorticks {0 bad 1} -smithrealmajorticks {0 0.5 1}}]
        list $code [.polar1 cget -smithrealmajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 0.2 0.5 1 2 5}}

    test RBC.polar.configure.A.smithticks.12 {
        polar Smith ticks: failed multi-option transaction rolls back all values
    } -setup {
        polar .polar1 -smithrealmajorticks {0 0.5 1} -smithimagmajorticks {0.5 1 2}
    } -body {
        set code [catch {.polar1 configure -smithrealmajorticks {0 2 4} -smithimagmajorticks {0 1 2}}]
        list $code [.polar1 cget -smithrealmajorticks] [.polar1 cget -smithimagmajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 0.5 1} {0.5 1 2}}

    test RBC.polar.configure.A.smithticks.13 {
        polar Smith ticks: later valid duplicate wins
    } -setup {
        polar .polar1
    } -body {
        .polar1 configure -smithrealmajorticks {0 1 2} -smithrealmajorticks {0 2 4}
        .polar1 cget -smithrealmajorticks
    } -cleanup {
        destroy .polar1
    } -result {0 2 4}

    test RBC.polar.configure.A.smithticks.14 {
        polar Smith ticks: custom contours redraw
    } -setup {
        polar .polar1 -representation smith -smithgrid both -smithrealmajorticks {0 0.25 1 4} -smithrealminorticks\
                {0 0.1 0.75 3} -smithimagmajorticks {0.25 1 4} -smithimagminorticks {0.1 0.75 3}
        .polar1 grid configure -minor yes
        pack .polar1
    } -body {
        update
        winfo exists .polar1
    } -cleanup {
        destroy .polar1
    } -result {1}

    test RBC.polar.configure.A.smithticks.15 {
        polar Smith ticks: empty contours redraw
    } -setup {
        polar .polar1 -representation smith -smithrealmajorticks {} -smithrealminorticks {} -smithimagmajorticks {}\
                -smithimagminorticks {}
        pack .polar1
    } -body {
        update
        winfo exists .polar1
    } -cleanup {
        destroy .polar1
    } -result {1}

    test RBC.polar.configure.A.angleticks.1 {
        polar angular ticks: defaults
    } -setup {
        polar .polar1
    } -body {
        list [.polar1 cget -anglemajorticks] [.polar1 cget -angleminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{0 30 60 90 120 150 180 210 240 270 300 330} {15 45 75 105 135 165 195 225 255 285 315 345}}

    test RBC.polar.configure.A.angleticks.2 {
        polar angular ticks: custom values
    } -setup {
        polar .polar1 -anglemajorticks {0 45 90 180 270} -angleminorticks {22.5 67.5}
    } -body {
        list [.polar1 cget -anglemajorticks] [.polar1 cget -angleminorticks]
    } -cleanup {
        destroy .polar1
    } -result {{0 45 90 180 270} {22.5 67.5}}

    test RBC.polar.configure.A.angleticks.3 {
        polar angular ticks: invalid major tick rolls back
    } -setup {
        polar .polar1 -anglemajorticks {0 45 90}
    } -body {
        set code [catch {.polar1 configure -anglemajorticks {0 90 360}}]
        list $code [.polar1 cget -anglemajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 45 90}}

    test RBC.polar.configure.A.angleticks.4 {
        polar angular ticks: invalid earlier duplicate is not hidden
    } -setup {
        polar .polar1
    } -body {
        set code [catch {.polar1 configure -anglemajorticks {0 bad 90} -anglemajorticks {0 45 90}}]
        list $code [.polar1 cget -anglemajorticks]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 30 60 90 120 150 180 210 240 270 300 330}}

    test RBC.polar.configure.A.anglecommand.1 {
        polar angle command: default
    } -setup {
        polar .polar1
    } -body {
        .polar1 cget -anglecommand
    } -cleanup {
        destroy .polar1
    } -result {}

    test RBC.polar.configure.A.anglecommand.2 {
        polar angle command: command prefix
    } -setup {
        polar .polar1 -anglecommand [list FormatAngle prefix]
    } -body {
        .polar1 cget -anglecommand
    } -cleanup {
        destroy .polar1
    } -result {FormatAngle prefix}

    test RBC.polar.configure.A.anglecommand.3 {
        polar angle command: malformed prefix rolls back
    } -setup {
        polar .polar1 -anglecommand [list FormatAngle good]
    } -body {
        set bad "{malformed"
        set code [catch {.polar1 configure -anglecommand $bad}]
        list $code [.polar1 cget -anglecommand]
    } -cleanup {
        destroy .polar1
    } -result {1 {FormatAngle good}}

    test RBC.polar.configure.A.anglecommand.4 {
        polar angle command: receives major angle values
    } -setup {
        set ::polarAngleValues {}
        proc ::PolarAngleFormat {widget degrees} {
            lappend ::polarAngleValues $degrees
            return "angle=$degrees"
        }
        polar .polar1 -width 400 -height 400 -anglemajorticks {0 45 90} -anglecommand ::PolarAngleFormat
        pack .polar1
    } -body {
        update
        list [expr {[lsearch -exact $::polarAngleValues 0] >= 0}]\
                [expr {[lsearch -exact $::polarAngleValues 45] >= 0}]\
                [expr {[lsearch -exact $::polarAngleValues 90] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::PolarAngleFormat {}
        unset -nocomplain ::polarAngleValues
    } -result {1 1 1}

        cleanupTests
    }
