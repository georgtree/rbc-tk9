# SVG native image/window capture. See license.terms for details.
package provide graph.svg

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval graph.svg.capture {

    proc Create {} {
        ::rbc::graph .capture -width 400 -height 300
        .capture axis configure x -min 0 -max 10
        .capture axis configure y -min 0 -max 10
        .capture legend configure -hide yes
        pack .capture
        update idletasks
    }

    proc Photo {document} {
        if {![regexp {href="data:image/png;base64,([A-Za-z0-9+/=]+)"} $document -> encoded]} {
            error "Missing embedded PNG"
        }
        return [image create photo -data [binary decode base64 $encoded] -format png]
    }

    proc Bitmap {} {
        return [image create bitmap -foreground #112233 -background {} -data {
#define bits_width 8
#define bits_height 1
static unsigned char bits_bits[] = {
    0x55
};
}]
    }

    test svgCapture-1 {non-photo tiles embed transparent PNG and follow image updates} -setup {
        set source {}
        set decoded {}
        Create
        set source [Bitmap]
        .capture element create signal -data {1 2 5 8 9 2} -symbol none -linewidth 0 -areatile $source
    } -body {
        set first [.capture svg output]
        set decoded [Photo $first]
        set result [list [$decoded get 0 0 -withalpha] [$decoded transparency get 1 0 -alpha]\
                           [expr {[string first {<pattern } $first] >= 0}]]
        image delete $decoded
        set decoded {}
        $source configure -foreground #445566 -background #778899
        set decoded [Photo [.capture svg output]]
        lappend result [$decoded get 0 0 -withalpha] [$decoded get 1 0 -withalpha]
        set result
    } -cleanup {
        destroy .capture
        if {$source ne {}} {
            image delete $source 
        }
        if {$decoded ne {}} {
            image delete $decoded
        }
    } -result {{17 34 51 255} 0 1 {68 85 102 255} {119 136 153 255}}

    test svgCapture-2 {window markers embed current pixels and omit hidden content} -setup {
        set decoded {}
        Create
        frame .capture.child -width 24 -height 16 -background #112233 -borderwidth 0 -highlightthickness 0
        .capture marker create window -name child -coords {5 5} -window .capture.child
        update
    } -body {
        set decoded [Photo [.capture svg output]]
        set result [list [image width $decoded] [image height $decoded] [$decoded get 12 8 -withalpha]]
        image delete $decoded
        set decoded {}
        .capture.child configure -background #445566
        update
        set decoded [Photo [.capture svg output]]
        lappend result [$decoded get 12 8 -withalpha]
        .capture marker configure child -hide yes
        update
        lappend result [expr {[string first {<image } [.capture svg output]] < 0}]
        set result
    } -cleanup {
        destroy .capture
        if {$decoded ne {}} {
            image delete $decoded
        }
    } -result {24 16 {17 34 51 255} {68 85 102 255} 1}

    test svgCapture-3 {SVG capture leaves the legacy non-photo PostScript behavior unchanged} -setup {
        set source {}
        Create
        set source [Bitmap]
        .capture marker create image -name im -image $source -coords {5 5}
    } -body {
        set before [.capture postscript output]
        set before [string range $before [string first {% Transform coordinate system} $before] end]
        .capture svg output
        set after [.capture postscript output]
        set after [string range $after [string first {% Transform coordinate system} $after] end]
        expr {$before eq $after}
    } -cleanup {
        destroy .capture
        if {$source ne {}} {
            image delete $source
        }
    } -result 1
}

::tcltest::cleanupTests
