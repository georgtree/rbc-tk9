# RBC.graph.axis.create.A.test --
#
###Abstract
# This file tests the axis create function of the graph BLT component.
# Axis create is an instance function of graph.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.axis

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.axis {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the axis create command works correctly when given a unique axis
	# name.
	# ------------------------------------------------------------------------------------
	test RBC.graph.axis.create.A.1.1 {
		Unique Name
	} -setup {
		graph .graph1
	} -body {
		.graph1 axis create Axis1
		.graph1 axis names Axis1
	} -cleanup {
		destroy .graph1
	} -result {Axis1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the axis create command works correctly when given a unique axis
	# name and a valid option and value.
	# ------------------------------------------------------------------------------------
	test RBC.graph.axis.create.A.1.2 {
		Unique Name
	} -setup {
		graph .graph1
	} -body {
		.graph1 axis create Axis1 -color black
		.graph1 axis names Axis1
	} -cleanup {
		destroy .graph1
	} -result {Axis1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the axis create command works correctly when given an existing axis
	# name.
	# ------------------------------------------------------------------------------------
	test RBC.graph.axis.create.A.1.3 {
		Existing Name
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
	} -body {
		if {[catch {.graph1 axis create Axis1}]} {
			return 0
		} else {
			return 1
		}
	} -cleanup {
		destroy .graph1
	} -result {0}

    test RBC.graph.axis.create.A.2.1 {
        graph axis create: -title is not -titleshadow
    } -setup {
        graph .graph1
    } -body {
        set result [.graph1 axis create temp -title temp -titlecolor blue3]
        list $result [.graph1 axis cget temp -title] [.graph1 axis cget temp -titlecolor]
    } -cleanup {
        destroy .graph1
    } -result {temp temp blue3}

    set testCase(3) 0
    foreach invalidOptions {{-color noSuchAxisColour} {-rotate Inf}} {
        test RBC.graph.axis.create.A.3.[incr testCase(3)] {
            failed revival preserves a referenced axis and its configuration
        } -setup {
            graph .graph1
            .graph1 axis create retained -min 0 -max 10 -title Original
            .graph1 element create data -xdata {0 10} -ydata {0 1} -mapx retained
            set before [.graph1 axis configure retained]
            .graph1 axis delete retained
        } -body {
            set code [catch {.graph1 axis create retained -title Changed {*}$invalidOptions}]
            set result [list $code [.graph1 axis names retained]]
            .graph1 axis create retained
            lappend result [expr {$before eq [.graph1 axis configure retained]}] \
                [.graph1 element cget data -mapx] [.graph1 axis limits retained]
            .graph1 axis delete retained
            .graph1 element delete data
            # Releasing the final reference must remove the pending record.
            .graph1 axis create retained -title Fresh
            lappend result [.graph1 axis cget retained -title]
            set result
        } -cleanup {
            destroy .graph1
        } -result {1 {} 1 retained {0.0 10.0} Fresh}
    }

    test RBC.graph.axis.create.A.3.3 {
        failed creation of a new axis still removes its registry entry
    } -setup {
        graph .graph1
    } -body {
        set code [catch {.graph1 axis create fresh -rotate Inf}]
        list $code [.graph1 axis names fresh] [.graph1 axis create fresh]
    } -cleanup {
        destroy .graph1
    } -result {1 {} fresh}

	cleanupTests
}
