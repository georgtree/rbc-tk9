# SVG export commands and vector geometry. See license.terms for details.
###Package Definition
package provide graph.svg

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval graph.svg {
    # Numeric case IDs for loop-generated tests.
    array set testCase {7 0 13 0}
    proc Create {} {
        ::rbc::graph .svg -width 400 -height 300
        .svg axis configure x -min 0 -max 10 -loose no
        .svg axis configure y -min 0 -max 10 -loose no
        .svg element create signal -data {1 2 4 8 9 3} -symbol circle -color red
        pack .svg
        update idletasks
    }

    test RBC.graph.svg.A.1.1 {named export resources support class defaults, instance precedence and all graph types} -setup {
        interp create exportOptionChild
        interp eval exportOptionChild [list set auto_path $::auto_path]
        interp eval exportOptionChild {package require rbc; wm withdraw .}
    } -body {
        interp eval exportOptionChild {
            option add *Svg.Width 510
            option add *Svg.Height 320
            option add *Svg.Decorations false
            option add *Svg.EmbedFonts true
            option add *g.svg.width 620
            set result {}
            foreach type {graph barchart stripchart polar trackgraph} {
                rbc::$type .g
                lappend result [.g svg cget -width] [.g svg cget -height] \
                    [.g svg cget -decorations] [.g svg cget -embedfonts] \
                    [.g pdf cget -width] [expr {[winfo children .g] eq {}}]
                destroy .g
            }
            expr {$result eq [concat {620 320 0 1 0 1} {620 320 0 1 0 1} {620 320 0 1 0 1} {620 320 0 1 0 1} {620 320 0 1 0 1}]}
        }
    } -cleanup {interp delete exportOptionChild} -result 1

    test RBC.graph.svg.A.2.1 {database changes affect new widgets only; configure and output override initialized values} -setup {
        interp create exportOptionChild
        interp eval exportOptionChild [list set auto_path $::auto_path]
        interp eval exportOptionChild {package require rbc; wm withdraw .}
    } -body {
        interp eval exportOptionChild {
            option add *svg.width 510
            rbc::graph .g
            option add *svg.width 610
            rbc::graph .h
            set result [list [.g svg cget -width] [.h svg cget -width]]
            .g svg configure -width 520
            lappend result [.g svg configure -width]
            .g svg output -width 530
            lappend result [.g svg cget -width] [.g pdf cget -width]
            set result
        }
    } -cleanup {interp delete exportOptionChild} -result {510 610 {-width width Width 0 520} 530 0}

    test RBC.graph.svg.A.3.1 {invalid database dimensions and booleans fail widget creation cleanly} -setup {
        interp create exportOptionChild
        interp eval exportOptionChild [list set auto_path $::auto_path]
        interp eval exportOptionChild {package require rbc; wm withdraw .}
    } -body {
        interp eval exportOptionChild {
            set result {}
            foreach {resource value} {width -1 height bogus decorations bogus embedFonts bogus} {
                option clear
                option add *svg.$resource $value
                lappend result [catch {rbc::graph .g}] [expr {![winfo exists .g] && [info commands .g] eq {}}]
                option clear
                rbc::graph .g
                destroy .g
            }
            expr {0 ni $result}
        }
    } -cleanup {interp delete exportOptionChild} -result 1

    test RBC.graph.svg.A.4.1 {screen-distance resource values are converted to pixels} -setup {
        interp create exportOptionChild
        interp eval exportOptionChild [list set auto_path $::auto_path]
        interp eval exportOptionChild {package require rbc; wm withdraw .}
    } -body {
        interp eval exportOptionChild {
            option add *svg.width 2c
            option add *svg.height 1i
            rbc::graph .g
            list [expr {[.g svg cget -width]==[winfo pixels .g 2c]}] \
                [expr {[.g svg cget -height]==[winfo pixels .g 1i]}]
        }
    } -cleanup {interp delete exportOptionChild} -result {1 1}

    test RBC.graph.svg.A.5.1 {options are independent and invalid configurations roll back} -setup {
        Create
    } -body {
        set ps [.svg postscript cget -width]
        set defaults [list [.svg svg cget -width] [.svg svg cget -height] [.svg svg cget -decorations]]
        .svg svg configure -width 500 -height 350
        set failed [catch {.svg svg configure -width 600 -height -1}]
        list $defaults $failed [.svg svg cget -width] [.svg svg cget -height]\
                [expr {$ps eq [.svg postscript cget -width]}] [llength [.svg svg configure]]
    } -cleanup {
        destroy .svg
    } -result {{0 0 1} 1 500 350 1 4}

    test RBC.graph.svg.A.6.1 {document has XML, clipping, escaped text and no PostScript syntax} -setup {
        Create
        .svg configure -title {A & B < C}
        .svg marker create text -coords {5 5} -text {α & β} -rotate 27
    } -body {
        set data [.svg svg output]
        list [string match {<?xml*} $data]\
                [expr {[string first {xmlns="http://www.w3.org/2000/svg"} $data] >= 0}]\
                [expr {[string first {A &amp; B &lt; C} $data] >= 0}]\
                [expr {[string first {α &amp; β} $data] >= 0}]\
                [expr {[string first {clip-path="url(#rbcPlot)"} $data] >= 0}]\
                [expr {[string first {%%} $data] < 0 && [string first {setlinewidth} $data] < 0}]\
                [string match *</svg>\n $data]
    } -cleanup {
        destroy .svg
    } -result {1 1 1 1 1 1 1}

    foreach symbol {circle square diamond plus cross splus scross triangle arrow} {
        test RBC.graph.svg.A.7.[incr testCase(7)] {standard symbol exports without a screen-renderer dependency} -setup {
            Create
            .svg element configure signal -symbol $symbol
        } -body {
            set data [.svg svg output]
            expr {[string first {<g transform="translate(} $data] >= 0 && [string first {stroke="#ff0000"} $data] >= 0}
        } -cleanup {
            destroy .svg
        } -result 1
    }

    test RBC.graph.svg.A.8.1 {solid area opacity is exported} -setup {
        Create
        .svg element configure signal -areapattern solid -areaforeground blue -areaopacity 0.35
    } -body {
        expr {[string first {fill-opacity="0.35"} [.svg svg output]] >= 0}
    } -cleanup {
        destroy .svg
    } -result 1

    test RBC.graph.svg.A.9.1 {invalid XML text does not truncate an existing output file} -setup {
        Create
        .svg configure -title "invalid\u0001text"
        set path [makeFile KEEP svg-preserve.svg]
    } -body {
        set failed [catch {.svg svg output $path} message]
        set f [open $path r]
        set data [read $f]
        close $f
        list $failed [string match {*XML cannot represent*} $message] [string trim $data]
    } -cleanup {
        destroy .svg
        removeFile svg-preserve.svg
    } -result {1 1 KEEP}

    test RBC.graph.svg.A.10.1 {output size persists as an SVG option and screen mapping is restored} -setup {
        Create
        set before [.svg transform 5 5]
    } -body {
        set data [.svg svg output -width 500 -height 350]
        update idletasks
        list [expr {[string first {viewBox="0 0 500 350"} $data] >= 0}] [.svg svg cget -width]\
                [expr {$before eq [.svg transform 5 5]}] [string match {%!PS-Adobe*} [.svg postscript output]]
    } -cleanup {
        destroy .svg
    } -result {1 500 1 1}

    test RBC.graph.svg.A.11.1 {UTF-8 file output matches returned document} -setup {
        Create
        .svg configure -title {α & β}
        set path [makeFile {} svg-output.svg]
    } -body {
        set expected [.svg svg output]
        .svg svg output $path
        set f [open $path r]
        fconfigure $f -encoding utf-8 -translation lf
        set actual [read $f]
        close $f
        expr {$expected eq $actual}
    } -cleanup {
        destroy .svg
        removeFile svg-output.svg
    } -result 1

    test RBC.graph.svg.A.12.1 {bitmap symbols export as reusable vector geometry} -setup {
        Create
        .svg element configure signal -symbol warning
    } -body {
        expr {[string first {<use href="#rbcBitmap} [.svg svg output]] >= 0}
    } -cleanup {
        destroy .svg
    } -result 1

    foreach type {stripchart barchart polar} {
        test RBC.graph.svg.A.13.[incr testCase(13)] {other graph types use the SVG export traversal} -setup {
            ::rbc::$type .svg -width 400 -height 300
            .svg element create signal -data {1 2 4 8 9 3}
            pack .svg
            update idletasks
        } -body {
            set data [.svg svg output]
            list [string match {<?xml*} $data] [string match *</svg>\n $data]
        } -cleanup {
            destroy .svg
        } -result {1 1}
    }

    test RBC.graph.svg.A.14.1 {XML-incompatible text reports an error} -setup {
        Create
        .svg configure -title "invalid\u0001text"
    } -body {
        set failed [catch {.svg svg output} message]
        list $failed [string match {*XML cannot represent*} $message]
    } -cleanup {
        destroy .svg
    } -result {1 1}

    test RBC.graph.svg.A.15.1 {photo markers embed PNG data} -setup {
        Create
        set image [image create photo -width 8 -height 8]
        $image put red -to 0 0 8 8
        .svg marker create image -coords {5 5} -image $image
    } -body {
        expr {[string first {href="data:image/png;base64,} [.svg svg output]] >= 0}
    } -cleanup {
        destroy .svg
        image delete $image
    } -result 1

    test RBC.graph.svg.A.16.1 {alternating exports preserve independent state and PostScript geometry} -setup {
        Create
        .svg postscript configure -decorations yes
        set before [.svg postscript output]
        set before [string range $before [string first {% Transform coordinate system} $before] end]
    } -body {
        .svg svg output -width 700 -height 450 -decorations no
        set after [.svg postscript output]
        set after [string range $after [string first {% Transform coordinate system} $after] end]
        list [expr {$before eq $after}] [.svg postscript cget -decorations] [.svg svg cget -decorations]\
                [.svg svg cget -width]
    } -cleanup {
        destroy .svg
    } -result {1 1 0 700}

    test RBC.graph.svg.A.17.1 {failed SVG export does not poison later PostScript or SVG exports} -setup {
        Create
        .svg configure -title "invalid\u0001text"
    } -body {
        set failed [catch {.svg svg output}]
        set ps [.svg postscript output]
        .svg configure -title {}
        set svg [.svg svg output]
        list $failed [string match {%!PS-Adobe*} $ps] [string match {<?xml*} $svg]
    } -cleanup {
        destroy .svg
    } -result {1 1 1}


    test RBC.graph.svg.A.18.1 {complete metadata uses stable defaults and current configured values} -setup {
        Create
        .svg svg configure -w 321 -h 234 -d no -e yes
    } -body {
        set result {}
        foreach info [.svg svg configure] {
            set name [lindex $info 0]
            lappend result [expr {$info eq [.svg svg configure $name]}] \
                [expr {[lindex $info 4] eq [.svg svg cget $name]}]
        }
        list [expr {0 ni $result}] [.svg svg configure]
    } -cleanup {destroy .svg} -result {1 {{-width width Width 0 321} {-height height Height 0 234} {-decorations decorations Decorations 1 0} {-embedfonts embedFonts EmbedFonts 0 1}}}

    test RBC.graph.svg.A.18.2 {ambiguous options preserve state and report the component's option list} -setup {
        Create
    } -body {
        set before [.svg svg configure]
        set failed [catch {.svg svg configure -w 700 - 1} message]
        list $failed $message [expr {$before eq [.svg svg configure]}]
    } -cleanup {destroy .svg} -result {1 {ambiguous SVG option "-": must be -width, -height, -decorations, or -embedfonts} 1}


cleanupTests
}
