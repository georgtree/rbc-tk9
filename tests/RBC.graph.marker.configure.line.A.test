    test RBC.graph.marker.configure.line.A.10.4 {
        graph marker configure line: arrowshape - too few values
    } -setup {
        graph .graph1
        .graph1 marker create line -name Marker1 -coords {0 0 1 1}
    } -body {
        catch {.graph1 marker configure Marker1 -arrowshape {8 10}}
    } -cleanup {
        destroy .graph1
    } -result {1}

    test RBC.graph.marker.configure.line.A.10.5 {
        graph marker configure line: arrowshape - too many values
    } -setup {
        graph .graph1
        .graph1 marker create line -name Marker1 -coords {0 0 1 1}
    } -body {
        catch {.graph1 marker configure Marker1 -arrowshape {8 10 3 2}}
    } -cleanup {
        destroy .graph1
    } -result {1}

    test RBC.graph.marker.configure.line.A.10.6 {
        graph marker configure line: arrowshape - invalid screen distance
    } -setup {
        graph .graph1
        .graph1 marker create line -name Marker1 -coords {0 0 1 1}
    } -body {
        catch {.graph1 marker configure Marker1 -arrowshape {8 bad 3}}
    } -cleanup {
        destroy .graph1
    } -result {1}

    test RBC.graph.marker.configure.line.A.10.7 {
        graph marker configure line: arrow and arrowshape - transactional rollback
    } -setup {
        graph .graph1
        .graph1 marker create line -name Marker1 -coords {0 0 1 1} -arrow first -arrowshape {8 10 3}
    } -body {
        set code [catch {.graph1 marker configure Marker1 -arrow both -arrowshape {20 bad 5}}]
        list $code [.graph1 marker cget Marker1 -arrow] [.graph1 marker cget Marker1 -arrowshape]
    } -cleanup {
        destroy .graph1
    } -result {1 first {8 10 3}}	

	cleanupTests
}
