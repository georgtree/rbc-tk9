# RBC.polar.postscript.output.A.test --
#
###Abstract
# This file tests PostScript output from the polar RBC component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.

###Package Definition
package provide polar.postscript

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.postscript {

    test RBC.polar.postscript.output.A.1.1 {
        polar postscript output: complex element
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1} {-1 0} {0 -1}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        .polar1 element create Element1 -cdata z -symbol circle
        update
    } -body {
        set code [catch {.polar1 postscript output} ps]
        list $code [expr {[string length $ps] > 0}]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {0 1}

    test RBC.polar.postscript.output.A.1.2 {
        polar postscript output: complex value labels
    } -setup {
        vector create z -type complex
        z set {{1 2} {-3 4}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -5 -max 5
        .polar1 axis configure y -min -5 -max 5
        .polar1 element create Element1 -cdata z -symbol circle -showvalues both
        update
    } -body {
        set code [catch {.polar1 postscript output} ps]
        list $code [expr {[string length $ps] > 0}]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {0 1}

    test RBC.polar.postscript.output.A.1.3 {
        polar postscript output: angular labels
    } -setup {
        vector create z -type complex
        z set {{0 0} {2 0}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 element create Element1 -cdata z
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {30\260} $ps] >= 0}] [expr {[string first {330\260} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {1 1}

    test RBC.polar.postscript.output.A.1.4 {
        polar postscript output: radial labels use x axis command
    } -setup {
        proc FormatRadius {w value} {
            return "radius=$value"
        }
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 2 -majorticks {-2 -1 0 1 2} -command FormatRadius
        .polar1 axis configure y -min -2 -max 2
        .polar1 grid configure -hide no
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {radius=1} $ps] >= 0}
    } -cleanup {
        destroy .polar1
        rename FormatRadius {}
    } -result {1}

    test RBC.polar.postscript.output.A.smith.1 {
        smith postscript output: normalized reactance labels
    } -setup {
        polar .polar1 -width 400 -height 400 -representation smith
        pack .polar1
        .polar1 grid configure -hide no
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {+j0.2} $ps] >= 0}] [expr {[string first {-j0.2} $ps] >= 0}]\
                [expr {[string first {+j5} $ps] >= 0}] [expr {[string first {-j5} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
    } -result {1 1 1 1}

    test RBC.polar.postscript.output.A.smith.2 {
        smith postscript output: y -showticks hides reactance labels
    } -setup {
        polar .polar1 -width 400 -height 400 -representation smith
        pack .polar1
        .polar1 axis configure y -showticks no
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {+j0.2} $ps] < 0}
    } -cleanup {
        destroy .polar1
    } -result {1}

    cleanupTests
}
