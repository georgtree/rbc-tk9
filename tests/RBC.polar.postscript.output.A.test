# RBC.polar.postscript.output.A.test --
#
###Abstract
# This file tests PostScript output from the polar RBC component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.

###Package Definition
package provide polar.postscript

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.postscript {

    test RBC.polar.postscript.output.A.1.1 {
        polar postscript output: complex element
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1} {-1 0} {0 -1}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        .polar1 element create Element1 -cdata z -symbol circle
        update
    } -body {
        set code [catch {.polar1 postscript output} ps]
        list $code [expr {[string length $ps] > 0}]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {0 1}

    test RBC.polar.postscript.output.A.1.2 {
        polar postscript output: complex value labels
    } -setup {
        vector create z -type complex
        z set {{1 2} {-3 4}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -5 -max 5
        .polar1 axis configure y -min -5 -max 5
        .polar1 element create Element1 -cdata z -symbol circle -showvalues both
        update
    } -body {
        set code [catch {.polar1 postscript output} ps]
        list $code [expr {[string length $ps] > 0}]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {0 1}

    test RBC.polar.postscript.output.A.1.3 {
        polar postscript output: angular labels
    } -setup {
        vector create z -type complex
        z set {{0 0} {2 0}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 element create Element1 -cdata z
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {30\260} $ps] >= 0}] [expr {[string first {330\260} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {1 1}

    test RBC.polar.postscript.output.A.1.4 {
        polar postscript output: radial labels use x axis command
    } -setup {
        proc FormatRadius {w value} {
            return "radius=$value"
        }
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 2 -majorticks {-2 -1 0 1 2} -command FormatRadius
        .polar1 axis configure y -min -2 -max 2
        .polar1 grid configure -hide no
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {radius=1} $ps] >= 0}
    } -cleanup {
        destroy .polar1
        rename FormatRadius {}
    } -result {1}

    test RBC.polar.postscript.output.A.smith.1 {
        smith postscript output: normalized reactance labels
    } -setup {
        polar .polar1 -width 400 -height 400 -representation smith
        pack .polar1
        .polar1 grid configure -hide no
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {+j0.2} $ps] >= 0}] [expr {[string first {-j0.2} $ps] >= 0}]\
                [expr {[string first {+j5} $ps] >= 0}] [expr {[string first {-j5} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
    } -result {1 1 1 1}

    test RBC.polar.postscript.output.A.smith.2 {
        smith postscript output: y -showticks hides reactance labels
    } -setup {
        polar .polar1 -width 400 -height 400 -representation smith
        pack .polar1
        .polar1 axis configure y -showticks no
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {+j0.2} $ps] < 0}
    } -cleanup {
        destroy .polar1
    } -result {1}

    test RBC.polar.postscript.output.A.smithgrid.1 {
        smith postscript: live grid-domain switching
    } -setup {
        polar .polar1 -width 400 -height 400 -representation smith
        pack .polar1
        update
    } -body {
        .polar1 configure -smithgrid admittance
        update
        set code1 [catch {.polar1 postscript output}]
        .polar1 configure -smithgrid both
        update
        set code2 [catch {.polar1 postscript output}]
        .polar1 configure -smithgrid impedance
        update
        set code3 [catch {.polar1 postscript output}]
        list $code1 $code2 $code3
    } -cleanup {
        destroy .polar1
    } -result {0 0 0}

    test RBC.polar.postscript.output.A.anglecommand.1 {
        polar postscript: custom angle command
    } -setup {
        proc ::PolarPsAngleFormat {widget degrees} {
            return "ANGLE-$degrees"
        }
        polar .polar1 -width 400 -height 400 -anglemajorticks {0 45 90} -anglecommand ::PolarPsAngleFormat
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {ANGLE-0} $ps] >= 0}] [expr {[string first {ANGLE-45} $ps] >= 0}]\
                [expr {[string first {ANGLE-90} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::PolarPsAngleFormat {}
    } -result {1 1 1}

    test RBC.polar.postscript.output.A.anglecommand.2 {
        polar postscript: empty angle command result suppresses label
    } -setup {
        proc ::PolarPsAngleSuppress {widget degrees} {
            return {}
        }
        polar .polar1 -width 400 -height 400 -anglemajorticks {13} -anglecommand ::PolarPsAngleSuppress
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {13\260} $ps] < 0}
    } -cleanup {
        destroy .polar1
        rename ::PolarPsAngleSuppress {}
    } -result {1}

    test RBC.polar.postscript.output.A.smithcommand.1 {
        smith postscript: custom real label command
    } -setup {
        proc ::SmithPsRealFormat {widget domain value} {
            return "REAL-$domain-$value"
        }
        polar .polar1 -width 400 -height 400 -representation smith -smithgrid impedance -smithrealmajorticks {0 0.5 1}\
                -smithrealcommand ::SmithPsRealFormat
        pack .polar1
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {REAL-impedance-0} $ps] >= 0}] [expr {[string first {REAL-impedance-0.5} $ps] >= 0}]\
                [expr {[string first {REAL-impedance-1} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::SmithPsRealFormat {}
    } -result {1 1 1}

    test RBC.polar.postscript.output.A.smithcommand.2 {
        smith postscript: custom imaginary command receives signed values
    } -setup {
        proc ::SmithPsImagFormat {widget domain value} {
            return "IMAG-$domain-$value"
        }
        polar .polar1 -width 400 -height 400 -representation smith -smithgrid impedance -smithimagmajorticks {0.5 1}\
                -smithimagcommand ::SmithPsImagFormat
        pack .polar1
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {IMAG-impedance-0.5} $ps] >= 0}]\
                [expr {[string first {IMAG-impedance--0.5} $ps] >= 0}]\
                [expr {[string first {IMAG-impedance-1} $ps] >= 0}]\
                [expr {[string first {IMAG-impedance--1} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::SmithPsImagFormat {}
    } -result {1 1 1 1}

    test RBC.polar.postscript.output.A.smithcommand.3 {
        smith postscript: custom labels distinguish impedance and admittance
    } -setup {
        proc ::SmithPsDomainFormat {widget domain value} {
            return "DOMAIN-$domain-$value"
        }
        polar .polar1 -width 400 -height 400 -representation smith -smithgrid both -smithrealmajorticks {0.5}\
                -smithrealcommand ::SmithPsDomainFormat
        pack .polar1
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {DOMAIN-impedance-0.5} $ps] >= 0}]\
            [expr {[string first {DOMAIN-admittance-0.5} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::SmithPsDomainFormat {}
    } -result {1 1}

    test RBC.polar.postscript.output.A.smithcommand.4 {
        smith postscript: command prefix
    } -setup {
        proc ::SmithPsPrefixFormat {prefix widget domain value} {
            return "$prefix-$domain-$value"
        }
        polar .polar1 -width 400 -height 400 -representation smith -smithgrid impedance -smithrealmajorticks {0.5}\
                -smithrealcommand [list ::SmithPsPrefixFormat PREFIX]
        pack .polar1
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {PREFIX-impedance-0.5} $ps] >= 0}
    } -cleanup {
        destroy .polar1
        rename ::SmithPsPrefixFormat {}
    } -result {1}

    test RBC.polar.postscript.output.A.gridaxes.1 {
        polar postscript: labels use grid mapped axes
    } -setup {
        proc ::PolarGridAxisFormat {widget degrees} {
            return "GRIDANGLE-$degrees"
        }
        polar .polar1 -width 400 -height 400 -anglemajorticks {0 90} -anglecommand ::PolarGridAxisFormat
        pack .polar1
        #
        # The normal x/y axes do not contain the origin, so they
        # cannot define a Polar grid.
        #
        .polar1 axis configure x -min 10 -max 20
        .polar1 axis configure y -min 10 -max 20
        #
        # The alternate axes do contain the origin.
        #
        .polar1 axis configure x2 -min -2 -max 2
        .polar1 axis configure y2 -min -2 -max 2
        .polar1 grid configure -mapx x2 -mapy y2
        update
    } -body {
        set ps [.polar1 postscript output]
        list [.polar1 grid cget -mapx] [.polar1 grid cget -mapy] [expr {[string first {GRIDANGLE-0} $ps] >= 0}]\
                [expr {[string first {GRIDANGLE-90} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::PolarGridAxisFormat {}
    } -result {x2 y2 1 1}

    test RBC.polar.postscript.output.A.gridaxes.2 {
        polar postscript: live grid axis switching
    } -setup {
        proc ::PolarGridSwitchFormat {widget degrees} {
            return "SWITCHANGLE-$degrees"
        }
        polar .polar1 -width 400 -height 400 -anglemajorticks {45} -anglecommand ::PolarGridSwitchFormat
        pack .polar1
        .polar1 axis configure x  -min 10 -max 20
        .polar1 axis configure y  -min 10 -max 20
        .polar1 axis configure x2 -min -2 -max 2
        .polar1 axis configure y2 -min -2 -max 2
        update
    } -body {
        #
        # Valid Polar grid axes.
        #
        .polar1 grid configure -mapx x2 -mapy y2
        update
        set ps1 [.polar1 postscript output]
        #
        # These axes do not contain zero, so Polar labels should
        # disappear.
        #
        .polar1 grid configure -mapx x -mapy y
        update
        set ps2 [.polar1 postscript output]
        #
        # Switch back again.
        #
        .polar1 grid configure -mapx x2 -mapy y2
        update
        set ps3 [.polar1 postscript output]

        list [expr {[string first {SWITCHANGLE-45} $ps1] >= 0}] [expr {[string first {SWITCHANGLE-45} $ps2] < 0}]\
                [expr {[string first {SWITCHANGLE-45} $ps3] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::PolarGridSwitchFormat {}
    } -result {1 1 1}

    test RBC.polar.postscript.output.A.smith.logaxis.1 {
        smith postscript: logarithmic mapped axes suppress Smith labels
    } -setup {
        proc ::SmithLogAxisFormat {widget domain value} {
            return "SMITHLOG-$domain-$value"
        }
        polar .polar1 -width 400 -height 400 -representation smith -smithrealmajorticks {0.5 1 2} -smithrealcommand\
                ::SmithLogAxisFormat
        pack .polar1
        .polar1 axis configure x -logscale yes -min 0.1 -max 10
        .polar1 axis configure y -logscale yes -min 0.1 -max 10
        update
    } -body {
        set ps [.polar1 postscript output]
        expr {[string first {SMITHLOG-} $ps] < 0}
    } -cleanup {
        destroy .polar1
        rename ::SmithLogAxisFormat {}
    } -result {1}

    test RBC.polar.postscript.output.A.geometry.1 {
        polar postscript: off-centre ranges still produce angular labels
    } -setup {
        proc ::PolarOffCenterFormat {widget degrees} {
            return "OFFCENTER-$degrees"
        }
        polar .polar1 -width 400 -height 400 -anglemajorticks {0 90 180 270} -anglecommand ::PolarOffCenterFormat
        pack .polar1
        #
        # Both axes contain zero, but zero is deliberately not
        # at the centre of either numerical range.
        #
        .polar1 axis configure x -min -5 -max 2
        .polar1 axis configure y -min -3 -max 4
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {OFFCENTER-0} $ps] >= 0}] [expr {[string first {OFFCENTER-90} $ps] >= 0}]\
                [expr {[string first {OFFCENTER-180} $ps] >= 0}] [expr {[string first {OFFCENTER-270} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::PolarOffCenterFormat {}
    } -result {1 1 1 1}

    test RBC.polar.postscript.output.A.geometry.2 {
        polar geometry: non-square widget keeps equal X/Y scale
    } -setup {
        polar .polar1 -width 600 -height 300
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        update
    } -body {
        lassign [.polar1 transform 0 0] ox oy
        lassign [.polar1 transform 1 0] xx xy
        lassign [.polar1 transform 0 1] yx yy
        set dx [expr {hypot($xx - $ox, $xy - $oy)}]
        set dy [expr {hypot($yx - $ox, $yy - $oy)}]
        expr {abs($dx - $dy) <= 1.0}
    } -cleanup {
        destroy .polar1
    } -result {1}

    test RBC.polar.postscript.output.A.smith.invertxy.1 {
        smith postscript: inverted axes retain both-domain labels
    } -setup {
        proc ::SmithInvertFormat {widget domain value} {
            return "INV-$domain-$value"
        }
        polar .polar1 -width 400 -height 400 -representation smith -smithgrid both -invertxy yes -smithrealmajorticks\
                {0.5} -smithrealcommand ::SmithInvertFormat
        pack .polar1
        .polar1 axis configure x -min -1.2 -max 1.2
        .polar1 axis configure y -min -1.2 -max 1.2
        update
    } -body {
        set ps [.polar1 postscript output]
        list [expr {[string first {INV-impedance-0.5} $ps] >= 0}] [expr {[string first {INV-admittance-0.5} $ps] >= 0}]
    } -cleanup {
        destroy .polar1
        rename ::SmithInvertFormat {}
    } -result {1 1}

    test RBC.polar.postscript.output.A.smooth.1 {
        smith postscript: natural and quadratic output smoothed traces
    } -setup {
        vector create z -type complex
        z set {{50 0} {50 100} {0 50}}
        polar .polar1 -width 500 -height 500 -representation smith
        pack .polar1
        .polar1 axis configure x -min -1.2 -max 1.2
        .polar1 axis configure y -min -1.2 -max 1.2
        .polar1 element create Element1 -cdata z -cdataformat impedance -z0 50 -smooth linear -symbol none -linewidth 2
        update
    } -body {
        set linearPs [.polar1 postscript output]
        set nLinear [regexp -all { lineto} $linearPs]
        .polar1 element configure Element1 -smooth natural
        update
        set naturalPs [.polar1 postscript output]
        set nNatural [regexp -all { lineto} $naturalPs]
        .polar1 element configure Element1 -smooth quadratic
        update
        set quadraticPs [.polar1 postscript output]
        set nQuadratic [regexp -all { lineto} $quadraticPs]
        list [expr {$nNatural > $nLinear}] [expr {$nQuadratic > $nLinear}]
    } -cleanup {
        destroy .polar1
        catch {vector destroy z}
    } -result {1 1}

    cleanupTests
}
