# RBC.graph.marker.arrowalignment.A.test --
#
###Abstract
# Checks line-marker shaft/arrowhead pixel alignment without relying on
# platform-specific golden images. Export must not acquire screen offsets.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Package Definition
package provide graph.marker.arrowalignment
package require rbc
package require tcltest
namespace import tcltest::*

namespace eval graph.marker.arrowalignment {
    proc Setup {renderer} {
        rbc::graph .arrowAlign -width 240 -height 240 -renderer $renderer -antialias gray \
            -plotbackground white -background white -plotborderwidth 0 -borderwidth 0 \
            -highlightthickness 0 -leftmargin 20 -rightmargin 20 -topmargin 20 -bottommargin 20
        .arrowAlign legend configure -hide yes
        .arrowAlign grid configure -hide yes
        foreach axis {x y x2 y2} {
            .arrowAlign axis configure $axis -hide yes -min 0 -max 1 -loose no
        }
        pack .arrowAlign
        update
    }

    proc Coordinates {pixels} {
        set coords {}
        foreach {x y} $pixels {
            lappend coords {*}[.arrowAlign invtransform $x $y]
        }
        return $coords
    }

    proc AddArrow {pixels arrow width} {
        .arrowAlign marker create line -name direction -coords [Coordinates $pixels] \
            -arrow $arrow -arrowshape {20 26 10} -outline red -linewidth $width
    }

    proc Snapshot {} {
        update idletasks
        set photo [image create photo]
        .arrowAlign snap $photo
        return $photo
    }

    proc Region {photo vertical} {
        set pixels {}
        for {set along 80} {$along <= 110} {incr along} {
            for {set across 76} {$across <= 85} {incr across} {
                if {$vertical} {
                    lappend pixels [$photo get $across $along]
                } else {
                    lappend pixels [$photo get $along $across]
                }
            }
        }
        return $pixels
    }

    # 1. Native shafts and arrow vertices use nearest-integer conversion.
    foreach vertical {0 1} {
        foreach arrow {first last both} {
            test RBC.graph.marker.arrowalignment.A.1.1-$vertical-$arrow \
                    {fractional native shaft agrees with nearest-pixel reference} -setup {
                Setup native
                if {$vertical} {
                    set pixels {80.75 40.75 80.75 180.75}
                    set reference {81.25 41.25 81.25 181.25}
                } else {
                    set pixels {40.75 80.75 180.75 80.75}
                    set reference {41.25 81.25 181.25 81.25}
                }
                AddArrow $pixels $arrow 1
                set photo [Snapshot]
            } -body {
                set actual [Region $photo $vertical]
                .arrowAlign marker configure direction -arrow none -coords [Coordinates $reference]
                set expected [Snapshot]
                expr {$actual eq [Region $expected $vertical]}
            } -cleanup {
                catch {image delete $photo}
                catch {image delete $expected}
                destroy .arrowAlign
            } -result 1
        }
    }

    Setup native
    set code [catch {.arrowAlign configure -renderer cairo} message]
    destroy .arrowAlign
    if {$code && $message ne {Cairo renderer is not available in this build}} {
        error $message
    }
    testConstraint arrowAlignmentCairo [expr {!$code}]

    # 2. Coverage-weighted centers expose the half-pixel fill/stroke offset.
    #    Sampling well inside the head avoids its tip and neck boundaries.
    foreach arrow {first last both} {
        test RBC.graph.marker.arrowalignment.A.2.1-$arrow \
                {Cairo arrowhead is centered on the fractional shaft} \
                -constraints arrowAlignmentCairo -setup {
            Setup cairo
            AddArrow {40 80.25 180 80.25} $arrow 1
            set photo [Snapshot]
        } -body {
            set weight 0.0
            set moment 0.0
            set start [expr {$arrow eq "first" ? 50 : 166}]
            for {set x $start} {$x < $start+4} {incr x} {
                for {set y 60} {$y <= 100} {incr y} {
                    lassign [$photo get $x $y] r g b
                    set coverage [expr {(255.0-$g)/255.0}]
                    set weight [expr {$weight+$coverage}]
                    set moment [expr {$moment+$coverage*$y}]
                }
            }
            expr {$weight > 0 && abs($moment/$weight-80.25) < 0.12}
        } -cleanup {
            catch {image delete $photo}
            destroy .arrowAlign
        } -result 1
    }

    # 3. A diagonal head is symmetric about x+y=240. Integer polygon
    #    boundaries must not shift the fill away from the shaft's centers.
    foreach width {1 3} {
        test RBC.graph.marker.arrowalignment.A.3.1-$width \
                {native diagonal arrowhead retains reflection symmetry} -setup {
            Setup native
            AddArrow {60 180 180 60} last $width
            set photo [Snapshot]
        } -body {
            set mismatches 0
            set filled 0
            for {set y 40} {$y <= 90} {incr y} {
                for {set x 150} {$x <= 200} {incr x} {
                    set pixel [$photo get $x $y]
                    incr filled [expr {$pixel eq {255 0 0}}]
                    if {$pixel ne [$photo get [expr {240-$y}] [expr {240-$x}]]} {
                        incr mismatches
                    }
                }
            }
            expr {$filled > 100 && $mismatches <= 2}
        } -cleanup {
            catch {image delete $photo}
            destroy .arrowAlign
        } -result 1
    }

    # 4. Drawing either backend must not mutate the geometry used by SVG.
    test RBC.graph.marker.arrowalignment.A.4.1 {screen drawing preserves SVG geometry} \
            -constraints arrowAlignmentCairo -setup {
        Setup native
        AddArrow {40.75 180.25 180.75 40.25} both 2
        set photo [Snapshot]
    } -body {
        set before [.arrowAlign svg output]
        .arrowAlign configure -renderer cairo
        update idletasks
        .arrowAlign snap $photo
        set after [.arrowAlign svg output]
        expr {$before eq $after}
    } -cleanup {
        catch {image delete $photo}
        destroy .arrowAlign
    } -result 1

    cleanupTests
}
