        destroy .polar1
        catch {vector destroy z}
        catch {vector destroy ref}
    } -result {natural 1 0 quadratic 1 0}

    test RBC.polar.element.closest.A.smooth.gap.1 {
        smith impedance: valid runs are smoothed across a singular gap
    } -setup {
        #
        # Gamma paths:
        #
        #   run 1:  0,0 -> 0.5,0.5 -> 0,1
        #
        #   Z=-50 is singular and creates the gap.
        #
        #   run 2: -1,0 -> -0.5,-0.5 -> 0,-1
        #
        vector create z -type complex
        z set {{50 0} {50 100} {0 50} {-50 0} {0 0} {10 -20} {0 -50}}
        vector create gamma -type complex
        gamma set {{0 0} {0.5 0.5} {0 1}}
        spline parametric natural gamma ref 5
        polar .polar1 -width 500 -height 500 -representation smith
        pack .polar1
        .polar1 axis configure x -min -1.2 -max 1.2
        .polar1 axis configure y -min -1.2 -max 1.2
        .polar1 element create Element1 -cdata z -cdataformat impedance -z0 50 -smooth natural -symbol none -linewidth 2
        update
    } -body {
        #
        # First run must actually be smoothed.
        #
        lassign [lindex [ref range 0 end] 1] real imag
        lassign [.polar1 transform $real $imag] px py
        set smoothed [.polar1 element closest $px $py info -along both -interpolate 1 -halo 4 Element1]
        if {$smoothed} {
            set smoothIndex $info(index)
        } else {
            set smoothIndex -1
        }
        unset -nocomplain info
        #
        # But there must still be no segment across the singular gap.
        # This is the midpoint between the end of run 1, Gamma=(0,1),
        # and the beginning of run 2, Gamma=(-1,0).
        #
        lassign [.polar1 transform -0.5 0.5] px py
        set acrossGap [.polar1 element closest $px $py info -along both -interpolate 1 -halo 2 Element1]
        list $smoothed $smoothIndex $acrossGap
    } -cleanup {
        unset -nocomplain info
        destroy .polar1
        catch {vector destroy z}
        catch {vector destroy gamma}
        catch {vector destroy ref}
    } -result {1 0 0}

	cleanupTests
}
