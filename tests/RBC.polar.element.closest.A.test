                2
        update
    } -body {
        set result {}
        foreach {sample expectedIndex} {1 0 3 1} {
            lassign [lindex [ref range 0 end] $sample] real imag
            lassign [.polar1 transform $real $imag] px py
            set found [.polar1 element closest $px $py info -along both -interpolate 1 -halo 4 Element1]
            if {$found} {
