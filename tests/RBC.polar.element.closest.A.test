    test RBC.polar.element.closest.A.smooth.invertxy.1 {
        polar parametric smoothing works with inverted axes
    } -setup {
        vector create z -type complex
        z set {{0 0} {2 2} {0 4}}
        polar .polar1 -width 500 -height 500 -invertxy yes
        pack .polar1
        .polar1 axis configure x -min -1 -max 5
        .polar1 axis configure y -min -1 -max 5
        .polar1 element create Element1 -cdata z -smooth natural -symbol none -linewidth 2
        update
    } -body {
        set result {}
        foreach smooth {natural quadratic} {
            spline parametric $smooth z ref 5
            .polar1 element configure Element1 -smooth $smooth
            update
            lassign [lindex [ref range 0 end] 1] real imag
            lassign [.polar1 transform $real $imag] px py
            set found [.polar1 element closest $px $py info -along both -interpolate 1 -halo 4 Element1]
            if {$found} {
                lappend result $smooth $found $info(index)
            } else {
                lappend result $smooth $found -1
            }
            unset -nocomplain info
        }
        set result
    } -cleanup {
