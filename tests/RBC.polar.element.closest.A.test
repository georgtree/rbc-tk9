    test RBC.polar.element.closest.A.smooth.3 {
        polar element closest: XY natural smoothing is also parametric
    } -setup {
        # The reference is generated from the identical 2-D path using
        # the public complex parametric spline command.
        vector create z -type complex
        z set {{0 0} {2 2} {0 4}}
        spline parametric natural z ref 5
        polar .polar1 -width 500 -height 500
        pack .polar1
        .polar1 axis configure x -min -1 -max 5
        .polar1 axis configure y -min -1 -max 5
        # Deliberately use ordinary XY data rather than -cdata.  Polar
        # elements must still use parametric natural smoothing.
        .polar1 element create Element1 -data {0 0 2 2 0 4} -smooth natural -symbol none -linewidth 2
        update
    } -body {
        lassign [lindex [ref range 0 end] 1] real imag
        lassign [.polar1 transform $real $imag] x y
        set found [.polar1 element closest $x $y info -along both -interpolate 1 -halo 4 Element1]
        if {$found} {
            list $found $info(index)
        } else {
            list $found -1
        }
    } -cleanup {
        unset -nocomplain info
        destroy .polar1
        catch {vector destroy z}
        catch {vector destroy ref}
    } -result {1 0}

    test RBC.polar.element.closest.A.smooth.loop.1 {
        polar smoothing: closed loop preserves interval indices
    } -setup {
        vector create z -type complex
        z set {{0 0} {1 1} {0 2} {-1 1} {0 0}}
        polar .polar1 -width 500 -height 500
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        .polar1 element create Element1 -cdata z -smooth natural -symbol none -linewidth 2
        update
    } -body {
        set result {}
        foreach smooth {natural quadratic} {
            spline parametric $smooth z ref 17
            .polar1 element configure Element1 -smooth $smooth
            update
            #
            # With four equal-length intervals and 17 samples,
            # sample 2 lies halfway through source interval 0 and
            # sample 14 halfway through source interval 3.
            #
            foreach {sample expectedIndex} {2 0 14 3} {
                lassign [lindex [ref range 0 end] $sample] real imag
                lassign [.polar1 transform $real $imag] px py
                set found [.polar1 element closest $px $py info -along both -interpolate 1 -halo 4 Element1]
                if {$found} {
                    lappend result $smooth $found $info(index)
                } else {
                    lappend result $smooth $found -1
                }
                unset -nocomplain info
            }
        }
        set result
    } -cleanup {
        unset -nocomplain info
        destroy .polar1
        catch {vector destroy z}
        catch {vector destroy ref}
    } -result {natural 1 0 natural 1 3 quadratic 1 0 quadratic 1 3}

    test RBC.polar.element.closest.A.smooth.impedance.1 {
