# RBC.graph.axis.view.A.test --
#
###Abstract
# This file tests the axis view function of the graph BLT component.
# Axis view is an instance function of graph.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.axis

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.axis {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the axis view command works correctly
	# ------------------------------------------------------------------------------------
	test RBC.graph.axis.view.A.1.1 {
		User Axis
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
	} -body {
		.graph1 axis configure Axis1 -scrollmax 10
		.graph1 axis view Axis1
	} -cleanup {
		destroy .graph1
	} -result {0.0 0.0}

    # ------------------------------------------------------------------------------------
    # Purpose: Ensure scrollbar fractions work when max-min overflows double.
    # ------------------------------------------------------------------------------------
    test RBC.graph.axis.view.A.1.2 {
        Extreme finite scroll range
    } -setup {
        graph .graph1
        pack .graph1
        .graph1 element create Element1 -xdata {-1.0e308 1.0e308} -ydata {0 1} -symbol none
        .graph1 axis configure x -min -1.0e307 -max 1.0e307 -scrollmin -1.0e308 -scrollmax 1.0e308
        update idletasks
    } -body {
        lassign [.graph1 axis view x] first last
        list [expr {abs($first - 0.45) < 1.0e-12}] [expr {abs($last - 0.55) < 1.0e-12}]
    } -cleanup {
        destroy .graph1
    } -result {1 1}

    test RBC.graph.axis.view.A.1.3 {
        Extreme finite scroll range moveto
    } -setup {
        graph .graph1
        pack .graph1
        .graph1 element create Element1 -xdata {-1.0e308 1.0e308} -ydata {0 1} -symbol none
        .graph1 axis configure x -min -1.0e307 -max 1.0e307 -scrollmin -1.0e308 -scrollmax 1.0e308
        update idletasks
    } -body {
        .graph1 axis view x moveto 0.25
        update idletasks
        lassign [.graph1 axis view x] first last
        list [expr {abs($first - 0.25) < 1.0e-12}] [expr {abs($last - 0.35) < 1.0e-12}]
    } -cleanup {
        destroy .graph1
    } -result {1 1}

    test RBC.graph.axis.view.A.1.4 {
        Invalid effective one-sided scroll region
    } -setup {
        graph .graph1
        pack .graph1
        .graph1 element create Element1 -xdata {0 10} -ydata {0 1} -symbol none
        .graph1 axis configure x -scrollmin 20
        update idletasks
    } -body {
        set code [catch {.graph1 axis view x} message]
        list $code [string match {*invalid scroll region*} $message]
    } -cleanup {
        destroy .graph1
    } -result {1 1}

    test RBC.graph.axis.view.A.1.5 {
        Scroll region clips initial viewport before preserving its width
    } -setup {
        graph .graph1
        pack .graph1
        .graph1 element create Element1 -xdata {0 5} -ydata {0 1} -symbol none
        proc ::RbcScrollTest {first last} {
            set ::rbcScrollFractions [list $first $last]
        }
        .graph1 axis configure x -min 0 -max 5 -scrollmin 2 -scrollmax 10 -scrollcommand ::RbcScrollTest
        update idletasks
    } -body {
        lassign [.graph1 axis view x] first last
        list [expr {abs($first - 0.0) < 1.0e-12}] [expr {abs($last - 0.375) < 1.0e-12}] [.graph1 axis limits x]
    } -cleanup {
        catch {destroy .graph1}
        catch {rename ::RbcScrollTest {}}
        unset -nocomplain ::rbcScrollFractions
    } -result {1 1 {2.0 5.0}}

    test RBC.graph.axis.view.A.log.1 {
        logarithmic axis view with explicit scroll region
    } -setup {
        graph .graph1
        pack .graph1
        .graph1 axis configure x -logscale yes -min 10 -max 1000 -scrollmin 1 -scrollmax 10000
    } -body {
        update idletasks
        .graph1 axis view x
    }  -result {0.25 0.75} -cleanup {
        catch {destroy .graph1}
    }
	
    # Fractional scroll counts from wheel/touchpad bindings must not be
    # truncated. Compare against an integer step without relying on DPI.
    foreach widget {graph barchart stripchart} {
        foreach axis {x y} {
            foreach descending {no yes} {
                foreach logarithmic {no yes} {
                    test RBC.graph.axis.view.A.fraction.$widget.$axis.$descending.$logarithmic {
                        fractional units, pages and shorthand preserve direction and viewport width
                    } -setup {
                        $widget .graph1 -width 500 -height 400 -leftmargin 80 -rightmargin 80 -topmargin 60 -bottommargin 60
                        pack .graph1
                        if {$logarithmic eq {yes}} {
                            set limits {-min 100 -max 1000 -scrollmin 1 -scrollmax 1000000}
                        } else {
                            set limits {-min 40 -max 60 -scrollmin 0 -scrollmax 100}
                        }
                        .graph1 axis configure $axis -logscale $logarithmic -descending $descending {*}$limits
                        update idletasks
                    } -body {
                        set checks {}
                        foreach form {units pages shorthand} {
                            .graph1 axis configure $axis {*}$limits
                            update idletasks
                            lassign [.graph1 axis view $axis] first last
                            if {$form eq {shorthand}} {
                                .graph1 axis view $axis 1
                            } else {
                                .graph1 axis view $axis scroll 1 $form
                            }
                            update idletasks
                            set step [expr {[lindex [.graph1 axis view $axis] 0] - $first}]
                            foreach count {0.5 -0.5 0.0 1.0} {
                                .graph1 axis configure $axis {*}$limits
                                update idletasks
                                if {$form eq {shorthand}} {
                                    .graph1 axis view $axis $count
                                } else {
                                    .graph1 axis view $axis scroll $count $form
                                }
                                update idletasks
                                lassign [.graph1 axis view $axis] newFirst newLast
                                lappend checks [expr {$step > 0 && abs($newFirst - $first - $count*$step) < 1e-10 &&
                                                      abs(($newLast-$newFirst)-($last-$first)) < 1e-10}]
                            }
                        }
                        expr {0 ni $checks}
                    } -cleanup {
                        destroy .graph1
                    } -result 1
                }
            }
        }
    }

    foreach form {units pages shorthand} {
        foreach count {Inf -Inf NaN invalid {}} {
            test RBC.graph.axis.view.A.invalid.$form.$count {
                invalid scroll counts are rejected without changing the viewport
            } -setup {
                graph .graph1
                pack .graph1
                .graph1 axis configure x -min 40 -max 60 -scrollmin 0 -scrollmax 100
                update idletasks
            } -body {
                set before [.graph1 axis view x]
                if {$form eq {shorthand}} {
                    set code [catch {.graph1 axis view x $count}]
                } else {
                    set code [catch {.graph1 axis view x scroll $count $form}]
                }
                update idletasks
                list $code [expr {$before eq [.graph1 axis view x]}]
            } -cleanup {
                destroy .graph1
            } -result {1 1}
        }
    }

    test RBC.graph.axis.view.A.wheel {
        a MouseWheel binding can pass a fractional count to axis view
    } -setup {
        graph .graph1 -width 500 -height 400
        pack .graph1
        .graph1 axis configure x -min 40 -max 60 -scrollmin 0 -scrollmax 100
        set ::rbcWheelResult {}
        bind .graph1 <MouseWheel> {
            set ::rbcWheelResult [catch {%W axis view x scroll [expr {%D / 120.0}] units}]
        }
        update
    } -body {
        set before [lindex [.graph1 axis view x] 0]
        event generate .graph1 <MouseWheel> -delta 60
        update
        list $::rbcWheelResult [expr {[lindex [.graph1 axis view x] 0] > $before}]
    } -cleanup {
        destroy .graph1
        unset -nocomplain ::rbcWheelResult
    } -result {0 1}

	cleanupTests
	
}
