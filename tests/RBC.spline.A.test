###Package Definition
package provide spline

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*


# ------------------------------------------------------------------------------------
# Purpose: Ensure natural spline rejects duplicate source X coordinates.
# ------------------------------------------------------------------------------------
test RBC.spline.A.1.1 {
    spline natural: duplicate source X coordinates
} -setup {
    vector create VectorX
    VectorX set {0 1 1 2}

    vector create VectorY
    VectorY set {0 1 2 3}

    vector create VectorEval
    VectorEval set {0 0.5 1 1.5 2}
} -body {
    set code [catch {
        spline natural VectorX VectorY VectorEval VectorResult
    } message]

    list $code $message
} -cleanup {
    foreach vectorName {
        VectorX VectorY VectorEval VectorResult
    } {
        catch {vector destroy $vectorName}
    }
} -result {1 {x vector "VectorX" must be strictly increasing}}


# ------------------------------------------------------------------------------------
# Purpose: Ensure quadratic spline rejects duplicate source X coordinates.
# ------------------------------------------------------------------------------------
test RBC.spline.A.1.2 {
    spline quadratic: duplicate source X coordinates
} -setup {
    vector create VectorX
    VectorX set {0 1 1 2}

    vector create VectorY
    VectorY set {0 1 2 3}

    vector create VectorEval
    VectorEval set {0 0.5 1 1.5 2}
} -body {
    set code [catch {
        spline quadratic VectorX VectorY VectorEval VectorResult
    } message]

    list $code $message
} -cleanup {
    foreach vectorName {
        VectorX VectorY VectorEval VectorResult
    } {
        catch {vector destroy $vectorName}
    }
} -result {1 {x vector "VectorX" must be strictly increasing}}


# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects a non-finite source X value.
# ------------------------------------------------------------------------------------
test RBC.spline.A.2.1 {
    spline natural: non-finite source X value
} -setup {
    vector create VectorX
    VectorX set {0 1 Inf}

    vector create VectorY
    VectorY set {0 1 2}

    vector create VectorEval
    VectorEval set {0 0.5 1}
} -body {
    set code [catch {
        spline natural VectorX VectorY VectorEval VectorResult
    } message]

    list $code $message
} -cleanup {
    foreach vectorName {
        VectorX VectorY VectorEval VectorResult
    } {
        catch {vector destroy $vectorName}
    }
} -result {1 {vectors "VectorX" and "VectorY" must contain only finite values}}


# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects a non-finite source Y value.
# ------------------------------------------------------------------------------------
test RBC.spline.A.2.2 {
    spline natural: non-finite source Y value
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 Inf 2}

    vector create VectorEval
    VectorEval set {0 0.5 1}
} -body {
    set code [catch {
        spline natural VectorX VectorY VectorEval VectorResult
    } message]

    list $code $message
} -cleanup {
    foreach vectorName {
        VectorX VectorY VectorEval VectorResult
    } {
        catch {vector destroy $vectorName}
    }
} -result {1 {vectors "VectorX" and "VectorY" must contain only finite values}}


# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects a non-finite interpolation X value.
# ------------------------------------------------------------------------------------
# ------------------------------------------------------------------------------------
# Purpose: Ensure a non-finite interpolation X value is rejected without modifying
# an existing result vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.2.3 {
    spline natural: non-finite interpolation X value is atomic
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 2}

    vector create VectorEval
    VectorEval set {0 Inf 2}

    vector create VectorResult
    VectorResult set {10 20 30 40}
} -body {
    set code [catch {spline natural VectorX VectorY VectorEval VectorResult} message]
    list $code $message [VectorResult length] [VectorResult range 0 end]
} -cleanup {
    foreach vectorName {VectorX VectorY VectorEval VectorResult} {
        catch { vector destroy $vectorName }
    }
} -result {1 {interpolation vector "VectorEval" must contain only finite values} 4 {10.0 20.0 30.0 40.0}}

# ------------------------------------------------------------------------------------
# Purpose: Ensure invalid interpolation input does not create a missing result vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.2.4 {
    spline natural: invalid interpolation input does not create result
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 2}

    vector create VectorEval
    VectorEval set {0 Inf 2}

    catch { vector destroy VectorResult }
} -body {
    set code [catch {spline natural VectorX VectorY VectorEval VectorResult} message]
    list $code $message [expr {[llength [info commands VectorResult]] != 0}]
} -cleanup {
    foreach vectorName {VectorX VectorY VectorEval VectorResult} {
        catch { vector destroy $vectorName }
    }
} -result {1 {interpolation vector "VectorEval" must contain only finite values} 0}


# ------------------------------------------------------------------------------------
# Purpose: Ensure natural spline accepts an empty interpolation vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.3.1 {
    spline natural: empty interpolation vector
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 2}

    vector create VectorEval
} -body {
    spline natural VectorX VectorY VectorEval VectorResult

    list \
        [VectorEval length] \
        [VectorResult length]
} -cleanup {
    foreach vectorName {
        VectorX VectorY VectorEval VectorResult
    } {
        catch {vector destroy $vectorName}
    }
} -result {0 0}


# ------------------------------------------------------------------------------------
# Purpose: Ensure quadratic spline accepts an empty interpolation vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.3.2 {
    spline quadratic: empty interpolation vector
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 2}

    vector create VectorEval
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult

    list \
        [VectorEval length] \
        [VectorResult length]
} -cleanup {
    foreach vectorName {
        VectorX VectorY VectorEval VectorResult
    } {
        catch {vector destroy $vectorName}
    }
} -result {0 0}

# ------------------------------------------------------------------------------------
# Purpose: Ensure quadratic spline evaluates every point to the left of the source
# interval.  The final left-hand extrapolation point must not be skipped.
# ------------------------------------------------------------------------------------
test RBC.spline.A.4.1 {
    spline quadratic: left extrapolation point is not skipped
} -setup {
    vector create VectorX
    VectorX set {0 1 2}
    vector create VectorY
    VectorY set {0 1 2}
    vector create VectorEval
    VectorEval set {-1 0.5}
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult
    VectorResult range 0 end
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {-1.0 0.5}

# ------------------------------------------------------------------------------------
# Purpose: Ensure quadratic spline handles an evaluation vector entirely to the left
# of the source interval without reading beyond the interpolation array.
# ------------------------------------------------------------------------------------
test RBC.spline.A.4.2 {
    spline quadratic: all evaluation points left of source interval
} -setup {
    vector create VectorX
    VectorX set {0 1 2}
    vector create VectorY
    VectorY set {0 1 2}
    vector create VectorEval
    VectorEval set {-2 -1}
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult
    VectorResult range 0 end
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {-2.0 -1.0}

# ------------------------------------------------------------------------------------
# Purpose: Ensure quadratic spline handles an evaluation vector entirely to the right
# of the source interval without using end == -1 as an array index.
# ------------------------------------------------------------------------------------
test RBC.spline.A.4.3 {
    spline quadratic: all evaluation points right of source interval
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 2}

    vector create VectorEval
    VectorEval set {3 4}
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult

    VectorResult range 0 end
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {3.0 4.0}

# ------------------------------------------------------------------------------------
# Purpose: Ensure the first non-knot evaluation point is evaluated in the source
# interval immediately surrounding it.
# ------------------------------------------------------------------------------------
test RBC.spline.A.4.4 {
    spline quadratic: first non-knot uses correct source interval
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 4}

    vector create VectorEval
    VectorEval set {0.5}
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult
    VectorResult range 0 end
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {0.375}

# ------------------------------------------------------------------------------------
# Purpose: Ensure an evaluation beginning exactly at the final source knot returns
# that knot's ordinate rather than the preceding source ordinate.
# ------------------------------------------------------------------------------------
test RBC.spline.A.4.5 {
    spline quadratic: exact final source knot
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 4}

    vector create VectorEval
    VectorEval set {2}
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult
    VectorResult range 0 end
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {4.0}

# ------------------------------------------------------------------------------------
# Purpose: Ensure right-hand extrapolation following an exact source knot does not
# advance the source interval beyond the source array.
# ------------------------------------------------------------------------------------
test RBC.spline.A.4.6 {
    spline quadratic: exact knot followed by right extrapolation
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {0 1 4}

    vector create VectorEval
    VectorEval set {0 3}
} -body {
    spline quadratic VectorX VectorY VectorEval VectorResult
    VectorResult range 0 end
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {0.0 10.0}

# ------------------------------------------------------------------------------------
# Purpose: Ensure arithmetic overflow during natural spline generation fails
# transactionally and leaves an existing result vector unchanged.
# ------------------------------------------------------------------------------------
test RBC.spline.A.5.1 {
    spline natural: generated non-finite result is rejected
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {1e308 -1e308 1e308}

    vector create VectorEval
    VectorEval set {0.5}

    vector create VectorResult
    VectorResult set {10 20}
} -body {
    set code [catch {
        spline natural VectorX VectorY VectorEval VectorResult
    } message]

    list $code $message [VectorResult range 0 end]
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {1 {error generating spline for "VectorResult"} {10.0 20.0}}

# ------------------------------------------------------------------------------------
# Purpose: Ensure arithmetic overflow during quadratic spline generation fails
# transactionally and leaves an existing result vector unchanged.
# ------------------------------------------------------------------------------------
test RBC.spline.A.5.2 {
    spline quadratic: generated non-finite result is rejected
} -setup {
    vector create VectorX
    VectorX set {0 1 2}

    vector create VectorY
    VectorY set {1e308 -1e308 1e308}

    vector create VectorEval
    VectorEval set {0.5}

    vector create VectorResult
    VectorResult set {10 20}
} -body {
    set code [catch {
        spline quadratic VectorX VectorY VectorEval VectorResult
    } message]

    list $code $message [VectorResult range 0 end]
} -cleanup {
    foreach vectorName {
        VectorX
        VectorY
        VectorEval
        VectorResult
    } {
        catch { vector destroy $vectorName }
    }
} -result {1 {error generating spline for "VectorResult"} {10.0 20.0}}

test RBC.spline.extrapolate.A.1.1 {
    natural spline extrapolates and accepts unordered interpolation X
} -body {
    vector create x y splX splY
    x set {0.0 1.0 2.0}
    y set {0.0 1.0 2.0}
    splX set {-1.0 0.0 0.5 3.0 2.0 1.5 -2.0}
    spline natural x y splX splY
    set expected {-1.0 0.0 0.5 3.0 2.0 1.5 -2.0}
    set ok 1
    foreach actual [splY range 0 end] wanted $expected {
        if {abs($actual - $wanted) > 1.0e-12} {
            set ok 0
            break
        }
    }
    set ok
} -cleanup {
    catch {vector destroy x}
    catch {vector destroy y}
    catch {vector destroy splX}
    catch {vector destroy splY}
} -result 1

test RBC.spline.extrapolate.A.1.1 {
    quadratic spline extrapolates and accepts unordered interpolation X
} -body {
    vector create x y splX splY
    x set {0.0 1.0 2.0}
    y set {0.0 1.0 2.0}
    splX set {-1.0 0.0 0.5 3.0 2.0 1.5 -2.0}
    spline quadratic x y splX splY
    set expected {-1.0 0.0 0.5 3.0 2.0 1.5 -2.0}
    set ok 1
    foreach actual [splY range 0 end] wanted $expected {
        if {abs($actual - $wanted) > 1.0e-12} {
            set ok 0
            break
        }
    }
    set ok
} -cleanup {
    catch {vector destroy x}
    catch {vector destroy y}
    catch {vector destroy splX}
    catch {vector destroy splY}
} -result 1

# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects a complex source X vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.6.1 {
    spline: complex source x vector
} -setup {
    vector create X -type complex
    X set {{0 0} {1 0} {2 0}}
    vector create Y
    Y set {0 1 4}
    vector create SplX
    SplX set {0 0.5 1 1.5 2}
} -body {
    catch {spline natural X Y SplX SplY} message
    set message
} -cleanup {
    catch {vector destroy X}
    catch {vector destroy Y}
    catch {vector destroy SplX}
    catch {vector destroy SplY}
} -result {spline vector "X" must be real}

# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects a complex source Y vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.6.2 {
    spline: complex source y vector
} -setup {
    vector create X
    X set {0 1 2}
    vector create Y -type complex
    Y set {{0 0} {1 0} {4 0}}
    vector create SplX
    SplX set {0 0.5 1 1.5 2}
} -body {
    catch {spline natural X Y SplX SplY} message
    set message
} -cleanup {
    catch {vector destroy X}
    catch {vector destroy Y}
    catch {vector destroy SplX}
    catch {vector destroy SplY}
} -result {spline vector "Y" must be real}

# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects a complex interpolation X vector.
# ------------------------------------------------------------------------------------
test RBC.spline.A.6.3 {
    spline: complex interpolation x vector
} -setup {
    vector create X
    X set {0 1 2}
    vector create Y
    Y set {0 1 4}
    vector create SplX -type complex
    SplX set {{0 0} {0.5 0} {1 0} {1.5 0} {2 0}}
} -body {
    catch {spline natural X Y SplX SplY} message
    set message
} -cleanup {
    catch {vector destroy X}
    catch {vector destroy Y}
    catch {vector destroy SplX}
    catch {vector destroy SplY}
} -result {spline vector "SplX" must be real}

# ------------------------------------------------------------------------------------
# Purpose: Ensure spline rejects an existing complex result vector and leaves it
# unchanged.
# ------------------------------------------------------------------------------------
test RBC.spline.A.6.4 {
    spline: complex result vector
} -setup {
    vector create X
    X set {0 1 2}
    vector create Y
    Y set {0 1 4}
    vector create SplX
    SplX set {0 0.5 1 1.5 2}
    vector create SplY -type complex
    SplY set {{9 10} {11 12}}
} -body {
    set code [catch {
        spline natural X Y SplX SplY
    } message]
    list $code $message [SplY type] [SplY range 0 end]
} -cleanup {
    catch {vector destroy X}
    catch {vector destroy Y}
    catch {vector destroy SplX}
    catch {vector destroy SplY}
} -result {1 {spline vector "SplY" must be real} complex {{9.0 10.0} {11.0 12.0}}}


cleanupTests
