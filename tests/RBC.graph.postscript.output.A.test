# RBC.graph.postscript.output.A.test --
#
###Abstract
# This file contains the automatic tests that test the postscript output
# function of the graph BLT component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.postscript

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.postscript {

    proc MarkerPostScriptBlock {widget markerName nextMarkerName} {
        set ps [$widget postscript output]
        set startTag "% Marker \"$markerName\" is a "
        set endTag "% Marker \"$nextMarkerName\" is a "
        set first [string first $startTag $ps]
        if {$first < 0} {
            return -code error "PostScript block for marker \"$markerName\" was not found"
        }
        set last [string first $endTag $ps [expr {$first + [string length $startTag]}]]
        if {$last < 0} {
            set last [string length $ps]
        }
        return [string range $ps $first [expr {$last - 1}]]
    }
    proc PostScriptPathPoints {block} {
        set points {}
        foreach line [split $block \n] {
            set line [string trim $line]
            if {[regexp {^(?:newpath[ \t]+)?([-+0-9.eE]+)[ \t]+([-+0-9.eE]+)[ \t]+(?:moveto|lineto)$} \
                    $line -> x y]} {
                lappend points [list $x $y]
            }
        }
        return $points
    }
    proc PathHasPoint {points x y {tolerance 0.01}} {
        foreach point $points {
            lassign $point px py
            if {(abs($px - $x) <= $tolerance) &&
                (abs($py - $y) <= $tolerance)} {
                return 1
            }
        }
        return 0
    }

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that output will print postscript to the console
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.postscript.output.A.1.1 {
	    Test postscript output to console
	} -setup {
	    graph .graph1
	    pack .graph1
	} -body {
	    set TestPs [.graph1 postscript output]
	    if {$TestPs != ""} {
	        return 1
	    }
	    return 0
	} -cleanup {
	    destroy .graph1
	    unset TestPs
	} -result {1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that output will print postscript to a file
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.postscript.output.A.1.2 {
	    Test postscript output to file
	} -setup {
	    graph .graph1
	    pack .graph1
	    set FileName RBC.graph.legend.3.1.ps
	} -body {
	    .graph1 postscript output $FileName
	    file exists $FileName
	} -cleanup {
	    destroy .graph1
	    file delete -force $FileName
	    unset FileName
	} -result {1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that output will print postscript to the console with option-value
	# pairs
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.postscript.output.A.1.3 {
	    Test postscript output to console with options
	} -setup {
	    graph .graph1
	    pack .graph1
	} -body {
	    set TestPs [.graph1 postscript output -center 0]
	    if {$TestPs != ""} {
	        return 1
	    }
	    return 0
	} -cleanup {
	    destroy .graph1
	    unset TestPs
	} -result {1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that output will print postscript to a file with option-value pairs
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.postscript.output.A.1.4 {
	    Test postscript output to file with options
	} -setup {
	    graph .graph1
	    pack .graph1
	    set FileName RBC.graph.legend.3.4.ps
	} -body {
	    .graph1 postscript output $FileName -center 0
	    file exists $FileName
	} -cleanup {
	    destroy .graph1
	    file delete -force $FileName
	    unset FileName
	} -result {1}

    # ------------------------------------------------------------------------------------
    # Purpose: Ensure user-controlled filenames are escaped inside PostScript strings.
    # ------------------------------------------------------------------------------------
    test RBC.graph.postscript.output.A.1.5 {
        PostScript filename is escaped
    } -setup {
        graph .graph1
        pack .graph1
        set FileName [file join $::tcltest::temporaryDirectory {RBC.graph-(title)-test.ps}]
    } -body {
        .graph1 postscript output $FileName -footer yes
        set channel [open $FileName r]
        set ps [read $channel]
        close $channel
        list [regexp {(?m)^%%Title: \(.*\\050title\\051.*\)$} $ps]\
                [regexp {(?m)^\(File: .*\\050title\\051.*\) show$} $ps]
    } -cleanup {
        catch {close $channel}
        file delete -force $FileName
        destroy .graph1
    } -result {1 1}

    test RBC.graph.postscript.output.arrow.A.1.1 {
        graph postscript output: line marker arrowheads
    } -setup {
        graph .graph1 -width 400 -height 300
        pack .graph1
        .graph1 axis configure x -min 0 -max 10
        .graph1 axis configure y -min 0 -max 10
        .graph1 legend configure -hide yes
        .graph1 marker create line -name Marker1 -coords {2 5 8 5} -outline black -linewidth 2 -arrowshape {8 10 3}
        update idletasks
    } -body {
        .graph1 marker configure Marker1 -arrow none
        set ps [.graph1 postscript output]
        set none [regexp -all -line -- {^[ \t]*Fill[ \t]*$} $ps]
        .graph1 marker configure Marker1 -arrow first
        set ps [.graph1 postscript output]
        set first [regexp -all -line -- {^[ \t]*Fill[ \t]*$} $ps]
        .graph1 marker configure Marker1 -arrow last
        set ps [.graph1 postscript output]
        set last [regexp -all -line -- {^[ \t]*Fill[ \t]*$} $ps]
        .graph1 marker configure Marker1 -arrow both
        set ps [.graph1 postscript output]
        set both [regexp -all -line -- {^[ \t]*Fill[ \t]*$} $ps]
        list [expr {$first - $none}] [expr {$last - $none}] [expr {$both - $none}]
    } -cleanup {
        destroy .graph1
    } -result {1 1 2}

    # ------------------------------------------------------------------------------------
    # Purpose:
    # Ensure an exactly horizontal polygon edge lying only a tiny distance inside the
    # plot boundary is not incorrectly clipped.  This regresses the use of FLT_EPSILON
    # as an artificial slope for double-precision polygon geometry.
    # ------------------------------------------------------------------------------------
    test RBC.graph.postscript.output.polygon.A.1.1 {
        graph postscript output: polygon horizontal edge near clipping boundary
    } -setup {
        graph .graph1 -width 320 -height 240
        pack .graph1
        .graph1 axis configure x -min 0 -max 1
        .graph1 axis configure y -min 0 -max 1
        .graph1 legend configure -hide yes
        update idletasks
        lassign [.graph1 extents plotarea] left top width height
        #
        # Construct the rectangle in screen space.  Its top edge is
        # only 1e-8 pixel inside the clipping rectangle: comfortably
        # below FLT_EPSILON but far above DBL_EPSILON.
        #
        set leftPixel   [expr {$left + 30.0}]
        set rightPixel  [expr {$left + 130.0}]
        set topPixel    [expr {$top + 1.0e-8}]
        set bottomPixel [expr {$top + 80.0}]
        #
        # graph invtransform accepts double screen coordinates.  Convert
        # the desired screen rectangle to graph coordinates so that the
        # normal marker mapping path reconstructs it.
        #
        lassign [.graph1 invtransform $leftPixel  $topPixel]    x1 y1
        lassign [.graph1 invtransform $rightPixel $bottomPixel] x2 y2
        .graph1 marker create polygon -name Marker1 -coords [list $x1 $y1 $x2 $y1 $x2 $y2 $x1 $y2] -fill red\
                -outline {}
        #
        # Delimit Marker1's PostScript block.
        #
        .graph1 marker create text -name EndMarker -coords {0.95 0.95} -text end
        update idletasks
    } -body {
        set block [MarkerPostScriptBlock .graph1 Marker1 EndMarker]
        set points [PostScriptPathPoints $block]
        list [PathHasPoint $points $leftPixel $topPixel] [PathHasPoint $points $rightPixel $topPixel]\
                [PathHasPoint $points $rightPixel $bottomPixel] [PathHasPoint $points $leftPixel $bottomPixel]
    } -cleanup {
        destroy .graph1
        unset -nocomplain block points left top width height leftPixel rightPixel topPixel bottomPixel x1 y1 x2 y2
    } -result {1 1 1 1}

    # ------------------------------------------------------------------------------------
    # Purpose:
    # Ensure an exactly vertical polygon edge lying only a tiny distance inside the
    # plot boundary is not incorrectly clipped.  This covers the corresponding dx == 0
    # branch of Rbc_PolyRectClip().
    # ------------------------------------------------------------------------------------
    test RBC.graph.postscript.output.polygon.A.1.2 {
        graph postscript output: polygon vertical edge near clipping boundary
    } -setup {
        graph .graph1 -width 320 -height 240
        pack .graph1
        .graph1 axis configure x -min 0 -max 1
        .graph1 axis configure y -min 0 -max 1
        .graph1 legend configure -hide yes
        update idletasks
        lassign [.graph1 extents plotarea] left top width height
        #
        # This time the left edge is only 1e-8 pixel inside the
        # clipping rectangle.
        #
        set leftPixel   [expr {$left + 1.0e-8}]
        set rightPixel  [expr {$left + 100.0}]
        set topPixel    [expr {$top + 30.0}]
        set bottomPixel [expr {$top + 110.0}]
        lassign [.graph1 invtransform $leftPixel  $topPixel]    x1 y1
        lassign [.graph1 invtransform $rightPixel $bottomPixel] x2 y2
        .graph1 marker create polygon -name Marker1 -coords [list $x1 $y1 $x2 $y1 $x2 $y2 $x1 $y2] -fill red\
                -outline {}
        .graph1 marker create text -name EndMarker -coords {0.95 0.95} -text end
        update idletasks
    } -body {
        set block [MarkerPostScriptBlock .graph1 Marker1 EndMarker]
        set points [PostScriptPathPoints $block]
        list [PathHasPoint $points $leftPixel $topPixel] [PathHasPoint $points $rightPixel $topPixel]\
                [PathHasPoint $points $rightPixel $bottomPixel] [PathHasPoint $points $leftPixel $bottomPixel]
    } -cleanup {
        destroy .graph1
        unset -nocomplain block points left top width height leftPixel rightPixel topPixel bottomPixel x1 y1 x2 y2
    } -result {1 1 1 1}
	
    # ------------------------------------------------------------------------------------
    # Purpose: File output must finish rendering before touching the destination.
    # ------------------------------------------------------------------------------------
    test RBC.graph.postscript.output.A.2.1 {
        render failure preserves an existing file
    } -setup {
        graph .graph1
        pack .graph1
        update idletasks
        set FileName [makeFile {keep this file} RBC.postscript-preserve.ps]
        set library $::rbc::library
    } -body {
        set ::rbc::library [file join $::tcltest::temporaryDirectory missing-rbc-prologue]
        set code [catch {.graph1 postscript output $FileName} message]
        list $code [string match {*prologue*} $message] [string trim [viewFile $FileName]]
    } -cleanup {
        set ::rbc::library $library
        removeFile $FileName
        destroy .graph1
    } -result {1 1 {keep this file}}

    test RBC.graph.postscript.output.A.2.2 {
        render failure does not create a new file
    } -setup {
        graph .graph1
        pack .graph1
        update idletasks
        set FileName [file join $::tcltest::temporaryDirectory RBC.postscript-new.ps]
        set library $::rbc::library
    } -body {
        set ::rbc::library [file join $::tcltest::temporaryDirectory missing-rbc-prologue]
        list [catch {.graph1 postscript output $FileName}] [file exists $FileName]
    } -cleanup {
        set ::rbc::library $library
        removeFile $FileName
        destroy .graph1
    } -result {1 0}

    test RBC.graph.postscript.output.A.2.3 {
        formatter destruction preserves the destination and original error
    } -setup {
        graph .graph1
        pack .graph1
        update idletasks
        set FileName [makeFile {keep this file} RBC.postscript-callback.ps]
        .graph1 axis configure x -command {apply {{w value} {destroy $w}}}
    } -body {
        set code [catch {.graph1 postscript output $FileName} message options]
        list $code [dict get $options -errorcode] [winfo exists .graph1] \
                [string trim [viewFile $FileName]]
    } -cleanup {
        catch {destroy .graph1}
        removeFile $FileName
    } -result {1 {RBC GRAPH CALLBACK} 0 {keep this file}}

    # ------------------------------------------------------------------------------------
    # Purpose: Check Tcl path handling, byte output and I/O errors.
    # ------------------------------------------------------------------------------------
    test RBC.graph.postscript.output.A.3.1 {
        Unicode filename and ordinary EPS byte format
    } -setup {
        graph .graph1
        pack .graph1
        set FileName [file join $::tcltest::temporaryDirectory "RBC-\u03b1-\u6e2c.ps"]
    } -body {
        set result [.graph1 postscript output $FileName]
        set channel [open $FileName rb]
        set ps [read $channel]
        close $channel
        list $result [string match {%!PS-Adobe*} $ps] \
                [string match {*%EOF*} $ps] [expr {[string first \r $ps] < 0}]
    } -cleanup {
        catch {close $channel}
        removeFile $FileName
        destroy .graph1
    } -result {{} 1 1 1}

    test RBC.graph.postscript.output.A.3.2 {
        open errors are reported and the graph remains usable
    } -setup {
        graph .graph1
        pack .graph1
        set FileName [file join $::tcltest::temporaryDirectory missing-rbc-directory output.ps]
    } -body {
        set code [catch {.graph1 postscript output $FileName} message options]
        list $code [lindex [dict get $options -errorcode] 0] \
                [string match {%!PS-Adobe*} [.graph1 postscript output]]
    } -cleanup {
        destroy .graph1
    } -result {1 POSIX 1}

    testConstraint postscriptFullDevice [expr {$::tcl_platform(platform) eq "unix" && [file exists /dev/full]}]
    test RBC.graph.postscript.output.A.3.3 {
        output failure reports the original channel error
    } -constraints postscriptFullDevice -setup {
        graph .graph1
        pack .graph1
    } -body {
        set code [catch {.graph1 postscript output /dev/full} message options]
        list $code [lrange [dict get $options -errorcode] 0 1] \
                [string match {%!PS-Adobe*} [.graph1 postscript output]]
    } -cleanup {
        destroy .graph1
    } -result {1 {POSIX ENOSPC} 1}

    test RBC.graph.postscript.output.A.3.4 {
        buffered output failure at close is reported
    } -constraints postscriptFullDevice -setup {
        graph .graph1 -title {} -plotborderwidth 0 -borderwidth 0
        pack .graph1
        .graph1 axis configure x y x2 y2 -hide yes
        update idletasks
        set library $::rbc::library
        set prologDir [makeDirectory RBC.postscript-prolog]
        set channel [open [file join $prologDir rbcGraph.pro] w]
        close $channel
        set ::rbc::library $prologDir
    } -body {
        # A minimal prologue keeps the document below Tcl's default 4K
        # output buffer, so the device failure is deferred until close.
        set ps [.graph1 postscript output -decorations no]
        set code [catch {.graph1 postscript output /dev/full} message options]
        list [expr {[string length $ps] < 4000}] $code \
                [lrange [dict get $options -errorcode] 0 1] \
                [expr {![string match {error writing PostScript:*} $message]}]
    } -cleanup {
        set ::rbc::library $library
        removeDirectory $prologDir
        destroy .graph1
    } -result {1 1 {POSIX ENOSPC} 1}

    testConstraint postscriptZipfs [expr {[llength [info commands ::zipfs]] != 0 &&
            [info exists ::tcl::zipfs::wrmax]}]
    test RBC.graph.postscript.output.A.3.5 {
        output uses Tcl filesystem channels for a mounted file
    } -constraints postscriptZipfs -setup {
        graph .graph1
        pack .graph1
        set zipDir [makeDirectory RBC.postscript-zip]
        set channel [open [file join $zipDir output.ps] w]
        close $channel
        set zipFile [file join $::tcltest::temporaryDirectory RBC.postscript.zip]
        zipfs mkzip $zipFile $zipDir $zipDir
        set mountPoint [file join [zipfs root] RBC-postscript-test]
        zipfs mount $zipFile $mountPoint
        set writeLimit $::tcl::zipfs::wrmax
        set ::tcl::zipfs::wrmax 1000000
    } -body {
        set FileName [file join $mountPoint output.ps]
        set result [.graph1 postscript output $FileName]
        set channel [open $FileName rb]
        set ps [read $channel]
        close $channel
        list $result [string match {%!PS-Adobe*} $ps] [string match {*%EOF*} $ps]
    } -cleanup {
        catch {close $channel}
        set ::tcl::zipfs::wrmax $writeLimit
        zipfs unmount $mountPoint
        removeFile $zipFile
        removeDirectory $zipDir
        destroy .graph1
    } -result {{} 1 1}

    # ------------------------------------------------------------------------------------
    # Purpose: Preserve the binary DOS EPS preview layout on Windows.
    # ------------------------------------------------------------------------------------
    test RBC.graph.postscript.output.A.4.1 {
        Windows metafile preview offsets and binary payload
    } -constraints win -setup {
        graph .graph1
        pack .graph1
        update idletasks
        set FileName [file join $::tcltest::temporaryDirectory "RBC-preview-\u03b1.eps"]
    } -body {
        set result [.graph1 postscript output $FileName -preview yes -previewformat wmf]
        set channel [open $FileName rb]
        set eps [read $channel]
        close $channel
        binary scan $eps H8iu6su magic fields checksum
        lassign $fields psStart psLength wmfStart wmfLength tiffStart tiffLength
        list $result $magic [expr {$psStart == 30}] \
                [expr {$wmfStart == $psStart + $psLength}] \
                [expr {$wmfLength > 0 && [string length $eps] == $wmfStart + $wmfLength}] \
                [string match {%!PS-Adobe*} [string range $eps $psStart [expr {$wmfStart-2}]]] \
                [expr {[string index $eps [expr {$wmfStart-1}]] eq "\0"}] \
                [expr {$tiffStart == 0 && $tiffLength == 0 && $checksum == 65535}]
    } -cleanup {
        catch {close $channel}
        removeFile $FileName
        destroy .graph1
    } -result {{} c5d0d3c6 1 1 1 1 1 1}

	cleanupTests
}
