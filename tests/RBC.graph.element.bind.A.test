# RBC.graph.element.bind.A.test --
#
###Abstract
# This file contains the automatic tests that test the element bind 
# function of the graph BLT component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.element

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.element {	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the element bind command works correctly when given a tag name, an
	# event sequence, and a command.
	# ------------------------------------------------------------------------------------
	test RBC.graph.element.bind.A.1.1 {
		graph element: bind - tag, sequence, and command
	} -setup {
		graph .graph1
		.graph1 element create Element1
	} -body {
		.graph1 element bind Binding1 <Double-1> {puts foo}
		.graph1 element configure Element1 -bindtags Binding1
		.graph1 element cget Element1 -bindtags
	} -cleanup {
		destroy Binding1
		.graph1 element delete Element1
		destroy .graph1
	} -result {Binding1}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a real pointer event over an element dispatches the binding associated
	# with that element name.
	# ------------------------------------------------------------------------------------
    test RBC.graph.element.bind.A.1.2 {
		Element binding is delivered to picked element
	} -setup {
        graph .graph1 -width 400 -height 300
        pack .graph1
        .graph1 axis configure x -min 0 -max 10
        .graph1 axis configure y -min 0 -max 10
        .graph1 element create Element1 -data {2 2 5 5 8 8} -symbol circle
        .graph1 element bind Element1 <Enter> {
			set ::elementBindingResult Element1
		}
        set ::elementBindingResult {}
        update idletasks
        lassign [.graph1 transform 5 5] x y
    } -body {
        #
        # Establish a different current object first.
        #
        event generate .graph1 <Motion> -x 0 -y 0
        update
        event generate .graph1 <Motion> -x $x -y $y
        update
        set ::elementBindingResult
    } -cleanup {
        unset -nocomplain ::elementBindingResult
        destroy .graph1
    } -result {Element1}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a key event is delivered to the currently picked element when no
	# explicit binding-table focus item has been established.
	# ------------------------------------------------------------------------------------
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a key event is delivered to the currently picked element when no
	# explicit binding-table focus item has been established.
	# ------------------------------------------------------------------------------------
    test RBC.graph.element.bind.A.1.3 {
		Element key binding is delivered to current element
	} -setup {
        graph .graph1 -width 400 -height 300
        pack .graph1
        .graph1 axis configure x -min 0 -max 10
        .graph1 axis configure y -min 0 -max 10
        .graph1 element create Element1 -data {2 2 5 5 8 8} -symbol circle
        set ::elementKeyBindingResult {}
        .graph1 element bind Element1 <KeyPress-a> {
			set ::elementKeyBindingResult Element1
		}
        update
        lassign [.graph1 transform 5 5] x y
        focus -force .graph1
        update
    } -body {
        event generate .graph1 <Motion> -x $x -y $y
        update
        event generate .graph1 <KeyPress> -keysym a
        update
        set ::elementKeyBindingResult
    } -cleanup {
        unset -nocomplain ::elementKeyBindingResult
        destroy .graph1
    } -result {Element1}

    # ------------------------------------------------------------------------------------
    # Purpose: Non-positive data on a logarithmic axis must break a line trace rather
    # than reconnecting the valid points on either side of the invalid sample.
    # ------------------------------------------------------------------------------------
    test RBC.graph.element.bind.A.1.4 {
        Logscale invalid point breaks line trace
    } -setup {
        graph .graph1 -width 600 -height 400 -halo 3
        pack .graph1
        .graph1 axis configure x -min 1 -max 5
        .graph1 axis configure y -logscale yes -min 1 -max 100
        .graph1 element create Element1 -data {1 10 2 10 3 -1 4 10 5 10} -symbol none -linewidth 2
        .graph1 element bind Element1 <Enter> {
            set ::elementGapHit 1
        }
        set ::elementGapHit 0
        update
        lassign [.graph1 transform 3 10] x y
    } -body {
        #
        # Ensure there is no current element first.
        #
        event generate .graph1 <Motion> -x 0 -y 0
        update
        set ::elementGapHit 0
        #
        # This lies exactly on the false segment that would connect
        # data points 2 and 4 if the omitted point were merely compacted.
        #
        event generate .graph1 <Motion> -x $x -y $y
        update
        set ::elementGapHit
    } -cleanup {
        unset -nocomplain ::elementGapHit
        destroy .graph1
    } -result 0
	
	cleanupTests
}
