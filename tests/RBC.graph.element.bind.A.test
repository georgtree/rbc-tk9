# RBC.graph.element.bind.A.test --
#
###Abstract
# This file contains the automatic tests that test the element bind 
# function of the graph BLT component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.element

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.element {	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the element bind command works correctly when given a tag name, an
	# event sequence, and a command.
	# ------------------------------------------------------------------------------------
	test RBC.graph.element.bind.A.1.1 {
		graph element: bind - tag, sequence, and command
	} -setup {
		graph .graph1
		.graph1 element create Element1
	} -body {
		.graph1 element bind Binding1 <Double-1> {puts foo}
		.graph1 element configure Element1 -bindtags Binding1
		.graph1 element cget Element1 -bindtags
	} -cleanup {
		destroy Binding1
		.graph1 element delete Element1
		destroy .graph1
	} -result {Binding1}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a real pointer event over an element dispatches the binding associated
	# with that element name.
	# ------------------------------------------------------------------------------------
    test RBC.graph.element.bind.A.1.2 {
		Element binding is delivered to picked element
	} -setup {
        graph .graph1 -width 400 -height 300
        pack .graph1
        .graph1 axis configure x -min 0 -max 10
        .graph1 axis configure y -min 0 -max 10
        .graph1 element create Element1 -data {2 2 5 5 8 8} -symbol circle
        .graph1 element bind Element1 <Enter> {
			set ::elementBindingResult Element1
		}
        set ::elementBindingResult {}
        update idletasks
        lassign [.graph1 transform 5 5] x y
    } -body {
        #
        # Establish a different current object first.
        #
        event generate .graph1 <Motion> -x 0 -y 0
        update
        event generate .graph1 <Motion> -x $x -y $y
        update
        set ::elementBindingResult
    } -cleanup {
        unset -nocomplain ::elementBindingResult
        destroy .graph1
    } -result {Element1}
	
	cleanupTests
}
