# Photo-block conversion harness; ordinary suite runs skip it.
package provide image.photo
package require tcltest
namespace import tcltest::*
set imageAvailable 0
if {[info exists ::env(RBC_IMAGE_TEST_LIB)]} {
    package require Tk
    load $::env(RBC_IMAGE_TEST_LIB) Rbcimagetest
    set imageAvailable 1
}
testConstraint imageHarness $imageAvailable
testConstraint x11ImageHarness [expr {$imageAvailable && [llength [info commands ::rbctruecolortest]] != 0}]
namespace eval image.photo {
    foreach {case pixelSize expected} {
        1 1 {{10 10 10 255} {11 11 11 255} {12 12 12 255} {13 13 13 255} {14 14 14 255} {15 15 15 255}}
        2 2 {{10 10 10 255} {11 11 11 255} {12 12 12 255} {13 13 13 255} {14 14 14 255} {15 15 15 255}}
        3 3 {{10 30 50 255} {11 31 51 255} {12 32 52 255} {13 33 53 255} {14 34 54 255} {15 35 55 255}}
        4 4 {{10 30 50 200} {11 31 51 201} {12 32 52 202} {13 33 53 203} {14 34 54 204} {15 35 55 205}}
    } {
        test RBC.image.photo.A.1.$case "padded $pixelSize-byte block: whole and cropped channel mapping" \
                -constraints imageHarness -body [list ::rbcphotoblocktest $pixelSize] \
                -result [list $expected [list [lindex $expected 1] [lindex $expected 2] \
                        [lindex $expected 4] [lindex $expected 5]]]
    }
    foreach {case bits expected} {
        1 5 {0 5 10 15 20 25}
        2 6 {0 6 12 18 24}
        3 8 {0 8 16 24}
        4 10 {0 10 20}
    } {
        test RBC.image.photo.A.2.$case "X11 $bits-bit capture channels fit the gamma table" \
                -constraints x11ImageHarness -body [list ::rbctruecolortest $bits] -result $expected
    }

}
cleanupTests
if {$imageAvailable} {destroy .}
