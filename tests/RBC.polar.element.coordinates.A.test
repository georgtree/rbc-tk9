# RBC.polar.element.coordinates.A.test --
#
###Abstract
# Polar input coordinates and their Cartesian mapping.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.

package require rbc
package require tcltest
namespace import ::rbc::*
namespace import ::tcltest::*

namespace eval polar.coordinates {

    proc MakeGraph {} {
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -4 -max 4
        .polar1 axis configure y -min -4 -max 4
        update idletasks
    }

    proc Closest {x y} {
        update idletasks
        lassign [.polar1 transform $x $y] px py
        if {![.polar1 element closest $px $py info -along both -interpolate no -halo 3 signal]} {
            error "no point found at $x,$y"
        }
        return [list $info(index) [expr {abs($info(x)-$x) < 1e-10}] \
                    [expr {abs($info(y)-$y) < 1e-10}] $info(dataFormat)]
    }

    test polarCoordinates-1 {lists use radians and preserve source values} -setup {
        MakeGraph
    } -body {
        set theta [list 0 [expr {acos(-1)/2}] [expr {5*acos(-1)/2}]]
        .polar1 element create signal -xdata $theta -ydata {1 2 3} -datacoordinates polar
        list [Closest 1 0] [Closest 0 2] [Closest 0 3] \
            [expr {[.polar1 element cget signal -xdata] eq $theta}]
    } -cleanup {
        destroy .polar1
    } -result {{0 1 1 polar} {1 1 1 polar} {2 1 1 polar} 1}

    test polarCoordinates-2 {coordinate changes remap existing data} -setup {
        MakeGraph
        .polar1 element create signal -data {0 2}
    } -body {
        set before [Closest 0 2]
        .polar1 element configure signal -datacoordinates polar
        set after [Closest 2 0]
        .polar1 element configure signal -datacoordinates cartesian
        list $before $after [Closest 0 2]
    } -cleanup {
        destroy .polar1
    } -result {{0 1 1 xy} {0 1 1 polar} {0 1 1 xy}}

    test polarCoordinates-3 {real vector changes update converted points} -setup {
        MakeGraph
        vector create theta radius
        theta set {0}
        radius set {1}
        .polar1 element create signal -xdata theta -ydata radius -datacoordinates polar
    } -body {
        set before [Closest 1 0]
        theta index 0 [expr {acos(-1)/2}]
        radius index 0 2
        list $before [Closest 0 2]
    } -cleanup {
        destroy .polar1
        vector destroy theta radius
    } -result {{0 1 1 polar} {0 1 1 polar}}

    test polarCoordinates-4 {complex input conflicts roll back configuration} -setup {
        MakeGraph
        vector create z -type complex
        z set {{1 0}}
        .polar1 element create signal -cdata z
    } -body {
        set failed [catch {.polar1 element configure signal -datacoordinates polar}]
        list $failed [.polar1 element cget signal -datacoordinates] [Closest 1 0]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {1 cartesian {0 1 1 gamma}}

    test polarCoordinates-5 {error data conflicts roll back coordinate changes} -setup {
        MakeGraph
        .polar1 element create signal -data {0 2} -xerror {0.1}
    } -body {
        set failed [catch {.polar1 element configure signal -datacoordinates polar}]
        .polar1 element configure signal -xerror {} -datacoordinates polar
        list $failed [Closest 2 0]
    } -cleanup {
        destroy .polar1
    } -result {1 {0 1 1 polar}}

    test polarCoordinates-6 {closest reports radians and normalized geometry} -setup {
        MakeGraph
        .polar1 element create signal -data [list [expr {5*acos(-1)/2}] 2] -datacoordinates polar
    } -body {
        update idletasks
        lassign [.polar1 transform 0 2] px py
        .polar1 element closest $px $py info -interpolate no -halo 3 signal
        list [expr {abs($info(angle)-acos(-1)/2) < 1e-10}] [expr {abs($info(radius)-2) < 1e-10}]
    } -cleanup {
        destroy .polar1
        unset -nocomplain info
    } -result {1 1}

    test polarCoordinates-7 {Smith coordinates describe Gamma} -setup {
        MakeGraph
        .polar1 configure -representation smith
        .polar1 element create signal -data {0 0.5} -datacoordinates polar
    } -body {
        update idletasks
        lassign [.polar1 transform 0.5 0] px py
        .polar1 element closest $px $py info -interpolate no -halo 3 signal
        list [expr {abs($info(normalizedResistance)-3) < 1e-10}] $info(dataFormat)
    } -cleanup {
        destroy .polar1
        unset -nocomplain info
    } -result {1 polar}

    test polarCoordinates-8 {automatic extents use radius rather than raw angle} -setup {
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 element create signal -data {100 2} -datacoordinates polar
    }-body {
        update idletasks
        lassign [.polar1 axis limits x] lo hi
        set tolerance 1e-10
        if {$lo <= -2+$tolerance && $hi >= 2-$tolerance && $hi < 10} {
            set result {}
        } else {
            set result [list limits $lo $hi]
        }
        set result
    } -cleanup {
        destroy .polar1
    } -result {}

    test polarCoordinates-9 {negative radii and zero retain Cartesian semantics} -setup {
        MakeGraph
        .polar1 element create signal -data {0 -2 100 0} -datacoordinates polar
    } -body {
        list [Closest -2 0] [Closest 0 0]
    } -cleanup {
        destroy .polar1
    } -result {{0 1 1 polar} {1 1 1 polar}}

    test polarCoordinates-10 {interpolated closest returns the Cartesian chord} -setup {
        MakeGraph
        .polar1 element create signal -data [list 0 2 [expr {acos(-1)/2}] 2] \
            -datacoordinates polar -smooth linear -reduce 0 -symbol none
    } -body {
        update idletasks
        lassign [.polar1 transform 1 1] px py
        set found [.polar1 element closest $px $py info -interpolate yes -halo 5 signal]
        list $found [expr {abs($info(x)-1) < 0.1 && abs($info(y)-1) < 0.1}] \
            [expr {abs($info(radius)-sqrt(2)) < 0.1}] $info(dataFormat)
    } -cleanup {
        destroy .polar1
        unset -nocomplain info
    } -result {1 1 1 polar}

    test polarCoordinates-11 {failed complex switch retains real vector subscriptions} -setup {
        MakeGraph
        vector create theta radius
        theta set {0}
        radius set {1}
        vector create z -type complex
        z set {{0 1}}
        .polar1 element create signal -xdata theta -ydata radius -datacoordinates polar
    } -body {
        set failed [catch {.polar1 element configure signal -cdata z}]
        radius index 0 2
        list $failed [Closest 2 0]
    } -cleanup {
        destroy .polar1
        vector destroy theta radius z
    } -result {1 {0 1 1 polar}}

}

::tcltest::cleanupTests
