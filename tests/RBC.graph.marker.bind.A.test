# RBC.graph.marker.bind.A.test --
#
###Abstract
# This file contains the automatic tests that test the marker bind
# function of the graph BLT component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.marker

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.marker {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings can be created for a marker
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.marker.bind.A.1.1 {
		Test marker bind creation
	} -setup {
		graph .graph1
		.graph1 marker create text -name marker1
		pack .graph1
	} -body {
		if {[catch {.graph1 marker bind marker1 <Double-1> {puts test}}]} {
        return 1
    }
    return 0
	} -cleanup {
		destroy .graph1
	} -result {0}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings can be queried for a sequence and marker
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.marker.bind.A.1.2 {
    	Test marker bind query
	} -setup {
		graph .graph1
		.graph1 marker create text -name marker1
		pack .graph1
		.graph1 marker bind marker1 <Double-1> {puts test}
	} -body {
		.graph1 marker bind marker1 <Double-1>
	} -cleanup {
		destroy .graph1
	} -result {puts test}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings can be appended for a sequence and marker
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.marker.bind.A.1.3 {
	    Test marker bind append
	} -setup {
		graph .graph1
		.graph1 marker create text -name marker1
		pack .graph1
	    .graph1 marker bind marker1 <Double-1> {puts test}    
	} -body {
	    .graph1 marker bind marker1 <Double-1> {+puts test2}
	    .graph1 marker bind marker1 <Double-1>    
	} -cleanup {
	    destroy .graph1
	} -result "puts test\nputs test2"
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings are overwritten for a sequence and marker
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.marker.bind.A.1.4 {
	    Test marker bind overwrite
	} -setup {
		graph .graph1
		.graph1 marker create text -name marker1
		pack .graph1
	    .graph1 marker bind marker1 <Double-1> {puts test}    
	} -body {
	    .graph1 marker bind marker1 <Double-1> {+puts test2}
	    .graph1 marker bind marker1 <Double-1>    
	} -body {
	    .graph1 marker bind marker1 <Double-1> {puts test2}    
	    .graph1 marker bind marker1 <Double-1>    
	} -cleanup {
	    destroy .graph1
	} -result {puts test2}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bound sequences can be queried for just a marker
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.marker.bind.A.1.5 {
	    Test marker bind query
	} -setup {
		graph .graph1
		.graph1 marker create text -name marker1
		pack .graph1
		.graph1 marker bind marker1 <Double-1> {puts test}
		.graph1 marker bind marker1 <Key> {puts test2}   
	} -body {
	    .graph1 marker bind marker1
	} -cleanup {
	    destroy .graph1
	} -result {<Key> <Double-Button-1>}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a real pointer event over a marker dispatches the binding associated
	# with that marker name.
	# ------------------------------------------------------------------------------------
    test RBC.graph.marker.bind.A.1.6 {
		Marker binding is delivered to picked marker
	} -setup {
        graph .graph1 -width 400 -height 300
        pack .graph1
        .graph1 axis configure x -min 0 -max 10
        .graph1 axis configure y -min 0 -max 10
        .graph1 marker create text -name marker1 -coords {5 5} -text "MARKER" -anchor center
        .graph1 marker bind marker1 <Enter> {
			set ::markerBindingResult marker1
		}
        set ::markerBindingResult {}
        update idletasks
        lassign [.graph1 transform 5 5] x y
    } -body {
        event generate .graph1 <Motion> -x 0 -y 0
        update
        event generate .graph1 <Motion> -x $x -y $y
        update
        set ::markerBindingResult
    } -cleanup {
        unset -nocomplain ::markerBindingResult
        destroy .graph1
    } -result {marker1}

    test RBC.graph.marker.bind.arrow.A.1.1 {
        graph marker bind: line arrowhead participates in hit testing
    } -setup {
        graph .graph1 -width 400 -height 300 -halo 1
        pack .graph1
        .graph1 axis configure x -min 0 -max 10
        .graph1 axis configure y -min 0 -max 10
        .graph1 marker create line -name Marker1 -coords {2 5 7 5} -outline black -linewidth 2 -arrow none -arrowshape\
                {20 30 15}
        set ::markerArrowHit 0
        .graph1 marker bind Marker1 <ButtonPress-1> {
            set ::markerArrowHit 1
        }
        update idletasks
    } -body {
        lassign [.graph1 transform 7 5] tipX tipY
        set x [expr {round($tipX - 25)}]
        set y [expr {round($tipY + 8)}]
        set ::markerArrowHit 0
        event generate .graph1 <Motion> -x $x -y $y
        event generate .graph1 <ButtonPress-1> -x $x -y $y
        update
        set withoutArrow $::markerArrowHit
        .graph1 marker configure Marker1 -arrow last
        update idletasks
        set ::markerArrowHit 0
        event generate .graph1 <Motion> -x $x -y $y
        event generate .graph1 <ButtonPress-1> -x $x -y $y
        update
        set withArrow $::markerArrowHit
        list $withoutArrow $withArrow
    } -cleanup {
        unset -nocomplain ::markerArrowHit
        destroy .graph1
    } -result {0 1}
	
	cleanupTests
}
