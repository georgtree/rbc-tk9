# Named tracks: shared X geometry, independent Y regions, lifecycle and exports.
# See license.terms for details.
package require rbc
package require tcltest

namespace eval trackGraphTest {
    namespace import ::tcltest::*

    proc Create {} {
        ::rbc::trackgraph .tg -width 640 -height 480
        .tg legend configure -hide yes
        .tg axis configure x -min 0 -max 10 -loose no
        .tg axis create volts -min -1 -max 1 -loose no -title Voltage
        .tg axis create amps -min -10 -max 10 -loose no -title Current
        .tg track create voltage -yaxes volts -weight 2
        .tg track create current -yaxes amps -weight 1
        .tg line create v -track voltage -mapy volts -data {0 -1 5 1 10 -1} -color red -symbol none
        .tg strip create i -track current -mapy amps -data {0 10 5 -10 10 10} -color blue -symbol none
        pack .tg
        update
    }

    test trackgraph-strip-closest {interpolated strip picking uses the strip geometry in a mixed graph} -setup {
        Create
    } -body {
        set x [expr {round([.tg axis transform x 2.5])}]
        set y [expr {round([.tg axis transform amps 0])}]
        set found [.tg element closest $x $y stripClosest -interpolate yes -halo 3 i]
        list $found $stripClosest(name) [expr {abs($stripClosest(x)-2.5)<0.1 && abs($stripClosest(y))<0.2}]
    } -cleanup {destroy .tg; unset -nocomplain stripClosest} -result {1 i 1}

    test trackgraph-exported {trackgraph supports the ordinary rbc namespace import} -body {
        namespace eval importTrack {
            namespace import ::rbc::trackgraph
            namespace origin trackgraph
        }
    } -cleanup {namespace delete importTrack} -result ::rbc::trackgraph

    test trackgraph-layout {shared horizontal bounds and weighted independent vertical bounds} -setup {
        Create
    } -body {
        lassign [.tg track bbox voltage] l1 t1 r1 b1
        lassign [.tg track bbox current] l2 t2 r2 b2
        list [.tg track names] [expr {$l1 == $l2 && $r1 == $r2 && $b1 < $t2}] \
            [expr {abs(($b1-$t1-40)-2*($b2-$t2-40)) <= 2}] \
            [.tg element cget v -track] [.tg element type i]
    } -cleanup {destroy .tg} -result {{voltage current} 1 1 voltage StripElement}

    foreach logarithmic {0 1} {
        foreach descending {0 1} {
            test trackgraph-transform-$logarithmic-$descending {track and axis transforms agree and round trip} -setup {
                Create
                .tg axis configure volts -min 1 -max 100 -logscale $logarithmic -descending $descending
                .tg axis configure amps -min 1 -max 100 -logscale $logarithmic -descending $descending
            } -body {
                set result {}
                foreach {track axis} {voltage volts current amps} {
                    lassign [.tg track transform $track 4 10] px py
                    lassign [.tg track invtransform $track $px $py] x y
                    lassign [.tg track bbox $track] l t r b
                    lappend result [expr {abs($x-4)<1e-9 && abs($y-10)<1e-9}] \
                        [expr {$py >= $t && $py <= $b}] \
                        [expr {abs([.tg axis transform $axis 10]-$py)<1.0}]
                }
                set result
            } -cleanup {destroy .tg} -result {1 1 1 1 1 1}
        }
    }

    test trackgraph-picking {picking and bindings cannot select an element in another track} -setup {
        Create
    } -body {
        lassign [.tg track transform voltage 5 1] x y
        set result [list [.tg element closest $x $y hit -halo 3] $hit(name) [.tg track identify $y]]
        lassign [.tg track transform current 5 -10] x y
        lappend result [.tg element closest $x $y hit -halo 3] $hit(name) [.tg track identify $y]
        lassign [.tg track bbox voltage] l t r b
        lappend result [.tg track identify [expr {$b+6}]]
        set result
    } -cleanup {destroy .tg} -result {1 v voltage 1 i current {}}

    test trackgraph-shared-x {one X range change affects both tracks identically; multiple shared axes work} -setup {
        Create
        .tg axis create samples -min 0 -max 100 -loose no
        .tg x2axis use samples
    } -body {
        set result {}
        foreach range {{0 10} {2 8}} {
            .tg axis configure x -min [lindex $range 0] -max [lindex $range 1]
            lassign [.tg track transform voltage 4 0] x1 y1
            lassign [.tg track transform current 4 0] x2 y2
            lappend result [expr {$x1 == $x2 && $y1 < $y2}]
        }
        lassign [.tg track transform voltage 50 0 -mapx samples] x1 y1
        lassign [.tg track transform current 50 0 -mapx samples] x2 y2
        lappend result [expr {$x1 == $x2}]
        set result
    } -cleanup {destroy .tg} -result {1 1 1}

    test trackgraph-multiple-y {axes in one track share vertical geometry and reserve a common margin} -setup {
        Create
        .tg axis create volts2 -min 0 -max 100 -loose no -title Auxiliary
        .tg track configure voltage -yaxes {volts volts2}
    } -body {
        lassign [.tg track transform voltage 5 0] x1 y1
        lassign [.tg track transform voltage 5 50 -mapy volts2] x2 y2
        lassign [.tg track bbox voltage] l1 t1 r1 b1
        lassign [.tg track bbox current] l2 t2 r2 b2
        list [expr {$x1 == $x2 && $y1 == $y2}] [expr {$l1==$l2 && $r1==$r2}] \
            [.tg yaxis use]
    } -cleanup {destroy .tg} -result {1 1 {volts volts2 amps}}

    foreach options {{-weight 0} {-weight Inf} {-minheight -1} {-yaxes missing} {-yaxes amps} {-yaxes {volts volts}}} {
        test trackgraph-invalid-$options {invalid options leave track configuration unchanged} -setup {
            Create
        } -body {
            set before [.tg track configure voltage]
            list [catch {.tg track configure voltage {*}$options}] \
                [expr {$before eq [.tg track configure voltage]}]
        } -cleanup {destroy .tg} -result {1 1}
    }

    test trackgraph-ownership {element and axis ownership changes are checked before commit} -setup {
        Create
    } -body {
        list [catch {.tg element configure v -track current}] \
            [.tg element cget v -track] [.tg element cget v -mapy] \
            [catch {.tg track configure voltage -yaxes {}}] \
            [catch {.tg axis delete volts}] [catch {.tg track delete voltage}] \
            [catch {.tg yaxis use amps}] [catch {.tg configure -invertxy yes}] \
            [.tg cget -invertxy]
    } -cleanup {destroy .tg} -result {1 voltage volts 1 1 1 1 1 0}

    test trackgraph-move-delete {moving elements permits deleting tracks without deleting axes or vectors} -setup {
        Create
    } -body {
        .tg element configure v -track current -mapy amps
        .tg track delete voltage
        update
        list [.tg track names] [.tg element cget v -track] \
            [expr {"volts" in [.tg axis names]}] [.tg yaxis use]
    } -cleanup {destroy .tg} -result {current current 1 amps}

    test trackgraph-vectors {vector notifications update line and strip geometry in their own tracks} -setup {
        Create
        ::rbc::vector create trackX trackY
        trackX set {0 5 10}
        trackY set {0 0 0}
        .tg element configure i -xdata trackX -ydata trackY
    } -body {
        trackY set {1 2 3}
        update
        lassign [.tg track transform current 5 2] x y
        list [.tg element closest $x $y hit -halo 3] $hit(name) $hit(index) $hit(y)
    } -cleanup {destroy .tg; ::rbc::vector destroy trackX trackY} -result {1 i 1 2.0}

    test trackgraph-clipping {out-of-range lines are clipped to their owning track} -setup {
        Create
        .tg element configure v -data {0 -100 10 100}
    } -body {
        set svg [.tg svg output]
        lassign [.tg track bbox voltage] l t r b
        set count 0
        set valid 1
        foreach line [split $svg \n] {
            if {[string first {stroke="#ff0000"} $line]<0} {continue}
            if {[regexp {<polyline points="([^"]+)"} $line -> points]} {
                foreach {x y} [string map {, { }} $points] {
                    if {$y < $t-1 || $y > $b+1} {set valid 0}
                    incr count
                }
            }
        }
        list [expr {$count>0}] $valid
    } -cleanup {destroy .tg} -result {1 1}

    foreach format {svg postscript pdf} {
        test trackgraph-export-$format {resized export remaps tracks and restores screen geometry} -setup {
            Create
        } -body {
            set before [.tg track bbox voltage]
            set point [.tg track transform current 5 0]
            set original [.tg $format output]
            set enlarged [.tg $format output -width 900 -height 700]
            .tg $format configure -width 0 -height 0
            update
            list [expr {$original ne $enlarged}] [expr {$before eq [.tg track bbox voltage]}] \
                [expr {$point eq [.tg track transform current 5 0]}]
        } -cleanup {destroy .tg} -result {1 1 1}
    }

    test trackgraph-resize {small layouts and weight changes do not retain stale regions} -setup {
        Create
    } -body {
        set old [.tg track bbox voltage]
        .tg track configure voltage -weight 1
        .tg track configure current -weight 3
        update
        lassign [.tg track bbox voltage] l t r b
        lassign [.tg track bbox current] l2 t2 r2 b2
        set result [list [expr {$b-$t < $b2-$t2}]]
        .tg configure -height 140
        update
        lassign [.tg track bbox voltage] l t r b
        lassign [.tg track bbox current] l2 t2 r2 b2
        lappend result [expr {$t <= $b && $b <= $t2 && $t2 <= $b2}]
        .tg configure -height 480
        .tg track configure voltage -weight 2
        .tg track configure current -weight 1
        update
        lappend result [expr {$old eq [.tg track bbox voltage]}]
        set result
    } -cleanup {destroy .tg} -result {1 1 1}

    test trackgraph-restrictions {unsupported or ambiguous operations fail without leaving objects} -setup {
        Create
    } -body {
        list [catch {.tg bar create nope -data {1 1}}] [catch {.tg line create nope -data {1 1}}] \
            [expr {"nope" ni [.tg element names]}] [catch {.tg transform 1 1}] \
            [catch {.tg track transform voltage 1 1 -mapy amps}]
    } -cleanup {destroy .tg} -result {1 1 1 1 1}

    foreach renderer {native cairo} {
        ::rbc::trackgraph .trackProbe
        testConstraint trackRenderer$renderer [expr {![catch {.trackProbe configure -renderer $renderer}]}]
        destroy .trackProbe
        test trackgraph-raster-$renderer {out-of-range trace pixels remain inside their track} \
            -constraints trackRenderer$renderer -setup {
            Create
            .tg configure -renderer $renderer
            .tg element configure v -data {0 -100 10 100} -linewidth 1
            set photo [image create photo]
        } -body {
            update
            .tg snap $photo
            lassign [.tg track bbox voltage] l t r b
            set count 0
            set outside 0
            for {set y 0} {$y < [image height $photo]} {incr y} {
                for {set x $l} {$x <= $r} {incr x} {
                    lassign [$photo get $x $y] red green blue
                    if {$red>180 && $green<80 && $blue<80} {
                        incr count
                        if {$y < $t-1 || $y > $b+1} {incr outside}
                    }
                }
            }
            list [expr {$count>0}] $outside
        } -cleanup {image delete $photo; destroy .tg} -result {1 0}
    }

    test trackgraph-autorange {automatic Y limits remain independent while X limits are shared} -setup {
        Create
        .tg axis configure volts -min {} -max {}
        .tg axis configure amps -min {} -max {}
        .tg axis configure x -min {} -max {}
        .tg element configure i -data {0 1000 15 2000}
    } -body {
        update
        lassign [.tg axis limits volts] vmin vmax
        lassign [.tg axis limits amps] imin imax
        lassign [.tg axis limits x] xmin xmax
        list [expr {$vmin<=-1 && $vmax>=1 && $vmax<100}] \
            [expr {$imin>100 && $imax>=2000}] [expr {$xmax>=15}]
    } -cleanup {destroy .tg} -result {1 1 1}

    test trackgraph-failed-create {failed creation does not retain an axis reference or track name} -setup {
        Create
        .tg axis create auxiliary
    } -body {
        set result [list [catch {.tg track create extra -yaxes {auxiliary missing}}] [.tg track names]]
        .tg track create extra -yaxes auxiliary
        .tg track delete extra
        .tg axis delete auxiliary
        lappend result [expr {"auxiliary" ni [.tg axis names]}]
        set result
    } -cleanup {destroy .tg} -result {1 {voltage current} 1}

    test trackgraph-margin {adding a row reuses the existing Y margin} -setup {
        Create
        .tg axis create amps2 -min -10 -max 10 -loose no -title Current
    } -body {
        set before [lindex [.tg track bbox current] 0]
        .tg track create extra -yaxes amps2
        update
        expr {$before == [lindex [.tg track bbox extra] 0]}
    } -cleanup {destroy .tg} -result 1

    test trackgraph-lifecycle {repeated creation and destruction releases track-owned axis references} -body {
        for {set i 0} {$i<20} {incr i} {
            Create
            destroy .tg
            update
        }
        winfo exists .tg
    } -result 0
    # Track-owned markers use the same helpers and widget as the track tests above.
    proc MarkerSetup {} {
        Create
        .tg element delete v i
        .tg grid configure -hide yes
    }

    test trackgraph-marker-adopt-axis {track assignment cannot silently adopt graph-wide markers} -setup {
        MarkerSetup
        .tg marker create line -name m -mapy y -coords {0 0 1 1}
    } -body {
        set result [list [catch {.tg track create extra -yaxes y}] [.tg track names] [.tg marker cget m -track]]
        .tg marker delete m
        .tg track create extra -yaxes y
        lappend result [.tg track cget extra -yaxes]
        set result
    } -cleanup {destroy .tg} -result {1 {voltage current} {} y}

    test trackgraph-marker-ordinary {ordinary graphs reject a nonempty track without altering the marker} -setup {
        ::rbc::graph .tg
        .tg marker create text -name m -text Keep
    } -body {
        list [catch {.tg marker configure m -track missing -text Lost}] \
            [.tg marker cget m -text] [.tg marker cget m -track]
    } -cleanup {destroy .tg} -result {1 Keep {}}

    test trackgraph-marker-options {track and Y axis changes commit together or roll back} -setup {
        MarkerSetup
        .tg marker create line -name m -track voltage -mapy volts -coords {0 0 10 0}
    } -body {
        set result [list [.tg marker cget m -track] [catch {.tg marker configure m -track current}] \
            [.tg marker cget m -track] [.tg marker cget m -mapy]]
        .tg marker configure m -track current -mapy amps
        lappend result [.tg marker cget m -track] [.tg marker cget m -mapy]
        set result
    } -cleanup {destroy .tg} -result {voltage 1 voltage volts current amps}

    test trackgraph-marker-lifecycle {hidden markers protect their track and axis until moved or deleted} -setup {
        MarkerSetup
        .tg marker create text -name m -track voltage -mapy volts -hide yes
    } -body {
        set result [list [catch {.tg track delete voltage}] \
            [catch {.tg track configure voltage -yaxes {}}] [catch {.tg axis delete volts}]]
        .tg marker configure m -track current -mapy amps
        .tg track delete voltage
        .tg marker delete m
        .tg track delete current
        lappend result [.tg track names]
        set result
    } -cleanup {destroy .tg} -result {1 1 1 {}}

    test trackgraph-marker-invalid {unsupported combinations fail without replacing existing markers} -setup {
        MarkerSetup
        button .tg.child
        .tg marker create text -name m -text Keep -track voltage -mapy volts
    } -body {
        set result {}
        foreach command {
            {.tg marker create line -name m -track missing -mapy volts}
            {.tg marker create line -name m -track voltage -mapy amps}
            {.tg marker create window -name m -track voltage -mapy volts -window .tg.child}
            {.tg marker create line -name m -track voltage -mapy volts -xor yes}
            {.tg marker create polygon -name m -track voltage -mapy volts -xor yes}
            {.tg marker create arc -name m -track voltage -mapy volts -xor yes}
            {.tg marker configure m -track {}}
        } {
            lappend result [catch {eval $command}]
        }
        lappend result [.tg marker cget m -text] [.tg marker cget m -track]
        set result
    } -cleanup {destroy .tg} -result {1 1 1 1 1 1 1 Keep voltage}

    foreach logarithmic {0 1} {
        foreach descending {0 1} {
            test trackgraph-marker-map-$logarithmic-$descending {marker mapping agrees with track transforms} -setup {
                MarkerSetup
                .tg axis configure volts -min 1 -max 100 -logscale $logarithmic -descending $descending
                .tg marker create line -name m -track voltage -mapy volts -coords {2 10 8 10} -outline red
                update
            } -body {
                lassign [.tg track transform voltage 5 10] px py
                .tg marker find overlapping [expr {int($px)-2}] [expr {int($py)-2}] \
                    [expr {int($px)+2}] [expr {int($py)+2}]
            } -cleanup {destroy .tg} -result m
        }
    }

    test trackgraph-marker-picking {find and current marker ignore clipped overhangs in track gaps} -setup {
        MarkerSetup
        .tg marker create text -name m -track voltage -mapy volts -coords {5 -1} \
            -text XXXXX -font {Helvetica 40} -anchor center -background red
        update
    } -body {
        lassign [.tg track transform voltage 5 -1] x y
        set x [expr {int($x)}]; set y [expr {int($y)}]
        event generate .tg <Motion> -x $x -y [expr {$y-2}]
        update
        set result [list [.tg marker get current]]
        event generate .tg <Motion> -x $x -y [expr {$y+5}]
        update
        lappend result [.tg marker get current] \
            [.tg marker find overlapping [expr {$x-2}] [expr {$y+2}] [expr {$x+2}] [expr {$y+8}]]
        set result
    } -cleanup {destroy .tg} -result {m {} {}}

    foreach renderer {native cairo} {
        foreach {kind options} {
            line {-coords {5 -10 5 10} -outline red -linewidth 20 -arrow both}
            polygon {-coords {4 -10 6 -10 6 10 4 10} -fill red -outline red}
            arc {-coords {4 -10 6 10} -fill red -outline red}
            text {-coords {5 -1} -text XXXXX -font {Helvetica 40} -anchor center -foreground red}
            image {-coords {5 -1} -image trackMarkerPhoto -anchor center}
            bitmap {-coords {5 -1} -bitmap warning -foreground red -anchor center}
        } {
            test trackgraph-marker-raster-$renderer-$kind {all marker pixels stay inside the owning row} \
                -constraints trackRenderer$renderer -setup {
                MarkerSetup
                .tg configure -renderer $renderer
                image create photo trackMarkerPhoto -width 40 -height 100
                trackMarkerPhoto put red -to 0 0 40 100
                set photo [image create photo]
                .tg marker create $kind -name m -track voltage -mapy volts {*}$options
            } -body {
                update
                .tg snap $photo
                lassign [.tg track bbox voltage] l t r b
                set count 0; set outside 0
                for {set y 0} {$y < [image height $photo]} {incr y} {
                    for {set x 0} {$x < [image width $photo]} {incr x} {
                        lassign [$photo get $x $y] red green blue
                        if {$red>180 && $green<80 && $blue<80} {
                            incr count
                            if {$y < $t || $y > $b || $x < $l || $x > $r} {incr outside}
                        }
                    }
                }
                list [expr {$count>0}] $outside
            } -cleanup {image delete $photo trackMarkerPhoto; destroy .tg} -result {1 0}
        }
    }

    foreach under {yes no} {
        foreach buffered {yes no} {
            test trackgraph-marker-redraw-$under-$buffered {under/over markers redraw without stale pixels} -setup {
                MarkerSetup
                .tg configure -bufferelements $buffered -plotbackground white
                .tg marker create polygon -name m -track voltage -mapy volts -under $under \
                    -coords {4 -1 6 -1 6 1 4 1} -fill red -outline red
                set photo [image create photo]
            } -body {
                set result {}
                foreach hidden {no yes no} {
                    .tg marker configure m -hide $hidden
                    update
                    .tg snap $photo
                    lassign [.tg track transform voltage 5 0] x y
                    lappend result [$photo get [expr {int($x)}] [expr {int($y)}]]
                }
                set result
            } -cleanup {image delete $photo; destroy .tg} -result {{255 0 0} {255 255 255} {255 0 0}}
        }
    }

    test trackgraph-marker-inf {infinite Y endpoints map to the owning track boundaries} -setup {
        MarkerSetup
        .tg marker create line -name m -track current -mapy amps -coords {5 -Inf 5 Inf} -outline red
        update
    } -body {
        lassign [.tg track transform current 5 0] x y
        lassign [.tg track bbox current] l t r b
        set result {}
        foreach y [list $t $b] {
            lappend result [.tg marker find overlapping [expr {int($x)-1}] [expr {$y-1}] [expr {int($x)+1}] [expr {$y+1}]]
        }
        set result
    } -cleanup {destroy .tg} -result {m m}

    test trackgraph-marker-order {interleaved graph-wide markers retain painter order} -setup {
        MarkerSetup
        .tg axis configure y -min -1 -max 1 -loose no
        .tg marker create polygon -name first -track voltage -mapy volts \
            -coords {0 -Inf 10 -Inf 10 Inf 0 Inf} -fill red -outline red
        .tg marker create polygon -name global -coords {0 -Inf 10 -Inf 10 Inf 0 Inf} -fill blue -outline blue
        .tg marker create polygon -name last -track voltage -mapy volts \
            -coords {4 -1 6 -1 6 1 4 1} -fill green -outline green
        set photo [image create photo]
    } -body {
        update
        .tg snap $photo
        set result {}
        foreach x {2 5} {
            lassign [.tg track transform voltage $x 0] px py
            lappend result [$photo get [expr {int($px)}] [expr {int($py)}]]
        }
        set result
    } -cleanup {image delete $photo; destroy .tg} -result {{0 0 255} {0 128 0}}

    foreach format {svg postscript pdf} {
        test trackgraph-marker-export-$format {track marker exports establish a clip and restore screen geometry} -setup {
            MarkerSetup
            .tg marker create text -name m -track voltage -mapy volts -coords {5 -1} \
                -text TRACK_CLIP -font {Helvetica 40}
        } -body {
            update
            set before [.tg track bbox voltage]
            set output [.tg $format output]
            switch $format {
                svg {set clip [regexp {clip-path="url\(#rbcClip[0-9]+\)"} $output]}
                postscript {set clip [string match {*closepath clip newpath*} $output]}
                pdf {set clip [regexp {q [0-9]+ [0-9]+ [0-9]+ [0-9]+ re W n} $output]}
            }
            .tg $format output -width 900 -height 700
            .tg $format configure -width 0 -height 0
            update
            list $clip [expr {$before eq [.tg track bbox voltage]}]
        } -cleanup {destroy .tg} -result {1 1}
    }

    # Reordering and separators retain the same tracks, axes and plot objects.
    test trackgraph-order {reorder moves elements and markers without recreating them} -setup {
        Create
        .tg marker create text -name note -track voltage -mapy volts -coords {5 0} -text V
    } -body {
        set before [.tg track transform voltage 5 0]
        set result [list [.tg track order {current voltage}] [.tg track names] [.tg yaxis use]]
        lassign [.tg track transform voltage 5 0] x y
        lappend result [expr {$y > [lindex $before 1]}] [.tg element cget v -track] [.tg marker cget note -track]
        .tg track order {voltage current}
        lappend result [expr {$before eq [.tg track transform voltage 5 0]}]
        set result
    } -cleanup {destroy .tg} -result {{current voltage} {current voltage} {amps volts} 1 voltage voltage 1}

    foreach names {{} {voltage} {voltage voltage} {voltage missing} {current voltage extra}} {
        test trackgraph-order-invalid-$names {invalid permutations do not change layout or ownership} -setup {
            Create
        } -body {
            set before [.tg track bbox voltage]
            list [catch {.tg track order $names}] [.tg track order] [expr {$before eq [.tg track bbox voltage]}]
        } -cleanup {destroy .tg} -result {1 {voltage current} 1}
    }

    test trackgraph-order-empty {empty graphs accept an empty order} -setup {
        ::rbc::trackgraph .tg
    } -body {
        list [.tg track order] [.tg track order {}] [.tg track separator 0 0]
    } -cleanup {destroy .tg} -result {{} {} {}}

    proc ThirdTrack {} {
        .tg axis create aux -min -1 -max 1 -loose no
        .tg track create auxiliary -yaxes aux
        update
    }

    test trackgraph-sash {moving a separator changes only adjacent weights and respects minimum heights} -setup {
        Create
        ThirdTrack
    } -body {
        set outside [.tg track bbox auxiliary]
        set otherWeight [.tg track cget auxiliary -weight]
        set total [expr {[.tg track cget voltage -weight]+[.tg track cget current -weight]}]
        set old [.tg track sashpos voltage]
        set moved [.tg track sashpos voltage [expr {$old+20}]]
        set result [list [expr {abs($moved-$old-20)<=1}] [expr {$outside eq [.tg track bbox auxiliary]}] \
            [expr {$otherWeight == [.tg track cget auxiliary -weight]}] \
            [expr {abs($total-[.tg track cget voltage -weight]-[.tg track cget current -weight])<1e-12}]]
        foreach target {-1000000 1000000} {
            .tg track sashpos voltage $target
            foreach name {voltage current} {
                lassign [.tg track bbox $name] l t r b
                lappend result [expr {$b-$t >= [.tg track cget $name -minheight]-1}]
            }
        }
        set result
    } -cleanup {destroy .tg} -result {1 1 1 1 1 1 1 1}

    test trackgraph-separator {separator hit tests exclude plots and margins} -setup {
        Create
    } -body {
        lassign [.tg track bbox voltage] l t r b
        set y [.tg track sashpos voltage]
        list [.tg track separator [expr {($l+$r)/2}] $y] \
            [.tg track separator [expr {$l-1}] $y] [.tg track separator $l $b] \
            [.tg track separator $l -100] [catch {.tg track sashpos current}] \
            [catch {.tg track sashpos voltage bad}]
    } -cleanup {destroy .tg} -result {voltage {} {} {} 1 1}

    test trackgraph-sash-compressed {minimum-height compression leaves no space to redistribute} -setup {
        Create
        .tg track configure voltage -minheight 1000
        .tg track configure current -minheight 1000
    } -body {
        set old [.tg track sashpos voltage]
        list [expr {$old == [.tg track sashpos voltage [expr {$old+50}]]}] \
            [.tg track cget voltage -weight] [.tg track cget current -weight]
    } -cleanup {destroy .tg} -result {1 2.0 1.0}

    proc SeparatorPoint {} {
        lassign [.tg track bbox voltage] l t r b
        list [expr {($l+$r)/2}] [.tg track sashpos voltage]
    }

    test trackgraph-drag-disabled {default bindings do not resize tracks until explicitly enabled} -setup {
        Create
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        event generate .tg <ButtonRelease-1> -x $x -y [expr {$y+30}]
        update
        list [.tg cget -trackresize] [expr {$y == [.tg track sashpos voltage]}]
    } -cleanup {destroy .tg} -result {0 1}

    test trackgraph-drag {pointer drag resizes, restores cursor and keeps bindings reusable} -setup {
        Create
        .tg configure -trackresize yes -cursor crosshair
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <Motion> -x $x -y $y
        set hover [.tg cget -cursor]
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        event generate .tg <ButtonRelease-1> -x $x -y [expr {$y+30}]
        update
        list $hover [expr {abs([.tg track sashpos voltage]-$y-30)<=1}] \
            [.tg cget -cursor] [dict exists $::rbc::trackgraph::drag .tg]
    } -cleanup {destroy .tg} -result {sb_v_double_arrow 1 crosshair 0}

    test trackgraph-drag-click {clicking without motion does not quantize the weights} -setup {
        Create
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        set before [list [.tg track cget voltage -weight] [.tg track cget current -weight]]
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        expr {$before eq [list [.tg track cget voltage -weight] [.tg track cget current -weight]]}
    } -cleanup {destroy .tg} -result 1

    test trackgraph-drag-reordered-pair {moving the whole pair to another location cancels dragging} -setup {
        Create
        ThirdTrack
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        .tg track order {auxiliary voltage current}
        set before [list [.tg track cget voltage -weight] [.tg track cget current -weight]]
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        list [dict exists $::rbc::trackgraph::drag .tg] \
            [expr {$before eq [list [.tg track cget voltage -weight] [.tg track cget current -weight]]}]
    } -cleanup {destroy .tg} -result {0 1}

    test trackgraph-drag-cancel {Escape restores original weights and geometry} -setup {
        Create
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
        # Invoke the installed Escape binding without depending on WM focus.
        catch {eval [string map [list %W .tg] [bind Trackgraph <Escape>]]}
        update
        list [expr {$y == [.tg track sashpos voltage]}] [.tg track cget voltage -weight] \
            [.tg track cget current -weight] [dict exists $::rbc::trackgraph::drag .tg]
    } -cleanup {destroy .tg} -result {1 2.0 1.0 0}

    foreach change {{.tg track order {current voltage}} {.tg configure -trackresize no}} {
        test trackgraph-drag-invalidate-$change {structural changes or disabling cancel the active gesture safely} -setup {
            Create
            .tg configure -trackresize yes
        } -body {
            lassign [SeparatorPoint] x y
            set originalCursor [.tg cget -cursor]
            event generate .tg <ButtonPress-1> -x $x -y $y
            eval $change
            event generate .tg <B1-Motion> -x $x -y [expr {$y+30}]
            update
            list [dict exists $::rbc::trackgraph::drag .tg] [expr {$originalCursor eq [.tg cget -cursor]}]
        } -cleanup {destroy .tg} -result {0 1}
    }

    test trackgraph-drag-destroy {destroying a widget during drag clears per-widget state} -setup {
        Create
        .tg configure -trackresize yes
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        destroy .tg
        list [dict exists $::rbc::trackgraph::drag .tg] [dict exists $::rbc::trackgraph::cursors .tg]
    } -result {0 0}

    foreach format {svg postscript pdf} {
        test trackgraph-sash-export-$format {exports preserve reordered tracks and separator allocations} -setup {
            Create
            .tg track order {current voltage}
            .tg track sashpos current [expr {[.tg track sashpos current]+20}]
        } -body {
            set before [.tg track bbox current]
            set weights [list [.tg track cget current -weight] [.tg track cget voltage -weight]]
            .tg $format output -width 900 -height 700
            .tg $format configure -width 0 -height 0
            update
            list [.tg track order] [expr {$before eq [.tg track bbox current]}] \
                [expr {$weights eq [list [.tg track cget current -weight] [.tg track cget voltage -weight]]}]
        } -cleanup {destroy .tg} -result {{current voltage} 1 1}
    }

    proc FocusSetup {} {
        Create
        .tg configure -trackresize yes
        entry .trackFocus
        entry .trackOther
        pack .trackFocus .trackOther
        update
        focus -force .trackFocus
        update
    }

    foreach finish {release cancel invalidate} {
        test trackgraph-focus-$finish {drag temporarily borrows focus and restores it on completion} -setup {
            FocusSetup
        } -body {
            lassign [SeparatorPoint] x y
            event generate .tg <ButtonPress-1> -x $x -y $y
            update
            set during [expr {[focus] eq ".tg"}]
            switch $finish {
                release {event generate .tg <ButtonRelease-1> -x $x -y $y}
                cancel {event generate .tg <Escape>}
                invalidate {
                    .tg configure -trackresize no
                    event generate .tg <B1-Motion> -x $x -y [expr {$y+20}]
                }
            }
            update
            list $during [focus] [dict exists $::rbc::trackgraph::drag .tg]
        } -cleanup {destroy .tg .trackFocus .trackOther} -result {1 .trackFocus 0}
    }

    foreach initial {empty graph destroyed changed} {
        test trackgraph-focus-$initial {restoration respects empty, existing, destroyed and independently changed focus} -setup {
            FocusSetup
        } -body {
            switch $initial {
                graph {focus .tg}
            }
            update
            lassign [SeparatorPoint] x y
            event generate .tg <ButtonPress-1> -x $x -y $y
            update
            switch $initial {
                empty {dict set ::rbc::trackgraph::drag .tg focus {}}
                destroyed {destroy .trackFocus}
                changed {focus .trackOther; update}
            }
            event generate .tg <ButtonRelease-1> -x $x -y $y
            update
            set expected [dict get {empty . graph .tg destroyed . changed .trackOther} $initial]
            expr {[focus] eq $expected}
        } -cleanup {destroy .tg .trackFocus .trackOther} -result 1
    }

    test trackgraph-focus-repeated-press {a second press does not overwrite the original focus owner} -setup {
        FocusSetup
    } -body {
        lassign [SeparatorPoint] x y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        update
        focus
    } -cleanup {destroy .tg .trackFocus .trackOther} -result .trackFocus

    proc LocalLegendSetup {} {
        Create
        .tg element configure v -label VoltageLegend
        .tg element configure i -label CurrentLegend
        foreach track {voltage current} {
            .tg track legend $track configure -hide no -position right -anchor ne -background white
        }
        update
    }

    proc LocalLegendPoint {track element} {
        lassign [.tg track legend $track bbox] left top width height
        for {set y $top} {$y<$top+$height} {incr y 2} {
            for {set x $left} {$x<$left+$width} {incr x 2} {
                if {[.tg track legend $track get @$x,$y] eq $element} {return [list $x $y]}
            }
        }
        error "legend entry $element not found in $track"
    }

    test tracklegend-defaults {local legends are opt-in and do not reserve graph margins} -setup {
        Create
    } -body {
        set bounds [.tg track bbox voltage]
        set defaults [list [.tg track legend voltage cget -hide] [.tg track legend voltage cget -position]\
                          [.tg track legend voltage cget -raised] [.tg track legend voltage bbox]]
        .tg track legend voltage configure -hide no
        update
        list $defaults [expr {$bounds eq [.tg track bbox voltage]}] [.tg legend cget -hide]
    } -cleanup {destroy .tg} -result {{1 plotarea 1 {}} 1 1}

    test tracklegend-filter {local get and activation are scoped; global activation shares element state} -setup {
        LocalLegendSetup
    } -body {
        lassign [LocalLegendPoint voltage v] x y
        set result [list [.tg track legend voltage get @$x,$y] [.tg track legend current get @$x,$y]]
        lappend result [.tg track legend voltage activate *] [.tg track legend current activate]
        lappend result [lsort [.tg legend activate]]
        .tg legend deactivate v
        lappend result [.tg track legend voltage activate]
        set result
    } -cleanup {destroy .tg} -result {v {} v {} v {}}

    foreach position {plotarea left right top bottom} {
        test tracklegend-position-$position {position and anchor use the track rectangle} -setup {
            LocalLegendSetup
        } -body {
            .tg track legend current configure -position $position -anchor se
            lassign [.tg track bbox current] left top right bottom
            lassign [.tg track legend current bbox] x y w h
            expr {$w>0 && $h>0 && $x >= $left && $y >= $top && $x+$w <= $right+1 && $y+$h <= $bottom+1}
        } -cleanup {destroy .tg} -result 1
    }

    foreach position {rightmargin .external @10,10 nonsense} {
        test tracklegend-invalid-$position {invalid local positions roll back all changed options} -setup {
            LocalLegendSetup
        } -body {
            set before [.tg track legend voltage configure]
            list [catch {.tg track legend voltage configure -foreground red -position $position}]\
                [expr {$before eq [.tg track legend voltage configure]}] [winfo exists .external]
        } -cleanup {destroy .tg} -result {1 1 0}
    }

    test tracklegend-order {reordering and resizing move legend geometry without replacing bindings} -setup {
        LocalLegendSetup
    } -body {
        .tg track legend voltage bind v <Enter> {set ::localEntered yes}
        set before [.tg track legend voltage bbox]
        .tg track order {current voltage}
        update
        set reordered [.tg track legend voltage bbox]
        .tg track sashpos current [expr {[.tg track sashpos current]+15}]
        update
        list [expr {[lindex $reordered 1]>[lindex $before 1]}]\
            [expr {$reordered ne [.tg track legend voltage bbox]}]\
            [.tg track legend voltage bind v <Enter>]
    } -cleanup {destroy .tg} -result {1 1 {set ::localEntered yes}}

    test tracklegend-bindings {bindings and current entries are scoped independently to each legend} -setup {
        LocalLegendSetup
        set ::localHits {}
        .tg legend bind all <ButtonPress-1> {lappend ::localHits global}
        foreach track {voltage current} {
            .tg track legend $track bind all <ButtonPress-1> [list apply [list {track} {
                lappend ::localHits $track [.tg track legend $track get current]
            }] $track]
        }
    } -body {
        foreach track {voltage current} element {v i} {
            lassign [LocalLegendPoint $track $element] x y
            event generate .tg <Motion> -x $x -y $y
            event generate .tg <ButtonPress-1> -x $x -y $y
            event generate .tg <ButtonRelease-1> -x $x -y $y
            update
        }
        set ::localHits
    } -cleanup {destroy .tg; unset ::localHits} -result {voltage v current i}

    test tracklegend-external {global external legend does not steal local event routing} -setup {
        LocalLegendSetup
        .tg legend configure -hide no -position .outsideLegend
        pack .outsideLegend
        set ::localHits {}
        .tg track legend voltage bind all <ButtonPress-1> {lappend ::localHits local}
        update
    } -body {
        lassign [LocalLegendPoint voltage v] x y
        event generate .tg <Motion> -x $x -y $y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        update
        list $::localHits [winfo exists .outsideLegend] [.tg legend cget -position]
    } -cleanup {destroy .tg; catch {destroy .outsideLegend}; unset ::localHits} -result {local 1 .outsideLegend}

    test tracklegend-delete-binding {deleting the picked element and track inside a binding is safe} -setup {
        LocalLegendSetup
        .tg track legend voltage bind all <ButtonPress-1> {
            .tg element delete v
            .tg track delete voltage
        }
    } -body {
        lassign [LocalLegendPoint voltage v] x y
        event generate .tg <Motion> -x $x -y $y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        update
        .tg track create voltage -yaxes volts
        list [.tg track legend voltage cget -hide] [catch {.tg track legend voltage bind all <ButtonPress-1>}]
    } -cleanup {destroy .tg} -result {1 1}

    test tracklegend-destroy-binding {destroying the graph inside a local binding is safe} -setup {
        LocalLegendSetup
        .tg track legend voltage bind all <ButtonPress-1> {destroy .tg}
    } -body {
        lassign [LocalLegendPoint voltage v] x y
        event generate .tg <Motion> -x $x -y $y
        event generate .tg <ButtonPress-1> -x $x -y $y
        update
        winfo exists .tg
    } -cleanup {catch {destroy .tg}} -result 0

    test tracklegend-lifecycle {moving elements, hiding plots and deleting entries update local membership} -setup {
        LocalLegendSetup
    } -body {
        .tg element configure v -track current -mapy amps -hideplot yes
        update
        set old [.tg track legend voltage bbox]
        lassign [LocalLegendPoint current v] x y
        set hidden [.tg track legend current get @$x,$y]
        .tg element configure v -label {}
        .tg element delete i
        update
        list $old $hidden [.tg track legend current bbox]
    } -cleanup {destroy .tg} -result {{} v {}}

    foreach renderer {native cairo} {
        test tracklegend-clipping-$renderer {oversized legend drawing and picking are clipped to the owning track}\
                -constraints trackRenderer$renderer -setup {
            LocalLegendSetup
            .tg configure -renderer $renderer
            .tg track legend current configure -hide yes
            .tg track legend voltage configure -background #00ff00 -foreground black -anchor sw
            .tg element configure v -label [string repeat "very wide legend\n" 35]
            set photo [image create photo]
        } -body {
            update
            .tg snap $photo
            lassign [.tg track bbox voltage] left top right bottom
            set count 0
            set outside 0
            for {set y 0} {$y<[image height $photo]} {incr y} {
                for {set x 0} {$x<[image width $photo]} {incr x} {
                    lassign [$photo get $x $y] red green blue
                    if {$green>240 && $red<15 && $blue<15} {
                        incr count
                        if {$x<$left || $x>$right || $y<$top || $y>$bottom} {incr outside}
                    }
                }
            }
            list [expr {$count>0}] $outside [.tg track legend voltage get @$left,[expr {$bottom+3}]]
        } -cleanup {image delete $photo; destroy .tg} -result {1 0 {}}
    }

    foreach format {svg pdf postscript} {
        test tracklegend-export-$format {export remaps local legends and restores screen geometry} -setup {
            LocalLegendSetup
        } -body {
            set before [.tg track legend current bbox]
            set original [.tg $format output]
            set resized [.tg $format output -width 900 -height 700]
            .tg $format configure -width 0 -height 0
            update
            set restored [.tg $format output]
            list [expr {$original ne $resized}] [expr {$original eq $restored}]\
                [expr {$before eq [.tg track legend current bbox]}]
        } -cleanup {destroy .tg} -result {1 1 1}
    }

    test tracklegend-svg {local legend labels use export clipping and hide independently} -setup {
        LocalLegendSetup
    } -body {
        set both [.tg svg output]
        .tg track legend voltage configure -hide yes
        set one [.tg svg output]
        list [expr {[string first VoltageLegend $both]>=0 && [string first CurrentLegend $both]>=0}]\
            [expr {[string first VoltageLegend $one]<0 && [string first CurrentLegend $one]>=0}]\
            [expr {[string first {clip-path=} $both]>=0}]
    } -cleanup {destroy .tg} -result {1 1 1}

    test tracklegend-overlap {global/local legend overlap routes each click to only the top legend} -setup {
        LocalLegendSetup
        .tg legend configure -hide no -position plotarea -anchor ne -raised yes
        set ::localHits {}
        .tg legend bind all <ButtonPress-1> {lappend ::localHits global}
        .tg track legend voltage bind all <ButtonPress-1> {lappend ::localHits local}
        update
    } -body {
        lassign [LocalLegendPoint voltage v] x y
        foreach raised {yes no} {
            .tg legend configure -raised $raised
            update
            event generate .tg <Motion> -x $x -y $y
            event generate .tg <ButtonPress-1> -x $x -y $y
            event generate .tg <ButtonRelease-1> -x $x -y $y
            update
        }
        set ::localHits
    } -cleanup {destroy .tg; unset ::localHits} -result {global local}

    test tracklegend-underlying-bindings {local legend clicks do not also select underlying plotted elements} -setup {
        LocalLegendSetup
        lassign [LocalLegendPoint voltage v] x y
        .tg element configure v -data [list [.tg axis invtransform x $x] [.tg axis invtransform volts $y]]
        set ::localHits {}
        .tg element bind v <ButtonPress-1> {lappend ::localHits element}
        .tg track legend voltage bind all <ButtonPress-1> {lappend ::localHits legend}
        update
    } -body {
        event generate .tg <Motion> -x $x -y $y
        event generate .tg <ButtonPress-1> -x $x -y $y
        event generate .tg <ButtonRelease-1> -x $x -y $y
        update
        set ::localHits
    } -cleanup {destroy .tg; unset ::localHits} -result legend

    test tracklegend-optiondb {local legend defaults use their own option-database component} -setup {
        option add *trackLegend.foreground purple widgetDefault
        option add *trackLegend.anchor sw widgetDefault
        Create
    } -body {
        list [.tg track legend voltage cget -foreground] [.tg track legend current cget -anchor]\
            [.tg track legend voltage cget -hide] [.tg legend cget -anchor]
    } -cleanup {destroy .tg; option clear} -result {purple sw 1 n}

}
::tcltest::cleanupTests
