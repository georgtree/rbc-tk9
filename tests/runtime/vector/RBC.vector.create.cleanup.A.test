# Vector creation cleanup. Use vectorLifecycleMemory.tcl under Valgrind to
# check memory growth; these tests check results and error-path cleanup.
###Package Definition
package provide vector.create.cleanup

package require rbc
namespace import rbc::*

package require tcltest 2
namespace import tcltest::*

namespace eval vector.create.cleanup {
    test RBC.vector.create.cleanup.A.1.1 {repeated creation preserves results and removes commands} -body {
        set valid 1
        for {set i 0} {$i < 100} {incr i} {
            set name [::rbc::vector create ::vector.create.cleanup::v]
            v set {1 2 3}
            if {$name ne "::vector.create.cleanup::v" ||
                [::rbc::vector expr {v + v}] ne {2.0 4.0 6.0}} {
                set valid 0
            }
            ::rbc::vector destroy ::vector.create.cleanup::v
        }
        list $valid [::rbc::vector names ::vector.create.cleanup::v] \
            [info commands ::vector.create.cleanup::v]
    } -cleanup {
        catch {::rbc::vector destroy ::vector.create.cleanup::v}
    } -result {1 {} {}}

    test RBC.vector.create.cleanup.A.2.1 {unknown command namespace removes newly created vector} -body {
        set failed [catch {
            ::rbc::vector create ::vector.create.cleanup::v \
                -command ::vector.create.cleanup::missing::command
        } message]
        list $failed [string match {unknown namespace*} $message] \
            [::rbc::vector names ::vector.create.cleanup::v] \
            [info commands ::vector.create.cleanup::v]
    } -cleanup {
        catch {::rbc::vector destroy ::vector.create.cleanup::v}
    } -result {1 1 {} {}}

    test RBC.vector.create.cleanup.A.3.1 {wrapper preserves helper errors and existing vectors} -setup {
        ::rbc::vector create ::vector.create.cleanup::v
        v set {1 2 3}
    } -body {
        set result {}
        foreach arguments {
            {::vector.create.cleanup::v -type complex}
            {::vector.create.cleanup::missing::v}
            {::vector.create.cleanup::bad?name}
            {::vector.create.cleanup::new(1bad)}
        } {
            lappend result [catch {::rbc::vector create {*}$arguments} message] \
                [expr {$message ne {}}]
        }
        lappend result [v range 0 end]
        set result
    } -cleanup {
        catch {::rbc::vector destroy ::vector.create.cleanup::v}
    } -result {1 1 1 1 1 1 1 1 {1.0 2.0 3.0}}

    test RBC.vector.create.cleanup.A.4.1 {long vector command and variable names survive buffer reuse} -setup {
        set stem ::vector.create.cleanup::[string repeat longName 50]
        set name ${stem}Vector
        set command ${stem}Command
        set variable ${stem}Variable
    } -body {
        set result [::rbc::vector create $name -command $command -variable $variable]
        $command set {7 8}
        set values [list [set ${variable}(0)] [set ${variable}(1)]]
        ::rbc::vector destroy $name
        list [expr {$result eq $name}] $values \
            [namespace which -command $command] [array exists $variable]
    } -cleanup {
        catch {::rbc::vector destroy $name}
        unset -nocomplain $variable
    } -result {1 {7.0 8.0} {} 0}

    cleanupTests
}
