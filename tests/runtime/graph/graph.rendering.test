# graph.rendering regression tests.
# See license.terms for details.
package provide graph.rendering
package require rbc
namespace import rbc::*
package require tcltest
namespace import tcltest::*

namespace eval graph.rendering {
    source [file join [file dirname [info script]] .. renderingSupport.tcl]
    namespace import ::rbcTest::rendering::StrokeFixture \
        ::rbcTest::rendering::CountPhotoColor \
        ::rbcTest::rendering::PlotInk \
        ::rbcTest::rendering::BitmapFixture \
        ::rbcTest::rendering::BitmapSymbolFixture
    ::rbcTest::rendering::CheckCairo
    array set testCase {23 0 24 0 25 0 36 0 42 0 57 0 74 0 75 0 77 0 79 0 81 0 82 0 83 0 85 0 86 0}
    test graph.rendering.1.1 {explicit native renderer and invalid-option rollback} -setup {
        ::rbc::graph .renderer -renderer native -title original
    } -body {
        set initial [.renderer cget -renderer]
        set code [catch {.renderer configure -title changed -renderer bogus}]
        list $initial $code [.renderer cget -renderer] [.renderer cget -title]
    } -cleanup {
        destroy .renderer
    } -result {native 1 native original}
    test graph.rendering.1.2 {unavailable Cairo restores other options} -constraints rbcNoCairo -setup {
        ::rbc::graph .renderer -title original
    } -body {
        set code [catch {.renderer configure -title changed -renderer cairo} message]
        list $code $message [.renderer cget -renderer] [.renderer cget -title]
    } -cleanup {
        destroy .renderer
    } -result {1 {Cairo renderer is not available in this build} native original}
    test graph.rendering.1.3 {failed derived configuration restores renderer} -constraints rbcCairo -setup {
        ::rbc::graph .renderer -renderer native -title original
    } -body {
        set code [catch {.renderer configure -renderer cairo -title changed -aspect Inf}]
        list $code [.renderer cget -renderer] [.renderer cget -title]
    } -cleanup {
        destroy .renderer
    } -result {1 native original}
    foreach kind {graph barchart stripchart polar} {
        test graph.rendering.23.[incr testCase(23)] {compiled renderer default follows Cairo availability} -setup {
            ::rbc::$kind .renderer
        } -body {
            # The descriptor exposes the compiled default even under the suite's option database.
            expr {[lindex [.renderer configure -renderer] 3] eq ([testConstraint rbcCairo] ? "cairo" : "native")}
        } -cleanup {
            destroy .renderer
        } -result 1
        test graph.rendering.24.[incr testCase(24)] {automated suite keeps native as its effective default}\
                -constraints rbcNativeSuiteDefault -setup {
            ::rbc::$kind .renderer
        } -body {
            .renderer cget -renderer
        } -cleanup {
            destroy .renderer
        } -result native
        test graph.rendering.25.[incr testCase(25)] {explicit Cairo overrides the automated native default}\
                -constraints rbcCairo -setup {
            ::rbc::$kind .renderer -renderer cairo
        } -body {
            .renderer cget -renderer
        } -cleanup {
            destroy .renderer
        } -result cairo
    }
    test graph.rendering.3.1 {antialias modes and transactional validation} -setup {
        ::rbc::graph .renderer -title original
    } -body {
        set initial [.renderer cget -antialias]
        set modes {}
        foreach mode {default none gray fast good best} {
            .renderer configure -antialias $mode
            lappend modes [.renderer cget -antialias]
        }
        set invalid [catch {.renderer configure -title changed -antialias bogus}]
        set derived [catch {.renderer configure -antialias none -aspect Inf}]
        list $initial $modes $invalid $derived [.renderer cget -antialias] [.renderer cget -title]
    } -cleanup {
        destroy .renderer
    } -result {default {default none gray fast good best} 1 1 best original}
    foreach renderer {native cairo} {
        test graph.rendering.36.[incr testCase(36)] {tile edits invalidate the displayed element cache}\
                -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
            StrokeFixture graph
            .renderer configure -renderer $renderer -bufferelements yes
            set tile [image create photo -width 2 -height 2]
            $tile put red -to 0 0 2 2
            .renderer element configure signal -data {1 8 5 8 9 8} -linewidth 0 -areatile $tile
            set photo [image create photo]
            update
        } -body {
            set results {}
            # Capture the displayed window: graph snap would bypass its cache.
            ::rbc::winop snap .renderer $photo
            lappend results [$photo get 120 120]
            $tile put blue -to 0 0 2 2
            update
            ::rbc::winop snap .renderer $photo
            lappend results [$photo get 120 120]
            $tile configure -width 3 -height 2
            $tile put #00ff00 -to 0 0 3 2
            update
            ::rbc::winop snap .renderer $photo
            lappend results [$photo get 120 120]
            set results
        } -cleanup {
            destroy .renderer
            catch {image delete $photo $tile}
        } -result {{255 0 0} {0 0 255} {0 255 0}}
    }
    foreach renderer {native cairo} {
        test graph.rendering.42.[incr testCase(42)] {source resizing discards a stale scaled photo}\
                -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
            StrokeFixture graph
            .renderer element delete signal
            .renderer configure -renderer $renderer -plotpadx 0 -plotpady 0
            update
            set tile [image create photo -width 12 -height 8]
            $tile put red -to 0 0 12 8
            .renderer marker create image -name m -coords {2 2 8 8} -image $tile
            lassign [.renderer extents plotarea] left top plotWidth plotHeight
            # The image mapper uses unrounded coordinates, unlike transform.
            set width [expr {int(0.6*($plotWidth-1))+1}]
            set height [expr {int(0.6*($plotHeight-1))+1}]
            set photo [image create photo]
        } -body {
            .renderer snap $photo
            set results [list [expr {[CountPhotoColor $photo {255 0 0}] > 96}]]
            # Match the mapped size without reconfiguring the marker.
            $tile configure -width $width -height $height
            $tile put blue -to 0 0 $width $height
            .renderer snap $photo
            lappend results [expr {[CountPhotoColor $photo {0 0 255}] == $width*$height}]\
                    [expr {[CountPhotoColor $photo {255 0 0}] == 0}]
            $tile configure -width 12 -height 8
            $tile put red -to 0 0 12 8
            .renderer snap $photo
            lappend results [expr {[CountPhotoColor $photo {255 0 0}] > 96}]
            set results
        } -cleanup {
            destroy .renderer
            catch {image delete $photo $tile}
        } -result {1 1 1 1}
    }
    foreach backend {native cairo} {
        foreach shape {circle bitmap} {
            test graph.rendering.57.[incr testCase(57)] {explicit active points survive repeated snapshot remapping}\
                    -constraints [expr {$backend eq "cairo" ? "rbcCairo" : {}}] -setup {
                lassign [BitmapSymbolFixture graph] bitmap mask
                .renderer configure -renderer $backend
                set symbol [expr {$shape eq "bitmap" ? "@$bitmap" : "circle"}]
                .renderer pen create selected -type line -linewidth 0 -symbol $symbol -pixels 17 -outline red -fill red
                .renderer element configure signal -activepen selected
                .renderer element activate signal 1
                set photo [image create photo]
            } -body {
                set results {}
                for {set i 0} {$i < 3} {incr i} {
                    .renderer snap $photo
                    lappend results [expr {[CountPhotoColor $photo {255 0 0}] > 0}]
                }
                set results
            } -cleanup {
                destroy .renderer
                catch {image delete $photo}
                removeFile $bitmap
                removeFile $mask
            } -result {1 1 1}
        }
    }
    foreach renderer {native cairo} {
        foreach angle {0 45 90} {
            test graph.rendering.74.[incr testCase(74)]\
                    {cached multiline marker text survives style changes and remapping}\
                    -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
                ::rbc::graph .renderer -renderer $renderer -width 320 -height 240 -plotbackground white
                pack .renderer
                .renderer legend configure -hide yes
                foreach axis {x y} {.renderer axis configure $axis -min 0 -max 10 -hide yes}
                .renderer marker create text -name label -coords {5 5} -text "Voltage \u03a9\nSecond line"\
                        -foreground red -background {} -rotate $angle -font TkDefaultFont -anchor center
                set photo [image create photo]
                update
            } -body {
                .renderer snap $photo
                set original [$photo data]
                set redPixels 0
                for {set y 0} {$y<[image height $photo]} {incr y} {
                    for {set x 0} {$x<[image width $photo]} {incr x} {
                        lassign [$photo get $x $y] r g b
                        if {$r>150 && $g<100 && $b<100} {incr redPixels}
                    }
                }
                .renderer marker configure label -foreground blue -text Changed -rotate 15
                .renderer snap $photo
                set changed [expr {$original ne [$photo data]}]
                .renderer marker configure label -foreground red -text "Voltage \u03a9\nSecond line" -rotate $angle
                .renderer axis configure x -max 20
                .renderer snap $photo
                .renderer axis configure x -max 10
                .renderer snap $photo
                list [expr {$redPixels>0}] $changed [expr {$original eq [$photo data]}]
            } -cleanup {destroy .renderer; image delete $photo} -result {1 1 1}
        }
    }
    foreach renderer {native cairo} {
        foreach inverted {0 1} {
            test graph.rendering.75.[incr testCase(75)] {axis text and global legend redraw after text style changes} \
                    -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
                ::rbc::graph .renderer -renderer $renderer -invertxy $inverted -width 420 -height 320 \
                        -title "Title\nSecond line" -buffergraph no -bufferelements no
                pack .renderer
                foreach axis {x y} {
                    .renderer axis configure $axis -min 0 -max 10 -rotate 45 -title "Axis $axis" \
                            -limitsformat {%.1f}
                }
                .renderer element create a -data {2 3 8 7} -label "Signal\nVoltage" -showvalues y
                .renderer legend configure -position plotarea -anchor ne -foreground red
                set photo [image create photo]
                update
            } -body {
                .renderer snap $photo
                set original [$photo data]
                .renderer legend configure -foreground blue
                .renderer axis configure x -rotate 90
                .renderer configure -title Changed
                .renderer snap $photo
                set changed [expr {$original ne [$photo data]}]
                .renderer legend configure -foreground red
                .renderer axis configure x -rotate 45
                .renderer configure -title "Title\nSecond line"
                .renderer snap $photo
                list $changed [expr {$original eq [$photo data]}]
            } -cleanup {destroy .renderer; image delete $photo} -result {1 1}
        }
    }
    foreach renderer {native cairo} {
        test graph.rendering.77.[incr testCase(77)]\
                {external legend text uses its own window and restores active styling} \
                -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
            ::rbc::graph .renderer -renderer $renderer -width 320 -height 240
            pack .renderer
            .renderer element create a -data {2 3 8 7} -label "External\nLegend" -symbol none -linewidth 0
            .renderer legend configure -position .textLegend -background white -foreground red \
                    -activeforeground blue -activebackground white -borderwidth 0 -activeborderwidth 0
            pack .textLegend
            set photo [image create photo]
            update
        } -body {
            ::rbc::winop snap .textLegend $photo
            set redPixels 0
            for {set y 0} {$y<[image height $photo]} {incr y} {
                for {set x 0} {$x<[image width $photo]} {incr x} {
                    lassign [$photo get $x $y] r g b
                    if {$r>150 && $g<100 && $b<100} {incr redPixels}
                }
            }
            set original [$photo data]
            .renderer legend activate a
            update
            ::rbc::winop snap .textLegend $photo
            set changed [expr {$original ne [$photo data]}]
            .renderer legend deactivate a
            update
            ::rbc::winop snap .textLegend $photo
            list [expr {$redPixels>0}] $changed [expr {$original eq [$photo data]}]
        } -cleanup {
            destroy .renderer
            catch {destroy .textLegend}
            image delete $photo
        } -result {1 1 1}
    }
    foreach renderer {native cairo} {
        foreach relief {flat raised sunken ridge groove solid} {
            test graph.rendering.79.[incr testCase(79)]\
                    {widget and legend decorations restore after tiled backgrounds and focus changes} \
                    -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
                ::rbc::graph .renderer -renderer $renderer -width 360 -height 260 -background ivory \
                        -plotbackground white -borderwidth 4 -relief $relief -plotborderwidth 3 \
                        -plotrelief $relief -highlightthickness 3 -highlightcolor magenta -buffergraph no
                pack .renderer
                .renderer axis configure x -min 0 -max 10 -background lightblue -borderwidth 2 -relief $relief
                .renderer axis configure y -min 0 -max 10
                .renderer element create a -data {2 3 8 7} -symbol none -linewidth 0 -label Signal
                .renderer legend configure -position rightmargin -background lightyellow -borderwidth 3 \
                        -relief $relief -activebackground orange -activeborderwidth 2 -activerelief $relief
                .renderer legend activate a
                set tile [image create photo -width 8 -height 8]
                $tile put navy -to 0 0 8 8
                $tile put gold -to 0 0 4 4
                set photo [image create photo]
                update
                event generate .renderer <FocusOut>
                update
            } -body {
                .renderer snap $photo
                set original [$photo data]
                .renderer configure -tile $tile
                .renderer legend configure -background {}
                .renderer snap $photo
                set tiled [expr {$original ne [$photo data]}]
                .renderer configure -tile {}
                .renderer legend configure -background lightyellow
                .renderer snap $photo
                set restored [expr {$original eq [$photo data]}]
                event generate .renderer <FocusIn>
                update
                .renderer snap $photo
                set focused [expr {$original ne [$photo data]}]
                event generate .renderer <FocusOut>
                update
                .renderer snap $photo
                list $tiled $restored $focused [expr {$original eq [$photo data]}]
            } -cleanup {
                destroy .renderer
                catch {image delete $photo $tile}
            } -result {1 1 1 1}
        }
    }
    foreach renderer {native cairo} {
        foreach type {graph trackgraph} {
            foreach inverted {0 1} {
                foreach dashes {{} {4 2}} {
                    test graph.rendering.81.[incr testCase(81)]\
                            {native XOR crosshairs erase exactly after movement and redraw} \
                            -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
                        ::rbc::$type .renderer -renderer $renderer -invertxy $inverted -width 400 -height 300 \
                                -plotbackground white
                        pack .renderer
                        .renderer axis configure x -min 0 -max 10
                        .renderer axis configure y -min 0 -max 10
                        if {$type eq "trackgraph"} {.renderer track create first -yaxes y}
                        .renderer grid configure -hide no -color lightblue -dashes {3 2}
                        .renderer crosshairs configure -hide yes -color red -linewidth 2 -dashes $dashes
                        set background [.renderer cget -background]
                        set photo [image create photo]
                        update
                    } -body {
                        ::rbc::winop snap .renderer $photo
                        set original [$photo data]
                        if {$type eq "trackgraph"} {
                            lassign [.renderer track transform first 3 4] x y
                        } else {
                            lassign [.renderer transform 3 4] x y
                        }
                        set position @[expr {int($x)}],[expr {int($y)}]
                        .renderer crosshairs configure -position $position -hide no
                        ::rbc::winop snap .renderer $photo
                        set visible [expr {$original ne [$photo data]}]
                        .renderer crosshairs configure -position @[expr {int($x)+12}],[expr {int($y)+12}]
                        .renderer crosshairs configure -hide yes
                        ::rbc::winop snap .renderer $photo
                        set erased [expr {$original eq [$photo data]}]
                        # Also erase without movement, then retrace a round trip.
                        .renderer crosshairs configure -position $position -hide no
                        .renderer crosshairs configure -hide yes
                        ::rbc::winop snap .renderer $photo
                        set stationary [expr {$original eq [$photo data]}]
                        .renderer crosshairs configure -position $position -hide no
                        .renderer crosshairs configure -position @[expr {int($x)+12}],[expr {int($y)+12}]
                        .renderer crosshairs configure -position $position
                        .renderer crosshairs configure -hide yes
                        ::rbc::winop snap .renderer $photo
                        set roundtrip [expr {$original eq [$photo data]}]
                        .renderer crosshairs configure -position $position -hide no
                        .renderer configure -background ivory
                        update
                        .renderer crosshairs configure -hide yes
                        .renderer configure -background $background
                        update
                        # Compare against a full redraw with the original background.
                        .renderer snap $photo
                        set redrawn [$photo data]
                        ::rbc::winop snap .renderer $photo
                        list $visible $erased $stationary $roundtrip [expr {$redrawn eq [$photo data]}]
                    } -cleanup {
                        destroy .renderer
                        catch {image delete $photo}
                    } -result {1 1 1 1 1}
                }
            }
        }
    }
    foreach renderer {native cairo} {
        foreach type {graph trackgraph} {
            foreach inverted {0 1} {
                foreach buffers {{0 0} {0 1} {1 0} {1 1}} {
                    test graph.rendering.82.[incr testCase(82)]\
                            {screen copies restore cached plots and transparent legends after redraw and resize} \
                            -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
                        lassign $buffers bufferGraph bufferElements
                        ::rbc::$type .renderer -renderer $renderer -invertxy $inverted -width 400 -height 300 \
                                -buffergraph $bufferGraph -bufferelements $bufferElements -plotbackground white
                        pack .renderer
                        .renderer axis configure x -min 0 -max 10
                        .renderer axis configure y -min 0 -max 10
                        .renderer legend configure -position plotarea -anchor ne -background {}
                        set options {}
                        if {$type eq "trackgraph"} {
                            .renderer legend configure -hide yes
                            foreach track {first second} {
                                .renderer axis create $track -min 0 -max 10 -title $track
                                .renderer track create $track -yaxes $track
                                .renderer line create $track -track $track -mapy $track \
                                        -data {0 2 5 8 10 2} -color blue -symbol none -label $track
                                .renderer track legend $track configure -hide no -position right -background {}
                            }
                            set options {-track first -mapy first}
                        }
                        .renderer element create signal -data {0 8 5 2 10 8} -color red -symbol none \
                                -label Signal {*}$options
                        set photo [image create photo]
                        update
                    } -body {
                        ::rbc::winop snap .renderer $photo
                        set original [$photo data]
                        .renderer element configure signal -color green
                        update
                        ::rbc::winop snap .renderer $photo
                        set changed [expr {$original ne [$photo data]}]
                        .renderer element configure signal -color red
                        update
                        ::rbc::winop snap .renderer $photo
                        set restored [expr {$original eq [$photo data]}]
                        .renderer configure -width 480 -height 360
                        update
                        .renderer configure -width 400 -height 300
                        update
                        ::rbc::winop snap .renderer $photo
                        list $changed $restored [expr {$original eq [$photo data]}]
                    } -cleanup {
                        destroy .renderer
                        catch {image delete $photo}
                    } -result {1 1 1}
                }
            }
        }
    }
    foreach renderer {native cairo} {
        test graph.rendering.83.[incr testCase(83)]\
                {alternating export backends retain independent state and restore the screen} \
                -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
            StrokeFixture graph $renderer
            .renderer marker create arc -coords {2 2 8 8} -start 25 -extent 220 \
                    -style pieslice -fill lightblue -outline navy
            .renderer marker create text -coords {5 5} -text Backend -rotate 25 -foreground black
            set photo [image create photo]
            update
        } -body {
            .renderer snap $photo
            set before [$photo data]
            set outputs {}
            set valid 1
            foreach format {svg pdf postscript postscript pdf svg} {
                set output [.renderer $format output]
                # Only the wall-clock creation date may differ between PS documents.
                if {$format eq "postscript"} {
                    regsub -line {^%%CreationDate:.*$} $output {} output
                }
                if {[dict exists $outputs $format]} {
                    if {$output ne [dict get $outputs $format]} {set valid 0}
                } else {
                    dict set outputs $format $output
                }
            }
            .renderer snap $photo
            list $valid [expr {$before eq [$photo data]}]
        } -cleanup {
            destroy .renderer
            catch {image delete $photo}
        } -result {1 1}
    }
    foreach renderer {native cairo} {
        foreach kind {text bitmap mixed} {
            test graph.rendering.85.[incr testCase(85)]\
                    {marker runs match individually flushed drawing without changing painter order} \
                    -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
                lassign [BitmapFixture $renderer] bitmap mask
                .renderer marker delete m
                set separators {}
                for {set i 0} {$i < 12} {incr i} {
                    set x [expr {1.0 + ($i % 4) * 2.5}]
                    set y [expr {2.0 + ($i / 4) * 3.0}]
                    if {$kind ne "bitmap"} {
                        .renderer marker create text -name text$i -coords [list $x $y] \
                                -text "Run $i" -foreground red -background {} -rotate [expr {($i % 3) * 30}]
                        lappend separators [.renderer marker create polygon -coords {1 1 2 1 2 2} \
                                -fill {} -outline {} -hide yes]
                    }
                    if {$kind ne "text"} {
                        .renderer marker create bitmap -name bitmap$i -coords [list $x $y] \
                                -bitmap @$bitmap -foreground black -background blue -rotate 0
                        lappend separators [.renderer marker create polygon -coords {1 1 2 1 2 2} \
                                -fill {} -outline {} -hide yes]
                    }
                }
                set photo [image create photo]
                update
            } -body {
                .renderer snap $photo
                set before [$photo data]
                set visible [expr {[lindex [PlotInk $photo] 0] > 0}]
                # A visible, unpainted polygon ends the preceding Windows run.
                # Hidden separators are skipped, allowing adjacent markers to batch.
                foreach marker $separators {.renderer marker configure $marker -hide no}
                .renderer snap $photo
                set individual [expr {$before eq [$photo data]}]
                foreach marker $separators {.renderer marker configure $marker -hide yes}
                .renderer snap $photo
                list $visible $individual [expr {$before eq [$photo data]}]
            } -cleanup {
                destroy .renderer
                catch {image delete $photo}
                removeFile renderer-bitmap.xbm
                removeFile renderer-mask.xbm
            } -result {1 1 1}
        }
    }
    foreach renderer {native cairo} {
        test graph.rendering.86.[incr testCase(86)]\
                {rotated backgrounds, arrowheads and native legend samples restore after redraw} \
                -constraints [expr {$renderer eq "cairo" ? "rbcCairo" : {}}] -setup {
            StrokeFixture graph $renderer
            .renderer configure -width 400 -height 300 -buffergraph no -bufferelements no
            .renderer element configure signal -label Dashed -dashes {3 5} -linewidth 2 -color navy
            .renderer bar create bars -data {3 4 7 6} -label Stipple -foreground purple \
                    -background yellow -stipple gray50 -barwidth 0.8
            .renderer legend configure -hide no -position rightmargin
            .renderer marker create text -name label -coords {5 7} -text "Rotated\nbackground" \
                    -rotate 37 -foreground black -background lightblue
            .renderer marker create line -name arrow -coords {1 1 9 9} -arrow both -arrowshape {12 18 6} \
                    -linewidth 2 -dashes {4 3} -outline red
            set photo [image create photo]
            update
        } -body {
            .renderer snap $photo
            set before [$photo data]
            .renderer marker configure label -background orange
            .renderer marker configure arrow -outline blue
            .renderer snap $photo
            set changed [expr {$before ne [$photo data]}]
            .renderer marker configure label -background lightblue
            .renderer marker configure arrow -outline red
            .renderer snap $photo
            set restored [expr {$before eq [$photo data]}]
            .renderer legend configure -hide yes
            .renderer snap $photo
            .renderer legend configure -hide no
            .renderer snap $photo
            list $changed $restored [expr {$before eq [$photo data]}]
        } -cleanup {
            destroy .renderer
            catch {image delete $photo}
        } -result {1 1 1}
    }

    cleanupTests
}
