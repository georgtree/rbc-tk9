# Solid area opacity configuration. See license.terms for details.
###Package Definition
package provide graph.element.areaopacity

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval graph.element.areaopacity {
    # Numeric case IDs for loop-generated tests.
    array set testCase {1 0 2 0}
    foreach type {graph polar} {
        test graph.element.areaopacity.1.[incr testCase(1)] {default and accepted opacity values} -setup {
            ::rbc::$type .area
            .area element create signal
        } -body {
            set values [list [.area element cget signal -areaopacity]]
            foreach opacity {0 0.25 1} {
                .area element configure signal -areaopacity $opacity
                lappend values [.area element cget signal -areaopacity]
            }
            set values
        } -cleanup {
            destroy .area
        } -result {1.0 0.0 0.25 1.0}

        test graph.element.areaopacity.2.[incr testCase(2)] {invalid opacity restores the complete configuration} -setup {
            ::rbc::$type .area
            .area element create signal -areaopacity 0.5 -label original
        } -body {
            set failures {}
            foreach value {-0.1 1.1 Inf -Inf NaN invalid} {
                set code [catch {.area element configure signal -label changed -areaopacity $value}]
                if {!$code || [.area element cget signal -areaopacity] != 0.5 ||
                        [.area element cget signal -label] ne {original}} {
                    lappend failures $value
                }
            }
            set failures
        } -cleanup {
            destroy .area
        } -result {}
    }

    namespace eval batching {
    source [file join [file dirname [info script]] .. renderingSupport.tcl]
    namespace import ::rbcTest::rendering::OpacityFixture \
        ::rbcTest::rendering::OpacityPixel
    array set testCase {}
    test graph.element.areaopacity.22.2 {native solid fills ignore opacity} -setup {
        OpacityFixture graph no native
        set photo [image create photo]
    } -body {
        set results {}
        foreach opacity {0 0.5 1} {
            .opacity element configure signal -areaopacity $opacity
            .opacity snap $photo
            lappend results [OpacityPixel $photo 1 1 {255 0 0}]
        }
        set results
    } -cleanup {
        destroy .opacity
        image delete $photo
    } -result {1 1 1}
    }

    cleanupTests
}
