# RBC.graph.element.show.A.test --
#
###Abstract
# This file contains the automatic tests that test the element show 
# function of the graph BLT component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.element

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.element {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the element show command works correctly when given a single element
	# name.
	# ------------------------------------------------------------------------------------
	test RBC.graph.element.show.A.1.1 {
		element show: single element name
	} -setup {
		graph .graph1
		.graph1 element create Element1
		.graph1 element create Element2
	} -body {
		.graph1 element show Element1
		.graph1 element show
	} -cleanup {
		.graph1 element delete Element2
		.graph1 element delete Element1
		destroy .graph1
	} -result {Element1}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the element show command works correctly when given multiple element
	# names.
	# ------------------------------------------------------------------------------------
	test RBC.graph.element.show.A.2.1 {
		element show: multiple element names
	} -setup {
		graph .graph1
		.graph1 element create Element1
		.graph1 element create Element2
	} -body {
		.graph1 element show {Element1 Element2}
		.graph1 element show
	} -cleanup {
		.graph1 element delete Element2
		.graph1 element delete Element1
		destroy .graph1
	} -result {Element1 Element2}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure the element show command works correctly when given a non-existent 
	# element name.
	# ------------------------------------------------------------------------------------
	test RBC.graph.element.show.A.3.1 {
		element show: non-existent element name
	} -setup {
		graph .graph1
	} -body {
		.graph1 element show invalid
		.graph1 element show
	} -cleanup {
		destroy .graph1
	} -result {}

    # ------------------------------------------------------------------------------------
    # Purpose: Ensure -hideplot suppresses plotting without removing the element from the
    # display list. This keeps its legend entry available.
    # ------------------------------------------------------------------------------------
    test RBC.graph.element.show.A.4.1 {
        element show: hideplot keeps element in display list
    } -setup {
        graph .graph1
        .graph1 element create Element1
    } -body {
        .graph1 element configure Element1 -hideplot yes
        list [.graph1 element show] [.graph1 element cget Element1 -hideplot]
    } -cleanup {
        .graph1 element delete Element1
        destroy .graph1
    } -result {Element1 1}

    # ------------------------------------------------------------------------------------
    # Purpose: Ensure -hide and -hideplot remain independent.
    # ------------------------------------------------------------------------------------
    test RBC.graph.element.show.A.5.1 {
        element show: hide and hideplot are independent
    } -setup {
        graph .graph1
        .graph1 element create Element1 -hideplot yes
    } -body {
        set before [.graph1 element show]
        .graph1 element configure Element1 -hide yes
        set hidden [.graph1 element show]
        .graph1 element configure Element1 -hide no
        set restored [.graph1 element show]
        list $before $hidden $restored [.graph1 element cget Element1 -hideplot]
    } -cleanup {
        .graph1 element delete Element1
        destroy .graph1
    } -result {Element1 {} Element1 1}
	
    test RBC.graph.element.show.A.6.1 {
        element show: duplicates retain first occurrence and ignore unknown names
    } -setup {
        graph .w
        foreach name {a b c d} {
            .w element create $name -data {0 1 1 2}
        }
        pack .w
        update
    } -body {
        set order [.w element show {b a b missing c a c}]
        list $order [.w element show] [.w element cget d -hide]
    } -cleanup {
        destroy .w
    } -result {{b a c} {b a c} 1}

    test RBC.graph.element.show.A.7.1 {
        element show: deleting and recreating a duplicated name leaves no stale references
    } -setup {
        graph .w
        foreach name {a b c d} {
            .w element create $name -data {0 1 1 2}
        }
        pack .w
        update
    } -body {
        set order [.w element show {a b a c b a}]
        .w element delete a
        update
        set remaining [.w element show]
        .w element create a -data {0 4 1 5}
        update
        list $order $remaining [.w element show] [.w element exists a]
    } -cleanup {
        destroy .w
    } -result {{a b c} {b c} {a b c} 1}

    test RBC.graph.element.show.A.8.1 {
        element show: hide and unhide after duplicate input retains unique membership
    } -setup {
        graph .w
        foreach name {a b c d} {
            .w element create $name -data {0 1 1 2}
        }
        pack .w
        update
    } -body {
        set order [.w element show {b a b c a}]
        .w element configure a -hide yes
        set hidden [.w element show]
        .w element configure a -hide no
        set restored [.w element show]
        list $order $hidden [llength $restored] [lsort $restored]
    } -cleanup {
        destroy .w
    } -result {{b a c} {b c} 3 {a b c}}

    test RBC.graph.element.show.A.9.1 {
        element show: malformed replacement preserves membership and visibility
    } -setup {
        graph .w
        foreach name {a b c d} {
            .w element create $name -data {0 1 1 2}
        }
        pack .w
        update
    } -body {
        set order [.w element show {b a b}]
        set failed [catch {.w element show "\{"}]
        list $failed $order [.w element show] [.w element cget c -hide]
    } -cleanup {
        destroy .w
    } -result {1 {b a} {b a} 1}

	cleanupTests
}
