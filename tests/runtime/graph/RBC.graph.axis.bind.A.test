# RBC.graph.axis.bind.A.test --
#
###Abstract
# This file tests the axis bind function of the graph BLT component.
# Axis bind is an instance function of graph.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Revision String
# SVN: $Id$

###Package Definition
package provide graph.axis

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval graph.axis {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings can be created for an axis element
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.axis.bind.A.1.1 {
		Test axis bind creation
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
		pack .graph1
	} -body {
		if {[catch {.graph1 axis bind Axis1 <Double-1> {puts test}}]} {
        return 1
    }
    return 0
	} -cleanup {
		destroy .graph1
	} -result {0}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings can be queried for a sequence and axis element
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.axis.bind.A.1.2 {
    	Test axis bind query
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
		pack .graph1
		.graph1 axis bind Axis1 <Double-1> {puts test}
	} -body {
		.graph1 axis bind Axis1 <Double-1>
	} -cleanup {
		destroy .graph1
	} -result {puts test}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings can be appended for a sequence and axis element
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.axis.bind.A.1.3 {
	    Test axis bind append
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
		pack .graph1
	    .graph1 axis bind Axis1 <Double-1> {puts test}    
	} -body {
	    .graph1 axis bind Axis1 <Double-1> {+puts test2}
	    .graph1 axis bind Axis1 <Double-1>    
	} -cleanup {
	    destroy .graph1
	} -result "puts test\nputs test2"
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bindings are overwritten for a sequence and axis element
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.axis.bind.A.1.4 {
	    Test axis bind overwrite
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
		pack .graph1
	    .graph1 axis bind Axis1 <Double-1> {puts test}    
	} -body {
	    .graph1 axis bind Axis1 <Double-1> {+puts test2}
	    .graph1 axis bind Axis1 <Double-1>    
	} -body {
	    .graph1 axis bind Axis1 <Double-1> {puts test2}    
	    .graph1 axis bind Axis1 <Double-1>    
	} -cleanup {
	    destroy .graph1
	} -result {puts test2}
	
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that bound sequences can be queried for just a legend element
	# ------------------------------------------------------------------------------------ 
	test RBC.graph.axis.bind.A.1.5 {
	    Test axis bind query
	} -setup {
		graph .graph1
		.graph1 axis create Axis1
		pack .graph1
		.graph1 axis bind Axis1 <Double-1> {puts test}
		.graph1 axis bind Axis1 <Key> {puts test2}   
	} -body {
	    .graph1 axis bind Axis1
	} -cleanup {
	    destroy .graph1
	} -result {<Key> <Double-Button-1>}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a real pointer event over an axis dispatches the binding associated
	# with that axis name.
	# ------------------------------------------------------------------------------------
    test RBC.graph.axis.bind.A.1.6 {
		Axis binding is delivered to picked axis
	} -setup {
        graph .graph1 -width 400 -height 300
        pack .graph1
        .graph1 axis configure x -title "X Axis" -linewidth 2
        update idletasks
        set ::axisBindingResult {}
        .graph1 axis bind x <Enter> {
			set ::axisBindingResult x
		}
        lassign [.graph1 extents plotarea] left top width height
        set right [expr {$left + $width - 1}]
        set bottom [expr {$top + $height - 1}]
    } -body {
        #
        # Start inside the plot so that no axis is current.
        #
        event generate .graph1 <Motion> -x [expr {$left + $width / 2}] -y [expr {$top + $height / 2}]
        update
        #
        # Search only the bottom margin.  This avoids depending on
        # font metrics, DPI, tick-label sizes, or exact axis offsets.
        #
        for {set y [expr {$bottom + 1}]} {$y < [winfo height .graph1]} {incr y} {
            for {set x $left} {$x <= $right} {incr x} {
                event generate .graph1 <Motion> -x $x -y $y
                update

                if {$::axisBindingResult eq "x"} {
                    break
                }
            }
            if {$::axisBindingResult eq "x"} {
                break
            }
        }
        set ::axisBindingResult
    } -cleanup {
        unset -nocomplain ::axisBindingResult
        destroy .graph1
    } -result {x}
	
	cleanupTests
}
