# trackgraph.element.decimate.test --
#
###Abstract
# Trackgraph element decimate tests, including interactions with owned tracks.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Package Definition
package provide trackgraph.element

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval trackgraph.element {
    source [file join [file dirname [info script]] trackgraph.support.tcl]

    # Number the generated cases independently within each test group.
    array set testCase {1 0}

    foreach inverted {0 1} {
        foreach kind {line strip} {
            test trackgraph.element.decimate.1.[incr testCase(1)] {dense track traces preserve extrema and original picking after remapping and vector updates} -setup {
                Create $inverted
                ::rbc::vector create trackDenseX trackDenseY
                set xs {}; set ys {}
                for {set i 0} {$i<10000} {incr i} {
                    lappend xs [expr {$i*0.001}]
                    lappend ys [expr {$i==5000 ? 0.9 : 0.0}]
                }
                trackDenseX set $xs
                trackDenseY set $ys
                .tg element delete v
                .tg $kind create v -track voltage -mapy volts -xdata trackDenseX -ydata trackDenseY \
                    -decimate auto -symbol none -linewidth 1 -color red
                set photo [image create photo]
                update
            } -body {
                set result {}
                foreach value {0.9 -0.9} {
                    trackDenseY index 5000 $value
                    .tg track configure voltage -weight 3
                    .tg axis configure x -min 4 -max 6
                    update
                    lassign [.tg track transform voltage 5 $value] x y
                    set found [.tg element closest $x $y hit -halo 3 -interpolate no v]
                    lappend result [expr {$found && $hit(index)==5000 && abs($hit(y)-$value)<1e-9}]
                    .tg snap $photo
                    set visible 0
                    for {set px [expr {int($x)-2}]} {$px<=int($x)+2} {incr px} {
                        for {set py [expr {int($y)-2}]} {$py<=int($y)+2} {incr py} {
                            lassign [$photo get $px $py] red green blue
                            # A one-pixel Cairo stroke between columns has partial coverage.
                            # Require red dominance rather than an almost solid red pixel.
                            if {$red>180 && $red-$green>80 && $red-$blue>80} {set visible 1}
                        }
                    }
                    lappend result $visible
                }
                .tg element configure v -decimate none
                set full [.tg svg output]
                .tg element configure v -decimate auto
                lappend result [expr {$full eq [.tg svg output]}]
                set result
            } -cleanup {image delete $photo; destroy .tg; ::rbc::vector destroy trackDenseX trackDenseY} -result {1 1 1 1 1}
        }
    }

    # Exact directional picking must not prune along an ignored screen coordinate.
    set testCase(2) 0
    foreach elementKind {line strip} {
        foreach inverted {0 1} {
            foreach descending {0 1} {
                foreach along {x y both} {
                    test trackgraph.element.decimate.2.[incr testCase(2)] {
                        directional point picking agrees with full geometry in either orientation
                    } -setup {
                        set xs {}
                        set ys {}
                        for {set i 0} {$i <= 10000} {incr i} {
                            lappend xs $i
                            lappend ys [expr {$i == 100 ? 0.8 : 0.0}]
                        }
                        Create $inverted
                        .tg element delete v i
                        .tg axis configure x -min 0 -max 10000 -descending $descending
                        .tg axis configure volts -descending $descending
                        .tg $elementKind create Element1 -track voltage -mapy volts -xdata $xs -ydata $ys \
                            -symbol none -linewidth 1 -smooth linear -reduce 0.0
                    } -body {
                        set result {}
                        set snapshots {}
                        foreach mode {none auto} {
                            .tg element configure Element1 -decimate $mode
                            update
                            lassign [.tg track transform voltage 100 0.8] px py
                            lassign [.tg track transform voltage 9000 -0.8] farX farY
                            if {$along eq "x"} {set py $farY}
                            if {$along eq "y"} {set px $farX}
                            unset -nocomplain hit
                            set found [.tg element closest $px $py hit \
                                -along $along -interpolate no -halo 3 Element1]
                            # Integer query pixels can select a neighbouring X sample.
                            # Only the ordinate-only and Euclidean searches must hit the spike.
                            set spike [expr {$along eq "both" ||
                                ($inverted && $along eq "x") || (!$inverted && $along eq "y")}]
                            lappend result $found [expr {$found && (!$spike || $hit(index) == 100) &&
                                $hit(x) == [lindex $xs $hit(index)] && $hit(y) == [lindex $ys $hit(index)]}]
                            if {$found} {
                                lappend snapshots [list $hit(index) $hit(x) $hit(y) $hit(dist)]
                            } else {
                                lappend snapshots {}
                            }
                        }
                        lappend result [expr {[lindex $snapshots 0] eq [lindex $snapshots 1]}]
                        set result
                    } -cleanup {
                        unset -nocomplain hit xs ys result snapshots
                        destroy .tg
                    } -result {1 1 1 1 1}
                }
            }
        }
    }

    cleanupTests
}
namespace delete ::trackgraph.element
