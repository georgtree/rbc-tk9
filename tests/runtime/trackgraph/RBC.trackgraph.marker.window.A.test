# RBC.trackgraph.marker.window.A.test --
#
###Abstract
# Trackgraph marker window tests, including interactions with owned tracks.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
###Package Definition
package provide trackgraph.marker

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*
namespace eval trackgraph.marker {
    source [file join [file dirname [info script]] RBC.trackgraph.support.tcl]

    # Number the generated cases independently within each test group.
    array set testCase {1 0 2 0 3 0}

    foreach inverted {0 1} {
        foreach renderer {native cairo} {
            foreach under {0 1} {
                test RBC.trackgraph.marker.window.A.1.[incr testCase(1)] {live windows follow track geometry and visibility without resizing to the track} \
                        -constraints trackRenderer$renderer -setup {
                    Create $inverted
                    .tg configure -renderer $renderer
                    button .tg.child -text Window
                    .tg marker create window -name w -window .tg.child -track voltage -mapy volts \
                        -coords {5 0} -anchor nw -width 80 -height 30 -under $under
                    update
                } -body {
                    set result {}
                    foreach order {{voltage current} {current voltage}} {
                        .tg track order $order
                        update
                        lassign [.tg track transform voltage 5 0] x y
                        lappend result [expr {[winfo ismapped .tg.child] &&
                            [winfo x .tg.child]==int($x) && [winfo y .tg.child]==int($y)}]
                    }
                    .tg track configure voltage -weight 4
                    .tg configure -width 700 -height 520
                    update
                    lassign [.tg track transform voltage 5 0] x y
                    lappend result [expr {[winfo x .tg.child]==int($x) && [winfo y .tg.child]==int($y)}]
                    foreach options {{-hide yes} {-hide no} {-coords {5 -100}} {-coords {5 0}} {-coords {}} {-coords {5 0}}} {
                        .tg marker configure w {*}$options
                        update
                        lappend result [winfo ismapped .tg.child]
                    }
                    # The child overlaps the track edge, but keeps its complete size.
                    .tg marker configure w -coords [list 5 [expr {$inverted ? 1 : -1}]]
                    update
                    lappend result [winfo ismapped .tg.child] [winfo width .tg.child] [winfo height .tg.child]
                    lassign [.tg track bbox voltage] l t r b
                    lappend result [expr {$inverted ? [winfo x .tg.child]+[winfo width .tg.child]>$r :
                        [winfo y .tg.child]+[winfo height .tg.child]>$b}]
                    .tg marker configure w -track current -mapy amps -coords {5 0}
                    update
                    lassign [.tg track transform current 5 0] x y
                    lappend result [expr {[winfo x .tg.child]==int($x) && [winfo y .tg.child]==int($y)}]
                    lappend result [catch {.tg track delete current}]
                    .tg marker delete w
                    lappend result [winfo exists .tg.child]
                    set result
                } -cleanup {destroy .tg} -result {1 1 1 0 1 0 1 0 1 1 80 30 1 1 1 0}
            }
        }
    }

    foreach inverted {0 1} {
        foreach format {svg pdf postscript} {
            test RBC.trackgraph.marker.window.A.2.[incr testCase(2)] {window export restores screen geometry and omits hidden children} -setup {
                Create $inverted
                frame .tg.child -width 40 -height 20 -background red
                .tg marker create window -name w -window .tg.child -track voltage -mapy volts -coords {5 0}
                update
            } -body {
                set before [winfo geometry .tg.child]
                set point [.tg track transform voltage 5 0]
                set first [.tg $format output]
                set enlarged [.tg $format output -width 900 -height 700]
                .tg $format configure -width 0 -height 0
                update
                set result [list [expr {$first ne $enlarged}] [expr {$before eq [winfo geometry .tg.child]}] \
                    [expr {$point eq [.tg track transform voltage 5 0]}] [winfo ismapped .tg.child]]
                .tg marker configure w -hide yes
                update
                set hidden [.tg $format output]
                if {$format eq "svg"} {
                    lappend result [expr {[string first {<image } $first]>=0 && [string first {<image } $hidden]<0}]
                } elseif {$format eq "pdf"} {
                    lappend result [expr {[string first {/Subtype /Image} $first]>=0 && [string first {/Subtype /Image} $hidden]<0}]
                } else {
                    lappend result [expr {$first ne $hidden}]
                }
                set result
            } -cleanup {destroy .tg} -result {1 1 1 1 1}
        }
    }

    foreach inverted {0 1} {
        test RBC.trackgraph.marker.window.A.3.[incr testCase(3)] {fully offscreen track windows unmap and return after scrolling back} -setup {
            ScrollSetup $inverted
            button .tg.child -text Window
            .tg marker create window -name window -track voltage -mapy volts -coords {5 0} -window .tg.child
            update
        } -body {
            set before [winfo ismapped .tg.child]
            .tg track view moveto 1
            update
            set hidden [expr {![winfo ismapped .tg.child]}]
            .tg track view moveto 0
            update
            list $before $hidden [winfo ismapped .tg.child]
        } -cleanup {destroy .tg} -result {1 1 1}
    }
    cleanupTests
}
namespace delete ::trackgraph.marker
