# Private PostScript helper checks; uses the existing resource harness.
# See license.terms for details.
package provide postscript.primitives
package require tcltest
namespace import tcltest::*
set psAvailable 0
if {[info exists ::env(RBC_RESOURCE_TEST_LIB)]} {
    package require Tk
    load $::env(RBC_RESOURCE_TEST_LIB) Rbcresourcetest
    set psAvailable 1
}
testConstraint psHarness $psAvailable
namespace eval postscript.primitives {
    foreach {case count} {1 -1 2 0 3 1} {
        test postscript.primitives.1.$case {fewer than two points leave output untouched} \
            -constraints psHarness -body {
                ::rbcpslinetest $count
            } -result "% sentinel\n"
    }
    test postscript.primitives.2.1 {two points retain one complete stroke} \
        -constraints psHarness -body {
            ::rbcpslinetest 2
        } -result "% sentinel\n newpath 0 1 moveto\n 1 2 lineto\nDashesProc stroke\n"
    test postscript.primitives.2.2 {three points retain the intermediate vertex} \
        -constraints psHarness -body {
            ::rbcpslinetest 3
        } -result "% sentinel\n newpath 0 1 moveto\n 1 2 lineto\n 2 3 lineto\nDashesProc stroke\n"
    test postscript.primitives.3.1 {path batching restarts at the shared endpoint} \
        -constraints psHarness -body {
            set ps [::rbcpslinetest 1502]
            list [regexp -all {DashesProc stroke} $ps] \
                [regexp -all {lineto} $ps] \
                [regexp { 1500 1501 lineto\nDashesProc stroke\n newpath  1500 1501 moveto\n 1501 1502 lineto\nDashesProc stroke\n$} $ps]
        } -result {2 1501 1}
    test postscript.primitives.4.1 {RGB row size is not narrowed to signed int} \
        -constraints psHarness -body {
            regexp {/tmpStr 3221225472 string def} [::rbcpsrastertest wide]
        } -result 1
    test postscript.primitives.4.2 {ordinary RGB size and samples retain their encoding} \
        -constraints psHarness -body {
            set ps [::rbcpsrastertest rgb]
            list [regexp {/tmpStr 6 string def} $ps] \
                [regexp {false 3 colorimage\n  FF0000FFFFFF\n} $ps]
        } -result {1 1}
    test postscript.primitives.4.3 {greyscale row uses one byte per sample} \
        -constraints psHarness -body {
            set ps [::rbcpsrastertest grey]
            list [regexp {/tmpStr 2 string def} $ps] \
                [regexp {image\n  C900\n} $ps]
        } -result {1 1}
    test postscript.primitives.5.1 {failed X11 capture leaves token output untouched} \
        -constraints {psHarness unix} -body {
            ::rbcpsrastertest failure
        } -result "% sentinel\n"
    test postscript.primitives.5.2 {bitmap rows retain bit order and partial-byte padding} \
        -constraints psHarness -body {
            ::rbcpsrastertest bitmap
        } -result "% sentinel\n\t<80804000>\n"
    set case 0
    foreach {negative positive} {-90 270 -180 180 -270 90 -450 270 -459 261} {
        foreach anchor {nw n ne w center e sw s se} {
            test postscript.primitives.6.[incr case] {equivalent rotations retain the same anchored box} \
                -constraints psHarness -body {
                    set first [lindex [split [::rbcpstexttest $negative $anchor] \n] 0]
                    set second [lindex [split [::rbcpstexttest $positive $anchor] \n] 0]
                    list [expr {[lrange $first 0 1] eq [lrange $second 0 1]}] \
                        [expr {[lrange $first 3 4] eq [lrange $second 3 4]}] \
                        [expr {[lindex $first 2] == $negative && [lindex $second 2] == $positive}]
                } -result {1 1 1}
        }
    }
    foreach {case offset expected} {1 2147483647 4294967294 2 -2147483648 -4294967296 3 12 24} {
        test postscript.primitives.7.$case {fragment offset addition preserves the full coordinate} \
            -constraints psHarness -body {
                ::rbcpstexttest $offset
            } -result "(A) 7 $expected $expected DrawAdjText\n"
    }
    ::tcltest::cleanupTests
}
if {$psAvailable} {destroy .}
