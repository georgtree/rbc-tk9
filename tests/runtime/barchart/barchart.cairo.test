# barchart.cairo regression tests.
# See license.terms for details.
package provide barchart.cairo
package require rbc
namespace import rbc::*
package require tcltest
namespace import tcltest::*

namespace eval barchart.cairo {
    source [file join [file dirname [info script]] .. renderingSupport.tcl]
    namespace import ::rbcTest::rendering::PartialGrayPixels \
        ::rbcTest::rendering::CountPhotoColor \
        ::rbcTest::rendering::PlotInk \
        ::rbcTest::rendering::BarFixture \
        ::rbcTest::rendering::LegendPixels \
        ::rbcTest::rendering::ShowSampleLegend
    ::rbcTest::rendering::CheckCairo
    array set testCase {44 0 45 0 46 0 47 0 49 0}
    foreach mode {normal aligned overlap stacked} {
        foreach invert {no yes} {
            test barchart.cairo.44.[incr testCase(44)] {bar layouts and integer fill pixels match native}\
                    -constraints rbcCairo -setup {
                BarFixture
                .renderer configure -barmode $mode -invertxy $invert
                .renderer element create other -data {2 3 5 -3 8 2} -foreground blue -background {} -borderwidth 0\
                        -relief flat -showerrorbars none
                set photo [image create photo]
            } -body {
                .renderer configure -renderer native
                .renderer snap $photo
                set native [$photo data]
                set results {}
                foreach aa {none gray} {
                    .renderer configure -renderer cairo -antialias $aa
                    .renderer snap $photo
                    lappend results [expr {$native eq [$photo data]}] [expr {[lindex [PlotInk $photo] 0] > 0}]
                }
                set results
            } -cleanup {
                destroy .renderer
                catch {image delete $photo}
            } -result {1 1 1 1}
        }
    }
    foreach colors {{black {}} {black red} {{} blue}} {
        foreach pattern {gray25 gray50 warning} {
            test barchart.cairo.45.[incr testCase(45)]\
                    {bar stipple colors and origin match native after remapping} -constraints rbcCairo -setup {
                BarFixture
                .renderer element configure signal -foreground [lindex $colors 0] -background [lindex $colors 1]\
                        -stipple $pattern
                set photo [image create photo]
            } -body {
                set results {}
                foreach limits {{0 10} {-1 11}} {
                    .renderer axis configure x -min [lindex $limits 0] -max [lindex $limits 1]
                    .renderer configure -renderer native
                    .renderer snap $photo
                    set native [$photo data]
                    .renderer configure -renderer cairo
                    .renderer snap $photo
                    lappend results [expr {$native eq [$photo data]}] [expr {[lindex [PlotInk $photo] 0] > 0}]
                }
                set results
            } -cleanup {
                destroy .renderer
                catch {image delete $photo}
            } -result {1 1 1 1}
        }
    }
    foreach relief {flat raised sunken ridge groove solid} {
        test barchart.cairo.46.[incr testCase(46)] {bar relief borders and value labels retain native rendering}\
                -constraints rbcCairo -setup {
            BarFixture
            .renderer element configure signal -foreground blue -background navy -borderwidth 2 -relief $relief\
            -showvalues y
            set photo [image create photo]
        } -body {
            .renderer configure -renderer native
            .renderer snap $photo
            set native [$photo data]
            .renderer configure -renderer cairo
            .renderer snap $photo
            list [expr {$native eq [$photo data]}] [expr {[lindex [PlotInk $photo] 0] > 0}]
        } -cleanup {
            destroy .renderer
            catch {image delete $photo}
        } -result {1 1}
    }
    test barchart.cairo.10.4 {active bar selections and pens use the same fill path} -constraints rbcCairo\
            -setup {
        BarFixture
        .renderer pen configure activeBar -foreground red -background {} -borderwidth 0 -relief flat
        set photo [image create photo]
    } -body {
        set results {}
        foreach selection {{1} {}} {
            .renderer element deactivate signal
            .renderer element activate signal {*}$selection
            .renderer configure -renderer native
            .renderer snap $photo
            set native [$photo data]
            .renderer configure -renderer cairo
            .renderer snap $photo
            lappend results [expr {$native eq [$photo data]}] [expr {[CountPhotoColor $photo {255 0 0}] > 0}]
        }
        .renderer element deactivate signal
        .renderer snap $photo
        lappend results [expr {[CountPhotoColor $photo {255 0 0}] == 0}]
        set results
    } -cleanup {
        destroy .renderer
        catch {image delete $photo}
    } -result {1 1 1 1 1}
    test barchart.cairo.10.5 {bar error strokes honor Cairo antialiasing, hairlines and visibility}\
            -constraints rbcCairo -setup {
        BarFixture
        .renderer element configure signal -foreground {} -background {} -data {5.13 4.17} -xerror 1 -yerror 2\
                -errorbarcolor black -errorbarwidth 0 -errorbarcap 10 -showerrorbars both
        set photo [image create photo]
    } -body {
        set results {}
        foreach aa {none gray none} {
            .renderer configure -antialias $aa
            .renderer snap $photo
            lappend results [expr {[lindex [PlotInk $photo] 0] > 0}] [expr {[PartialGrayPixels $photo] > 0}]
        }
        .renderer element configure signal -showerrorbars none
        .renderer snap $photo
        lappend results [expr {[PlotInk $photo] eq {0 0}}]
        set results
    } -cleanup {
        destroy .renderer
        catch {image delete $photo}
    } -result {1 0 1 1 1 0 1}
    foreach invert {no yes} {
        test barchart.cairo.47.[incr testCase(47)] {wide and negative bars clip to the plot} -constraints rbcCairo\
                -setup {
            BarFixture
            .renderer configure -invertxy $invert
            .renderer element configure signal -data {0 30 5 -30 10 30} -barwidth 4
            set photo [image create photo]
        } -body {
            .renderer snap $photo
            lassign [PlotInk $photo] inside outside
            list [expr {$inside > 0}] $outside
        } -cleanup {
            destroy .renderer
            catch {image delete $photo}
        } -result {1 0}
    }
    test barchart.cairo.10.7 {weighted bar pens preserve their separate fills} -constraints rbcCairo -setup {
        BarFixture
        .renderer pen create low -type bar -foreground red -background {} -relief flat -borderwidth 0
        .renderer pen create high -type bar -foreground blue -background {} -relief flat -borderwidth 0
        .renderer element configure signal -weights {0.5 1.5 3} -styles {{low 0 1} {high 1 2}}
        set photo [image create photo]
    } -body {
        .renderer configure -renderer native
        .renderer snap $photo
        set native [$photo data]
        .renderer configure -renderer cairo
        .renderer snap $photo
        list [expr {$native eq [$photo data]}] [expr {[CountPhotoColor $photo {255 0 0}] > 0}]\
                [expr {[CountPhotoColor $photo {0 0 255}] > 0}] [expr {[CountPhotoColor $photo {0 0 0}] > 0}]
    } -cleanup {
        destroy .renderer
        catch {image delete $photo}
    } -result {1 1 1 1}
    foreach pattern {{} gray25 gray50 warning} {
        foreach background {{} red} {
            test barchart.cairo.49.[incr testCase(49)] {bar legend stipples restart at the swatch origin}\
                    -constraints rbcCairo -setup {
                BarFixture
                .renderer element configure signal -stipple $pattern -foreground black -background $background
                ShowSampleLegend
                set photo [image create photo]
            } -body {
                set results {}
                foreach position {rightmargin @40,30} {
                    .renderer legend configure -position $position
                    .renderer configure -renderer native
                    .renderer snap $photo
                    set native [$photo data]
                    .renderer configure -renderer cairo
                    .renderer snap $photo
                    lappend results [expr {$native eq [$photo data]}]\
                            [expr {[lindex [LegendPixels $photo {0 0 0}] 2] > 0}]
                }
                set results
            } -cleanup {
                destroy .renderer
                catch {image delete $photo}
            } -result {1 1 1 1}
        }
    }

    source [file join [file dirname [info script]] .. bar bar.fillopacity.support.tcl]
    array set testCase {}
    test barchart.cairo.fillopacity.3.1 {active pen opacity overrides normal fill opacity} -constraints rbcCairo -setup {
        ::rbcTest::barOpacity::Create cairo
        set photo [image create photo]
        .bo element configure e -fillopacity 0
        .bo pen configure activeBar -foreground blue -background blue -borderwidth 0 -fillopacity 0.5
        .bo element activate e
    } -body {
        lassign [::rbcTest::barOpacity::Pixel $photo 1.2 1] r g b
        expr {$b == 255 && $r >= 126 && $r <= 129 && $g == $r}
    } -cleanup {
        destroy .bo
        if {[info exists photo]} {catch {image delete $photo}}
    } -result 1
    test barchart.cairo.fillopacity.4.1 {Cairo blends both stipple colors} -constraints rbcCairo -setup {
        ::rbcTest::barOpacity::Create cairo
        set photo [image create photo]
        .bo element configure e -foreground red -background blue -stipple gray25 -fillopacity 0.5
    } -body {
        .bo snap $photo
        lassign [.bo transform 1 1] x y
        set x [expr {round($x)}]
        set y [expr {round($y)}]
        set red 0
        set blue 0
        for {set dy 0} {$dy < 8} {incr dy} {
            for {set dx 0} {$dx < 8} {incr dx} {
                lassign [$photo get [expr {$x + $dx}] [expr {$y + $dy}]] r g b
                if {$r == 255 && $g >= 126 && $g <= 129 && $b == $g} {incr red}
                if {$b == 255 && $g >= 126 && $g <= 129 && $r == $g} {incr blue}
            }
        }
        expr {$red > 0 && $blue > 0 && $red + $blue == 64}
    } -cleanup {
        destroy .bo
        if {[info exists photo]} {catch {image delete $photo}}
    } -result 1

    cleanupTests
}
