#

###Package Definition
package provide polar.marker

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.marker {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure creating a marker actually creates the marker on the polar widget.
	# ------------------------------------------------------------------------------------
	test RBC.polar.marker.create.A.1.1 {
		polar marker: create
	} -setup {
		polar .polar1
	} -body {
		.polar1 marker create text -name marker1 -coords {0.0 0.0} -text origin
		.polar1 marker exists marker1
	} -cleanup {
		.polar1 marker delete marker1
		destroy .polar1
	} -result {1}

	cleanupTests
}
