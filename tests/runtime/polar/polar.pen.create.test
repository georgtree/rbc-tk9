# polar.pen.create.test --
#
###Abstract
# This file contains the automatic tests that test the pen create
# function of the polar RBC component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#

###Package Definition
package provide polar.pen

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.pen {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that default pen creation on a polar widget creates a line pen.
	# ------------------------------------------------------------------------------------
	test polar.pen.create.1.1 {
		polar pen create: default pen type
	} -setup {
		polar .polar1
	} -body {
		.polar1 pen create Pen1
		.polar1 pen type Pen1
	} -cleanup {
		destroy .polar1
	} -result {LineElement}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure that polar pen creation accepts normal line-pen options.
	# ------------------------------------------------------------------------------------
	test polar.pen.create.1.2 {
		polar pen create: line pen option
	} -setup {
		polar .polar1
	} -body {
		.polar1 pen create Pen1 -color blue
		.polar1 pen cget Pen1 -color
	} -cleanup {
		destroy .polar1
	} -result {blue}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure explicit -type line remains supported.
	# ------------------------------------------------------------------------------------
	test polar.pen.create.1.3 {
		polar pen create: explicit line type
	} -setup {
		polar .polar1
	} -body {
		.polar1 pen create Pen1 -type line
		.polar1 pen type Pen1
	} -cleanup {
		destroy .polar1
	} -result {LineElement}


    # ------------------------------------------------------------------------------------
    # Purpose: Failed revival must retain hidden state and the original pen options.
    # ------------------------------------------------------------------------------------
    foreach {case options} {1 {-unknownpenoption 1} 2 {-showvalues invalid}} {
        test polar.pen.create.2.$case {
            failed revival preserves pending visibility and permits a later retry
        } -setup {
            polar .polar1
            .polar1 pen create Pen1 -color blue
            .polar1 element create e -xdata {1 2} -ydata {2 3} -pen Pen1
            .polar1 pen delete Pen1
        } -body {
            set result {}
            for {set attempt 0} {$attempt < 2} {incr attempt} {
                lappend result [catch {.polar1 pen create Pen1 -color red {*}$options} message]
                lappend result [expr {[string length $message] > 0}]
                lappend result [.polar1 pen names Pen1]
                lappend result [catch {.polar1 pen cget Pen1 -color}]
                lappend result [catch {.polar1 element configure e -pen Pen1}]
            }
            lappend result [.polar1 pen create Pen1]
            lappend result [.polar1 pen cget Pen1 -color] [.polar1 element cget e -pen]
            set result
        } -cleanup {
            destroy .polar1
        } -result {1 1 {} 1 1 1 1 {} 1 1 Pen1 blue Pen1}
    }

    # ------------------------------------------------------------------------------------
    # Purpose: Last-reference cleanup after failed revival must remove the retained record.
    # ------------------------------------------------------------------------------------
    test polar.pen.create.2.3 {
        failed revival remains pending until the final element reference is released
    } -setup {
        polar .polar1
        .polar1 pen create Pen1 -color blue
        .polar1 element create e -xdata {1 2} -ydata {2 3} -pen Pen1
        .polar1 pen delete Pen1
    } -body {
        set failed [catch {.polar1 pen create Pen1 -showvalues invalid}]
        .polar1 element delete e
        list $failed [.polar1 pen names Pen1] \
            [.polar1 pen create Pen1 -type bar] [.polar1 pen type Pen1]
    } -cleanup {
        destroy .polar1
    } -result {1 {} Pen1 BarElement}

	cleanupTests
}
