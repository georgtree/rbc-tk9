        .w element create a -cdata lengthZ -param lengthP
        update
    } -body {
        lengthZ set {{0 0} {1 0} {2 0} {3 0}}
        set code [catch {.w element configure a -param lengthP} msg]
        set rejected [expr {$code == (4 != 3)}]
        lengthP set {0 1 2 3}
        .w element configure a -param lengthP
        list $rejected [.w element cget a -param]
    } -cleanup {
        destroy .w
        vector destroy lengthX lengthY lengthP lengthZ
    } -result {1 lengthP}

    test polar.element.configure.25.6 {
        parameter validation: pending parameter resize matches new data, length 4
    } -setup {
        vector create lengthX lengthY lengthP
        vector create lengthZ -type complex
        lengthX set {0 1 2}
        lengthY set {0 1 2}
        lengthP set {10 20 30}
        lengthZ set {{0 0} {1 0} {2 0}}
        polar .w
        .w element create a -cdata lengthZ -param lengthP
        update
    } -body {
        lengthP set {0 1 2 3}
        lengthZ set {{0 0} {1 0} {2 0} {3 0}}
        .w element configure a -cdata lengthZ
        list [.w element cget a -param] [lengthP length]
    } -cleanup {
        destroy .w
        vector destroy lengthX lengthY lengthP lengthZ
    } -result {lengthP 4}

    test polar.element.configure.25.7 {
        parameter validation: current mismatch rejects data change and preserves options
    } -setup {
        vector create lengthX lengthY lengthP
        vector create lengthZ -type complex
        lengthX set {0 1 2}
        lengthY set {0 1 2}
        lengthP set {10 20 30}
        lengthZ set {{0 0} {1 0} {2 0}}
        polar .w
        .w element create a -cdata lengthZ -param lengthP
        update
    } -body {
        lengthP set {10 20}
        set before [.w element configure a]
        set code [catch {.w element configure a -cdata lengthZ -color red} msg]
        set unchanged [expr {$before eq [.w element configure a]}]
        .w element configure a -color blue
        list $code $msg $unchanged [.w element cget a -color]
    } -cleanup {
        destroy .w
        vector destroy lengthX lengthY lengthP lengthZ
    } -result {1 {parameter vector has 2 values, but element has 3 data points} 1 blue}

    test polar.element.configure.26.1 {
        smooth diagnostic lists all accepted names and retains the previous value
    } -setup {
        polar .w
        .w element create a
    } -body {
        set accepted {}
        foreach mode {linear step natural cubic quadratic catrom} {
            .w element configure a -smooth $mode
            lappend accepted [.w element cget a -smooth]
        }
        set code [catch {.w element configure a -smooth invalid} message]
        list $accepted $code $message [.w element cget a -smooth]
    } -cleanup {
        destroy .w
    } -result {{linear step natural cubic quadratic catrom} 1 {bad smooth value "invalid": should be linear, step, natural, cubic, quadratic, or catrom} catrom}


    # Failed reference-impedance validation must preserve derived drawing state,
    # not only the Tcl option values restored by Tk.
    set testCase(27) 0
    foreach invalidZ0 {0 -1 Inf -Inf} {
        foreach change {{-smooth step} {-color red} {-pen Replacement}} {
            test polar.element.configure.27.[incr testCase(27)] {
                invalid z0 rejects combined updates without changing rendered geometry
            } -setup {
                polar .polar1 -width 400 -height 300
                pack .polar1
                .polar1 pen create Replacement -color blue -linewidth 4
                .polar1 element create Element1 -data {0 0 0.5 0.7 0.8 0.2} \
                    -symbol none -smooth linear -color black -linewidth 2
                update
            } -body {
                set beforeOptions [.polar1 element configure Element1]
                set beforeSvg [.polar1 svg output]
                set code [catch {.polar1 element configure Element1 {*}$change -z0 $invalidZ0} message]
                set restored [expr {$beforeOptions eq [.polar1 element configure Element1]}]
                # SVG output remaps, revealing stale derived settings even when
                # cget reports the restored option values.
                set same [expr {$beforeSvg eq [.polar1 svg output]}]
                .polar1 element configure Element1 {*}$change -z0 75
                set changed [expr {$beforeSvg ne [.polar1 svg output]}]
                list $code [string match {bad reference impedance *positive finite value} $message] \
                    $restored $same $changed [.polar1 element cget Element1 -z0]
            } -cleanup {
                destroy .polar1
            } -result {1 1 1 1 1 75.0}
        }
    }

    test polar.element.configure.28.1 {
        invalid z0 preserves data and smoothing; subsequent valid update commits both
    } -setup {
        polar .polar1 -width 400 -height 300
        pack .polar1
        .polar1 element create Element1 -data {0 0 0.5 0.7 0.8 0.2} -symbol none
        update
    } -body {
        set beforeOptions [.polar1 element configure Element1]
        set beforeSvg [.polar1 svg output]
        set code [catch {.polar1 element configure Element1 -data {0 0 0.2 0.4 0.7 0.5} \
            -smooth step -z0 0}]
        set same [expr {$beforeOptions eq [.polar1 element configure Element1] &&
            $beforeSvg eq [.polar1 svg output]}]
        .polar1 element configure Element1 -data {0 0 0.2 0.4 0.7 0.5} -smooth step -z0 75
        list $code $same [.polar1 element cget Element1 -smooth] \
            [expr {$beforeSvg ne [.polar1 svg output]}]
    } -cleanup {
        destroy .polar1
    } -result {1 1 step 1}

    test polar.element.configure.28.2 {
        invalid initial z0 leaves no element and permits reuse of its name
    } -setup {
        polar .polar1
        .polar1 pen create Replacement -color blue
    } -body {
        set code [catch {.polar1 element create Element1 -pen Replacement -smooth step -z0 0}]
        set absent [expr {[lsearch -exact [.polar1 element names] Element1] < 0}]
        .polar1 element create Element1 -pen Replacement -smooth step -z0 75
        list $code $absent [.polar1 element cget Element1 -pen] [.polar1 element cget Element1 -z0]
    } -cleanup {
        destroy .polar1
    } -result {1 1 Replacement 75.0}

	cleanupTests
}
