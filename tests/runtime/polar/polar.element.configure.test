    test polar.element.configure.10.1 {
        polar element configure: empty -cdata restores XY data
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 10
        .polar1 axis configure y -min -2 -max 10
        .polar1 element create Element1 -data {8 8} -cdata z -symbol circle
        update
    } -body {
        .polar1 element configure Element1 -cdata {}
        set cdata [.polar1 element cget Element1 -cdata]
        # This must be safe: the element must no longer have a client
        # attached to z.
        set destroyCode [catch {vector destroy z}]
        update
        lassign [.polar1 transform 8 8] x y
        set found [.polar1 element closest $x $y info -along both -interpolate 0 -halo 2 Element1]
        list $cdata $destroyCode $found $info(index) $info(x) $info(y)
    } -cleanup {
        unset -nocomplain info
        destroy .polar1
        catch {vector destroy z}
    } -result {{} 0 1 0 8.0 8.0}

    test polar.element.configure.11.1 {
        polar element configure: real vector failure rolls back
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1}}
        vector create r
        r set {10 20}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        .polar1 element create Element1 -cdata z -symbol circle
        update
    } -body {
        set code [catch {.polar1 element configure Element1 -cdata r}]
        update
        lassign [.polar1 transform 1 0] x y
        set found [.polar1 element closest $x $y info -along both -interpolate 0 -halo 2 Element1]
        list $code [.polar1 element cget Element1 -cdata] $found $info(index) $info(x) $info(y)
    } -cleanup {
        unset -nocomplain info
        destroy .polar1
        vector destroy z r
    } -result {1 z 1 0 1.0 0.0}

    test polar.element.configure.12.1 {
        polar element configure: missing vector failure rolls back
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1}}
        polar .polar1 -width 400 -height 400
        pack .polar1
        .polar1 axis configure x -min -2 -max 2
        .polar1 axis configure y -min -2 -max 2
        .polar1 element create Element1 -cdata z -symbol circle
        update
    } -body {
        set code [catch {.polar1 element configure Element1 -cdata noSuchVector}]
        update
        lassign [.polar1 transform 1 0] x y
        set found [.polar1 element closest $x $y info -along both -interpolate 0 -halo 2 Element1]
        list $code [.polar1 element cget Element1 -cdata] $found $info(index) $info(x) $info(y)
    } -cleanup {
        unset -nocomplain info
        destroy .polar1
        vector destroy z
    } -result {1 z 1 0 1.0 0.0}

    test polar.element.configure.13.1 {
        polar element configure: deleting element releases complex vector client
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1}}
        polar .polar1
        .polar1 element create Element1 -cdata z
    } -body {
        .polar1 element delete Element1
        set updateCode [catch { z set {{2 0} {0 2}} }]
        set destroyCode [catch { vector destroy z }]
        list $updateCode $destroyCode
    } -cleanup {
        destroy .polar1
        catch {vector destroy z}
    } -result {0 0}

    test polar.element.configure.14.1 {
        polar element configure: failed -cdata create leaves no element
    } -setup {
        vector create r
        r set {1 2 3}
        polar .polar1
    } -body {
        set code [catch {.polar1 element create Element1 -cdata r}]
        list $code [.polar1 element exists Element1]
    } -cleanup {
        destroy .polar1
        vector destroy r
    } -result {1 0}

    test polar.element.configure.15.1 {
        polar element configure: complex data with parameter vector
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1} {-1 0}}
        vector create p
        p set {10 20 30}
        polar .polar1
        .polar1 element create Element1 -cdata z -param p
    } -body {
        list [.polar1 element cget Element1 -cdata] [.polar1 element cget Element1 -param]
    } -cleanup {
        destroy .polar1
        vector destroy z p
    } -result {z p}

    test polar.element.configure.16.1 {
        polar element configure: parameter length mismatch on create
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1} {-1 0}}
        vector create p
        p set {10 20}
        polar .polar1
    } -body {
        set code [catch {.polar1 element create Element1 -cdata z -param p} message]
        list $code [.polar1 element exists Element1] $message
    } -cleanup {
        destroy .polar1
        vector destroy z p
    } -result {1 0 {parameter vector has 2 values, but element has 3 data points}}

    test polar.element.configure.17.1 {
        polar element configure: complex data and parameter resize atomically
    } -setup {
        vector create z1 -type complex
        z1 set {{1 0} {0 1}}
        vector create z2 -type complex
        z2 set {{1 0} {0 1} {-1 0}}
        vector create p1
        p1 set {10 20}
        vector create p2
        p2 set {10 20 30}
        polar .polar1
        .polar1 element create Element1 -cdata z1 -param p1
    } -body {
        .polar1 element configure Element1 -cdata z2 -param p2
        list [.polar1 element cget Element1 -cdata] [.polar1 element cget Element1 -param]
    } -cleanup {
        destroy .polar1
        vector destroy z1 z2 p1 p2
    } -result {z2 p2}

    test polar.element.configure.18.1 {
        polar element configure: complex data length change alone rolls back
    } -setup {
        vector create z1 -type complex
        z1 set {{1 0} {0 1}}
        vector create z2 -type complex
        z2 set {{1 0} {0 1} {-1 0}}
        vector create p
        p set {10 20}
        polar .polar1
        .polar1 element create Element1 -cdata z1 -param p
    } -body {
        set code [catch { .polar1 element configure Element1 -cdata z2 } message]
        list $code $message [.polar1 element cget Element1 -cdata] [.polar1 element cget Element1 -param]
    } -cleanup {
        destroy .polar1
        vector destroy z1 z2 p
    } -result {1 {parameter vector has 2 values, but element has 3 data points} z1 p}

