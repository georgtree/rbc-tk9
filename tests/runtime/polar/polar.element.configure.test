    test polar.element.configure.25.5 {
        parameter validation: pending data resize matches new parameter, length 4
    } -setup {
        vector create lengthX lengthY lengthP
        vector create lengthZ -type complex
        lengthX set {0 1 2}
        lengthY set {0 1 2}
        lengthP set {10 20 30}
        lengthZ set {{0 0} {1 0} {2 0}}
