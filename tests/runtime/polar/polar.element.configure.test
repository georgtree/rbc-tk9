# polar.element.configure.test --
#
###Abstract
# This file contains the automatic tests that test the element configure
# function of the polar RBC component.
#
###Copyright
# See the file "license.terms" for information on usage and
# redistribution of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#

###Package Definition
package provide polar.element

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.element {
	# ------------------------------------------------------------------------------------
	# Purpose: Ensure PolarElement uses the graph-line option table rather than the
	# stripchart option table.  -trace is present only for graph line elements.
	# ------------------------------------------------------------------------------------
	test polar.element.configure.1.1 {
		polar element configure: graph-line option table
	} -setup {
		polar .polar1
		.polar1 element create Element1
	} -body {
		.polar1 element configure Element1 -trace both
		.polar1 element cget Element1 -trace
	} -cleanup {
		.polar1 element delete Element1
		destroy .polar1
	} -result {both}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure a line-type named pen created by a polar widget can be assigned to
	# a PolarElement.
	# ------------------------------------------------------------------------------------
	test polar.element.configure.2.1 {
		polar element configure: named line pen
	} -setup {
		polar .polar1
		.polar1 pen create Pen1 -color blue
		.polar1 element create Element1
	} -body {
		.polar1 element configure Element1 -pen Pen1
		.polar1 element cget Element1 -pen
	} -cleanup {
		.polar1 pen delete Pen1
		.polar1 element delete Element1
		destroy .polar1
	} -result {Pen1}

	# ------------------------------------------------------------------------------------
	# Purpose: Ensure PolarElement palettes accept ordinary line pens.
	# ------------------------------------------------------------------------------------
	test polar.element.configure.2.2 {
		polar element configure: styles use line pens
	} -setup {
		polar .polar1
		.polar1 pen create Pen1 -color blue
		.polar1 element create Element1
	} -body {
		.polar1 element configure Element1 -styles {Pen1}
		.polar1 element cget Element1 -styles
	} -cleanup {
		.polar1 pen delete Pen1
		.polar1 element delete Element1
		destroy .polar1
	} -result {Pen1}

    test polar.element.configure.3.1 {
        polar element configure: complex vector
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1} {-1 0} {0 -1}}
        polar .polar1
        .polar1 element create Element1 -cdata z
    } -body {
        list [.polar1 element type Element1] [.polar1 element cget Element1 -cdata]
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {PolarElement z}

    test polar.element.configure.4.1 {
        polar element configure: reject real vector
    } -setup {
        vector create z
        z set {1 2 3}
        polar .polar1
    } -body {
        catch {.polar1 element create Element1 -cdata z} message
        set message
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {vector "z" is real; -cdata requires a complex vector}

    test polar.element.configure.5.1 {
        graph line element does not expose -cdata
    } -setup {
        vector create z -type complex
        graph .graph1
        .graph1 element create Element1
    } -body {
        catch { .graph1 element configure Element1 -cdata z }
    } -cleanup {
        destroy .graph1
        vector destroy z
    } -result {1}

    test polar.element.configure.6.1 {
        polar element configure: later -cdata selects complex data
    } -setup {
        vector create z -type complex
        z set {{1 0} {0 1} {-1 0}}
        polar .polar1
        .polar1 element create Element1
    } -body {
        .polar1 element configure Element1 -data {10 10 20 20} -cdata z
        .polar1 element cget Element1 -cdata
    } -cleanup {
        destroy .polar1
        vector destroy z
    } -result {z}

