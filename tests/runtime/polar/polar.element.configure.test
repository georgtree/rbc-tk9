    test polar.element.configure.24.1 {
        polar complex data format: invalid z0 rolls back
    } -setup {
        polar .polar1
        .polar1 element create Element1
    } -body {
        set code [catch {.polar1 element configure Element1 -z0 0}]
        list $code [expr {[.polar1 element cget Element1 -z0] == 50.0}]
    } -cleanup {
        destroy .polar1
    } -result {1 1}



    test polar.element.configure.25.1 {
        parameter validation: pending data resize matches new parameter, length 0
    } -setup {
        vector create lengthX lengthY lengthP
        vector create lengthZ -type complex
        lengthX set {0 1 2}
        lengthY set {0 1 2}
        lengthP set {10 20 30}
        lengthZ set {{0 0} {1 0} {2 0}}
        polar .w
        .w element create a -cdata lengthZ -param lengthP
        update
    } -body {
        lengthZ set {}
        set code [catch {.w element configure a -param lengthP} msg]
        set rejected [expr {$code == (0 != 3)}]
        lengthP set {}
        .w element configure a -param lengthP
        list $rejected [.w element cget a -param]
    } -cleanup {
        destroy .w
        vector destroy lengthX lengthY lengthP lengthZ
    } -result {1 lengthP}

    test polar.element.configure.25.2 {
        parameter validation: pending parameter resize matches new data, length 0
    } -setup {
        vector create lengthX lengthY lengthP
        vector create lengthZ -type complex
        lengthX set {0 1 2}
        lengthY set {0 1 2}
        lengthP set {10 20 30}
        lengthZ set {{0 0} {1 0} {2 0}}
        polar .w
        .w element create a -cdata lengthZ -param lengthP
        update
    } -body {
        lengthP set {}
        lengthZ set {}
        .w element configure a -cdata lengthZ
        list [.w element cget a -param] [lengthP length]
    } -cleanup {
        destroy .w
        vector destroy lengthX lengthY lengthP lengthZ
    } -result {lengthP 0}

    test polar.element.configure.25.3 {
        parameter validation: pending data resize matches new parameter, length 2
    } -setup {
        vector create lengthX lengthY lengthP
        vector create lengthZ -type complex
        lengthX set {0 1 2}
        lengthY set {0 1 2}
        lengthP set {10 20 30}
        lengthZ set {{0 0} {1 0} {2 0}}
        polar .w
        .w element create a -cdata lengthZ -param lengthP
        update
    } -body {
        lengthZ set {{0 0} {1 0}}
        set code [catch {.w element configure a -param lengthP} msg]
        set rejected [expr {$code == (2 != 3)}]
        lengthP set {0 1}
        .w element configure a -param lengthP
        list $rejected [.w element cget a -param]
    } -cleanup {
        destroy .w
        vector destroy lengthX lengthY lengthP lengthZ
    } -result {1 lengthP}

