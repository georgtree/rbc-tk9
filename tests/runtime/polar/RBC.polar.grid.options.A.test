# Polar/Smith grid settings belong to the grid component.
###Package Definition
package provide polar.grid.options

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval polar.grid.options {
    # Numeric case IDs for loop-generated tests.
    array set testCase {6 0 8 0}
    set options {
        -anglelabelanchor -radiallabelanchor -anglemajorticks -angleminorticks -anglecommand
        -smithgrid -smithrealmajorticks -smithrealminorticks -smithimagmajorticks -smithimagminorticks
        -smithrealcommand -smithimagcommand
    }

    test RBC.polar.grid.options.A.1.1 {grid owns options and graph rejects the old location} -setup {
        ::rbc::polar .gridOptions
    } -body {
        set failures {}
        foreach option $options {
            set value [.gridOptions grid cget $option]
            if {[lindex [.gridOptions grid configure $option] 4] ne $value ||
                ![catch {.gridOptions cget $option}] ||
                ![catch {.gridOptions configure $option $value}]} {
                lappend failures $option
            }
        }
        list $failures [.gridOptions cget -representation] [.gridOptions cget -aspect]
    } -cleanup {
        destroy .gridOptions
    } -result {{} polar 1.0}

    test RBC.polar.grid.options.A.2.1 {component option database supplies parsed defaults at creation} -setup {
        option add *gridOptions.grid.AngleMajorTicks {10 70 190} interactive
        option add *gridOptions.grid.AngleLabelAnchor auto interactive
        option add *gridOptions.grid.SmithGrid admittance interactive
        option add *gridOptions.grid.SmithRealMajorTicks {0 0.75 3} interactive
        ::rbc::polar .gridOptions -representation smith
    } -body {
        list [.gridOptions grid cget -anglemajorticks] [.gridOptions grid cget -anglelabelanchor] \
            [.gridOptions grid cget -smithgrid] [.gridOptions grid cget -smithrealmajorticks]
    } -cleanup {
        catch {destroy .gridOptions}
        # Restore defaults for this test-specific pathname without clearing
        # the suite's renderer defaults or other option-database entries.
        option add *gridOptions.grid.AngleMajorTicks {0 30 60 90 120 150 180 210 240 270 300 330} interactive
        option add *gridOptions.grid.AngleLabelAnchor center interactive
        option add *gridOptions.grid.SmithGrid impedance interactive
        option add *gridOptions.grid.SmithRealMajorTicks {0 0.2 0.5 1 2 5} interactive
    } -result {{10 70 190} auto admittance {0 0.75 3}}

    test RBC.polar.grid.options.A.3.1 {invalid ticks roll back style, mappings and parsed grid state together} -setup {
        ::rbc::polar .gridOptions
        .gridOptions grid configure -color navy -mapx x -smithgrid impedance -anglemajorticks {0 90}
        set before [.gridOptions grid configure]
    } -body {
        set failed [catch {
            .gridOptions grid configure -color red -mapx x2 -smithgrid both \
                -anglemajorticks {0 45} -smithimagmajorticks {0 1}
        }]
        list $failed [expr {[.gridOptions grid configure] eq $before}]
    } -cleanup {
        destroy .gridOptions
    } -result {1 1}

    test RBC.polar.grid.options.A.4.1 {invalid mapping does not commit new tick arrays} -setup {
        ::rbc::polar .gridOptions
        .gridOptions grid configure -anglemajorticks {0 90}
        set before [.gridOptions grid configure]
    } -body {
        set failed [catch {
            .gridOptions grid configure -anglemajorticks {45 135} -mapx y
        }]
        list $failed [expr {[.gridOptions grid configure] eq $before}]
    } -cleanup {
        destroy .gridOptions
    } -result {1 1}

    proc AngleLabel {widget angle} {
        return "GRID-ANGLE-$angle"
    }

    test RBC.polar.grid.options.A.5.1 {visible grid labels follow tick changes and mapped-axis showticks} -setup {
        ::rbc::polar .gridOptions -width 400 -height 400
        .gridOptions axis configure x -min -1 -max 1 -loose no
        .gridOptions axis configure y -min -1 -max 1 -loose no -showticks yes
        .gridOptions grid configure -hide no -anglemajorticks {30} \
            -anglecommand ::polar.grid.options::AngleLabel
    } -body {
        set before [.gridOptions svg output]
        .gridOptions grid configure -anglemajorticks {60}
        set after [.gridOptions svg output]
        .gridOptions axis configure y -showticks no
        set hidden [.gridOptions svg output]
        list [string match {*GRID-ANGLE-30*} $before] \
            [string match {*GRID-ANGLE-60*} $after] \
            [expr {![string match {*GRID-ANGLE-30*} $after]}] \
            [expr {![string match {*GRID-ANGLE-*} $hidden]}]
    } -cleanup {
        destroy .gridOptions
    } -result {1 1 1 1}

    foreach {widget expected} {graph 1 stripchart 1 barchart 0 polar 0} {
        test RBC.polar.grid.options.A.6.[incr testCase(6)] {grid visibility defaults and option metadata agree} -setup {
            ::rbc::$widget .gridDefault
        } -body {
            list [.gridDefault grid cget -hide] \
                [expr {!![lindex [.gridDefault grid configure -hide] 3]}]
        } -cleanup {
            destroy .gridDefault
        } -result [list $expected $expected]
    }

    test RBC.polar.grid.options.A.7.1 {option database can hide a Smith grid at creation} -setup {
        option add *gridVisibilityOverride.grid.Hide yes interactive
        ::rbc::polar .gridVisibilityOverride -representation smith
    } -body {
        .gridVisibilityOverride grid cget -hide
    } -cleanup {
        destroy .gridVisibilityOverride
        option add *gridVisibilityOverride.grid.Hide no interactive
    } -result 1

    proc VisibilityRadiusLabel {widget value} {
        return GRID-VISIBILITY-LABEL
    }

    proc VisibilityLabel {args} {
        variable labelCalls
        incr labelCalls
        return GRID-VISIBILITY-LABEL
    }

    foreach representation {polar smith} {
        foreach output {screen svg postscript} {
            test RBC.polar.grid.options.A.8.[incr testCase(8)] {
                grid off/on/toggle/configure hide and restore coordinate labels
            } -setup {
                ::rbc::polar .gridVisibility -width 400 -height 400 -representation $representation
                pack .gridVisibility
                .gridVisibility axis configure x -min -1.2 -max 1.2 -loose no -showticks yes \
                    -command ::polar.grid.options::VisibilityRadiusLabel
                .gridVisibility axis configure y -min -1.2 -max 1.2 -loose no -showticks yes
                .gridVisibility grid configure -smithgrid both -anglemajorticks {30} \
                    -anglecommand ::polar.grid.options::VisibilityLabel \
                    -smithrealcommand ::polar.grid.options::VisibilityLabel \
                    -smithimagcommand ::polar.grid.options::VisibilityLabel
                set photo [image create photo]
                update idletasks
            } -body {
                set result {}
                # Start with the constructor default, then exercise each way
                # to change visibility. Screen snapshots force fresh drawing.
                foreach operation {{} off on toggle toggle {configure -hide yes} {configure -hide no}} {
                    if {$operation ne {}} {
                        .gridVisibility grid {*}$operation
                    }
                    update idletasks
                    set labelCalls 0
                    if {$output eq "screen"} {
                        .gridVisibility snap $photo
                        lappend result [expr {$labelCalls > 0}]
                    } else {
                        set document [.gridVisibility $output output]
                        lappend result [expr {[string first GRID-VISIBILITY-LABEL $document] >= 0}]
                    }
                }
                set result
            } -cleanup {
                destroy .gridVisibility
                image delete $photo
            } -result {1 0 1 0 1 0 1}
        }
    }

    proc CallbackSetup {option} {
        ::rbc::polar .gridCallback -width 400 -height 400
        .gridCallback axis configure x -min -1 -max 1 -loose no
        .gridCallback axis configure y -min -1 -max 1 -loose no -showticks yes
        .gridCallback grid configure -hide no -anglemajorticks {30 60} \
            -smithrealmajorticks {0.5 1} -smithimagmajorticks {0.5 1} -smithgrid both
        if {$option ne "-anglecommand"} {.gridCallback configure -representation smith}
    }

    proc ChangeDuringLabel {action widget args} {
        variable callbackCalls
        incr callbackCalls
        if {$callbackCalls == 1} {
            switch -- $action {
                destroy {destroy $widget}
                grid {$widget grid configure -anglemajorticks {90} -smithrealmajorticks {2} -smithimagmajorticks {2}}
                axis {$widget axis configure y -tickfont {Courier 18}}
                recursive {
                    variable recursiveResults
                    foreach operation {{svg output} {pdf output} {postscript output}} {
                        set code [catch {$widget {*}$operation} message options]
                        lappend recursiveResults [list $code [dict get $options -errorcode]]
                    }
                }
            }
        }
        return CALLBACK-LABEL
    }

    set testCase(9) 0
    foreach option {-anglecommand -smithrealcommand -smithimagcommand} {
        foreach output {screen svg pdf postscript} {
            foreach action {destroy grid axis} {
                test RBC.polar.grid.options.A.9.[incr testCase(9)] \
                    "$option $action during $output stops the current label pass" -setup {
                    CallbackSetup $option
                    set callbackCalls 0
                    set photo [image create photo]
                    .gridCallback grid configure $option [list ::polar.grid.options::ChangeDuringLabel $action]
                } -body {
                    if {$output eq "screen"} {
                        set code [catch {.gridCallback snap $photo} message details]
                    } else {
                        set code [catch {.gridCallback $output output} message details]
                    }
                    set errorCode {}
                    if {$code} {set errorCode [dict get $details -errorcode]}
                    set result [list $code $errorCode $callbackCalls]
                    if {$action ne "destroy"} {
                        .gridCallback grid configure $option {}
                        lappend result [expr {[string length [.gridCallback svg output]] > 0}]
                    } else {
                        lappend result [expr {![winfo exists .gridCallback]}]
                    }
                    set result
                } -cleanup {
                    catch {destroy .gridCallback}
                    image delete $photo
                } -result {1 {RBC GRAPH CALLBACK} 1 1}
            }
        }
    }

    set testCase(10) 0
    foreach option {-anglecommand -smithrealcommand -smithimagcommand} {
        test RBC.polar.grid.options.A.10.[incr testCase(10)] \
            "$option rejects recursive rendering without cancelling a valid outer export" -setup {
            CallbackSetup $option
            set callbackCalls 0
            set recursiveResults {}
            .gridCallback grid configure $option [list ::polar.grid.options::ChangeDuringLabel recursive]
        } -body {
            set document [.gridCallback svg output]
            list $recursiveResults [expr {[string first CALLBACK-LABEL $document] >= 0}]
        } -cleanup {
            destroy .gridCallback
        } -result {{{1 {RBC GRAPH CALLBACK}} {1 {RBC GRAPH CALLBACK}} {1 {RBC GRAPH CALLBACK}}} 1}
    }

    proc FailingLabel {args} {error {forced grid label failure}}
    proc CollectLabelError {message options} {
        variable labelErrors
        lappend labelErrors $message
    }

    set testCase(11) 0
    foreach option {-anglecommand -smithrealcommand -smithimagcommand} {
        test RBC.polar.grid.options.A.11.[incr testCase(11)] \
            "$option reports formatter errors and retains default text" -setup {
            CallbackSetup $option
            set labelErrors {}
            set savedBgerror [interp bgerror {}]
            interp bgerror {} ::polar.grid.options::CollectLabelError
        } -body {
            set expected [.gridCallback svg output]
            .gridCallback grid configure $option ::polar.grid.options::FailingLabel
            set actual [.gridCallback svg output]
            .gridCallback grid configure $option {}
            update
            list [expr {$actual eq $expected}] \
                [expr {[llength $labelErrors] > 0}] [lsort -unique $labelErrors]
        } -cleanup {
            interp bgerror {} $savedBgerror
            destroy .gridCallback
        } -result {1 1 {{forced grid label failure}}}
    }

::tcltest::cleanupTests
}
