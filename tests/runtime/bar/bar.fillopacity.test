# Bar fill opacity: configuration, screen rendering, legends, and export.
# See license.terms for details.
###Package Definition
package provide bar.fillopacity

package require rbc
namespace import rbc::*

package require tcltest
namespace import tcltest::*

namespace eval bar.fillopacity {
    source [file join [file dirname [info script]] bar.fillopacity.support.tcl]
    namespace import ::rbcTest::barOpacity::*

    # Numeric case IDs for loop-generated tests.
    array set testCase {2 0 6 0}
    source [file join [file dirname [info script]] .. renderingSupport.tcl]
    ::rbcTest::rendering::CheckCairo

    test bar.fillopacity.1.1 {element and pen defaults, metadata, and transactional validation} -setup {
        Create
        .bo pen create p -type bar -foreground red
    } -body {
        set result [list [.bo element cget e -fillopacity] [.bo pen cget p -fillopacity] \
            [lrange [.bo element configure e -fillopacity] 1 3]]
        set failures {}
        foreach target {{element e} {pen p}} {
            lassign $target kind name
            .bo $kind configure $name -fillopacity 0.25
            foreach value {-0.1 1.1 Inf -Inf NaN bad} {
                set code [catch {.bo $kind configure $name -foreground blue -fillopacity $value}]
                if {!$code || [.bo $kind cget $name -fillopacity] != 0.25 ||
                    [.bo $kind cget $name -foreground] eq {blue}} {
                    lappend failures $target $value
                }
            }
        }
        lappend result $failures
    } -cleanup {
        destroy .bo
    } -result {1.0 1.0 {fillOpacity FillOpacity 1.0} {}}

    foreach renderer {native cairo} {
        set constraints {}
        if {$renderer eq "cairo"} {
            set constraints rbcCairo
        }
        test bar.fillopacity.2.[incr testCase(2)] {zero, partial and full fill opacity} -constraints $constraints -setup {
            Create $renderer
            set photo [image create photo]
        } -body {
            set result {}
            foreach opacity {0 0.5 1} {
                .bo element configure e -fillopacity $opacity
                lassign [Pixel $photo 1.2 1] r g b
                if {$opacity == 0} {
                    lappend result [expr {$r == 255 && $g == 255 && $b == 255}]
                } elseif {$opacity == 0.5 && $renderer eq "cairo"} {
                    lappend result [expr {$r == 255 && $g >= 126 && $g <= 129 && $b == $g}]
                } else {
                    lappend result [expr {$r == 255 && $g == 0 && $b == 0}]
                }
            }
            set result
        } -cleanup {
            destroy .bo
            if {[info exists photo]} {catch {image delete $photo}}
        } -result {1 1 1}
    }

    test bar.fillopacity.5.1 {zero fill leaves error bars visible} -setup {
        Create
        set photo [image create photo]
        .bo element configure e -fillopacity 0 -yerror {1} -errorbarcolor black -errorbarwidth 3
    } -body {
        list [Pixel $photo 1.2 1] [Pixel $photo 1 3.5]
    } -cleanup {
        destroy .bo
        if {[info exists photo]} {catch {image delete $photo}}
    } -result {{255 255 255} {0 0 0}}

    foreach stipple {{} gray25} {
        test bar.fillopacity.6.[incr testCase(6)] {SVG bar and legend preserve solid or stippled opacity} -setup {
            Create
            .bo legend configure -hide no
            .bo pen create p -type bar -foreground red -background blue -borderwidth 0 \
                -fillopacity 0.25 -stipple $stipple
            .bo element configure e -pen p
            update
        } -body {
            set document [.bo svg output]
            set result [list [expr {[regexp -all {<g opacity="0.25">} $document] >= 2}]]
            if {$stipple ne {}} {
                lappend result [expr {[string first {fill="url(#rbcPattern} $document] >= 0}]
            } else {
                lappend result [expr {[string first {fill="#ff0000"} $document] >= 0}]
            }
            .bo pen configure p -fillopacity 0
            set document [.bo svg output]
            lappend result [expr {[string first {fill="#ff0000"} $document] < 0 &&
                [string first {fill="url(#rbcPattern} $document] < 0}]
        } -cleanup {
            destroy .bo
        } -result {1 1 1}
    }

    test bar.fillopacity.7.1 {PostScript omits zero fill and treats partial fill as opaque} -setup {
        Create
    } -body {
        set counts {}
        foreach opacity {0 0.5 1} {
            .bo element configure e -fillopacity $opacity
            lappend counts [regexp -all { Box fill} [.bo postscript output]]
        }
        lassign $counts zero half full
        list [expr {$half == $full}] [expr {$full == $zero + 1}]
    } -cleanup {
        destroy .bo
    } -result {1 1}

    cleanupTests
}
