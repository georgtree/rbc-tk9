# tcl-lsp: disable=W111
namespace eval ::rbc {

    variable _ruff_ns_opts {
        -includeimports false
        -excludeprocs {^(ActivateLegend|DeactivateLegend|HighlightLegend|Crosshairs|InitStack|ZoomStack|RemoveZoomStack|PrintKey|ClosestPoint|AddBindTag|RemoveBindTag|FindElement|FlashPoint|GetCoords|MarkPoint|DestroyZoomTitle|PopZoom|PushZoom|ResetZoom|ZoomTitleNext|ZoomTitleLast|SetZoomPoint|MarchingAnts|Box|PostScriptDialog|ResetPostScript|Legacy.*)$}
    }

    proc graph {pathName args} {
        # Creates a graph widget. A graph uses line elements as its default element type. The widget supports the
        # common graph components such as axes, elements, markers, pens, legends, grids, crosshairs, and PostScript
        # output. Configuration options supplied when the widget is created are the same options accepted later by
        # `GRAPHINST configure`.
        # pathName - Tk pathname of the graph widget to create.
        # option - graph widget configuration option.
        # value - value for the configuration option.
        # Returns: The pathname of the newly created graph widget.
        #
        # Example:
        # ```tcl
        # graph .g -title "Example graph" -width 800 -height 500
        # pack .g -fill both -expand yes
        # ```
        # Synopsis: pathName ?option value ...?
    }

    proc trackgraph {pathName args} {
        # Creates a graph with named tracks sharing X axes and owning independent Y axes. Tracks are stacked rows,
        # or side-by-side columns with `-invertxy yes`. Line elements are the default; `strip create` adds strip
        # elements to the same widget. See [::rbc::TRACKGRAPH] for layout and track commands, and [::rbc::GRAPHINST]
        # for common widget options and components.
        # pathName - Tk pathname of the trackgraph widget.
        # args - Common graph configuration options, including `-invertxy` and track separator options.
        # Returns: The pathname of the new widget.
        # Synopsis: pathName ?option value ...?
    }

    proc barchart {pathName args} {
        # Creates a barchart widget. A barchart uses bar elements as its default element type. It uses the same graph
        # widget infrastructure and common components as `graph`, but elements created through the generic
        # `GRAPHINST element` interface are bar elements by default. Configuration options supplied when the widget
        # is created are the same options accepted later by `GRAPHINST configure`.
        # pathName - Tk pathname of the barchart widget to create.
        # option - graph widget configuration option.
        # value - value for the configuration option.
        # Returns: The pathname of the newly created barchart widget.
        #
        # Example:
        # ```tcl
        # barchart .b -title "Example barchart" -width 800 -height 500
        # pack .b -fill both -expand yes
        # ```
        # Synopsis: pathName ?option value ...?
    }

    proc stripchart {pathName args} {
        # Creates a stripchart widget. A stripchart uses strip elements as its default element type. It uses the same
        # graph widget infrastructure and common components as `graph`, but elements created through the generic
        # `GRAPHINST element` interface are strip elements by default. Configuration options supplied when the widget
        # is created are the same options accepted later by `GRAPHINST configure`.
        # pathName - Tk pathname of the stripchart widget to create.
        # option - graph widget configuration option.
        # value - value for the configuration option.
        # Returns: The pathname of the newly created stripchart widget.
        #
        # Example:
        # ```tcl
        # stripchart .s -title "Example stripchart" -width 800 -height 500
        # pack .s -fill both -expand yes
        # ```
        # Synopsis: pathName ?option value ...?
    }

    proc polar {pathName args} {
        # Creates a polar graph widget. A polar widget uses polar elements as its default element type and represents
        # data in the Cartesian complex plane, where X is the real coordinate and Y is the imaginary coordinate.
        # pathName - Tk pathname of the polar widget to create.
        # option - graph widget configuration option.
        # value - value for the configuration option.
        # Returns: The pathname of the newly created polar widget.
        #
        # The `-representation` option selects either a conventional polar grid or a Smith-chart grid. The underlying
        # element coordinates remain Cartesian in both representations.
        #
        # Polar elements may use ordinary X/Y data or may obtain their data directly from a complex Rbc vector with
        # the element `-cdata` option. Complex data may represent reflection coefficient, impedance, or admittance.
        #
        # Unless `-aspect` is explicitly configured, a polar widget automatically adjusts the physical plotting-area
        # aspect ratio so that one X data unit and one Y data unit have the same screen scale. This keeps polar circles
        # and Smith-chart circles circular even when the mapped X and Y numerical ranges have different spans.
        #
        # Example:
        # ```tcl
        # vector create gamma -type complex
        # gamma set {{0 0} {0.25 0.4} {-0.2 0.6}}
        #
        # polar .p -representation smith -width 600 -height 500
        # .p element create trace -cdata gamma -smooth natural
        # pack .p -fill both -expand yes
        # ```
        # Synopsis: pathName ?option value ...?
    }

    namespace export graph barchart stripchart polar trackgraph
}

namespace eval ::rbc::GRAPHINST {
    variable _ruff_ns_opts {
        -heading {Graph widget instance `GRAPHINST` command}
        -excludeprocs {.*}
    }

    variable _ruff_preamble {
        Commands in this namespace document operations accepted by graph, barchart, stripchart, polar and trackgraph widget
        instances.

        `GRAPHINST` is used below as a placeholder for the actual widget command:

        ```tcl
        graph .g
        .g configure -title "Example"
        ```

        The common widget instance interface is shared by these graph types; track-specific differences are
        documented in [::rbc::TRACKGRAPH]. The main difference is the default
        element type used by the `element` operation.

        | Widget created by | Default element type |
        |-------------------|----------------------|
        | `graph`           | line                 |
        | `barchart`        | bar                  |
        | `stripchart`      | strip                |
        | `polar`           | polar                |
        | [::rbc::trackgraph] | line (tracks also accept strip elements) |

        Explicit `line` and `bar` operations are also available independently of the widget's default element type.

        Graph widgets contain several components with their own command interfaces:

        | Operation                            | Component                             |
        |--------------------------------------|---------------------------------------|
        | `axis`                               | virtual axes                          |
        | `xaxis`, `x2axis`, `yaxis`, `y2axis` | axes mapped to graph margins          |
        | `element`                            | elements of the widget's default type |
        | `line`                               | line elements                         |
        | `bar`                                | bar elements                          |
        | `marker`                             | graph markers                         |
        | `pen`                                | drawing pens                          |
        | `legend`                             | graph legend                          |
        | `grid`                               | graph grid                            |
        | `crosshairs`                         | interactive crosshairs                |
        | `postscript`                         | PostScript output                     |
        | `svg`                                | SVG output                            |
        | `pdf`                                | PDF output                            |

        These component interfaces are documented separately. The `track` component is documented in
        [::rbc::TRACKGRAPH].

        ## Margins
        The graph has four margins surrounding the plotting area. Their sizes are normally calculated automatically
        from axes, axis titles, tick labels, the graph title, and the legend.

        The margin options:
        ```text
        -bottommargin
        -leftmargin
        -rightmargin
        -topmargin
        ```

        override the automatically calculated size when set to a positive screen distance. Setting a margin size to `0`
        restores automatic sizing.

        The corresponding options:
        ```text
        -bottomvariable
        -leftvariable
        -rightvariable
        -topvariable
        ```

        can be used to observe the actual calculated margin sizes. After layout and drawing, Rbc writes the current
        size of each configured margin to the specified global Tcl variable.

        For example:
        ```tcl
        graph .g -leftvariable leftSize -bottomvariable bottomSize

        pack .g -fill both -expand yes
        update idletasks

        puts "left margin: $leftSize"
        puts "bottom margin: $bottomSize"
        ```

        ## Plotting area
        The outer graph background and the plotting-area background are configured independently.

        ```tcl
        graph .g -background grey90 -plotbackground white -plotrelief sunken -plotborderwidth 2
        ```

        `-plotpadx` and `-plotpady` add space immediately around the plotting surface. Each option accepts either one
        distance:
        ```tcl
        .g configure -plotpadx 10
        ```

        or two distances for the two sides:
        ```tcl
        .g configure -plotpadx {5 15}
        .g configure -plotpady {10 20}
        ```

        ## Aspect ratio
        A positive `-aspect` value constrains the plotting area to a requested width-to-height ratio.

        For example:
        ```tcl
        .g configure -aspect 1.0
        ```

        requests a square plotting area, while:
        ```tcl
        .g configure -aspect 1.5
        ```

        requests a plotting area whose width is 1.5 times its height.

        Rbc satisfies the requested ratio by reducing the usable width or height of the plotting area; it does not
        enlarge the widget. Set `-aspect` to `0` to disable the constraint.

        ## Layout
        For simple cartesian graph without legend and with all default axes shown, example of layout and corresponding
        dimensions:

        ```tcl
        set graph [graph .g -width 600 -height 600]
        $graph configure -plotpadx 20 -plotpady 20 -title {Title example} -plotborderwidth 5 -plotrelief sunken

        $graph axis configure x -hide no -title {x axis}
        $graph axis configure y -hide no -title {y axis}
        $graph axis configure x2 -hide no -title {x2 axis}
        $graph axis configure y2 -hide no -title {y2 axis}

        grid $graph -row 0 -column 0
        ```

        #ruffopt excludedformats nroff
        ![layout](images/layout.svg)
        #ruffopt excludedformats {}

        ## Coordinate systems
        Graph widgets use two coordinate systems:

        * **graph coordinates** are the numeric data values represented by the axes
        * **window coordinates** are pixel positions within the widget.

        The `transform` operation converts graph coordinates to window coordinates, while `invtransform` performs the
        reverse conversion.

        The general `transform` and `invtransform` operations use the graph's primary X and Y axes. To transform a
        value using a particular axis, use that axis's `transform` or `invtransform` operation.
        Trackgraphs use [::rbc::TRACKGRAPH::transform] and [::rbc::TRACKGRAPH::invtransform] to select a track.

        ## Polar and Smith charts
        A widget created with [::rbc::polar] uses the ordinary Rbc graph coordinate system but provides specialized
        Polar and Smith-chart grid representations.

        Polar data are always represented internally as Cartesian coordinates:
        ```text
        x = real
        y = imaginary
        ```

        The `-representation` option changes the grid and associated labels; it does not reinterpret ordinary X/Y
        element data as radius/angle pairs.

        For example:
        ```tcl
        set polar [polar .p -width 600 -height 500 -representation polar]
        $polar grid on
        $polar element create trace -data {1 0 0.5 0.5 0 1 -0.5 0.5}
        $polar axis configure x -min -1 -max 1
        $polar axis configure y -min -1 -max 1

        grid $polar -sticky news
        grid columnconfigure . 0 -weight 1
        grid rowconfigure . 0 -weight 1
        ```

        #ruffopt excludedformats nroff
        ![polar_cartesian](images/polar_cartesian.svg)
        #ruffopt excludedformats {}

        The same Cartesian coordinates may be displayed with a Smith grid:
        ```tcl
        .p configure -representation smith
        ```

        #ruffopt excludedformats nroff
        ![smith_cartesian](images/smith_cartesian.svg)
        #ruffopt excludedformats {}

        Element data can be interpreted differently that rectangular coordinates, for example, as a angle/radius pair,
        or complex gamma/impedance/admittance, for more details please check [POLARELEMENT] chapter.

        `-representation` is a graph option (database name `representation`, class `Representation`).
        It accepts `polar` (the default) or `smith`. The graph also owns `-aspect`.
        Tick lists, label anchors, formatters, and Smith contour selection belong to [::rbc::GRID].
        Configure them with `.p grid configure`, not `.p configure` or widget creation options.

        ### Automatic equal-unit aspect
        Polar and Smith geometry requires equal physical scaling of the Cartesian X and Y dimensions. Otherwise a
        circle in the complex plane would be displayed as an ellipse.

        A newly created polar widget therefore uses automatic equal-unit aspect handling when `-aspect` has not been
        explicitly supplied. The nominal value returned by:

        ```tcl
        .p cget -aspect
        ```

        is `1.0`, but the physical plotting-area width-to-height ratio is automatically derived from the current
        numerical spans of the grid's mapped X and Y axes.

        For example, with:

        ```text
        X range = -3.5 .. 1.3     span = 4.8
        Y range = -1.5 .. 1.5     span = 3.0
        ```

        the plotting area is made approximately `4.8 / 3.0 = 1.6` times wider than it is high. One X unit and one Y
        unit therefore occupy the same number of pixels and the Smith unit circle remains circular.

        This automatic calculation follows the axes selected by:

        ```tcl
        .p grid configure -mapx axisName -mapy axisName
        ```

        and is recalculated if those mappings or axis ranges change.

        Supplying `-aspect` explicitly selects the normal fixed plotting-area aspect semantics instead:

        ```tcl
        polar .p -aspect 1.0
        ```

        An aspect supplied through the Tk option database is likewise considered explicit. With an explicit aspect,
        unequal numerical X and Y spans can intentionally distort circles.

        `-invertxy` is supported by automatic equal-unit scaling.

        ### Polar autoscaling without visible elements
        Plot-hidden and normally hidden elements do not contribute to automatic axis limits.

        For a Polar representation, if a grid-mapped axis has no contributing visible element data, Rbc supplies a
        neutral `-1` to `+1` fallback range for that axis. This keeps an empty Polar widget, or a Polar widget whose
        plotted elements have all been hidden with `-hideplot`, in a usable state with a visible Polar grid.

        The fallback is used only when that grid axis has no visible data contribution. It does not constrain or extend
        an axis whose range is already determined by visible element data.

        When a hidden element is made visible again, normal data-driven autoscaling resumes.

        ### Limitations and domain rules
        Polar and Smith grids require linear Cartesian axes. If either mapped grid axis uses `-logscale yes`, the
        specialized grid and its labels are suppressed.

        A conventional Polar grid does not require the origin to be visible. Radial circles are displayed whenever
        they intersect the current Cartesian viewport, and angular spokes are clipped positive rays from the Polar
        origin. When the origin is outside the viewport, only spokes whose positive rays cross the visible area are
        drawn.

        Radial labels require their corresponding point on the positive zero-degree ray to be visible. Angular labels
        use the normal circular layout when a complete centered circle fits inside the viewport; otherwise they are
        placed at the visible ends of their clipped spokes.

        Smith grids do not clip element data to the unit circle.

        Polar coordinates supplied through ordinary `-data`, `-x`, and `-y` options are Cartesian X/Y coordinates;
        they are not `{radius angle}` values.

        Smoothing does not implicitly close a trace. To draw a closed data loop, include the first point again as the
        final point.

        The `step` smoothing mode remains Cartesian step-and-hold interpolation. It is not a radial/angular stepping
        mode.

        Singular impedance or admittance conversions are omitted from the mapped trace and create a real trace break.
        Smoothing is applied independently to valid continuous runs and never bridges such a gap.

        ## Stacked tracks
        [::rbc::trackgraph] creates a widget with shared X axes and independent Y axes in named tracks.
        See [::rbc::TRACKGRAPH] for layout, ownership, inversion, resizing, dividers and the track command API.
        Common widget options and component commands remain documented here.

        ## Rendering backend
        `-renderer native|cairo` selects the screen renderer. Builds configured with `--enable-cairo` default to
        `cairo`; builds without Cairo default to `native`. Explicit options override option-database defaults.
        Its option-database name is `renderer` and its class is `Renderer`.

        Cairo is optional and requires a build configured with `--enable-cairo`.
        Requesting `cairo` from a build without Cairo support returns an error.

        ```tcl
        graph .g -renderer cairo
        .g element create signal -data {0 0 1 2 2 1} -symbol none
        .g configure -renderer native
        ```

        Cairo draws solid and dashed line traces, strip segments, geometric symbols, line/strip error bars, and solid,
        stippled, or photo-tiled line areas. Active traces and symbols use Cairo too. Grid lines, non-XOR line markers
        (including arrowheads), and polygon markers also use Cairo. Mapping, decimation, and point selection remain
        shared with native rendering.

        Supported symbols are `circle`, `square`, `diamond`, `plus`, `cross`, `splus`, `scross`, `triangle`, and
        `arrow`. Their size, fill, outline, and `-maxsymbols` settings are preserved. Symbols remain partially visible
        at plot edges, including when their centers are outside. Fill passes precede outline passes, using bounded
        batches.

        Error bars retain their color, cap geometry, and `-showerrorbars` settings. They are solid, independent of
        trace dashes. A zero error-bar width retains the native one-pixel hairline.

        Line areas use the existing mapped polygon and even-odd fill rule. Stipples repeat from the widget origin, with
        crisp pattern pixels and antialiased polygon edges. An empty `-areabackground` leaves stipple gaps transparent;
        a color paints them. Solid fills use `-areaforeground`. Areas are drawn before the line's traces, error bars,
        and symbols.

        Photo tiles repeat from the toplevel window origin, matching native tile alignment. Their pixels remain sharp;
        `-antialias` controls polygon edges. Cairo composites photo alpha, including partially transparent pixels,
        against the existing graph contents. Native tiles retain their existing transparency-mask behavior. Image edits
        invalidate the cached element image.

        Bar elements use Cairo for solid/stippled fills and error bars, including active bars and named pens. Existing
        bar modes, baselines, axes, and selection mapping are shared with native rendering. Mapped rectangles retain
        crisp integer edges. Stipples retain their widget origin and transparent or colored gaps. Tk relief borders and
        value labels remain native.

        Legend line/strip samples, geometric symbols, and bar swatches also use Cairo, including external
        legends. Swatch stipples restart at the sample origin. Legend text, backgrounds, and borders retain native
        drawing. Samples use the normal pen and do not consume plot symbol limits.

        Axis lines and tick marks use Cairo with the existing color, width, and projecting caps. They draw across the
        widget margins, independently of the plot clip. Axis labels, titles, and relief backgrounds remain native. A
        zero axis `-linewidth` hides strokes, as with native rendering.

        Non-photo image tiles retain native rendering. Empty `-areaforeground` values use Cairo with the native GC
        color. Text-marker backgrounds use Cairo antialiasing and plot clipping, including rotated backgrounds. All
        text, window markers, non-photo image markers, and crosshairs retain native rendering.

        Grid and marker geometry is clipped to the plotting area. Marker color pairs, stipples, dash offsets, caps, and
        under/over ordering are preserved. Mapped segments remain independent, retaining their existing dash
        restarts. XOR markers keep native drawing and erase behavior. A line marker with an empty `-outline` also uses
        Cairo with its native GC color.

        Symbols smaller than three mapped pixels use Cairo one-pixel fills, sharp in every antialias mode. As with
        native drawing, they use only the fill color and bypass `-maxsymbols`; an empty fill hides them.

        Bitmap element symbols and their legend samples use Cairo with existing aspect-preserving scaling and mask
        behavior. Pixels stay sharp in every antialias mode. Active pens and `-maxsymbols` retain their existing
        selection rules; legend samples do not consume that limit. The scaled bitmap is converted once per pen drawing
        pass and reused for its selected symbols.

        Bitmap markers use their existing mapped bitmap and mask with Cairo clipping and color composition. Scaling,
        rotation, anchors, offsets, and layer order are preserved. Bitmap pixels stay sharp; `-antialias` affects the
        polygon background of arbitrarily rotated markers. An empty foreground uses Cairo with the native GC color.

        Photo image markers also use Cairo. Their existing anchors, offsets, scaling, and layer order are
        preserved. Cairo composites photo alpha at the mapped integer position and clips to the plot; `-antialias` does
        not resample image pixels. Source edits, resizing, and deletion refresh the marker.

        `-antialias default|none|gray|fast|good|best` selects antialiasing for Cairo geometry. Its default is
        `default`; its option-database name and class are `antialias` and `Antialias`. Native rendering ignores this
        option. Changing it invalidates the cached element image.

        `none` disables antialiasing. `gray` requests coverage antialiasing. `fast`, `good`, and `best` are
        backend-dependent quality hints; they need not produce different images. Antialiasing can vary the apparent
        brightness of a one-pixel diagonal. A wider line or `none` can make that effect less noticeable.

        ```tcl
        .g configure -renderer cairo -antialias gray
        .g element configure signal -dashes {8 4} -offdash red
        ```

        Dash lengths and offsets use the existing pen values in screen pixels. Phase continues within each mapped line
        trace and restarts for each independent strip segment. An empty `-offdash` leaves gaps transparent. A color
        paints the gaps using the existing PostScript underlay convention; `defcolor` uses the foreground color and
        produces a solid stroke.

        Two-color strip segments are stroked individually to preserve drawing order at intersections. Solid and
        single-color strip segments retain batching.

        Snapshots use the selected renderer for these primitives. PostScript and Windows metafile output retain their
        existing exporters. Switching renderers invalidates the cached element image. On Windows, mixed/Cairo marker
        passes share a temporary DIB drawing target. Existing pixels are copied once into the target and once back;
        native text and fallbacks retain display-list order. Text-only passes keep native batching. The target is
        released at the end of each pass, including snapshot rendering. Consecutive compatible solid line and
        outline-only polygon markers share a Cairo context. Each marker retains a separate stroke so overlapping
        antialiased edges keep their appearance. Style changes, arrows, dashes, fills, and native drawing end the
        run. The context is released before the marker pass ends. Native rendering remains the fallback when a Cairo
        drawing surface cannot be opened.

        Comparison of native renderer versus Cairo renderer with `-antialias default` option (demos/cairoGraph1.tcl):

        #ruffopt excludedformats nroff
        ![renderers_comparison](images/cairoGraph1.png)
        #ruffopt excludedformats {}


        ## Widget options
        The following options configure the graph widget itself. They are shared by `graph`, `barchart`, `stripchart`,
        and `polar` and may be specified when the widget is created or modified later with `GRAPHINST configure`.

        Some options, such as `-barmode`, `-barwidth`, and `-baseline`, primarily affect bar elements but are available
        on all four graph widget types.

        | Option                       | Database name         | Database class        | Description                                                                                                                                                                                                                                                                         |
        |------------------------------|-----------------------|-----------------------|-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
| `-antialias mode` | `antialias` | `Antialias` | Selects the Cairo antialiasing mode: `default`, `none`, `gray`, `fast`, `good`, or `best`. The default is `default`, which uses Cairo's default policy. This option has no effect with the native renderer. |
        | `-aspect ratio`              | `aspect`              | `Aspect`              | Sets a fixed physical width-to-height aspect ratio for the plotting area when explicitly configured. For graph, barchart, and stripchart the default is `0.0`, which disables fixed aspect enforcement. A polar widget reports a nominal default of `1.0`; when that value is implicit, Polar/Smith layout instead adjusts the effective plot aspect automatically to preserve equal X/Y data-unit scale. Explicitly supplying `-aspect` selects the normal fixed-aspect behavior. |
        | `-background color`          | `background`          | `Background`          | Sets the background used for the outer graph area and margins. The plotting area has its own `-plotbackground` option. `-bg` is a synonym.                                                                                                                                          |
        | `-barmode mode`              | `barMode`             | `BarMode`             | Controls how bar elements having the same X coordinate are arranged. Valid modes are `normal`, `infront`, `aligned`, `overlap`, and `stacked`. `normal` is equivalent to `infront`. The default is `normal`.                                                                        |
        | `-barwidth width`            | `barWidth`            | `BarWidth`            | Sets the default width of bar elements in graph-coordinate units. The value must be finite. Values less than or equal to zero are normalized to `0.1`. The default is `0.8`.                                                                                                        |
        | `-baseline value`            | `baseline`            | `Baseline`            | Sets the baseline from which bars are drawn. The value must be finite. The default is `0.0`. Logarithmic Y axes use positive values directly and otherwise fall back to `1.0`.                                                                                                                                                                                        |
        | `-borderwidth width`         | `borderWidth`         | `BorderWidth`         | Sets the width of the 3-D border around the outside of the widget. The appearance of the border is controlled by `-relief`. `-bd` is a synonym.                                                                                                                                     |
        | `-bottommargin size`         | `bottomMargin`        | `Margin`              | Sets the requested size of the bottom margin. A value of `0` lets the graph calculate the required size automatically. `-bm` is a synonym.                                                                                                                                          |
        | `-bottomvariable varName`    | `bottomVariable`      | `BottomVariable`      | Names a global Tcl variable that is updated with the actual size of the bottom margin after graph layout. An empty value disables the variable update.                                                                                                                              |
        | `-bufferelements boolean`    | `bufferElements`      | `BufferElements`      | Enables caching of the plotted elements in a backing pixmap. This can improve redraw performance when elements remain unchanged while markers, legends, or other overlays are updated. The default is `1`.                                                                          |
        | `-buffergraph boolean`       | `bufferGraph`         | `BufferGraph`         | Enables double-buffering of the complete graph. When enabled, the graph is first rendered into a pixmap and then copied to the widget window, reducing visible redraw flicker. The default is `1`.                                                                                  |
        | `-cursor cursor`             | `cursor`              | `Cursor`              | Specifies the mouse cursor displayed over the graph widget. The default is `crosshair`.                                                                                                                                                                                             |
        | `-data string`               | `data`                | `Data`                | Stores application-defined data associated with the graph widget. The graph rendering code does not interpret this value; it may be used by Tcl code or bindings to associate additional information with the widget.                                                               |
        | `-datacommand command`       | `dataCommand`         | `DataCommand`         | Stores an application-defined command string associated with the graph. The graph core currently does not invoke this command automatically.                                                                                                                                        |
        | `-font fontName`             | `font`                | `Font`                | Specifies the font used for the graph title.                                                                                                                                                                                                                                        |
        | `-foreground color`          | `foreground`          | `Foreground`          | Specifies the foreground color of the graph title. `-fg` is a synonym.                                                                                                                                                                                                              |
        | `-halo distance`             | `halo`                | `Halo`                | Sets the default maximum screen distance used when searching for a closest data point or element. Operations that provide their own halo value override this setting. The default is `2m`.                                                                                          |
        | `-height distance`           | `height`              | `Height`              | Specifies the requested height of the graph widget. The default is `4i`.                                                                                                                                                                                                            |
        | `-highlightbackground color` | `highlightBackground` | `HighlightBackground` | Specifies the color used for the traversal highlight area when the widget does not have keyboard focus.                                                                                                                                                                             |
        | `-highlightcolor color`      | `highlightColor`      | `HighlightColor`      | Specifies the color used for the traversal highlight when the widget has keyboard focus.                                                                                                                                                                                            |
        | `-highlightthickness width`  | `highlightThickness`  | `HighlightThickness`  | Specifies the width of the keyboard-focus highlight around the widget. The default is `2`.                                                                                                                                                                                          |
        | `-invertxy boolean`          | `invertXY`            | `InvertXY`            | Swaps the placement and orientation of the logical X and Y axes. When enabled, X axes are displayed vertically and Y axes horizontally. The default is `0`.                                                                                                                         |
        | `-justify justify`           | `justify`             | `Justify`             | Specifies the justification of multi-line graph title text. Valid values are `left`, `center`, and `right`. The default is `center`.                                                                                                                                                |
        | `-leftmargin size`           | `leftMargin`          | `Margin`              | Sets the requested size of the left margin. A value of `0` lets the graph calculate the required size automatically. `-lm` is a synonym.                                                                                                                                            |
        | `-leftvariable varName`      | `leftVariable`        | `LeftVariable`        | Names a global Tcl variable that is updated with the actual size of the left margin after graph layout. An empty value disables the variable update.                                                                                                                                |
        | `-plotbackground color`      | `plotBackground`      | `Background`          | Specifies the background color of the plotting area. This is independent of the outer `-background` color. The default is white.                                                                                                                                                    |
        | `-plotborderwidth width`     | `plotBorderWidth`     | `BorderWidth`         | Sets the width of the 3-D border surrounding the plotting area. Its appearance is controlled by `-plotrelief`.                                                                                                                                                                      |
        | `-plotpadx pad`              | `plotPadX`            | `PlotPad`             | Sets horizontal padding around the plotting area. `pad` may contain one screen distance, applied to both sides, or two distances specifying the left and right padding separately. The default is `8`.                                                                              |
        | `-plotpady pad`              | `plotPadY`            | `PlotPad`             | Sets vertical padding around the plotting area. `pad` may contain one screen distance, applied to both sides, or two distances specifying the top and bottom padding separately. The default is `8`.                                                                                |
        | `-plotrelief relief`         | `plotRelief`          | `Relief`              | Specifies the 3-D relief of the plotting area. Valid values are the standard Tk relief values. The default is `sunken`.                                                                                                                                                             |
        | `-relief relief`             | `relief`              | `Relief`              | Specifies the 3-D relief of the outer graph widget. Valid values are the standard Tk relief values. The default is `flat`.                                                                                                                                                          |
| `-renderer name` | `renderer` | `Renderer` | Selects the screen renderer: `native` or `cairo`. The default is `cairo` when compiled with Cairo support, otherwise `native`. Selecting `cairo` without that support reports an error. |
        | `-rightmargin size`          | `rightMargin`         | `Margin`              | Sets the requested size of the right margin. A value of `0` lets the graph calculate the required size automatically. `-rm` is a synonym.                                                                                                                                           |
        | `-rightvariable varName`     | `rightVariable`       | `RightVariable`       | Names a global Tcl variable that is updated with the actual size of the right margin after graph layout. An empty value disables the variable update.                                                                                                                               |
        | `-shadow shadow`             | `shadow`              | `Shadow`              | Specifies the shadow used when drawing the graph title. An empty value disables the title shadow.                                                                                                                                                                                   |
        | `-takefocus focus`           | `takeFocus`           | `TakeFocus`           | Controls whether the graph participates in keyboard focus traversal. It has the same interpretation as the standard Tk `-takefocus` option. The default is an empty value.                                                                                                          |
        | `-tile image`                | `tile`                | `Tile`                | Specifies an image used to tile the background of the graph margins. An empty value disables tiling and uses the normal `-background` instead.                                                                                                                                      |
        | `-tracklayout mode` | `trackLayout` | `TrackLayout` | Track layout policy; defaults to `fit`. `scroll` preserves requested track sizes. See [::rbc::TRACKGRAPH]. |
        | `-trackscrollcommand commandPrefix` | `trackScrollCommand` | `TrackScrollCommand` | Optional command prefix called with track-list `first last` scrollbar fractions after display. Empty disables it. |
        | `-trackresize boolean` | `trackResize` | `TrackResize` | Enables mouse dragging of separators in trackgraph widgets. Default `no`; ordinary graphs reject `yes`. Native track layout commands remain available when disabled. See [::rbc::TRACKGRAPH]. |
        | `-title text`                | `title`               | `Title`               | Specifies the graph title. An empty value suppresses the title.                                                                                                                                                                                                                     |
        | `-topmargin size`            | `topMargin`           | `Margin`              | Sets the requested size of the top margin. A value of `0` lets the graph calculate the required size automatically. `-tm` is a synonym.                                                                                                                                             |
        | `-topvariable varName`       | `topVariable`         | `TopVariable`         | Names a global Tcl variable that is updated with the actual size of the top margin after graph layout. An empty value disables the variable update.                                                                                                                                 |
        | `-width distance`            | `width`               | `Width`               | Specifies the requested width of the graph widget. The default is `5i`.                                                                                                                                                                                                             |

        ## Tk option database
        Graph widgets and their components participate in Tk's option database.

        Every configurable option has three names:

        | Kind           | Example      |
        |----------------|--------------|
        | Command option | `-linewidth` |
        | Database name  | `lineWidth`  |
        | Database class | `LineWidth`  |

        The command option is used with `configure` and `cget`:
        ```tcl
        .g element configure signal -linewidth 2
        ```

        The database name and database class are used by Tk's `option` command:
        ```tcl
        option add *Graph.signal.lineWidth 2
        option add *Graph.Element.LineWidth 2
        ```

        The first form targets the option by component and database name. The second targets all matching components by
        resource class and option database class.

        RBC uses the same option-database mechanism for graph subcomponents even though most of them are not separate
        Tk widgets. When a component is initialized, RBC performs option lookup using a temporary child window having
        the component's resource name and resource class.

        ### Component resource names and classes

        | Component      | Resource name                                 | Resource class  |
        |----------------|-----------------------------------------------|-----------------|
        | Axis           | axis name, such as `x`, `y`, or `temperature` | `Axis`          |
        | Element        | element name                                  | `Element`       |
        | Pen            | pen name                                      | `Pen`           |
        | Bitmap marker  | marker name                                   | `BitmapMarker`  |
        | Image marker   | marker name                                   | `ImageMarker`   |
        | Line marker    | marker name                                   | `LineMarker`    |
        | Polygon marker | marker name                                   | `PolygonMarker` |
        | Text marker    | marker name                                   | `TextMarker`    |
        | Window marker  | marker name                                   | `WindowMarker`  |
        | Legend         | `legend`                                      | `Legend`        |
        | Grid           | `grid`                                        | `Grid`          |
        | Crosshairs     | `crosshairs`                                  | `Crosshairs`    |
        | PostScript     | `postscript`                                  | `Postscript`    |

        Thus an option-database entry can target either a whole component class:
        ```tcl
        option add *Graph.Axis.Color navy
        option add *Graph.Element.LineWidth 2
        option add *Graph.Pen.Color blue
        option add *Graph.TextMarker.Foreground darkgreen
        ```

        or a particular named component:
        ```tcl
        option add *Graph.x.color red
        option add *Graph.signal.lineWidth 3
        option add *Graph.activeLine.color green
        option add *Graph.annotation.foreground purple
        ```

        The graph widget class in these examples is `Graph`. For `barchart` and `stripchart` widgets, use their
        corresponding `Barchart` and `Stripchart` resource classes.

        Named elements, pens, and markers are represented internally as component resource names. For these components,
        RBC converts the first character of the object name to lowercase for option-database lookup. For example, an
        element named `Signal` uses the component resource name `signal`.

        ### When option database values are applied
        Option database values are read when a component is initialized. They therefore normally need to be installed
        before that component is created.

        For a dynamically created element:
        ```tcl
        graph .g
        option add *Graph.Element.Color navy
        .g element create signal
        ```

        the new element obtains its initial color from the option database.

        To target one particular element:
        ```tcl
        graph .g
        option add *Graph.signal.color red
        .g element create signal
        .g element create reference
        ```

        only `signal` receives that instance-specific value.

        Components created automatically with the graph, such as the built-in axes, active pens, legend, grid,
        crosshairs, and PostScript component, should have their option-database entries installed before the graph
        widget itself is created:
        ```tcl
        option add *Graph.Grid.Color grey70
        option add *Graph.Legend.Foreground navy
        option add *Graph.activeLine.color red
        graph .g
        ```

        Adding an option-database entry later does not reconfigure components that have already been initialized.
        Use the component's `configure` operation to change an existing object.

        Explicit options supplied when an object is created override values obtained from the option database:
        ```tcl
        option add *Graph.Element.Color navy
        .g element create signal -color red
        ```

        Here `signal` is red.

        ### Discovering database names and classes
        The `configure` query forms report the exact database name and database class used by an option.

        For example:

        ```tcl
        set info [.g element configure signal -linewidth]
        lassign $info optionName databaseName databaseClass defaultValue currentValue
        ```

        The five values correspond to:
        ```text
        command option
        database name
        database class
        default value
        current value
        ```

        The same technique works for axes, pens, markers, the legend, grid, crosshairs, PostScript, and the graph widget
        itself.

        For example:
        ```tcl
        .g axis configure x -color
        .g pen configure activeLine -color
        .g marker configure annotation -foreground
        .g legend configure -foreground
        .g grid configure -linewidth
        .g crosshairs configure -color
        .g postscript configure -landscape
        ```

        Synonym options such as `-bg`, `-fg`, and `-bd` refer to the database name and class of their canonical option.

        Some options intentionally have no option-database name or class. Such options can be set only through the
        component command. For example, a marker's `-name` option is not read from the option database.

        ## Bar modes
        The `-barmode` option determines how bars from different elements are arranged when they use the same X
        coordinate.

        | Mode      | Description                                             |
        |-----------|---------------------------------------------------------|
        | `normal`  | Equivalent to `infront`. This is the default.           |
        | `infront` | Draws each successive bar in front of the previous bar. |
        | `stacked` | Stacks successive bars vertically.                      |
        | `aligned` | Places bars side by side.                               |
        | `overlap` | Places bars side by side with a small overlap.          |

        For example:
        ```tcl
        barchart .b
        .b configure -barmode stacked
        ```

        #ruffopt excludedformats nroff
        `-barmode normal`:

        ![barmode_normal](images/barmode_normal.svg)

        `-barmode stacked`:

        ![barmode_stacked](images/barmode_stacked.svg)

        `-barmode aligned`:

        ![barmode_aligned](images/barmode_aligned.svg)

        `-barmode overlap`:

        ![barmode_overlap](images/barmode_overlap.svg)
        #ruffopt excludedformats {}


        The `-barmode`, `-barwidth`, and `-baseline` options have no significant effect unless bar elements are present
        in the graph.

        ## Buffering
        Two separate buffering mechanisms are available.

        `-buffergraph` controls double-buffering of the complete widget. With double-buffering enabled, Rbc renders the
        graph to an off-screen pixmap and copies the completed image to the window.

        `-bufferelements` controls an additional backing store containing the plot region and data elements. It is
        useful when elements themselves are unchanged but the graph must frequently redraw objects placed above them,
        such as markers.

        Element buffering is only used when graph double-buffering is also enabled.

        For graphs whose element data or axes change very frequently, disabling `-bufferelements` may avoid maintaining
        a cache that cannot be reused.

        For example:
        ```tcl
        .g configure -buffergraph yes -bufferelements no
        ```

        ## SVG output
        The [SVG][::rbc::SVG] component exports the complete graph as SVG, independently of the screen renderer
        and without requiring Cairo. It is available on graph, stripchart, barchart and polar widgets.

        ```tcl
        .g svg configure -width 1200 -height 800
        set document [.g svg output]
        .g svg output plot.svg
        ```

        See [::rbc::SVG] for command syntax, options, examples and export limitations.

        ## PDF output
        The [PDF][::rbc::PDF] component writes a single-page PDF without Cairo or an external converter:
        ```tcl
        .g pdf output plot.pdf -width 16c -height 12c
        set bytes [.g pdf output]
        ```
        It shares the graph export abstraction with SVG and PostScript. Returned data is a binary bytearray.
        See [::rbc::PDF] for options, font/encoding restrictions and image-capture limitations.

        ## Named fonts and display scaling
        Graph, stripchart, barchart and polar widgets follow changes to named Tk fonts. After `font configure`, pending
        idle work refreshes graph and axis titles, tick labels, legends (including external legends), text-marker
        geometry and element value labels. This includes named pens and active pens. No explicit graph or component
        reconfiguration is needed.

        ```tcl
        font create PlotFont -family Helvetica -size 10
        .g axis configure x -tickfont PlotFont
        .g legend configure -font PlotFont
        font configure PlotFont -size 16
        update idletasks
        ```

        Font changes invalidate graph layout and buffered drawing. They do not change data or explicitly configured
        axis limits. Automatic tick placement can change to fit the new text dimensions.

        This notification handles font resources, not automatic resizing of every pixel-valued option. Explicit pixel
        sizes remain pixels. Physical screen distances are converted through Tk when configured; changing `tk scaling`
        does not promise to rescale every existing graph option. Configure application scaling before creating
        widgets. Toolbar icon and spacing adaptation is separate from this core behavior.

        ## Numeric values and expressions
        Expression support is option-specific. The option tables say when a value accepts a Tcl numeric expression, or
        when each list item accepts one. Integer expressions must produce integer results; numeric expressions may
        produce floating-point results. The option's range and domain rules still apply.

        Axis limits and explicit ticks, literal element data and error lists, marker coordinates, numeric dash lists,
        and the legend's `@x,y` position support expressions. Other numeric options do not automatically evaluate
        arithmetic. For example, `-valueoffset` requires two integer pixel values, and crosshair `-position` accepts Tk
        pixel distances rather than the legend's integer expressions.

        Brace an expression to pass it to Rbc without Tcl substituting it first:
        ```tcl
        .g axis configure x -max {2 * acos(-1)}
        .g legend configure -position {@10+5,20+10}
        ```

        For list options, each expression must be one list item. Use inner braces around expressions containing spaces;
        the outer braces delimit the entire list:
        ```tcl
        .g element configure signal -x {0 {1.0 / 3} {2.0 / 3} 1}
        .g grid configure -dashes {{2 * 3} {1 + 1}}
        ```

        Use floating-point operands when a fractional result is needed: `1 / 3` is integer division, while `1.0 / 3`
        produces a fraction. Tcl expression functions and substitutions follow normal Tcl expression rules. Outer
        braces defer substitution; they do not disable it when Rbc evaluates the expression.

        Expressions are evaluated when Rbc parses the option. They are not live formulas: changing a referenced Tcl
        variable does not itself update the graph. Supply the option again to evaluate it with new values. An existing
        Rbc vector name supplied to a vector-capable data option is handled as a vector reference, not an expression;
        vector notifications provide its automatic updates.

        For an option that does not evaluate expressions, calculate the value explicitly:
        ```tcl
        set gap 8
        .g element configure signal -valueoffset [list 0 [expr {-$gap - 4}]]
        ```

        ## Application data
        The `-data` option is an application-defined storage slot. Rbc stores the supplied value but does not interpret
        it in the C graph implementation.

        For example:
        ```tcl
        .g configure -data [dict create source simulation1 quantity voltage]
        set graphData [.g cget -data]
        ```

        `-datacommand` similarly stores a command string. It is retained as part of the graph configuration interface,
        but the current graph core does not automatically execute it.

        ## Graph change notification
        Graph, barchart, stripchart, and polar widgets generate `<<RbcGraphChanged>>` when changes to the on-screen
        coordinate mapping or plotted element geometry have been processed for display.

        Applications can use this event to refresh information that depends on the displayed graph without waiting for
        pointer motion. Typical causes include:

        * Axis range changes, including zooming, panning, and stripchart automatic scrolling.
        * Widget resizing or layout changes that alter the plotting area.
        * Element data changes that require plotted geometry to be remapped, even when axis limits remain fixed.

        The event is also generated for the initial mapped display. It is a notification that mapping work occurred,
        not a comparison of old and new coordinates: reconfiguration can generate an event even when the resulting axis
        limits or geometry are unchanged.

        ### Geometry event delivery and data
        The event is queued on the graph widget after its on-screen display pass completes. Delivery is asynchronous;
        it does not occur immediately inside the command that changes an axis or element.

        Several changes handled by one display pass are combined into one notification. Changes requiring further
        display passes can produce further notifications. Applications must not assume one event per configuration
        command or data update.

        An unmapped widget defers notification until it can complete an on-screen display with a usable plotting area.

        No application data payload is attached to the event. Use `%W` to identify the graph and query its current
        state. Because delivery is queued, that state may include changes made after the display pass that queued the
        event.

        For example, this binding records the current primary axis limits:
        ```tcl
        bind .g <<RbcGraphChanged>> {
            set ::graphView [dict create x [%W axis limits x] y [%W axis limits y]]
        }
        ```

        ### Scope
        `<<RbcGraphChanged>>` is not a notification for every repaint. Exposure or focus redraws and marker-only
        updates do not generate it unless coordinate mapping or element remapping is also required.

        Temporary mappings used for PostScript output do not generate this event. A subsequent on-screen display that
        restores or changes the screen mapping can generate it normally.

        The event does not reposition ordinary graph markers or change the configured crosshair position. Applications
        implement any additional tracking behavior in their bindings. The graphtoolbar already uses this notification
        to refresh its enhanced crosshair annotations.

        Event handlers should avoid repeatedly changing axes or element data in response to the notification: such
        changes can schedule another display and another notification.

        ## Axis change notifications
        Graph, barchart, stripchart, and polar widgets provide two axis events:

        * `<<RbcAxisChanged>>` reports successful axis configuration and changes to effective numeric limits.
          Configuration includes log/linear mode, descending direction, major/minor ticks, formatting commands,
          titles, colors, visibility, and other axis options. Reapplying an option with the same value also counts
          as configuration; the event does not compare every option's old and new values.
        * `<<RbcAxisLimitsChanged>>` reports changes to the bounds returned by `axis limits`. These include
          zooming, panning, scrolling, and automatic limits derived from element data. Cosmetic configuration
          does not generate this event when the resulting numeric limits are unchanged.

        ### Axis event delivery and data
        Both events are queued on the graph after an on-screen display pass with a usable plotting area. An unmapped
        graph defers delivery until it can display. Each event combines all affected axes from that display pass;
        several commands before a redraw can therefore produce one event. Changes followed by a return to the
        previously displayed limits before redraw do not produce a limits-change event.

        `%W` identifies the graph and `%d` is a Tcl list of axis names. Each name appears once; ordering is
        unspecified. Hidden axes and named axes outside the margins are included. Initial display, and the first
        display after creating an axis, announce its limits through both events. Deleted axes are skipped when building
        the notification; deletion itself is not an axis-change notification.

        The payload identifies affected axes, not an old/new snapshot. Query the graph for current limits and
        configuration. Because delivery is asynchronous, the current state may be newer than the display that queued
        the event, and an axis may have been deleted in the meantime.

        ```tcl
        proc RecordAxisState {graph axes} {
            foreach axis $axes {
                if {$axis ni [$graph axis names]} {
                    continue
                }
                dict set ::axisState $graph $axis [dict create limits [$graph axis limits $axis] logscale\
                                                           [$graph axis cget $axis -logscale]]
            }
        }
        bind .g <<RbcAxisChanged>> [list RecordAxisState %W %d]
        ```

        Axis queries, failed configuration, and temporary PostScript or snapshot mappings do not themselves generate
        these events. A later screen display compares the effective limits with the previous screen display. Data
        changes inside fixed bounds, marker updates, hover highlighting, and ordinary repainting do not generate axis
        events unless an axis is configured or its effective limits change.

        These events do not report every change in tick-label placement or screen geometry. Use `<<RbcGraphChanged>>`
        for mapping and layout updates, including resizing without changed numeric limits. Log/linear switching is
        always covered by `<<RbcAxisChanged>>`, but only generates `<<RbcAxisLimitsChanged>>` if the resulting numeric
        bounds change. Logarithmic bounds are reported in data units, just as by `axis limits`.

        ## Legacy graph helpers
        `package require rbc` also loads `graph.tcl`, providing the historical global `Rbc_*` helper commands for
        existing applications. These are a backward-compatibility option, not the recommended interface for new
        applications. They use only Tcl/Tk and native RBC commands; they do not require argparse.
        `package require rbc::vector` does not load them.

        For new interactive graph interfaces, prefer `package require rbc::graphtoolbar`. **Using the legacy helpers
        together with `rbc::graphtoolbar` is not recommended, especially on the toolbar's embedded graph:** both manage
        mouse/legend bindings, markers, and axis limits. Both packages can be loaded in one application, with each
        interaction system used on separate widgets.

        The following commands operate on an already-created native graph widget:

        - `Rbc_ActiveLegend graph`: highlight legend entries on pointer entry; click to toggle element highlighting.
        - `Rbc_Crosshairs graph`: enable red crosshairs following pointer motion.
        - `Rbc_ResetCrosshairs graph on|off`: enable or disable the legacy crosshair bindings.
        - `Rbc_ZoomStack graph`: select two corners with button 1 to zoom; button 3 cancels selection or restores
          the previous limits. Cartesian x/x2 and y/y2 axes are handled. This is not the toolbar's polar/Smith control.
        - `Rbc_RemoveZoomStack graph`: disable legacy zoom, cancel its timers and pending selection, and restore
          the axis limits saved before the first completed zoom (including automatic limits). Other legacy features
          and application markers remain active. Repeated removal is harmless; `Rbc_ZoomStack` enables zoom again.
        - `Rbc_ClosestPoint graph`: Control-button-2 displays and briefly flashes the closest data point.
        - `Rbc_PrintKey graph`: Shift-button-3 release opens the legacy PostScript dialog.
        - `Rbc_PostScriptDialog graph`: open that dialog directly. Print retains the historical behavior of writing
          `out.ps` in the current directory, replacing that file if it already exists. Reset rereads the graph's
          current PostScript settings into the dialog. Cancel closes it.

        ```tcl
        package require rbc
        rbc::graph .g
        pack .g -fill both -expand yes
        .g element create signal -xdata {0 1 2} -ydata {0 1 0}
        Rbc_ActiveLegend .g
        Rbc_Crosshairs .g
        Rbc_ZoomStack .g
        Rbc_ClosestPoint .g
        Rbc_PrintKey .g
        ```

        The helpers retain their global command names; no `namespace import` is necessary. Loading the package only
        defines the helpers: it does not enable interactions or change global option-database defaults. Requiring the
        package again does not reset existing interaction state. Repeating `Rbc_ZoomStack` preserves that graph's
        completed zoom history and current axis limits, while cancelling an unfinished selection. Timers, private
        bindings, and per-widget state are cleared when the graph is destroyed.

        The helpers reserve marker names `zoomTitle`, `zoomOutline`, `zoomText_A`, `zoomText_B`, `rbcClosest_*`, and
        `line.rbcClosest_*`, and bindtags beginning with `legacy-rbc-`, `crosshairs-`, `zoom-`, `print-`,
        `closest-point-`, and `select-region-`. Their `rbc::*` implementation procedures and state arrays are private.
    }

    proc track {operation args} {
        # Manages named plot regions in a trackgraph. See [::rbc::TRACKGRAPH] for operations and options.
        # operation - create, configure, cget, names, order, sashpos, separator, delete, bbox, identify, transform, invtransform or legend.
        # args - Arguments for the selected operation.
        # Synopsis: operation ?args ...?
    }

    proc strip {operation args} {
        # Manages strip elements through the ordinary element interface, using the strip element type on creation.
        # operation - An element operation, such as create, configure or delete.
        # args - Arguments for the selected operation.
        # Synopsis: operation ?args ...?
    }

    proc axis {args} {
        # Performs an operation on the graph's virtual axes. Virtual axes can be created, deleted, configured,
        # transformed, bound to events, and mapped to graph margins.
        #
        # See [AXIS] for the complete virtual-axis command and option reference.
        # Returns: Result of the selected axis operation.
        # Synopsis: operation ?args ...?
    }

    proc bar {args} {
        # Performs an element operation using bar elements explicitly, regardless of the default element type of the
        # graph widget.
        # Returns: Result of the selected element operation.
        # Synopsis: operation ?args ...?
    }

    proc cget {option} {
        # Queries the current value of a graph widget configuration option.
        # option - graph widget configuration option.
        #
        # See [Widget options] for the complete list of supported options and their descriptions.
        # Returns: Current value of `option`.
    }

    proc configure {args} {
        # Queries or modifies graph widget configuration options. With no arguments, returns configuration information
        # for all widget options. With one option, returns configuration information for that option. With one or more
        # option/value pairs, changes the specified options.
        # option - graph widget configuration option.
        # value - new value for the option.
        #
        # See [Widget options] for the complete list of supported options and their descriptions.
        # Returns: Configuration information when querying; nothing when setting options.
        # Synopsis:
        # Synopsis: option
        # Synopsis: ?option value ...?
    }

    proc crosshairs {args} {
        # Performs an operation on the graph crosshairs.
        # Returns: Result of the selected crosshairs operation.
        # Synopsis: operation ?args ...?
    }

    proc element {args} {
        # Performs an operation on graph elements using the widget's default element type. The default is a line
        # element for `graph`, a bar element for `barchart`, and a strip element for `stripchart`.
        # Returns: Result of the selected element operation.
        # Synopsis: operation ?args ...?
    }

    proc extents {item} {
        # Gives back the size or geometry of a graph component.
        # item - component whose extents are requested. Must be `plotheight`, `plotwidth`, `plotarea`, `legend`,
        #   `leftmargin`, `rightmargin`, `topmargin`, or `bottommargin`.
        # Returns: For `plotheight`, `plotwidth`, and the margin items, returns one size in pixels. For `plotarea` and
        #   `legend`, returns a list of four values in the form `x y width height`.
    }

    proc grid {args} {
        # Performs an operation on the graph grid.
        # Returns: Result of the selected grid operation.
        # Synopsis: operation ?args ...?
    }

    proc inside {winX winY} {
        # Tests whether a window coordinate lies inside the graph plotting area.
        # winX - X coordinate in window coordinates.
        # winY - Y coordinate in window coordinates.
        # Returns: Boolean value indicating whether the point is inside the plotting area.
    }

    proc invtransform {winX winY} {
        # Converts a point from window coordinates to graph coordinates using the graph's primary X and Y axes.
        # `winX` and `winY` may be Tcl expressions that evaluate to numeric values.
        # winX - X coordinate in window coordinates.
        # winY - Y coordinate in window coordinates.
        # Returns: A two-element list containing the corresponding graph coordinates `x y`.
    }

    proc legend {args} {
        # Performs an operation on the graph legend.
        # Returns: Result of the selected legend operation.
        # Synopsis: operation ?args ...?
    }

    proc line {args} {
        # Performs an element operation using line elements explicitly, regardless of the default element type of the
        # graph widget.
        # Returns: Result of the selected element operation.
        # Synopsis: operation ?args ...?
    }

    proc marker {args} {
        # Performs an operation on graph markers.
        # Returns: Result of the selected marker operation.
        # Synopsis: operation ?args ...?
    }

    proc pen {args} {
        # Performs an operation on graph pens. Pens define reusable drawing attributes for line and bar elements.
        # Returns: Result of the selected pen operation.
        # Synopsis: operation ?args ...?
    }

    proc postscript {args} {
        # Performs a PostScript output operation for the graph.
        # Returns: Result of the selected PostScript operation.
        # Synopsis: operation ?args ...?
    }

    proc pdf {args} {
        # Performs a PDF output operation. See [::rbc::PDF] for options and limitations.
        # Returns: Option information, a PDF bytearray, or nothing when writing a file.
        # Synopsis: cget option
        # Synopsis: configure ?option? ?value ...?
        # Synopsis: output ?file? ?option value ...?
    }

    proc svg {args} {
        # Performs an SVG output operation. See [::rbc::SVG] for options and export limitations.
        # Returns: Option information, an SVG XML string, or nothing when writing a file.
        # Synopsis: cget option
        # Synopsis: configure ?option? ?value ...?
        # Synopsis: output ?file? ?option value ...?
    }

    proc snap {args} {
        # Renders a snapshot of the graph. By default the snapshot is written to an existing Tk photo image. On
        # Windows, snapshots can also be written as Windows Metafile (`wmf`) or Enhanced Metafile (`emf`) output.
        # name - for `photo` format, name of an existing Tk photo image; for `wmf` or `emf`, output filename. On
        #   Windows, `CLIPBOARD` writes metafile output to the clipboard instead of a file.
        # -format format - output format. `photo` is available on all platforms. `wmf` and `emf` are available on
        #   Windows. The default is `photo`.
        # -height height - height of the rendered snapshot. If omitted, the current widget height is used.
        # -width width - width of the rendered snapshot. If omitted, the current widget width is used.
        # Returns: Nothing.
        #
        # Example:
        # ```tcl
        # image create photo graphImage
        # .g snap graphImage
        #
        # .g snap graphImage -width 1200 -height 800
        # ```
        # Synopsis: name ?-format format? ?-height height? ?-width width?
    }

    proc transform {x y} {
        # Converts a point from graph coordinates to window coordinates using the graph's primary X and Y axes.
        # `x` and `y` may be Tcl expressions that evaluate to numeric values.
        # x - X coordinate in graph coordinates.
        # y - Y coordinate in graph coordinates.
        # Returns: A two-element list containing the corresponding integer window coordinates `x y`.
    }

    proc x2axis {args} {
        # Performs an operation on the axis mapped to the secondary X-axis margin. With a normal graph orientation
        # this is the top margin.
        # Returns: Result of the selected margin-axis operation.
        # Synopsis: operation ?args ...?
    }

    proc xaxis {args} {
        # Performs an operation on the axis mapped to the primary X-axis margin. With a normal graph orientation this
        # is the bottom margin.
        # Returns: Result of the selected margin-axis operation.
        # Synopsis: operation ?args ...?
    }

    proc y2axis {args} {
        # Performs an operation on the axis mapped to the secondary Y-axis margin. With a normal graph orientation
        # this is the right margin.
        # Returns: Result of the selected margin-axis operation.
        # Synopsis: operation ?args ...?
    }

    proc yaxis {args} {
        # Performs an operation on the axis mapped to the primary Y-axis margin. With a normal graph orientation this
        # is the left margin.
        # Returns: Result of the selected margin-axis operation.
        # Synopsis: operation ?args ...?
    }

    namespace export *
    namespace ensemble create
}

namespace eval ::rbc::TRACKGRAPH {
    variable _ruff_ns_opts {
        -heading {Trackgraph layout}
        -excludeprocs {.*}
    }

    variable _ruff_preamble {
        This page documents widgets created by [::rbc::trackgraph] and their named-track operations.
        `TRACKGRAPH` is a fictional documentation prefix for `widgetPath track`, not a runtime command.
        For example, `TRACKGRAPH create voltage -yaxes volts` means `.g track create voltage -yaxes volts`.
        The procedures below describe that component API; they are not Tcl wrappers to invoke directly.

        Common widget commands and configuration are described in [::rbc::GRAPHINST]. Use [::rbc::AXIS] for axes,
        [::rbc::LINEELEMENT] and [::rbc::STRIPELEMENT] for traces, [::rbc::MARKER] for annotations, and
        [::rbc::LEGEND] for global and track-local legends. Toolbar integration is described in [::rbc::graphtoolbar].

        ## Stacked tracks
        `rbc::trackgraph` is one native graph window containing named vertical plot regions. It reuses the graph's
        line and strip elements, renderers and SVG, PDF and PostScript exporters. It does not create child graphs.
        The axis-region approach is also used by BLT's `-stackaxes` feature; RBC tracks explicitly group one or
        more Y axes and their elements into a row.

        ```tcl
        rbc::trackgraph .g -width 800 -height 500
        .g axis create voltageY -title Voltage
        .g axis create currentY -title Current
        .g track create voltage -weight 2 -yaxes voltageY
        .g track create current -weight 1 -yaxes currentY
        .g line create voltageTrace -track voltage -mapy voltageY -xdata time -ydata voltage
        .g strip create currentTrace -track current -mapy currentY -xdata time -ydata current
        pack .g -fill both -expand yes
        ```

        Tracks initially appear in creation order from top to bottom. Use `track order` to change their order without
        recreating axes, elements or markers. Every track receives the same horizontal plotting bounds.

        The common left margin accommodates the widest set of track Y axes, including titles and tick labels. X axes
        remain widget-wide: elements select them with `-mapx`, and ordinary `xaxis use` and `x2axis use` control their
        display. Independent X axes need not have matching tick positions. By default, tracks inherit the graph's
        [::rbc::GRID] settings: `grid -mapx` selects the shared X axis, and a nonempty `grid -mapy` enables grid lines
        from each track's first Y axis. An empty axis selection disables that direction. See [grid] for independent
        grid settings within each track.

        | Track option | Default | Meaning |
        |--------------|---------|---------|
        | `-weight` | `1.0` | Positive finite share of remaining layout space after track minima are allocated; at most 1000000. |
        | `-minheight` | `40` | Positive minimum requested plot height, or width when inverted, in Tk screen-distance units. |
        | `-height` | `160` | Requested plot height in scroll layout, or width when inverted; from 1 to 1000000 pixels, with Tk screen-distance units accepted. The effective size is at least `-minheight`. Ignored in fit layout. |
        | `-yaxes` | empty | List of existing Y axes assigned exclusively to this track and displayed in its left margin (bottom when inverted). |

        ### Scrolling tracks and their data

        The default `-tracklayout fit` divides the available plot space using `-weight` and `-minheight`, as before.
        With `-tracklayout scroll`, each track retains `max(-height, -minheight)` pixels and adjacent tracks have
        a 12-pixel gap. Content may extend beyond the visible viewport. Track weights are ignored in this mode.
        Scrolling moves tracks vertically, or horizontally with `-invertxy yes`; shared X axes remain fixed.
        Tracks do not change their data ranges or rescale when partially visible. Drawing and picking use only
        the visible part. `bbox` returns that visible rectangle; a fully hidden track has zero size along the
        scrolling direction. Transforms still use the full track geometry and may return offscreen coordinates.

        Use [view] for the track list and [yview] for local data scrolling. They are independent:

        ```tcl
        .g configure -tracklayout scroll -trackscrollcommand {.tracks set}
        .g track configure voltage -height 280
        ttk::scrollbar .tracks -orient vertical -command {.g track view}
        .g axis configure voltageY -scrollmin -10 -scrollmax 10 -scrollcommand {.volts set}
        ttk::scrollbar .volts -orient vertical -command {.g track yview voltage -mapy voltageY}
        ```

        Position the scrollbar widgets with ordinary Tk geometry management. For an inverted graph, use horizontal
        scrollbars. Each track may have a separate local scrollbar, and each of its Y axes may have one too.
        Existing axis `-scrollmin`, `-scrollmax`, `-scrollincrement`, and `-scrollcommand` settings apply to local
        scrolling; the graph's `-trackscrollcommand` receives the track-list viewport's first and last fractions.
        Use finite axis scroll limits when the full data range is not a useful scroll region.

        Separator dragging in scroll layout changes the preceding track's requested `-height` and the total
        content extent. It leaves the next track's size and both weights unchanged. Escape restores the original
        size. In fit layout, dragging continues to redistribute adjacent weights. A change to the list viewport,
        orientation or layout mode cancels active separator/toolbar gestures rather than reusing stale pixels.

        SVG, PDF and PostScript export the viewport at the current scroll offset, with track sizes expressed in
        output pixels; a differently sized export can include more or fewer tracks. Export does not change the
        screen scroll position or notify its scrollbar. Local axes, legends, grids and ordinary markers are
        clipped to the viewport. Window markers retain the existing partial-child-clipping limitations described
        in [::rbc::MARKER]; fully offscreen track windows are hidden.
        `demos/trackgraph1.tcl` includes a track-list scrollbar and separate local Y scrollbars.

        Assign axes with `track configure -yaxes`, rather than `yaxis use`. An axis may belong to only one track.
        Elements must specify both `-track` and a `-mapy` axis belonging to that track. Change both options in one
        `element configure` call to move an element. An axis in use by an element cannot be detached, and an axis owned
        by a track cannot be deleted until detached. These ownership checks include markers, even hidden markers or
        markers with empty coordinates, and Y axes selected by independently configured track grids. Hiding an axis
        hides its decorations, not its track. Lists and RBC vectors retain their ordinary ownership and notification behaviour.

        Track transforms default to shared axis `x` and the track's first Y axis. Use `-mapx` or `-mapy` to select
        alternatives. Ordinary graph-level `transform` and `invtransform` are ambiguous in a trackgraph and report
        an error; individual `axis transform` and `axis invtransform` operations remain available.

        The layout fits the available height. After minimum heights, spare space is distributed by weight.
        Tracks have a 12-pixel gap, reduced in very small windows. If minimum heights do not fit, they are scaled
        proportionally to avoid forcing the window larger. Resizing and export recompute the layout. Elements and
        closest-point searches are restricted to their own track; normal, descending and logarithmic Y scales work
        independently. Horizontal zoom or pan is performed through the shared X axes; vertical navigation uses the
        desired track's Y axes. The native crosshair's vertical line spans all tracks and its horizontal line follows
        the pointer's row.

        Line and strip elements retain their existing `-decimate none|auto` option; the default remains `none`.
        Set `-decimate auto` on each desired element. Density is measured along the shared physical X-axis span,
        not by the number of tracks: plot width normally, plot height when inverted. Local Y mapping and clipping
        still use the owning track. The existing eligibility rules apply, including fallback for smoothed traces
        and unsupported fill/style combinations. Data-domain caches remain per element and follow vector updates;
        closest-point queries retain original samples, and exports use full geometry. See [::rbc::LINEELEMENT].

        Each row also owns an optional local legend, hidden by default. For example:
        ```tcl
        .g track legend voltage configure -hide no -position right -anchor ne
        ```

        shows only that row's element labels. Local legends overlay and clip to the track; they do not change shared X
        alignment. The global legend remains independent. See [::rbc::LEGEND] for options, bindings and export
        behavior.

        ### Inverted tracks
        Set `.g configure -invertxy yes` to rotate the layout into side-by-side columns. Track order runs left to
        right, shared X axes run vertically, and each track's Y axes run horizontally below its column. The common
        bottom margin accommodates the largest set of track Y axes. Shared X grid lines are horizontal; local Y grid
        lines are vertical. Track weights divide the available width. The existing `-minheight` option now requests a
        minimum column width; it retains its name and value when toggling orientation. Tiny layouts compress those
        minima proportionally in either orientation.

        `track identify` and `track sashpos` take a physical X coordinate in inverted mode. `track bbox`, `track
        separator`, `track transform` and `track invtransform` always use physical widget X/Y coordinates. Axis names
        and data X/Y values retain their meaning. Markers, picking, local legends and exports follow the column
        rectangle. Legend positions and anchors remain physical directions: `right` is still the right edge. Global and
        local legends can be shown together, as in `demos/trackgraph1.tcl`. Toolbar navigation works in either
        orientation; changing orientation during a gesture cancels it.

        ### Reordering and resizing tracks
        `track order` takes the full list of existing track names, with no omissions or duplicates. Ownership, axis
        configuration, vector subscriptions and marker bindings remain unchanged. Legend order still follows element
        order, independently of track order.

        ```tcl
        .g track order {current voltage}
        set y [.g track sashpos current]
        .g track sashpos current [expr {$y+30}]
        .g configure -trackresize yes
        ```

        `track sashpos` changes the two adjacent tracks' weights while preserving their sum. Other tracks keep their
        weights and allocated space, subject to one-pixel layout rounding. Requested positions are clamped by the
        adjacent minimum heights and the positive weight range. The returned position is the actual one. If minimum
        heights already consume the available space, the separator cannot move. The resulting weights continue to
        govern later window resizes and exports; no fixed pixel sizes are stored.

        `-trackresize` is a graph option with database name `trackResize`, class `TrackResize`, and default `no`. Only
        trackgraph widgets accept `yes`. With it enabled, the standard `Trackgraph` class bindings show a vertical
        resize cursor over a row gap, or a horizontal cursor between inverted columns. Drag with button 1 to resize the
        adjacent tracks; release to keep the result, or press Escape to restore the weights from the start of the
        drag. The gesture borrows keyboard focus so Escape works, then restores the previous focus on release,
        cancellation or invalidation, provided focus is still on the graph. If there was no previous focus or its
        widget has been destroyed, focus returns to the graph's toplevel. Focus moved elsewhere during dragging is left
        alone; a graph already focused before dragging remains focused.  Pointer events in plot interiors keep their
        ordinary behaviour. Changing the track list/order, orientation, or disabling resizing invalidates the gesture
        on the next motion or release, without restoring obsolete weights. Destroying the widget removes its gesture
        state. These dependency-free bindings are loaded with `package require rbc`.

        Optional divider lines make separator gaps visible. `-trackseparatorcolor` (database name
        `trackSeparatorColor`, class `TrackSeparatorColor`) defaults to empty, disabling the lines.
        `-trackseparatorwidth` (`trackSeparatorWidth`, `TrackSeparatorWidth`) defaults to `1` and accepts a positive Tk
        screen distance. These graph options affect only trackgraphs. For example:

        ```tcl
        .g configure -trackresize yes -trackseparatorcolor gray60 -trackseparatorwidth 2
        ```

        Each divider follows the centre returned by `track sashpos`, horizontally for rows and vertically for inverted
        columns. Its width is limited to the available gap. It does not change track geometry or enlarge the existing
        separator hit area, and can be shown without enabling dragging. Dividers appear in SVG, PDF and PostScript
        exports when `-decorations yes` is selected.

        Applications may call the native order and separator operations regardless of `-trackresize`; the option
        controls only the supplied mouse bindings. Custom interaction code can leave it disabled and use the same
        commands. Keep the `Trackgraph` class in `bindtags` to use the standard bindings; a widget binding that returns
        `break` before the class binding can intentionally suppress them.

        Trackgraph supports line and strip elements in both orientations. Bar/polar elements are rejected. Track
        scrolling is not yet provided. The optional `rbc::graphtoolbar` package accepts `-type trackgraph`: zoom and
        pan use shared X axes and the starting track's Y axes; wheel zoom and coordinate annotations follow the pointed
        track. Separator dragging remains available. See [::rbc::graphtoolbar] and `demos/trackgraph1.tcl` for the
        interaction controls.  Markers can select a track with `-track name -mapy axisName`; see [::rbc::MARKER] for
        clipping, ownership and restrictions. See `demos/trackgraph1.tcl` for multiple shared X axes, live vector
        updates, track weights, annotations and shared horizontal navigation.

    }

    proc create {name args} {
        # Creates a uniquely named track and returns its name. Options are `-yaxes`, `-weight` and `-minheight`.
        # name - Track name.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name ?option value ...?
    }

    proc configure {name args} {
        # Configures a track. With no options returns its option dictionary; with one option returns its value.
        # name - Track name.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name ?option ?value ...??
    }

    proc cget {name option} {
        # Returns the current value of a track option.
        # name - Track name.
        # option - Track option name.
        # Synopsis: name option
    }

    proc names {} {
        # Returns track names in layout order: top to bottom, or left to right when inverted.
    }

    proc order {args} {
        # Returns the layout order, or sets a complete permutation of all track names. Invalid lists leave it unchanged.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: ?nameList?
    }

    proc sashpos {name args} {
        # Returns or moves the separator after the named track. Its coordinate is physical Y normally, physical X when
        # inverted. The last track has no separator.
        # name - Track name.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name ?coordinate?
    }

    proc separator {x y} {
        # Returns the track before the separator gap at physical widget coordinates, or an empty string.
        # x - X coordinate.
        # y - Y coordinate.
        # Synopsis: x y
    }

    proc delete {name} {
        # Deletes an empty track, retaining its axes. Move or delete its elements and markers first.
        # name - Track name.
        # Synopsis: name
    }

    proc bbox {name} {
        # Returns the track plotting rectangle as `left top right bottom` in physical widget pixels.
        # name - Track name.
        # Synopsis: name
    }

    proc identify {coordinate} {
        # Returns the track containing a physical Y coordinate, or X when inverted; returns empty in a gap.
        # coordinate - Widget pixel coordinate along the track layout direction.
        # Synopsis: coordinate
    }

    proc transform {name x y args} {
        # Maps data coordinates through the shared X axis and local Y axis into physical widget coordinates. Defaults to
        # axis `x` and the first owned Y axis.
        # name - Track name.
        # x - X coordinate.
        # y - Y coordinate.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name x y ?-mapx axis? ?-mapy axis?
    }

    proc invtransform {name x y args} {
        # Maps physical widget coordinates back to data using the selected shared X and local Y axes.
        # name - Track name.
        # x - X coordinate.
        # y - Y coordinate.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name x y ?-mapx axis? ?-mapy axis?
    }

    proc view {args} {
        # Queries or changes the track-list viewport. With no arguments, returns `first last` fractions of the
        # content extent. `moveto` places the requested fraction at the leading viewport edge; `scroll` moves by
        # 20-pixel units or pages of 90% of the viewport. Movement is clamped to the content boundaries.
        # Fit layout, an empty track list, or content smaller than the viewport returns `0.0 1.0`.
        # Changing this view never modifies data-axis limits. Bind a scrollbar to `widgetPath track view` and set
        # the graph's `-trackscrollcommand` to its `set` command prefix.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: ?moveto fraction|scroll number units|pages?
    }

    proc yview {name args} {
        # Queries or changes the local Y-axis view using the existing [::rbc::AXIS] `view` machinery. With `-mapy`,
        # only that owned Y axis is used. Without it, queries use the first Y axis and mutations apply to all Y
        # axes owned by the track, honoring each axis's scroll range, increment, log scale and direction.
        # Invalid multi-axis requests leave every destination's requested limits unchanged. An axis must belong
        # to the selected track; a track without Y axes reports an error. Track position and shared X axes do not
        # change. A scrollbar should select one axis and use that axis's `-scrollcommand` callback.
        # name - Track name.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name ?-mapy axis? ?moveto fraction|scroll number units|pages?
    }

    proc grid {name operation args} {
        # Queries or configures the named track's grid. Supports the [::rbc::GRID] operations `configure`, `cget`,
        # `on`, `off` and `toggle`, with Cartesian options `-color`, `-dashes`, `-hide`, `-linewidth`, `-mapx`,
        # `-mapy` and `-minor`.
        #
        # Until its first successful configuration or visibility change, a track inherits the graph-wide grid.
        # Queries do not change inheritance. The first mutation copies the current effective settings, then applies
        # the requested changes. Later graph-wide grid changes do not affect that track. Failed changes preserve
        # both the previous settings and inheritance. Deleting and recreating the track restores inheritance.
        #
        # `-mapx` selects an existing shared X axis; `-mapy` selects an existing Y axis owned by this track, including
        # any of its additional Y axes. An empty string disables that direction. Inherited `-mapy` reports the
        # first owned Y axis, or empty when the graph disables Y grid lines or the track owns no Y axes.
        # A selected local Y axis cannot be detached until the grid is remapped or that direction is disabled.
        #
        # Lines are clipped to the owning track and follow resizing, reordering, axis range changes and inversion.
        # X lines are vertical normally and horizontal when inverted; Y lines rotate correspondingly. Native,
        # Cairo, SVG, PDF and PostScript output use the same local configuration. A local visible grid is drawn
        # even when the graph-wide grid is hidden.
        #
        # ```tcl
        # .g grid configure -hide no -minor no
        # .g track grid voltage configure -mapx x -mapy voltageY -color steelblue
        # .g track grid current configure -mapx samples -mapy currentY -color darkorange
        # .g track grid current off
        # .g track grid voltage cget -mapx
        # ```
        #
        # name - Track name.
        # operation - Local grid operation.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name operation ?args ...?
    }

    proc legend {name operation args} {
        # Operates on the named track's local legend. See [::rbc::LEGEND] for `configure`, `cget`, `bbox`, `get`,
        # `activate`, `deactivate` and `bind`.
        # name - Track name.
        # operation - Local legend operation.
        # args - Optional arguments shown in the synopsis.
        # Synopsis: name operation ?args ...?
    }

    namespace export *
    namespace ensemble create
}
