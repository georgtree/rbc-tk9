# Deliberately scoped to maintained modules, not the whole tree.
PROJECT_NAME           = "RBC developer reference"
PROJECT_NUMBER         = @VERSION@
OUTPUT_DIRECTORY       = @OUTPUT@
INPUT                  = @PUBLIC_HEADER@ @RENDER_HEADER@ @NATIVE_HEADER@ @DISPATCH_HEADER@ @CHAIN_HEADER@ @LIST_HEADER@ @IMAGE_HEADER@ @TILE_HEADER@ @TEXT_HEADER@ @FONT_HEADER@ @EXPORT_HEADER@ @PS_HEADER@ @GRAPH_HEADER@ @GRAPH_SOURCE@ @GRID_SOURCE@ @HAIRS_SOURCE@ @LINE_SOURCE@ @BAR_SOURCE@ @POLAR_SOURCE@ @CAIRO_SOURCE@ @SVG_SOURCE@ @PDF_RENDER_SOURCE@ @PS_RENDER_SOURCE@ @EXPORT_RENDER_HEADER@ @EXPRESSION_SOURCE@ @FFT_SOURCE@ @SPLINE_SOURCE@ @VECTOR_SOURCE@ @VECTOR_HEADER@ @VECTOR_INT_HEADER@ @VECTOR_COMMAND_SOURCE@ @BIND_HEADER@ @BIND_SOURCE@ @CONFIG_HEADER@ @TRACK_HEADER@ @TRACK_SOURCE@ @LEGEND_HEADER@ @ELEMENT_HEADER@ @WINOP_SOURCE@ @EPS_SOURCE@ @GEOMETRY_SOURCE@ @LIST_SOURCE@ @SCROLL_SOURCE@ @MATH_HEADER@
STRIP_FROM_PATH        = @ROOT@
FULL_PATH_NAMES        = YES
RECURSIVE              = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
ENABLE_PREPROCESSING   = YES
# Sphinx's C signature parser does not accept the legacy register qualifier.
# Remove it, the INLINE portability macro and public EXTERN decoration only
# in documentation input; leave compiled declarations unchanged.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            = RBC_HAVE_CAIRO=1 EXTERN:= INLINE= register= "TCL_FORMAT_PRINTF(a,b)="
SEARCH_INCLUDES        = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
# Coverage is incremental. Strict builds validate existing contracts and links.
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = @WARNINGS@
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = NO
HAVE_DOT               = NO
