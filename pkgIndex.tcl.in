if {[package vsatisfies [package provide Tcl] 9.0-]} {
    set rbcLib @PKG_LIB_FILE9@
} else {
    set rbcLib @PKG_LIB_FILE8@
}

package ifneeded @PACKAGE_NAME@ @PACKAGE_VERSION@ [list apply {{dir lib} {
    package require Tk
    load [file join $dir $lib]
    source [file join $dir graphtoolbar.tcl]
}} $dir $rbcLib]

unset rbcLib
