if {[package vsatisfies [package provide Tcl] 9.0-]} {
    set rbcLib @PKG_LIB_FILE9@
} else {
    set rbcLib @PKG_LIB_FILE8@
}

package ifneeded rbc::vector @PACKAGE_VERSION@ [list load [file join $dir $rbcLib] Rbc]

package ifneeded @PACKAGE_NAME@ @PACKAGE_VERSION@ [list apply {{dir version} {
    package require -exact rbc::vector $version
    package require Tk
    ::rbc::_initTk
    set ::rbc::library [file normalize $dir]
}} $dir @PACKAGE_VERSION@]

package ifneeded rbc::graphtoolbar @PACKAGE_VERSION@ [list apply {{dir version} {
    package require -exact rbc $version
    source [file join $dir graphtoolbar.tcl]
    package provide rbc::graphtoolbar $version
}} $dir @PACKAGE_VERSION@]

unset rbcLib
