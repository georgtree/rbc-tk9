test zoomInteractive-16 {wheel zoom with inverted axes} -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {}\
                        -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {wheel zoom with inverted axes} -invertxy yes {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min -100 -max 100
    $widget graph element create line1 -data {0 -100 5 0 10 100}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/3}]
    set y [expr {$top+$height*2/3}]
    # With -invertxy, the X data dimension is physical widget Y and
    # the Y data dimension is physical widget X.
    set expected [list {*}[ExpectedWheelLimits $graph x 0.5 $y] {*}[ExpectedWheelLimits $graph y 0.5 $x]]
    GenerateGraphWheelEvent $graph $x $y 120 20
    set actual [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    approxNestedEqual $actual $expected
} -result true -cleanup {
    destroy $widget
}

test zoomInteractive-17 {each wheel zoom step is reversible with right-click pop}\
        -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {}\
                        -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {each wheel zoom step is reversible with right-click pop} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min -100 -max 100
    $widget graph element create line1 -data {0 -100 5 0 10 100}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/3}]
    set y [expr {$top+$height*2/3}]
    set state0 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphWheelEvent $graph $x $y 120 20
    set state1 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphWheelEvent $graph $x $y 120 20
    set state2 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-3> $x $y 20
    GenerateGraphEvent $graph <ButtonRelease-3> $x $y 20
    set pop1 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-3> $x $y 20
    GenerateGraphEvent $graph <ButtonRelease-3> $x $y 20
    set pop2 [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    sleep $defaultDelay
    expr {![approxNestedEqual $state0 $state1] && ![approxNestedEqual $state1 $state2] &&\
                  [approxNestedEqual $pop1 $state1] && [approxNestedEqual $pop2 $state0]}
} -result 1 -cleanup {
    destroy $widget
}

#### crosshairs
test crosshairsInteractive-1 {crosshairs with current coordinate marker}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode current]
    grid .gtb -row 0 -column 0 -sticky nsew
    pack .gtb -fill both -expand yes
    $widget graph configure -title {crosshairs with current coordinate marker} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerExistence 1
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        set markerExistence [expr {[$widget graph marker exists crosshairsText] && $markerExistence}]
    }
    return $markerExistence
}  -result 1 -cleanup {
    destroy $widget
}

test crosshairsInteractive-2 {crosshairs with closest element coordinate marker}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {crosshairs with closest element coordinate marker} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set failures [list]
    foreach x $xlist y $ylist {
        set expected [$graph element closest $x $y pointVar -along both -interpolate yes -halo 10]
        GenerateGraphEvent $graph <Motion> $x $y 5
        set actual [$graph marker exists crosshairsClosestText]
        if {$actual != $expected} {
            lappend failures [list $x $y $expected $actual]
        }
    }
    return $failures
}  -result {} -cleanup {
    destroy $widget
}

