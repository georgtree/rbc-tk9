test crosshairsInteractive-4 {interactive crosshairs with closest element coordinate marker, larger halo}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-halo 30}]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive crosshairs with closest element coordinate marker, larger halo}\
            {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set leftMargin [$widget graph extents leftmargin]
    set topMargin [$widget graph extents topmargin]
    set plotWidth [$widget graph extents plotwidth]
    set plotHeight [$widget graph extents plotheight]
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerCount 0
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        if {[$widget graph marker exists cursorText]} {
            incr markerCount
        }
    }
    return $markerCount
}  -result 45 -cleanup {
    destroy $widget
}

test crosshairsInteractive-5 {interactive crosshairs with closes element coordinate marker, multiple elements}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-single no}]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive crosshairs with closest element coordinate marker, multiple elements}\
            {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set leftMargin [$widget graph extents leftmargin]
    set topMargin [$widget graph extents topmargin]
    set plotWidth [$widget graph extents plotwidth]
    set plotHeight [$widget graph extents plotheight]
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerCount0 0
    set markerCount1 0
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        if {[$widget graph marker exists cursorText0]} {
            incr markerCount0
        }
        if {[$widget graph marker exists cursorText1]} {
            incr markerCount1
        }
    }
    return [list $markerCount0 $markerCount1]
}  -result {21 4} -cleanup {
    destroy $widget
}

test crosshairsInteractive-6 {interactive crosshairs with closes element coordinate marker, no interpolaton}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 30}]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive crosshairs with closes element coordinate marker} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set leftMargin [$widget graph extents leftmargin]
    set topMargin [$widget graph extents topmargin]
    set plotWidth [$widget graph extents plotwidth]
    set plotHeight [$widget graph extents plotheight]
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerCount 0
    set prevCoords [list]
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        if {[$widget graph marker exists cursorText]} {
            set coords [$widget graph marker configure cursorText -coords]
            if {$coords ne $prevCoords} {
                incr markerCount
            }
            set prevCoords $coords
        }
    }
    return $markerCount
}  -result 2 -cleanup {
    destroy $widget
}

#### axes
test axesInteractive-1 {interactive change of axis scale} -constraints {isInteractive isAxes} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -scaletoggle all]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive crosshairs with closes element coordinate marker} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
    set axis x
    set side bottom
} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph $axis $side] axisX axisY
    set plotX [expr {[$graph extents leftmargin] + [$graph extents plotwidth] / 2}]
    set plotY [expr {[$graph extents topmargin] + [$graph extents plotheight] / 2}]
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $axisX $axisY 500
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY 500
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $plotX $plotY 500
    return $scale
}  -result {0 1} -cleanup {
    destroy $widget
}

