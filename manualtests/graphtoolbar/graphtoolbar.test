    $widget graph element create line1 -data {0 -100 5 0 10 100}
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph x bottom] axisX axisY
    set expectedX [ExpectedWheelLimits $graph x 0.5]
    set expectedY [$graph axis limits y]
    GenerateGraphWheelEvent $graph $axisX $axisY 120 20
    set actualX [$graph axis limits x]
    set actualY [$graph axis limits y]
    sleep $defaultDelay
    expr {[approxNestedEqual $actualX $expectedX] && [approxNestedEqual $actualY $expectedY]}
} -result 1 -cleanup {
