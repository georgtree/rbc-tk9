    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox $defaultDelay
    lappend actualStates [list {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y3]\
                                  {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y4]]
    lappend expectedStates [lindex $expectedStates 0]
    return [approxNestedEqual $actualStates $expectedStates]
}  -result true  -cleanup {
    destroy $widget
}

