test zoomInteractive-5 {interactive single-stage zoom, check for disabled toolbar during selection} -match approxEqual\
        -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoomtitle -zoommark\
                        -zoomboxopts {-linewidth 1}]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive single-stage zoom, check for disabled toolbar during selection}\
            {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lappend limits {*}[$widget graph axis limits x] {*}[$widget graph axis limits y]
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox
    foreach w [winfo children [$widget subwidget toolbarFrame]] {
        lappend states [$w cget -state]
    }
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox
    GenerateGraphEvent $graph <ButtonPress-3> $bXPointBox $bYPointBox
    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox
    foreach w [winfo children [$widget subwidget toolbarFrame]] {
        lappend states [$w cget -state]
    }
    return $states
}  -result {disabled disabled disabled disabled disabled normal normal normal normal normal} -cleanup {
    destroy $widget
}

