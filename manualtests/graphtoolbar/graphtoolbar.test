### interactive features tests
set winSize {-width 700 -height 400}
set titleFont {-font {ArialNarrow 8}}

#### zoom
proc ExpectedZoomLimits {graph x1 y1 x2 y2 {xaxis x} {yaxis y}} {
    set xmin [$graph axis invtransform $xaxis $x1]
    set xmax [$graph axis invtransform $xaxis $x2]
    set ymin [$graph axis invtransform $yaxis $y1]
    set ymax [$graph axis invtransform $yaxis $y2]
    if {$xmin > $xmax} {
        lassign [list $xmax $xmin] xmin xmax
    }
    if {$ymin > $ymax} {
        lassign [list $ymax $ymin] ymin ymax
    }
    return [list $xmin $xmax $ymin $ymax]
}

proc ExpectedWheelLimits {graph axis factor {pixel {}}} {
    lassign [$graph axis limits $axis] min max
    set logscale [$graph axis cget $axis -logscale]
    if {$pixel eq {}} {
        if {$logscale} {
            set center [expr {exp((log($min)+log($max))/2.0)}]
        } else {
            set center [expr {($min+$max)/2.0}]
        }
    } else {
        set center [$graph axis invtransform $axis [expr {round($pixel)}]]
    }
    if {$logscale} {
        set logCenter [expr {log($center)}]
        set newMin [expr {exp($logCenter+(log($min)-$logCenter)*$factor)}]
        set newMax [expr {exp($logCenter+(log($max)-$logCenter)*$factor)}]
    } else {
        set newMin [expr {$center+($min-$center)*$factor}]
        set newMax [expr {$center+($max-$center)*$factor}]
    }
    return [list $newMin $newMax]
}

test zoomInteractive-1 {single-stage zoom} -match approxEqual -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoomtitle -zoommark\
                        -zoomboxopts {-linewidth 1}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {single-stage zoom} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set initial [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    set expectedStates [list $initial]
    set actualStates [list $initial]
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    lappend expectedStates [ExpectedZoomLimits $graph $aXPointBox $aYPointBox $bXPointBox $bYPointBox]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox $defaultDelay
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox $defaultDelay
    lappend actualStates [list {*}[$widget widgetcommand graph axis limits x]\
                                  {*}[$widget widgetcommand graph axis limits y]]
    GenerateGraphEvent $graph <ButtonPress-3> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox $defaultDelay
    lappend actualStates [list {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y]]
    lappend expectedStates [lindex $expectedStates 0]
    return [approxNestedEqual $actualStates $expectedStates]
}  -result true  -cleanup {
    destroy $widget
}

test zoomInteractive-2 {multi-stage zoom} -match approxEqual -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoomtitle -zoommark\
                        -zoomboxopts {-linewidth 1}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {multi-stage zoom} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set initial [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    set expectedStates [list $initial]
    set actualStates [list $initial]
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    for {set i 0} {$i<3} {incr i} {
        set expected [ExpectedZoomLimits $graph $aXPointBox $aYPointBox $bXPointBox $bYPointBox]
        GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox $defaultDelay
        GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox $defaultDelay
        GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox $defaultDelay
        GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox $defaultDelay
        lappend expectedStates $expected
        lappend actualStates [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
    }
    for {set i 0} {$i<3} {incr i} {
        GenerateGraphEvent $graph <ButtonPress-3> $bXPointBox $bYPointBox $defaultDelay
        GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox $defaultDelay
        lappend actualStates [list {*}[$graph axis limits x] {*}[$graph axis limits y]]
        lappend expectedStates [lindex $expectedStates [expr {2 - $i}]]
    }
    return [approxNestedEqual $actualStates $expectedStates]
} -result true -cleanup {
    destroy $widget
}

test zoomInteractive-3 {single-stage zoom with no title} -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoommark\
                        -zoomboxopts {-linewidth 1}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {single-stage zoom with no title} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox $defaultDelay
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox $defaultDelay
    set titleExistence [$widget graph marker exists gtbZoomTitle]
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-3> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox $defaultDelay
    return $titleExistence
}  -result 0 -cleanup {
    destroy $widget
}

