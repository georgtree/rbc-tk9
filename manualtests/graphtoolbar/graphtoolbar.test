    $widget graph configure -barwidth 0.8 -barmode aligned
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Element1 -data {7 4}
    $widget graph element create Element2 -data {7 7}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 7 2] x y
    $graph element closest $x $y info1 -along both -interpolate no -halo 1000 Element1
    $graph element closest $x $y info2 -along both -interpolate no -halo 1000 Element2
    set x [expr {round(($info1(left) + $info1(right)) / 2.0)}]
    set y [expr {round(($info1(top) + $info1(bottom)) / 2.0)}]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    lassign [MarkerWidgetCoords $graph crosshairsClosestBarLine] lineX1 lineY1 lineX2 lineY2
    set markedElement [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    list [expr {$markedElement eq {Element1}}]\
            [expr {($info1(left) != $info2(left)) || ($info1(right) != $info2(right)) }]\
            [expr {abs($lineY1 - $info1(top)) <= 1.0}] [expr {abs($lineY2 - $info1(bottom)) <= 1.0}]\
            [expr {(abs($lineX1 - ($info1(left) - 4)) <= 1.0) || (abs($lineX1 - ($info1(right) + 4)) <= 1.0)}]
} -cleanup {
    unset -nocomplain info1 info2
    destroy .gtb
} -result {1 1 1 1 1}

test crosshairsInteractive-23 {closest bar marker: overlap mode creates marker for each bar with single no}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 500 -single no}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: overlap mode creates marker for each bar with single no}\
            {*}$titleFont
    $widget graph configure -barwidth 0.8 -barmode overlap
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Element1 -data {7 4}
    $widget graph element create Element2 -data {7 7}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 7 2] x y
    $graph element closest $x $y info1 -along both -interpolate no -halo 500 Element1
    $graph element closest $x $y info2 -along both -interpolate no -halo 500 Element2
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    unset -nocomplain marker1 marker2
    foreach i {0 1} {
        set name [lindex [split [$graph marker cget crosshairsClosestText$i -text] \n] 0]
        if {$name eq {Element1}} {
            set marker1 crosshairsClosestBarLine$i
        } elseif {$name eq {Element2}} {
            set marker2 crosshairsClosestBarLine$i
        }
    }
    lassign [MarkerWidgetCoords $graph $marker1] x11 y11 x12 y12
    lassign [MarkerWidgetCoords $graph $marker2] x21 y21 x22 y22
    list [info exists marker1] [info exists marker2] [expr {abs($y11 - $info1(top)) <= 1.0}]\
            [expr {abs($y12 - $info1(bottom)) <= 1.0}] [expr {abs($y21 - $info2(top)) <= 1.0}]\
            [expr {abs($y22 - $info2(bottom)) <= 1.0}]\
            [expr {(abs($x11 - ($info1(left) - 4)) <= 1.0) || (abs($x11 - ($info1(right) + 4)) <= 1.0)}]\
            [expr {(abs($x21 - ($info2(left) - 4)) <= 1.0) || (abs($x21 - ($info2(right) + 4)) <= 1.0)}]
} -cleanup {
    unset -nocomplain info1 info2 marker1 marker2
    destroy .gtb
} -result {1 1 1 1 1 1 1 1}

test crosshairsInteractive-24 {closest bar marker: inverted graph uses horizontal dimension line}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -type barchart -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest bar marker: inverted graph uses horizontal dimension line} {*}$titleFont
    $widget graph configure -barwidth 0.8 -invertxy yes
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph element create Bar1 -data {6 8}
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 6 4] x y
    set found [$graph element closest $x $y info -along both -interpolate no -halo 2 Bar1]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    lassign [MarkerWidgetCoords $graph crosshairsClosestBarLine] lineX1 lineY1 lineX2 lineY2
    set anchor [$graph marker cget crosshairsClosestText -anchor]
    if {$anchor eq {s}} {
        set position [expr {abs($lineY1 - ($info(top) - 4)) <= 1.0}]
    } elseif {$anchor eq {n}} {
        set position [expr {abs($lineY1 - ($info(bottom) + 4)) <= 1.0}]
    } else {
        set position false
    }
    list $found [expr {abs($lineX1 - $info(left)) <= 1.0}] [expr {abs($lineX2 - $info(right)) <= 1.0}]\
            [expr {abs($lineY1 - $lineY2) <= 1.0}] $position
} -cleanup {
    unset -nocomplain info
    destroy .gtb
} -result {1 1 1 1 1}

test crosshairsInteractive-25 {closest marker: mixed bar and line elements select the correct marker type}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 10 -single yes}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest marker: mixed bar and line elements select the correct marker type}\
            {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph bar create Bar1 -data {2 8}
    $widget graph line create Line1 -data {6 2 7 2 8 2} -symbol circle
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 2 4] barX barY
    GenerateGraphEvent $graph <Motion> $barX $barY 50
    sleep $defaultDelay
    set barText [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    set barResult [list [$graph element type Bar1] $barText [$graph marker exists crosshairsClosestText]\
                           [$graph marker exists crosshairsClosestTextBox]\
                           [$graph marker exists crosshairsClosestBarLine]\
                           [$graph marker exists crosshairsClosestBitmap]]
    lassign [$graph transform 7 2] lineX lineY
    GenerateGraphEvent $graph <Motion> $lineX $lineY 50
    sleep $defaultDelay
    set lineText [lindex [split [$graph marker cget crosshairsClosestText -text] \n] 0]
    set lineResult [list [$graph element type Line1] $lineText [$graph marker exists crosshairsClosestText]\
                            [$graph marker exists crosshairsClosestTextBox]\
                            [$graph marker exists crosshairsClosestBarLine]\
                            [$graph marker exists crosshairsClosestBitmap]]
    list $barResult $lineResult
} -cleanup {
    destroy .gtb
} -result {{BarElement Bar1 1 1 1 0} {LineElement Line1 1 1 0 1}}

test crosshairsInteractive-26 {closest marker: mixed bar and line elements use independent marker types with single no}\
        -constraints {isInteractive isCrosshairs}  -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-interpolate no -halo 30 -single no}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {closest marker: mixed bar and line elements use independent marker types with\
                                            single no} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 10
    $widget graph bar create Bar1 -data {5 8}
    $widget graph line create Line1 -data {4 4 5 4 6 4} -symbol circle
    set graph [.gtb subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph transform 5 4] x y
    set barFound [$graph element closest $x $y barInfo -along both -interpolate no -halo 30 Bar1]
    set lineFound [$graph element closest $x $y lineInfo -along both -interpolate no -halo 30 Line1]
    GenerateGraphEvent $graph <Motion> $x $y 50
    sleep $defaultDelay
    unset -nocomplain barIndex lineIndex
    foreach i {0 1} {
        set marker crosshairsClosestText$i
        if {![$graph marker exists $marker]} {
            continue
        }
        set element [lindex [split [$graph marker cget $marker -text] \n] 0]
        if {$element eq {Bar1}} {
            set barIndex $i
        } elseif {$element eq {Line1}} {
            set lineIndex $i
        }
    }
    if { ![info exists barIndex] || ![info exists lineIndex] } {
        return [list found $barFound $lineFound indexes [info exists barIndex] [info exists lineIndex]]
    }
    set barResult [list [$graph marker exists crosshairsClosestText$barIndex]\
                           [$graph marker exists crosshairsClosestText${barIndex}Box]\
                           [$graph marker exists crosshairsClosestBarLine$barIndex]\
                           [$graph marker exists crosshairsClosestBitmap$barIndex]]
    set lineResult [list [$graph marker exists crosshairsClosestText$lineIndex]\
                            [$graph marker exists crosshairsClosestText${lineIndex}Box]\
                            [$graph marker exists crosshairsClosestBarLine$lineIndex]\
                            [$graph marker exists crosshairsClosestBitmap$lineIndex]]
    list $barFound $lineFound [$graph element type Bar1] [$graph element type Line1] $barResult $lineResult
} -cleanup {
    unset -nocomplain barInfo lineInfo barIndex lineIndex
    destroy .gtb
} -result {1 1 BarElement LineElement {1 1 1 0} {1 1 0 1}}

#### axes
test axesInteractive-1 {change of axis scale} -constraints {isInteractive isAxes} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -scaletoggle all]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {change of axis scale} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
    set axis x
    set side bottom
} -body {
    WaitForWindow $graph
    lassign [FindAxisPoint $graph $axis $side] axisX axisY
    set plotX [expr {[$graph extents leftmargin] + [$graph extents plotwidth] / 2}]
    set plotY [expr {[$graph extents topmargin] + [$graph extents plotheight] / 2}]
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $plotX $plotY $defaultDelay
    return $scale
}  -result {0 1} -cleanup {
    destroy $widget
}

#### cross-interactions
test crossInteractive-1 {single-stage zoom, check crosshairs marking disabling during selection}\
        -match approxEqual -constraints {isInteractive isCross} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoomtitle -zoommark\
                        -zoomboxopts {-linewidth 1} -crosshairs -crosshairsmode current]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {single-stage zoom, check crosshairs marking disabling during\
                                            selection} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox $defaultDelay
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox $defaultDelay
    set crosshairsMarkerExists [$widget graph marker exists crosshairsText]
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox $defaultDelay
    GenerateGraphEvent $graph <Motion> [expr {$bXPointBox+1}] [expr {$bYPointBox+1}] $defaultDelay
    sleep $defaultDelay
    lappend crosshairsMarkerExists [$widget graph marker exists crosshairsText]
    return $crosshairsMarkerExists
}  -result {0 1}  -cleanup {
    destroy $widget
}

