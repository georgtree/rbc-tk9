#### crosshairs
test crosshairsInteractive-1 {interactive crosshairs with current coordinate marker}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode current]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
            $widget graph configure -title {Interactive crosshairs with current coordinate marker} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set leftMargin [$widget graph extents leftmargin]
    set topMargin [$widget graph extents topmargin]
    set plotWidth [$widget graph extents plotwidth]
    set plotHeight [$widget graph extents plotheight]
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerExistence 1
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        set markerExistence [expr {[$widget graph marker exists cursorText] && $markerExistence}]
    }
    return $markerExistence
}  -result 1 -cleanup {
    destroy $widget
}

test crosshairsInteractive-2 {interactive crosshairs with closes element coordinate marker}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive crosshairs with closes element coordinate marker} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set leftMargin [$widget graph extents leftmargin]
    set topMargin [$widget graph extents topmargin]
    set plotWidth [$widget graph extents plotwidth]
    set plotHeight [$widget graph extents plotheight]
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerCount 0
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        if {[$widget graph marker exists cursorText]} {
            incr markerCount
        }
    }
    return $markerCount
}  -result 21 -cleanup {
    destroy $widget
}

