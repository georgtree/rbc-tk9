### interactive features tests
set winSize {-width 400 -height 400}
set titleFont {-font {Helvetica 10}}

#### zoom
test zoomInteractive-1 {interactive single-stage zoom} -match approxEqual -constraints {isInteractive isZoom} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoommod {Any-} -zoomtitle -zoommark\
                        -zoomboxopts {-linewidth 1}]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive single-stage zoom} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lappend limits {*}[$widget graph axis limits x] {*}[$widget graph axis limits y]
    set leftMargin [$widget graph extents leftmargin]
    set topMargin [$widget graph extents topmargin]
    set plotWidth [$widget graph extents plotwidth]
    set plotHeight [$widget graph extents plotheight]
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox 500
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox 500
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox 500
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox 500
    lappend limits {*}[$widget widgetcommand graph axis limits x] {*}[$widget widgetcommand graph axis limits y]
    GenerateGraphEvent $graph <ButtonPress-3> $bXPointBox $bYPointBox 500
    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox 500
    lappend limits {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y]
    return $limits
}  -result {0.2 2.0 16.18 185.38 0.7609756097560976 1.3902439024390245 73.708 133.492 0.2 2.0 16.18 185.38} -cleanup {
    destroy $widget
}

