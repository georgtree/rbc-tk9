    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set markerExistence 1
    foreach x $xlist y $ylist {
        GenerateGraphEvent $graph <Motion> $x $y 5
        if {[$widget graph marker exists crosshairsText]} {
            set markerExistence [expr {[$widget graph marker exists crosshairsTextBox] && $markerExistence}]
        }
    }
    return $markerExistence
}  -result 0 -cleanup {
    destroy $widget
}

test crosshairsInteractive-12 {interactive crosshairs with current coordinate marker and inverted axes}\
