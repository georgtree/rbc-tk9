test crosshairsInteractive-4 {crosshairs with closest element coordinate marker, larger halo}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-halo 30 -hide no}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {crosshairs with closest element coordinate marker, larger halo}\
            {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set failures [list]
    foreach x $xlist y $ylist {
        set expected [$graph element closest $x $y pointVar -along both -interpolate yes -halo 30]
        GenerateGraphEvent $graph <Motion> $x $y 5
        set actual [$graph marker exists crosshairsClosestText]
        if {$actual != $expected} {
            lappend failures [list $x $y $expected $actual]
        }
    }
    return $failures
}  -result {} -cleanup {
    destroy $widget
}

test crosshairsInteractive-5 {crosshairs with closes element coordinate marker, multiple elements}\
        -constraints {isInteractive isCrosshairs} -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -crosshairs -crosshairsmode closest\
                        -crosshairsclosestopts {-single no -hide no}]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {crosshairs with closest element coordinate marker, multiple elements}\
            {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    set steps 100
    set xlist [lseq $aXPointBox to $bXPointBox by [expr {($bXPointBox-$aXPointBox)/double($steps)}]]
    set ylist [lseq $aYPointBox to $bYPointBox by [expr {($bYPointBox-$aYPointBox)/double($steps)}]]
    set failures [list]
    foreach x $xlist y $ylist {
        set count 0
        foreach elem {line1 line2} {
            if {[$graph element closest $x $y pointVar -along both -interpolate yes -halo 10 $elem]} {
                incr count
            }
        }
        set expected [list [expr {$count >= 1}] [expr {$count >= 2}]]
        GenerateGraphEvent $graph <Motion> $x $y 5
        set actual [list [$graph marker exists crosshairsClosestText0] [$graph marker exists crosshairsClosestText1]]
        if {$actual != $expected} {
            lappend failures [list $x $y $expected $actual]
        }
    }
    return $failures
}  -result {} -cleanup {
    destroy $widget
}

