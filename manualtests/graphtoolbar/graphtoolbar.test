}

test zoomInteractive-13 {wheel zoom includes hidden used axes but not unused axes} -constraints {isInteractive isZoom}\
        -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -zoom -zoomwheel -zoomwheelmod {} -zoomwheelscale 2.0]
    pack .gtb -fill both -expand yes
    $widget graph configure -title {wheel zoom includes hidden used axes but not unused axes} {*}$titleFont
    $widget graph axis configure x -min 0 -max 10
    $widget graph axis configure y -min 0 -max 20
    $widget graph axis create xHidden -min 100 -max 200 -hide yes
    $widget graph axis create yHidden -min 1000 -max 2000 -hide yes
    $widget graph axis create xUnused -min -10 -max -5
    $widget graph axis create yUnused -min -100 -max -50
    $widget graph x2axis use xHidden
    $widget graph y2axis use yHidden
    $widget graph element create line1 -data {0 0 5 10 10 20}
    $widget graph element create line2 -data {100 1000 150 1500 200 2000} -mapx xHidden -mapy yHidden
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    lassign [$graph extents plotarea] left top width height
    set x [expr {$left+$width/3}]
    set y [expr {$top+$height*2/3}]
    set expected [list {*}[ExpectedWheelLimits $graph x 0.5 $x] {*}[ExpectedWheelLimits $graph y 0.5 $y]\
                          {*}[ExpectedWheelLimits $graph xHidden 0.5 $x] {*}[ExpectedWheelLimits $graph yHidden 0.5 $y]\
                          {*}[$graph axis limits xUnused] {*}[$graph axis limits yUnused]]
    GenerateGraphWheelEvent $graph $x $y 120 20
    sleep $defaultDelay
    set actual [list {*}[$graph axis limits x] {*}[$graph axis limits y] {*}[$graph axis limits xHidden]\
                        {*}[$graph axis limits yHidden] {*}[$graph axis limits xUnused] {*}[$graph axis limits yUnused]]
    approxNestedEqual $actual $expected
} -result true -cleanup {
    destroy $widget
}

