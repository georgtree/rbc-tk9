    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive single-stage zoom with multiple axes} {*}$titleFont
    $widget graph axis create y3
    $widget graph axis create y4
    $widget graph yaxis use {y3 y4}
    $widget graph element create line1 -xdata xVec1 -ydata yVec1 -mapy y3
    $widget graph element create line2 -xdata xVec2 -ydata yVec2 -mapy y4
    set graph [$widget subwidget graph]
} -body {
    WaitForWindow $graph
    set initial [list {*}[$graph axis limits x] {*}[$graph axis limits y3] {*}[$graph axis limits x]\
                         {*}[$graph axis limits y4]]
    set expectedStates [list $initial]
    set actualStates [list $initial]
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    lappend expectedStates [list {*}[ExpectedZoomLimits $graph $aXPointBox $aYPointBox $bXPointBox $bYPointBox x y3]\
                                    {*}[ExpectedZoomLimits $graph $aXPointBox $aYPointBox $bXPointBox $bYPointBox x y4]]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox
    GenerateGraphEvent $graph <Motion> $bXPointBox $bYPointBox
    GenerateGraphEvent $graph <ButtonPress-1> $bXPointBox $bYPointBox
    GenerateGraphEvent $graph <ButtonRelease-1> $bXPointBox $bYPointBox
    lappend actualStates [list {*}[$widget widgetcommand graph axis limits x]\
                                  {*}[$widget widgetcommand graph axis limits y3]\
                                  {*}[$widget widgetcommand graph axis limits x]\
                                  {*}[$widget widgetcommand graph axis limits y4]]
    GenerateGraphEvent $graph <ButtonPress-3> $bXPointBox $bYPointBox
    GenerateGraphEvent $graph <ButtonRelease-3> $bXPointBox $bYPointBox
    lappend actualStates [list {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y3]\
                                  {*}[$widget graph axis limits x] {*}[$widget widgetcommand graph axis limits y4]]
    lappend expectedStates [lindex $expectedStates 0]
    return [approxNestedEqual $actualStates $expectedStates]
}  -result true  -cleanup {
    destroy $widget
}

