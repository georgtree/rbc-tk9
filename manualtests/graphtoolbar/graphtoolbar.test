    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
    set axis x
    set side bottom
} -body {
    WaitForWindow $graph
    # generate zoom window coordinates
    lassign [$graph extents plotarea] leftMargin topMargin plotWidth plotHeight
    set aXPointBox [expr {$leftMargin+$plotWidth/3}]
    set aYPointBox [expr {$topMargin+$plotHeight/3}]
    set bXPointBox [expr {$leftMargin+$plotWidth*2/3}]
    set bYPointBox [expr {$topMargin+$plotHeight*2/3}]
    # generate active axis coordinates
    lassign [FindAxisPoint $graph $axis $side] axisX axisY
    set plotX [expr {[$graph extents leftmargin]+[$graph extents plotwidth]/2}]
    set plotY [expr {[$graph extents topmargin]+[$graph extents plotheight]/2}]
    set scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <ButtonPress-1> $aXPointBox $aYPointBox
    GenerateGraphEvent $graph <Motion> $axisX $axisY
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    GenerateGraphEvent $graph <Motion> $axisX $axisY
    GenerateGraphEvent $graph <ButtonPress-1> $axisX $axisY
    GenerateGraphEvent $graph <ButtonRelease-1> $axisX $axisY 20
    sleep 500
    lappend scale [lindex [$graph axis configure $axis -logscale] end]
    return $scale
}  -result {0 0 1}  -cleanup {
    destroy $widget
}

#### active legend
test activeLegendInteractive-1 {interactive three-state active legend} -constraints {isInteractive isActiveLegend}\
        -setup {
    set widget [::graphtoolbar::graphtoolbar .gtb {*}$winSize -activelegend]
    grid .gtb -row 0 -column 0 -sticky nsew
    grid columnconfigure . 0 -weight 1
    grid rowconfigure . 0 -weight 1
    $widget graph configure -title {Interactive three-state active legend} {*}$titleFont
    $widget graph element create line1 -xdata xVec1 -ydata yVec1
    $widget graph element create line2 -xdata xVec2 -ydata yVec2
    set graph [$widget subwidget graph]
    set element line1
} -body {
    WaitForWindow $graph
    lassign [FindLegendPoint $graph $element] legendX legendY
    set states [list]
    # Initial state: normal.
    lappend states [list [expr {$element in [$graph element activate]}] [$graph element cget $element -hideplot]\
                            [$graph element cget $element -labelrelief]]
    # first click: normal -> active.
    GenerateGraphEvent $graph <Motion> $legendX $legendY 20
    GenerateGraphEvent $graph <ButtonPress-1> $legendX $legendY
    GenerateGraphEvent $graph <ButtonRelease-1> $legendX $legendY 20
    lappend states [list [expr {$element in [$graph element activate]}] [$graph element cget $element -hideplot]\
                            [$graph element cget $element -labelrelief]]
    # second click: active -> plot-hidden.
    GenerateGraphEvent $graph <Motion> $legendX $legendY 20
    GenerateGraphEvent $graph <ButtonPress-1> $legendX $legendY
    GenerateGraphEvent $graph <ButtonRelease-1> $legendX $legendY 20
    lappend states [list [expr {$element in [$graph element activate]}] [$graph element cget $element -hideplot]\
                            [$graph element cget $element -labelrelief]]
    # the legend entry must still exist while the element is plot-hidden.
    set legendStillPresent [expr {[$graph legend get @$legendX,$legendY] eq $element}]
    # third click: plot-hidden -> normal.
    GenerateGraphEvent $graph <Motion> $legendX $legendY 20
    GenerateGraphEvent $graph <ButtonPress-1> $legendX $legendY
    GenerateGraphEvent $graph <ButtonRelease-1> $legendX $legendY 20
    lappend states [list [expr {$element in [$graph element activate]}] [$graph element cget $element -hideplot]\
                            [$graph element cget $element -labelrelief]]
    return [list $states $legendStillPresent]
} -result {{{0 0 flat} {1 0 raised} {0 1 sunken} {0 0 flat}} 1} -cleanup {
    destroy $widget
}

cleanupTests




